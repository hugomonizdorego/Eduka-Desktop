def fail(message):
    print(message, file=sys.stderr)
    sys.exit(2)


def caller_uid():
    try:
        return int(os.environ.get('PKEXEC_UID', os.getuid()))
    except ValueError:
        return os.getuid()


def on_accent(accent):
    r, g, b = (int(accent[i:i + 2], 16) for i in (1, 3, 5))
    return '#10231e' if (0.299 * r + 0.587 * g + 0.114 * b) > 170 else '#ffffff'


def field_color(accent):
    """The accent a little darker (Qt.darker(accent, 1.18) of Main.qml), so
    white text on the fields stays readable."""
    r, g, b = (int(accent[i:i + 2], 16) for i in (1, 3, 5))
    return '#%02x%02x%02x' % tuple(max(0, min(255, round(c / 1.18))) for c in (r, g, b))


