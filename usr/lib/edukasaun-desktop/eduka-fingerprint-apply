"""Switch fingerprint login on or off for the whole computer. Runs as root
through pkexec (polkit action org.edukasaun.desktop.fingerprint, which always
asks for an administrator password).

  eduka-fingerprint-apply --enable     pam-auth-update --enable fprintd
  eduka-fingerprint-apply --disable    pam-auth-update --disable fprintd
  eduka-fingerprint-apply --status     prints "enabled" or "disabled"

Only Debian's own PAM profile of libpam-fprintd (/usr/share/pam-configs/fprintd)
is switched, with Debian's pam-auth-update; nothing else is accepted. The
login screen, the screen lock, sudo and polkit then accept a finger and still
accept the password.
"""
import os, subprocess, sys

PROFILE = '/usr/share/pam-configs/fprintd'
COMMON_AUTH = '/etc/pam.d/common-auth'
PAM_AUTH_UPDATE = '/usr/sbin/pam-auth-update'
ACTIONS = {'--enable': '--enable', '--disable': '--disable'}


def enabled():
    try:
        with open(COMMON_AUTH, encoding='utf-8', errors='ignore') as f:
            return any('pam_fprintd.so' in line and not line.lstrip().startswith('#') for line in f)
    except OSError:
        return False


def main(argv):
    if len(argv) != 1 or argv[0] not in (*ACTIONS, '--status'):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    if argv[0] == '--status':
        print('enabled' if enabled() else 'disabled')
        return 0
    if os.geteuid() != 0:
        print('eduka-fingerprint-apply must run as root (pkexec).', file=sys.stderr)
        return 1
    if not os.path.isfile(PROFILE):
        print('libpam-fprintd is not installed (no PAM profile fprintd).', file=sys.stderr)
        return 3
    if not os.access(PAM_AUTH_UPDATE, os.X_OK):
        print('pam-auth-update is not installed.', file=sys.stderr)
        return 3
    env = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL': 'C.UTF-8', 'DEBIAN_FRONTEND': 'noninteractive'}
    try:
        r = subprocess.run([PAM_AUTH_UPDATE, ACTIONS[argv[0]], 'fprintd'], env=env, stdin=subprocess.DEVNULL,
                           capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired) as e:
        print(f'pam-auth-update failed: {e}', file=sys.stderr)
        return 1
    if r.stdout:
        sys.stdout.write(r.stdout)
    if r.stderr:
        sys.stderr.write(r.stderr)
    want = argv[0] == '--enable'
    if r.returncode == 0 and enabled() != want:
        # pam-auth-update keeps files that were changed by hand.
        print('The PAM files were changed by hand; pam-auth-update left them as they are.', file=sys.stderr)
        return 4
    return r.returncode


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
