"""Prepare the LXQt settings of this account for an Eduka-Desktop session.

Run by eduka-desktop-session as the user, every login, before startlxqt
(nothing of LXQt runs yet, so no LXQt program writes these files meanwhile):

* lxqt-panel and lxqt-notificationd do not start: Eduka-Panel is the panel,
  the Action Center and the notification server of Eduka-Desktop. This is
  LXQt's own way to switch off an autostart module (a copy of its entry in
  ~/.config/autostart with Hidden=true). Before 0.11 lxqt-panel started and
  was stopped a few seconds later: it flashed at every login and its main
  menu held the Super key. The files carry a mark; removing the package
  deletes them again (postrm).
* picom's own autostart entry (/etc/xdg/autostart/picom.desktop, started in
  every desktop) stays off as well: Eduka-Panel starts picom itself with the
  settings of the theme and of Eduka-Settings → Compositor, and leaves it
  off with xfwm4 or KWin, which composite themselves. Before 0.11 the
  autostart picom (with shadows and fading from picom.conf) came first and
  Eduka's compositor settings were not used.
* The Super (Windows) key opens Eduka-Desktop, the start menu, through
  lxqt-globalkeys (the LXQt shortcut daemon).
* The Windows shortcuts (Super+E, Super+D, Super+arrows, …) and the sound
  and media keys are added next to LXQt's own (0.11 RC3, eduka_shortcuts),
  without taking a key that LXQt, the user or the window manager uses.

Files the user made (without the mark) are never changed.
"""
import configparser, json, os, sys, tempfile

MARK = 'Disabled by Edukasaun Desktop'
HIDE = {
    'lxqt-panel.desktop': ('LXQt Panel', 'lxqt-panel', True),
    'lxqt-notifications.desktop': ('LXQt Notification Daemon', 'lxqt-notificationd', True),
    'picom.desktop': ('picom', 'picom', False),
}
SHORTCUT_COMMENT = 'Eduka-Desktop (start menu)'
SHORTCUT_SECTION = 'Super_L.900'
SHORTCUT_EXEC = 'eduka-menu, --toggle'


def config_home():
    return os.environ.get('XDG_CONFIG_HOME') or os.path.join(os.path.expanduser('~'), '.config')


def write_atomic(path, text):
    folder = os.path.dirname(path)
    os.makedirs(folder, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix='.eduka-', dir=folder)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            f.write(text)
        mask = os.umask(0o022); os.umask(mask)
        os.chmod(tmp, 0o644 & ~mask)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def hide_lxqt_modules(cfg):
    for name, (title, program, module) in HIDE.items():
        path = os.path.join(cfg, 'autostart', name)
        if os.path.lexists(path):
            try:
                if os.path.islink(path):
                    continue
                with open(path, encoding='utf-8', errors='ignore') as f:
                    if MARK not in f.read():
                        continue          # the user's own entry
            except OSError:
                continue
        write_atomic(path,
                     '[Desktop Entry]\n'
                     'Type=Application\n'
                     f'Name={title}\n'
                     f'Comment={MARK}: Eduka-Panel replaces it in Eduka-Desktop sessions\n'
                     f'Exec={program}\n'
                     + ('OnlyShowIn=LXQt;\nX-LXQt-Module=true\n' if module else '') +
                     'Hidden=true\n')


def system_shortcuts():
    """LXQt's default shortcuts (lxqt-globalkeysd reads them while the
    account has no file of its own)."""
    for folder in ('/etc/xdg/lxqt', '/usr/share/lxqt'):
        path = os.path.join(folder, 'globalkeyshortcuts.conf')
        if os.path.isdir(path):           # some packagings ship a folder there
            path = os.path.join(path, 'globalkeyshortcuts.conf')
        if os.path.isfile(path):
            return path
    return ''


def super_key_opens_menu(cfg):
    """Adds Super_L → eduka-menu --toggle to ~/.config/lxqt/globalkeyshortcuts.conf.
    A missing file starts from LXQt's defaults, so the other shortcuts stay."""
    if not any(os.access(os.path.join(d, 'lxqt-globalkeysd'), os.X_OK)
               for d in os.environ.get('PATH', '/usr/bin:/bin').split(':') if d):
        return
    path = os.path.join(cfg, 'lxqt', 'globalkeyshortcuts.conf')
    text = ''
    if os.path.isfile(path):
        with open(path, encoding='utf-8', errors='ignore') as f:
            text = f.read()
    else:
        source = system_shortcuts()
        if source:
            with open(source, encoding='utf-8', errors='ignore') as f:
                text = f.read()
    parser = configparser.RawConfigParser(strict=False, interpolation=None)
    parser.optionxform = str
    try:
        parser.read_string(text)
    except configparser.Error:
        return                                   # a broken file stays as it is
    for section in parser.sections():
        if parser.get(section, 'Comment', fallback='') == SHORTCUT_COMMENT:
            return                               # already there (maybe changed by the user)
    if text and not text.endswith('\n'):
        text += '\n'
    text += ('\n' if text else '') + (f'[{SHORTCUT_SECTION}]\nComment={SHORTCUT_COMMENT}\nEnabled=true\nExec={SHORTCUT_EXEC}\n')
    write_atomic(path, text)


QUICK_COMMENT = 'Eduka-Quick'
# Super+Space switches the keyboard layout (0.11 RC3): no longer offered.
QUICK_KEYS = ('Meta+Q', 'Control+Alt+Space', 'Control+Alt+A')


def quick_launcher_key(cfg):
    """Eduka-Quick (RC2) on its key: the choice of Eduka-Settings
    (~/.config/eduka-desktop/desktop/quick.json, on by default with Super+Q)
    is written before lxqt-globalkeysd reads the file."""
    if not any(os.access(os.path.join(d, 'lxqt-globalkeysd'), os.X_OK)
               for d in os.environ.get('PATH', '/usr/bin:/bin').split(':') if d):
        return
    enabled, key = True, QUICK_KEYS[0]
    try:
        with open(os.path.join(cfg, 'eduka-desktop', 'desktop', 'quick.json'), encoding='utf-8') as f:
            data = json.load(f)
        enabled = bool(data.get('enabled', True))
        key = data.get('hotkey') if data.get('hotkey') in QUICK_KEYS else key
    except (OSError, ValueError, AttributeError):
        pass
    path = os.path.join(cfg, 'lxqt', 'globalkeyshortcuts.conf')
    if not os.path.isfile(path):
        return                                   # super_key_opens_menu makes it first
    with open(path, encoding='utf-8', errors='ignore') as f:
        text = f.read()
    parser = configparser.RawConfigParser(strict=False, interpolation=None)
    parser.optionxform = str
    try:
        parser.read_string(text)
    except configparser.Error:
        return
    encoded = key.replace('+', '%2B')
    mine = [s for s in parser.sections() if parser.get(s, 'Comment', fallback='') == QUICK_COMMENT]
    taken = [s for s in parser.sections() if s.rsplit('.', 1)[0] == encoded and s not in mine]
    lines = text.splitlines()
    if mine:
        section = mine[0]
        ident = section.rsplit('.', 1)[1] if '.' in section else '950'
        out, inside = [], False
        for line in lines:
            st = line.strip()
            if st.startswith('[') and st.endswith(']'):
                inside = st[1:-1] == section
                if inside and not taken:
                    line = f'[{encoded}.{ident}]'
            elif inside and st.startswith('Enabled='):
                line = 'Enabled=' + ('true' if enabled and not taken else 'false')
            out.append(line)
        new = '\n'.join(out) + '\n'
    elif enabled and not taken:
        new = text.rstrip('\n') + f'\n\n[{encoded}.950]\nComment={QUICK_COMMENT}\nEnabled=true\nExec=eduka-quick\n'
    else:
        return
    if new != text:
        write_atomic(path, new)


def windows_shortcuts(cfg):
    """The LXQt and Windows shortcuts of Eduka (0.11 RC3, eduka_shortcuts):
    written before lxqt-globalkeysd reads the file; keys of LXQt, of the
    user and of the window manager are never taken."""
    if not any(os.access(os.path.join(d, 'lxqt-globalkeysd'), os.X_OK)
               for d in os.environ.get('PATH', '/usr/bin:/bin').split(':') if d):
        return
    if '/usr/lib/edukasaun-desktop' not in sys.path:
        sys.path.insert(0, '/usr/lib/edukasaun-desktop')
    import eduka_shortcuts
    # The window manager starts after this script: read the one LXQt will start.
    wm = ''
    try:
        with open(os.path.join(cfg, 'lxqt', 'session.conf'), encoding='utf-8', errors='ignore') as f:
            m = [l.split('=', 1)[1].strip() for l in f if l.strip().startswith('window_manager=')]
        wm = os.path.basename(m[-1]) if m else ''
    except OSError:
        pass
    if not wm:                                   # first login: the one lxqt-defaults.sh will pick
        import shutil
        wm = next((w for w in ('xfwm4', 'kwin_x11', 'openbox', 'marco', 'fluxbox', 'icewm') if shutil.which(w)), '')
    eduka_shortcuts.apply(cfg, wm=wm)


def display_scale(cfg):
    """A sharp screen at the first login of an account: the display scale
    recommended for it (eduka_device, 0.11 RC3), once; Eduka-Settings →
    Display changes it later."""
    if not os.environ.get('DISPLAY'):
        return
    if '/usr/lib/edukasaun-desktop' not in sys.path:
        sys.path.insert(0, '/usr/lib/edukasaun-desktop')
    import eduka_device
    eduka_device.first_login_scale(cfg)


def touch(cfg):
    """Touch screens and touchpads (eduka_touch, 0.11 RC3): smooth finger
    scrolling in Firefox for every session, and once per account the
    gestures (Touchégg) and, on a tablet, the on-screen keyboard."""
    if '/usr/lib/edukasaun-desktop' not in sys.path:
        sys.path.insert(0, '/usr/lib/edukasaun-desktop')
    import eduka_touch, eduka_device
    conf = os.path.join(cfg, 'lxqt', 'session.conf')
    try:
        with open(conf, encoding='utf-8', errors='ignore') as f:
            have = f.read()
    except OSError:
        have = ''
    missing = {k: v for k, v in eduka_touch.session_environment().items() if f'{k}=' not in have}
    if missing:
        from pathlib import Path
        eduka_device._set_environment(Path(conf), missing)
    if os.environ.get('DISPLAY'):
        eduka_touch.first_login(cfg)


def main():
    cfg = config_home()
    for step in (hide_lxqt_modules, super_key_opens_menu, quick_launcher_key, windows_shortcuts, display_scale, touch):
        try:
            step(cfg)
        except Exception as e:                   # never stop the login
            print(f'eduka-session-prepare: {step.__name__}: {e}', file=sys.stderr)
    return 0


if __name__ == '__main__':
    sys.exit(main())
