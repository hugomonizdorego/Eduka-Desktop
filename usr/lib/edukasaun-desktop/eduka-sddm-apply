"""Apply Edukasaun login screen (SDDM) settings. Runs as root via pkexec.

Reads one JSON object from standard input (written by Eduka-Settings):
  style          light | dark | glass | pastel
  accent         #rrggbb
  title          short text shown on the login card
  default_user   user name pre-filled on the login screen ('' = none)
  show_clock     true / false
  background     image path to copy, '' = keep, 'reset' = use the built-in gradient
  logo           image path to copy, '' = keep, 'reset' = Edukasaun logo
  autologin_user '' = ask for the password, otherwise that user logs in automatically

Every value is validated; images must be real PNG/JPEG/WebP/BMP files that the
calling user may read, so this helper cannot be used to copy other files.

The first argument picks what is changed, and with it the polkit action:
  --look       everything but automatic login (org.edukasaun.desktop.sddm-config;
               administrators at the computer need no password)
  --autologin  only autologin_user (org.edukasaun.desktop.sddm-autologin; always
               asks for an administrator password, so nobody can switch on
               automatic login from an unlocked session)
Without an argument pkexec asks for the password and both are applied.
"""
import json, os, pwd, re, shutil, stat, sys, tempfile

THEME_DIR = '/usr/share/sddm/themes/edukasaun'
USER_CONF = THEME_DIR + '/theme.conf.user'
DATA_DIR = '/usr/share/Edukasaun/SDDM'
BACKGROUND = DATA_DIR + '/Default.png'
LOGO = DATA_DIR + '/Logo.png'
DEFAULT_LOGO = '/usr/share/Edukasaun/Logo/Edukasaun Logo.png'
AUTOLOGIN = '/etc/sddm.conf.d/20-eduka-autologin.conf'
THEME_PIN = '/etc/sddm.conf.d/zz-edukasaun-theme.conf'
METADATA = THEME_DIR + '/metadata.desktop'
SESSION = 'edukasaun-desktop.desktop'
STYLES = ('light', 'dark', 'glass', 'pastel')
MODES = ('--look', '--autologin')
MAX_IMAGE = 25 * 1024 * 1024


def fail(message):
    print(message, file=sys.stderr)
    sys.exit(2)


def caller_uid():
    try:
        return int(os.environ.get('PKEXEC_UID', os.getuid()))
    except ValueError:
        return os.getuid()


def open_image(path, uid):
    """Open the picture once and check that very file (owner, mode, size and
    the picture header come from the opened file, so it cannot be swapped for
    another file between the check and the copy)."""
    real = os.path.realpath(path)
    try:
        fd = os.open(real, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        fail(f'Image not found: {path}')
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_size <= 0 or st.st_size > MAX_IMAGE:
        os.close(fd)
        fail(f'Not a usable image file: {path}')
    readable_by_caller = (st.st_mode & 0o004) or (st.st_uid == uid and st.st_mode & 0o400)
    if not readable_by_caller:
        os.close(fd)
        fail(f'The image must be readable by your account: {path}')
    head = os.pread(fd, 16, 0)
    is_image = (head.startswith(b'\x89PNG\r\n\x1a\n') or head[:3] == b'\xff\xd8\xff'
                or (head[:4] == b'RIFF' and head[8:12] == b'WEBP') or head[:2] == b'BM')
    if not is_image:
        os.close(fd)
        fail(f'Only PNG, JPEG, WebP or BMP pictures can be used: {path}')
    return fd


def install_image(source_fd, target):
    os.makedirs(os.path.dirname(target), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(target))
    with os.fdopen(source_fd, 'rb') as src, os.fdopen(fd, 'wb') as dst:
        src.seek(0)
        shutil.copyfileobj(src, dst, 1024 * 1024)
    os.chmod(tmp, 0o644)
    os.replace(tmp, target)


def write_text(path, text, mode=0o644):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
    with os.fdopen(fd, 'w', encoding='utf-8') as handle:
        handle.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def ensure_theme_active():
    """SDDM reads /etc/sddm.conf.d in order and /etc/sddm.conf last: make
    every place point to the Edukasaun theme."""
    write_text(THEME_PIN, '# Written by Eduka-Settings: use the Edukasaun login screen.\n[Theme]\nCurrent=edukasaun\n')
    main_conf='/etc/sddm.conf'
    if os.path.exists(main_conf):
        with open(main_conf, encoding='utf-8', errors='ignore') as handle:
            text=handle.read()
        new=re.sub(r'(?m)^(\s*Current\s*=).*$', r'\1edukasaun', text)
        if new != text:
            write_text(main_conf, new)


def ensure_qt_version():
    """SDDM 0.21 starts the Qt 6 greeter only for themes that say
    QtVersion=6; the theme works with both greeters."""
    if not os.path.exists(METADATA):
        return
    with open(METADATA, encoding='utf-8') as handle:
        lines=[l for l in handle.read().splitlines() if not l.startswith('QtVersion=')]
    qt6=shutil.which('sddm-greeter-qt6') is not None and shutil.which('sddm-greeter') is None
    if qt6:
        lines.append('QtVersion=6')
    write_text(METADATA, '\n'.join(lines)+'\n')


def apply_look(req, uid):
    style = str(req.get('style', 'light'))
    if style not in STYLES:
        fail('Unknown style.')
    accent = str(req.get('accent', '#00a879'))
    if not re.fullmatch(r'#[0-9a-fA-F]{6}', accent):
        fail('Accent must look like #00a879.')
    title = str(req.get('title', 'Edukasaun')).strip() or 'Edukasaun'
    if len(title) > 40 or not re.fullmatch(r"[\w .'()&!?-]+", title):
        fail('Title: up to 40 letters, digits, spaces and . \' ( ) & ! ? -')
    user = str(req.get('default_user', '')).strip()
    if user and not re.fullmatch(r'[a-z_][a-z0-9_-]{0,31}', user):
        fail('Invalid user name.')
    show_clock = 'true' if req.get('show_clock', True) else 'false'

    background = str(req.get('background', ''))
    if background == 'reset':
        if os.path.exists(BACKGROUND):
            os.remove(BACKGROUND)
    elif background:
        install_image(open_image(background, uid), BACKGROUND)

    logo = str(req.get('logo', ''))
    logo_path = LOGO if os.path.exists(LOGO) else DEFAULT_LOGO
    if logo == 'reset':
        if os.path.exists(LOGO):
            os.remove(LOGO)
        logo_path = DEFAULT_LOGO
    elif logo:
        install_image(open_image(logo, uid), LOGO)
        logo_path = LOGO

    write_text(USER_CONF, (
        '# Written by Eduka-Settings (Login Screen page).\n'
        '[General]\n'
        f'style={style}\n'
        f'accent={accent}\n'
        f'title={title}\n'
        f'defaultUser={user}\n'
        f'showClock={show_clock}\n'
        f'background={BACKGROUND}\n'
        f'logo={logo_path}\n'))
    ensure_theme_active()
    ensure_qt_version()


def apply_autologin(req):
    autologin = str(req.get('autologin_user', '')).strip()
    if autologin:
        if not re.fullmatch(r'[a-z_][a-z0-9_-]{0,31}', autologin):
            fail('Invalid automatic login user.')
        try:
            entry = pwd.getpwnam(autologin)
        except KeyError:
            fail(f'User {autologin} does not exist.')
        shell = os.path.basename(entry.pw_shell or '')
        if not 1000 <= entry.pw_uid < 60000 or shell in ('nologin', 'false'):
            fail('Automatic login is only possible for normal user accounts.')
        write_text(AUTOLOGIN, (
            '# Written by Eduka-Settings: log in automatically.\n'
            '[Autologin]\n'
            f'User={autologin}\n'
            f'Session={SESSION}\n'
            'Relogin=false\n'))
    elif os.path.exists(AUTOLOGIN):
        os.remove(AUTOLOGIN)


def main():
    if os.geteuid() != 0:
        fail('eduka-sddm-apply must run as root (use pkexec).')
    mode = sys.argv[1] if len(sys.argv) > 1 else ''
    if mode and mode not in MODES:
        fail('Unknown option: use --look or --autologin.')
    try:
        req = json.loads(sys.stdin.read(65536))
    except Exception:
        fail('Invalid request.')
    if not isinstance(req, dict):
        fail('Invalid request.')
    if mode in ('', '--look'):
        apply_look(req, caller_uid())
    if mode in ('', '--autologin'):
        apply_autologin(req)
    print('Login screen updated.')


if __name__ == '__main__':
    main()
