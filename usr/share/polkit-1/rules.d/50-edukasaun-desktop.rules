// Edukasaun OS: administrators (group sudo) sitting at the computer can
// change the look of the login screen (SDDM and LightDM) from Eduka-Settings
// without typing the password for every change. The helpers eduka-sddm-apply
// and eduka-lightdm-apply still check every value. Automatic login, the
// choice of display manager and Parental Control always ask for the password.
polkit.addRule(function(action, subject) {
    if ((action.id == "org.edukasaun.desktop.sddm-config" ||
         action.id == "org.edukasaun.desktop.lightdm-config") &&
        subject.local && subject.active && subject.isInGroup("sudo")) {
        return polkit.Result.YES;
    }
});

// The clock (Eduka-Settings → Date & Time, Action Center → Sync time):
// everyone sitting at the computer may switch network time on and sync the
// clock, which can only make it right; administrators may also change the
// time zone without typing the password. Setting the clock by hand, the time
// zone for other accounts and the hardware clock mode still ask for the
// password: the clock could otherwise move Parental Control's day.
polkit.addRule(function(action, subject) {
    if (!subject.local || !subject.active) {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id == "org.freedesktop.timedate1.set-ntp") {
        return polkit.Result.YES;
    }
    if (action.id == "org.freedesktop.timedate1.set-timezone" && subject.isInGroup("sudo")) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
