#!/bin/sh
# Create the standard Edukasaun account: user "edukasaun", password
# "edukasaun", with administrator rights (group sudo), so the same password
# answers every "Authentication required" prompt. Run as root. The package
# does this by itself while the ISO is built (no personal account exists
# yet). After installation the installer creates the owner's own account and
# the standard account is locked (see live-autologin).
set -e
NAME=edukasaun
MARKER=/var/lib/edukasaun-desktop/default-user
if [ "$(id -u)" -ne 0 ]; then
    echo "Run as root: sudo eduka-default-user" >&2
    exit 1
fi
groups=""
for g in sudo audio video plugdev netdev bluetooth lpadmin scanner cdrom dip users; do
    getent group "$g" >/dev/null 2>&1 && groups="${groups:+$groups,}$g"
done
mkdir -p "$(dirname "$MARKER")"
if getent passwd "$NAME" >/dev/null 2>&1; then
    # Existing standard account: make sure it can answer admin prompts.
    [ -n "$groups" ] && usermod -a -G "$groups" "$NAME"
    echo "User $NAME already exists; groups updated."
    exit 0
fi
useradd --create-home --shell /bin/bash --comment "Edukasaun" ${groups:+--groups "$groups"} "$NAME"
echo "$NAME:$NAME" | chpasswd
echo "$NAME" > "$MARKER"
echo "Created user $NAME (password: $NAME, administrator)."
