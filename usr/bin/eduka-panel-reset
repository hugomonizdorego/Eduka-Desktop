"""eduka-panel-reset [--all]

Restore the default settings of Eduka-Desktop, Eduka-Panel and the
Eduka-Desktop menu for this account. A copy of ~/.config/eduka-desktop is
kept first (~/.config/eduka-desktop.backup-<date>-<time>).

Without --all the agenda, favorites, pinned applications and saved
notifications stay; --all starts again from an empty settings folder.
"""
import sys, shutil, time
sys.path.insert(0,'/usr/lib/edukasaun-desktop')
from eduka_common import (BASE_CONFIG, save_panel_config, save_menu_config, save_desktop_config,
                          DEFAULT_PANEL, DEFAULT_MENU, DEFAULT_DESKTOP, panel_running, request_panel_restart)


def main(args):
    if '-h' in args or '--help' in args:
        print(__doc__.strip())
        return 0
    if BASE_CONFIG.exists():
        stamp=time.strftime('%Y%m%d-%H%M%S')
        backup=BASE_CONFIG.with_name(f'{BASE_CONFIG.name}.backup-{stamp}')
        n=1
        while backup.exists():
            n+=1; backup=BASE_CONFIG.with_name(f'{BASE_CONFIG.name}.backup-{stamp}-{n}')
        shutil.copytree(BASE_CONFIG, backup, symlinks=True)
        print(f'Old settings copied to {backup}')
        if '--all' in args:
            shutil.rmtree(BASE_CONFIG)
    save_panel_config(DEFAULT_PANEL); save_menu_config(DEFAULT_MENU); save_desktop_config(DEFAULT_DESKTOP)
    if panel_running() and request_panel_restart():
        print('Eduka settings reset. Eduka-Panel starts again with them.')
    else:
        print('Eduka settings reset. They are used the next time Eduka-Panel starts.')
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
