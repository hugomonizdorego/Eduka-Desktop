#!/usr/bin/env python3
"""Reliable Qt About dialog for every Edukasaun Desktop component."""
import sys

from PyQt5.QtCore import Qt
from PyQt5.QtWidgets import (
    QApplication, QDialog, QDialogButtonBox, QFrame, QHBoxLayout,
    QLabel, QTextBrowser, QVBoxLayout,
)

sys.path.insert(0, '/usr/lib/edukasaun-desktop')
from eduka_common import START_ICON, VERSION, get_icon, icon_theme_setup, install_translations, _


class AboutDialog(QDialog):
    def __init__(self):
        super().__init__()
        self.setWindowTitle(_('About Edukasaun Desktop'))
        self.setWindowIcon(get_icon(START_ICON, 'help-about'))
        self.setWindowFlag(Qt.WindowStaysOnTopHint, True)
        self.setModal(True)
        self.resize(610, 500)
        self.setMinimumSize(560, 440)

        root = QVBoxLayout(self)
        root.setContentsMargins(18, 18, 18, 16)
        root.setSpacing(12)

        header = QFrame()
        header_layout = QHBoxLayout(header)
        header_layout.setContentsMargins(4, 2, 4, 2)
        logo = QLabel()
        logo.setPixmap(get_icon(START_ICON, 'start-here').pixmap(58, 58))
        header_layout.addWidget(logo)
        title = QLabel(
            f"<b style='font-size:22px'>Edukasaun Desktop</b><br>"
            f"<span style='font-size:15px;color:#008b68'>{_('Suite Version')} {VERSION}</span>"
        )
        header_layout.addWidget(title, 1)
        root.addWidget(header)

        details = QTextBrowser()
        details.setOpenExternalLinks(True)
        notes = [
            _('Eduka-Desktop follows the language chosen when the computer starts; Tetun is built in.'),
            _('New login screen with user pictures, keyboard layout, accessibility and power menu.'),
            _('The Action Center never leaves the screen: its content scrolls when space is short.'),
            _('One clock color for the digital, analog and LED clock.'),
            _('Rounded drop-down lists, softer themes and helpers of virtual machines hidden.'),
        ]
        rows = [('Eduka-Desktop', _('Start menu and application launcher')), ('Eduka-Panel', _('Panel, taskbar and status controls')),
                ('Eduka-Menu', _('Launcher button and toggle bridge')), ('Eduka-Settings', _('Configuration center'))]
        details.setHtml(
            f"<h3>{_('About Edukasaun Desktop Suite')}</h3>"
            f"<p><b>{_('Visible system name')}:</b> Edukasaun Desktop<br>"
            f"<b>{_('Internal launcher engine')}:</b> Eduka-Desktop<br>"
            f"<b>{_('Release target')}:</b> {_('Final Version')} 1.1.12 — {_('November 2026')}</p>"
            "<table cellspacing='4' cellpadding='5' width='100%'>"
            + ''.join(f"<tr><td><b>{n}</b></td><td>{VERSION}</td><td>{d}</td></tr>" for n, d in rows)
            + f"</table><h3>{_('Version')} {VERSION}</h3><ul>"
            + ''.join(f'<li>{x}</li>' for x in notes)
            + f"</ul><p><b>{_('Developer')}:</b> Hugo Moniz do Rego<br>"
            f"<b>{_('Organizations')}:</b> STI, Digitalização &amp; Mídia – MCAS and Grupo IDEA</p>")
        root.addWidget(details, 1)

        buttons = QDialogButtonBox(QDialogButtonBox.Close)
        buttons.rejected.connect(self.reject)
        root.addWidget(buttons)

        self.setStyleSheet("""
        QDialog{background:#f5fbf8;color:#1f2d2a;}
        QFrame{background:transparent;border:0;}
        QLabel{color:#1f2d2a;}
        QTextBrowser{background:white;color:#1f2d2a;border:1px solid #dbe8e3;border-radius:14px;padding:12px;}
        QPushButton{background:#00a879;color:white;border:0;border-radius:10px;padding:8px 22px;font-weight:800;}
        QPushButton:hover{background:#008f68;}
        """)


def main():
    app = QApplication(sys.argv)
    install_translations(app)
    app.setApplicationName('Eduka-About')
    icon_theme_setup(force=True)
    dialog = AboutDialog()
    return dialog.exec_()


if __name__ == '__main__':
    sys.exit(main())
