"""Reliable Qt About dialog for every Edukasaun Desktop component."""
import os, sys
os.environ.setdefault('QT_LINUX_ACCESSIBILITY_ALWAYS_ON', '1')

from PyQt5.QtCore import Qt
from PyQt5.QtWidgets import (
    QApplication, QDialog, QDialogButtonBox, QFrame, QHBoxLayout,
    QLabel, QTextBrowser, QVBoxLayout,
)

sys.path.insert(0, '/usr/lib/edukasaun-desktop')
from eduka_common import START_ICON, VERSION, get_icon, icon_theme_setup, install_translations, theme_accent, theme_tokens, dialog_qss, _


class AboutDialog(QDialog):
    def __init__(self):
        super().__init__()
        self.setWindowTitle(_('About Edukasaun Desktop'))
        self.setWindowIcon(get_icon(START_ICON, 'help-about'))
        self.setWindowFlag(Qt.WindowStaysOnTopHint, True)
        self.setModal(True)
        self.resize(660, 560)
        self.setMinimumSize(560, 440)

        root = QVBoxLayout(self)
        root.setContentsMargins(18, 18, 18, 16)
        root.setSpacing(12)

        header = QFrame()
        header_layout = QHBoxLayout(header)
        header_layout.setContentsMargins(4, 2, 4, 2)
        logo = QLabel()
        logo.setPixmap(get_icon(START_ICON, 'start-here').pixmap(58, 58))
        header_layout.addWidget(logo)
        title = QLabel(
            f"<b style='font-size:22px'>Edukasaun Desktop</b><br>"
            f"<span style='font-size:15px;color:{theme_accent()}'>{_('Suite Version')} {VERSION}</span>"
        )
        header_layout.addWidget(title, 1)
        root.addWidget(header)

        details = QTextBrowser()
        details.setOpenExternalLinks(True)
        details.document().setDefaultStyleSheet(f'a{{color:{theme_accent()};text-decoration:none;}}')
        notes = [
            _('Update 3: the license and credits of every part (Debian copyright file and manual pages), automatic login always asks for an administrator password, and Liquid Glass stays readable on dark wallpapers.'),
            _('Eduka-Pastel, the default theme, now in soft mint green and sky blue with colorful raised cards — for the desktop, programs, dialog boxes and the login screen.'),
            _('Icons: Papirus follows the theme (light or dark), so every icon has the same style.'),
            _('Every theme now changes the whole desktop: GTK and Qt programs, dialog boxes, menus and the window borders.'),
            _('Eduka-Panel: Long, Floating, Short and Dock styles; Wi-Fi, Bluetooth, sound and battery work right in the panel.'),
            _('Eduka-Settings sets the wallpaper, desktop icons, keyboard, mouse and touchpad; changes work at once.'),
            _('Parental Control: times from 5 minutes, set to the hour, minute and second.'),
        ]
        # Work of others that Edukasaun Desktop uses — thank you!
        credits = [
            ('Orchis theme', 'Vince Liu (vinceliuice)', 'https://github.com/vinceliuice/Orchis-theme', 'GPL-3.0', _('Edukasaun-Dark, Eduka-Default and Eduka-Liquid themes')),
            ('Orchis theme (Eduka-Pastel colors)', 'Vince Liu (vinceliuice)', 'https://github.com/vinceliuice/Orchis-theme', 'GPL-3.0', _('Eduka-Pastel theme')),
            ('Yaru-remix', 'Muqtxdir', 'https://github.com/Muqtxdir/yaru-remix', 'GPL-3.0, CC BY-SA 4.0', _('Eduka-Low-Theme')),
            ('Graphite GTK theme', 'Vince Liu (vinceliuice)', 'https://github.com/vinceliuice/Graphite-gtk-theme', 'GPL-3.0', _('Eduka-MultiColor theme')),
            ('Liquid Glass', 'Ryosuke Watanabe (ryohsuke1231)', 'https://github.com/ryohsuke1231/liquid-glass', 'MIT', _('Look of the Liquid Glass theme')),
            ('Noto Emoji', 'Google', 'https://github.com/googlefonts/noto-emoji', 'Apache-2.0', _('Emoji pictures of Parental Control')),
            ('Transparent-Shell-Theme', 'mrbrownstone07', 'https://github.com/mrbrownstone07/Transparent-Shell-Theme', 'GPL-3.0', _('Eduka-Transparan theme')),
            ('Papirus icon theme', 'Papirus Development Team', 'https://github.com/PapirusDevelopmentTeam/papirus-icon-theme', 'GPL-3.0', _('Icons')),
            ('Natural Earth', 'naturalearthdata.com', 'https://www.naturalearthdata.com', _('Public domain'), _('World map of the globe')),
            ('Open-Meteo', 'open-meteo.com', 'https://open-meteo.com', 'CC BY 4.0', _('Weather forecast')),
            ('GeoJS', 'geojs.io', 'https://www.geojs.io', _('Free service'), _('Location for the weather')),
            ('IANA Time Zone Database', 'IANA', 'https://www.iana.org/time-zones', _('Public domain'), _('Time zones and daylight saving time')),
            ('picom', 'Yuxuan Shui (yshui) and contributors', 'https://github.com/yshui/picom', 'MPL-2.0, MIT', _('Compositor: transparency and rounded corners')),
            ('LXQt', 'LXQt team', 'https://lxqt-project.org', 'LGPL-2.1+, GPL-2.0+', _('Desktop session, file manager, terminal and settings tools')),
            ('Openbox', _('Openbox developers'), 'http://openbox.org', 'GPL-2.0+', _('Window manager')),
            ('Xfwm4', _('Xfce developers'), 'https://docs.xfce.org/xfce/xfwm4/start', 'GPL-2.0+', _('Window manager with its own compositor')),
            ('SDDM', _('SDDM contributors'), 'https://github.com/sddm/sddm', 'GPL-2.0+', _('Login screen')),
            ('NetworkManager', _('NetworkManager developers'), 'https://networkmanager.dev', 'GPL-2.0+', _('Wired and Wi-Fi networks')),
            ('BlueZ, Blueman', _('BlueZ and Blueman developers'), 'https://www.bluez.org', 'GPL-2.0+, GPL-3.0+', 'Bluetooth'),
            ('PulseAudio, PipeWire', _('PulseAudio and PipeWire developers'), 'https://pipewire.org', 'LGPL-2.1+, MIT', _('Sound')),
            ('UDisks', _('UDisks developers'), 'https://github.com/storaged-project/udisks', 'GPL-2.0+', _('USB sticks and memory cards')),
            ('Orca', _('GNOME Orca developers'), 'https://orca.gnome.org', 'LGPL-2.1+', _('Screen reader')),
            ('Qt', 'The Qt Company', 'https://www.qt.io', 'LGPL-3.0', _('Toolkit')),
            ('PyQt5', 'Riverbank Computing', 'https://www.riverbankcomputing.com/software/pyqt/', 'GPL-3.0', _('Python bindings for Qt')),
            ('Python', 'Python Software Foundation', 'https://www.python.org', 'PSF-2.0', _('Programming language')),
            ('Debian', 'Debian Project', 'https://www.debian.org', _('Free software'), _('Base system')),
        ]
        rows = [('Eduka-Desktop', _('Start menu and application launcher')), ('Eduka-Panel', _('Panel, taskbar and status controls')),
                ('Eduka-Menu', _('Launcher button and toggle bridge')), ('Eduka-Settings', _('Configuration center'))]
        details.setHtml(
            f"<h3>{_('About Edukasaun Desktop Suite')}</h3>"
            f"<p><b>{_('Visible system name')}:</b> Edukasaun Desktop<br>"
            f"<b>{_('Internal launcher engine')}:</b> Eduka-Desktop<br>"
            f"<b>{_('Release target')}:</b> {_('Final Version')} 1.1.12 — {_('November 2026')}</p>"
            "<table cellspacing='4' cellpadding='5' width='100%'>"
            + ''.join(f"<tr><td><b>{n}</b></td><td>{VERSION}</td><td>{d}</td></tr>" for n, d in rows)
            + f"</table><h3>{_('Version')} {VERSION}</h3><ul>"
            + ''.join(f'<li>{x}</li>' for x in notes)
            + f"</ul><p><b>{_('Developer')}:</b> Hugo Moniz do Rego<br>"
            f"<b>{_('Organizations')}:</b> STI, Digitalização &amp; Mídia – MCAS and Grupo IDEA</p>"
            + f"<h3>{_('Credits')}</h3><p>{_('Edukasaun Desktop is built on the work of these people and projects. Thank you!')}</p>"
            "<table cellspacing='2' cellpadding='4' width='100%'>"
            + ''.join(f"<tr><td><a href='{url}'><b>{name}</b></a><br><span style='color:#5b6e69'>{who}</span></td>"
                      f"<td>{use}</td><td style='color:#5b6e69'>{lic}</td></tr>" for name, who, url, lic, use in credits)
            + "</table>"
            + f"<h3>{_('License')}</h3><p>"
            + _('Edukasaun Desktop is free software: you can share and change it under the GNU General Public License, version 3 or (at your option) any later version. It comes without any warranty.')
            + "</p><p><a href='file:///usr/share/common-licenses/GPL-3'>GNU GPL 3</a> • "
            f"<a href='file:///usr/share/doc/edukasaun-desktop-menu/copyright'>{_('Licenses of every part')}</a></p>")
        root.addWidget(details, 1)

        buttons = QDialogButtonBox(QDialogButtonBox.Close)
        buttons.rejected.connect(self.reject)
        root.addWidget(buttons)

        t = theme_tokens()
        self.setStyleSheet(dialog_qss(scoped=False) + f"""
        QFrame{{background:transparent;border:0;}}
        QTextBrowser{{background:{t['card']};color:{t['text']};border:1px solid {t['border']};border-radius:14px;padding:12px;}}
        QPushButton{{background:{t['accent']};color:white;border:0;border-radius:10px;padding:8px 22px;font-weight:800;}}
        QPushButton:hover{{background:{t['accent']};border:1px solid {t['text']};}}
        """)


def main():
    app = QApplication(sys.argv)
    install_translations(app)
    app.setApplicationName('Eduka-About')
    icon_theme_setup(force=True)
    dialog = AboutDialog()
    return dialog.exec_()


if __name__ == '__main__':
    from eduka_common import exit_now
    exit_now(main())
