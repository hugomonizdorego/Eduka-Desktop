"""Eduka leave screen: Lock, Log Out, Sleep, Hibernate, Restart, Shut Down.

eduka-session-action shutdown   show the leave screen with Shut Down ready
                                (Enter runs it)
eduka-session-action --now X    run X at once (lock, logout, suspend,
                                hibernate, restart, shutdown)

The screen dims the desktop and shows the actions as large buttons. A click
on a button runs it at once (0.11 RC3: no countdown, no second button).
Escape or a click on the dim area cancels. Sleep is shown when the computer
can suspend, Hibernate only when it can hibernate (swap and resume set up).
"""
import sys, os
sys.path.insert(0, '/usr/lib/edukasaun-desktop')
from eduka_common import *
from eduka_common import _
from PyQt5.QtWidgets import *
from PyQt5.QtCore import *
from PyQt5.QtGui import *

ALL_ACTIONS = ['lock', 'logout', 'suspend', 'hibernate', 'restart', 'shutdown']
ICONS = {'lock': 'system-lock-screen', 'logout': 'system-log-out', 'suspend': 'system-suspend',
         'hibernate': 'system-suspend-hibernate', 'restart': 'system-reboot', 'shutdown': 'system-shutdown'}
# The color a button turns when the pointer is on it.
COLORS = {'lock': '#3fa684', 'logout': '#2f8fd8', 'suspend': '#7c6cf0', 'hibernate': '#159a9c',
          'restart': '#f08c2e', 'shutdown': '#e5484d'}
HINTS = {'lock': 'Keep your programs open; your password unlocks the screen.',
         'logout': 'Close your programs and go back to the login screen.',
         'suspend': 'Sleep: very little power, back in a few seconds.',
         'hibernate': 'Save everything to the disk and switch off.',
         'restart': 'Close everything and start the computer again.',
         'shutdown': 'Close everything and switch the computer off.'}


def action_text(action, lang=None):
    if action == 'suspend':
        return _('Sleep')
    if action == 'hibernate':
        return _('Hibernate')
    return tr(action, lang)


def available_actions():
    acts = ['lock', 'logout']
    if can_suspend(): acts.append('suspend')
    if can_hibernate(): acts.append('hibernate')
    return acts + ['restart', 'shutdown']


class ActionButton(QToolButton):
    def __init__(self, action, parent=None):
        super().__init__(parent)
        self.action=action
        self.setObjectName('leaveButton'); self.setCursor(Qt.PointingHandCursor); self.setFocusPolicy(Qt.StrongFocus)
        self.setIcon(get_icon(ICONS[action], 'system-shutdown')); self.setIconSize(QSize(42, 42))
        self.setText(action_text(action)); self.setToolButtonStyle(Qt.ToolButtonTextUnderIcon)
        self.setFixedSize(124, 124); self.setAccessibleName(action_text(action))
        self.setAccessibleDescription(_(HINTS[action])); self.setToolTip(_(HINTS[action]))
        self.setProperty('kind', action)


class LeaveScreen(QWidget):
    def __init__(self, action):
        super().__init__(None, Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint | Qt.Tool)
        self.lang=ui_language(); self.composited=compositor_running(force=True)
        if self.composited:
            self.setAttribute(Qt.WA_TranslucentBackground)
        dark=is_dark_theme()
        # Same colors as the menus and dialog boxes of the theme.
        t=theme_tokens(); card=QColor(t['bg']); card.setAlpha(245)
        card_bg=f'rgba({card.red()},{card.green()},{card.blue()},245)'
        text=t['text']; sub=t['sub']; tile=t['hover'] if not dark else 'rgba(255,255,255,16)'; border=t['border']
        per_kind=''.join(
            f"QToolButton#leaveButton[kind=\"{k}\"]:hover, QToolButton#leaveButton[kind=\"{k}\"]:focus"
            f"{{background:{c};border:1px solid {c};color:#ffffff;}}" for k, c in COLORS.items())
        self.setStyleSheet(f"""
            QFrame#card{{background:{card_bg};border:1px solid {border};border-radius:28px;}}
            QLabel{{color:{text};background:transparent;}}
            QLabel#title{{font-size:22px;font-weight:800;}}
            QLabel#sub{{color:{sub};font-size:13px;}}
            QLabel#hint{{color:{sub};font-size:13px;}}
            QToolButton#leaveButton{{background:{tile};border:1px solid {border};border-radius:26px;color:{text};font-size:13px;font-weight:700;padding:12px 4px 10px 4px;}}
            QToolButton#leaveButton:pressed{{padding-top:14px;}}
            {per_kind}
        """)
        outer=QVBoxLayout(self); outer.setContentsMargins(0, 0, 0, 0)
        outer.addStretch(1)
        row=QHBoxLayout(); row.addStretch(1)
        self.card=QFrame(); self.card.setObjectName('card')
        v=QVBoxLayout(self.card); v.setContentsMargins(32, 26, 32, 26); v.setSpacing(16)
        head=QHBoxLayout(); head.setSpacing(14)
        logo='/usr/share/Edukasaun/Logo/Edukasaun Logo.png'
        avatar=QLabel(); avatar.setPixmap((QIcon(logo) if os.path.exists(logo) else QIcon(str(START_ICON))).pixmap(48, 48)); head.addWidget(avatar)
        names=QVBoxLayout(); names.setSpacing(2)
        self.title=QLabel(f'{greeting_text(lang=self.lang)}, {user_display_name()}'.rstrip(', ')); self.title.setObjectName('title'); names.addWidget(self.title)
        self.sub=QLabel(_('Save your work first. Click what you want to do; Esc cancels.')); self.sub.setObjectName('sub'); names.addWidget(self.sub)
        head.addLayout(names, 1); v.addLayout(head)
        self.actions=available_actions()
        grid=QGridLayout(); grid.setSpacing(12); self.buttons={}
        screen=QApplication.primaryScreen().availableGeometry()
        per_row=len(self.actions) if len(self.actions) * 136 + 64 <= screen.width() - 40 else 3
        for i, name in enumerate(self.actions):
            b=ActionButton(name)
            b.clicked.connect(lambda _=False, n=name: self.run(n))
            b.installEventFilter(self)
            grid.addWidget(b, i // per_row, i % per_row); self.buttons[name]=b
        v.addLayout(grid)
        self.hint=QLabel(' '); self.hint.setObjectName('hint'); self.hint.setWordWrap(True); v.addWidget(self.hint)
        row.addWidget(self.card); row.addStretch(1); outer.addLayout(row); outer.addStretch(1)
        self.first=action if action in self.actions else 'shutdown'
        self.setGeometry(QApplication.primaryScreen().geometry())
        QShortcut(QKeySequence(Qt.Key_Escape), self, activated=self.close)
        for i, name in enumerate(self.actions, 1):
            QShortcut(QKeySequence(str(i)), self, activated=lambda n=name: self.run(n))
        self.done=False

    def eventFilter(self, obj, event):
        if isinstance(obj, ActionButton) and event.type() in (QEvent.Enter, QEvent.FocusIn):
            self.hint.setText(_(HINTS[obj.action]))
        return super().eventFilter(obj, event)

    def run(self, action):
        """A click on a big button runs it at once."""
        if self.done:
            return
        self.done=True
        self.releaseKeyboard(); self.hide()
        QApplication.processEvents()
        if action in ('suspend', 'hibernate'):
            # Locked when the computer wakes up again.
            session_action('lock')
            QTimer.singleShot(700, lambda: (session_action(action), QApplication.instance().quit()))
            return
        session_action(action)
        QTimer.singleShot(300, QApplication.instance().quit)

    def paintEvent(self, e):
        p=QPainter(self)
        p.fillRect(self.rect(), QColor(0, 0, 0, 150) if self.composited else QColor('#1e2a27'))

    def mousePressEvent(self, e):
        if not self.card.geometry().contains(e.pos()):
            self.close()

    def closeEvent(self, e):
        self.releaseKeyboard()
        super().closeEvent(e)
        if not self.done:
            QTimer.singleShot(0, QApplication.instance().quit)   # a Qt.Tool window does not end the app

    def showEvent(self, e):
        super().showEvent(e)
        self.activateWindow(); self.raise_()
        # Keys (Esc, 1-6, arrows, Enter) work even before the window manager focuses us.
        QTimer.singleShot(50, self.grabKeyboard)
        b=self.buttons.get(self.first)
        if b: QTimer.singleShot(60, b.setFocus)
        if self.composited:
            self._fade=fade_in(self, 160)

    def keyPressEvent(self, e):
        names=self.actions; cur=next((n for n, b in self.buttons.items() if b.hasFocus()), self.first)
        i=names.index(cur) if cur in names else 0
        if e.key() in (Qt.Key_Right, Qt.Key_Down, Qt.Key_Tab):
            self.buttons[names[(i+1) % len(names)]].setFocus(); return
        if e.key() in (Qt.Key_Left, Qt.Key_Up, Qt.Key_Backtab):
            self.buttons[names[(i-1) % len(names)]].setFocus(); return
        if e.key() in (Qt.Key_Return, Qt.Key_Enter, Qt.Key_Space):
            self.run(cur); return
        super().keyPressEvent(e)


def main():
    args=sys.argv[1:]
    if args[:1] == ['--now']:
        what=args[1] if len(args) > 1 else 'logout'
        what={'sleep': 'suspend', 'standby': 'suspend'}.get(what, what)
        return 0 if session_action(what) else 1
    action=args[0] if args else 'shutdown'
    if action in ('sleep', 'standby'): action='suspend'
    if action == 'lock' or not os.environ.get('DISPLAY'):
        return 0 if session_action(action) else 1
    app=QApplication(sys.argv); install_translations(app); app.setApplicationName('eduka-session-action'); icon_theme_setup()
    w=LeaveScreen(action); w.show()
    return app.exec_()


if __name__ == '__main__':
    exit_now(main())
