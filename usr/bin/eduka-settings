        p.v.addWidget(self.card_title('Time allowed'))
        row=QHBoxLayout(); row.setSpacing(8); self.pc_presets={}
        for secs, label in PRESETS:
            b=QPushButton(label); b.setObjectName('chip'); b.setCheckable(True); b.setCursor(Qt.PointingHandCursor)
            b.clicked.connect(lambda _=False, v=secs: self.set_pc_seconds(v)); row.addWidget(b); self.pc_presets[secs]=b
        row.addStretch(1); p.v.addLayout(row)
        manual=QHBoxLayout(); manual.setSpacing(6)
        manual.addWidget(QLabel('Or set it yourself:'))
        self.pc_h=QSpinBox(); self.pc_h.setRange(0, 24); self.pc_h.setSuffix(' h')
        self.pc_m=QSpinBox(); self.pc_m.setRange(0, 59); self.pc_m.setSuffix(' min')
        self.pc_s=QSpinBox(); self.pc_s.setRange(0, 59); self.pc_s.setSuffix(' s')
        for w, tip in ((self.pc_h, 'Hours'), (self.pc_m, 'Minutes'), (self.pc_s, 'Seconds')):
            w.setToolTip(tip); w.setAccessibleName(tip); w.setMinimumWidth(84); w.valueChanged.connect(self.pc_time_changed); manual.addWidget(w)
        self.pc_total=QLabel(''); self.pc_total.setObjectName('fieldHint'); manual.addWidget(self.pc_total)
        manual.addStretch(1); p.v.addLayout(manual)
        f=form()
        self.pc_mode=QComboBox(); self.pc_mode.addItem('Each time the computer starts', 'boot'); self.pc_mode.addItem('In total per day', 'daily')
        f.addRow('Count:', self.pc_mode); p.v.addLayout(f)
        msg=p.new_card('Message before shutting down')
        self.pc_message=QPlainTextEdit(); self.pc_message.setPlaceholderText('It is time to rest. See you later!'); self.pc_message.setFixedHeight(76)
        self.pc_message.textChanged.connect(lambda: self.pc_message.toPlainText().__len__() > 300 and self.pc_message.setPlainText(self.pc_message.toPlainText()[:300]))
        msg.addWidget(self.pc_message)
        er=QGridLayout(); er.setSpacing(6); self.pc_emojis={}; eg=QButtonGroup(self)
        for i, e in enumerate(EMOJIS):
            b=QToolButton(); b.setObjectName('emojiChip'); b.setCheckable(True); b.setFixedSize(36,36); b.setCursor(Qt.PointingHandCursor)
            ic=emoji_icon(e)
            if ic.isNull(): b.setText(e)
            else: b.setIcon(ic); b.setIconSize(QSize(24, 24))
            eg.addButton(b); er.addWidget(b, i//8, i%8); self.pc_emojis[e]=b
        er.setColumnStretch(8, 1); msg.addLayout(er)
        btns=QHBoxLayout()
        prev=QPushButton('Preview message'); prev.clicked.connect(self.preview_parental); btns.addWidget(prev)
        btns.addStretch(1)
        self.pc_save=QPushButton('Save Parental Control'); self.pc_save.setObjectName('primary'); self.pc_save.clicked.connect(self.save_parental); btns.addWidget(self.pc_save)
        msg.addLayout(btns)
        msg.addWidget(hint_label('Saving always asks for an administrator password, so only parents and teachers can change or switch off the limit. On the message screen a parent can press Ctrl+Alt+P to add 30 minutes.'))
        self.load_parental()
        t=QTimer(self); t.timeout.connect(self.update_parental_status); t.start(5000); self.update_parental_status()
        return p.finish()

    def load_parental(self):
        try:
            with open(PARENTAL_CONF, encoding='utf-8') as f: conf=json.load(f)
        except Exception:
            conf={}
        self.pc_enabled.setChecked(bool(conf.get('enabled', False)))
        try:
            secs=int(conf['seconds']) if conf.get('seconds') is not None else int(conf.get('minutes', 60) or 60)*60
        except Exception:
            secs=3600
        self.set_pc_seconds(secs)
        idx=self.pc_mode.findData(conf.get('mode', 'boot')); self.pc_mode.setCurrentIndex(max(0, idx))
        self.pc_message.setPlainText(str(conf.get('message', '')))
        b=self.pc_emojis.get(conf.get('emoji', '😊')) or next(iter(self.pc_emojis.values())); b.setChecked(True)

    def pc_seconds(self):
        return max(60, min(86400, self.pc_h.value()*3600+self.pc_m.value()*60+self.pc_s.value()))

    def set_pc_seconds(self, secs):
        secs=max(60, min(86400, int(secs)))
        for w, v in ((self.pc_h, secs//3600), (self.pc_m, secs%3600//60), (self.pc_s, secs%60)):
            w.blockSignals(True); w.setValue(v); w.blockSignals(False)
        self.pc_time_changed()

    def pc_time_changed(self, *_a):
        from eduka_parental import duration_text
        raw=self.pc_h.value()*3600+self.pc_m.value()*60+self.pc_s.value(); secs=self.pc_seconds()
        for v, b in self.pc_presets.items(): b.setChecked(v == secs)
        text='= '+duration_text(secs)
        if raw < 60: text+='  '+_('(at least 1 minute)')
        elif raw > 86400: text+='  '+_('(at most 24 hours)')
        self.pc_total.setText(text)

    def parental_request(self):
        emoji=next((e for e, b in self.pc_emojis.items() if b.isChecked()), '😊')
        secs=self.pc_seconds()
        return {'enabled': self.pc_enabled.isChecked(), 'seconds': secs, 'minutes': max(1, -(-secs//60)), 'mode': self.pc_mode.currentData(),
                'message': self.pc_message.toPlainText().strip()[:300], 'emoji': emoji, 'reset': True}

    def update_parental_status(self):
        from eduka_parental import read_state, minutes_text
        st=read_state()
        if st.get('enabled') and st.get('phase') in ('ok', 'warn'):
            used=minutes_text(st.get('used', 0)); left=minutes_text(st.get('remaining', 0))
            self.pc_status.setText(_('✓ On: {u} used, {l} left.').replace('{u}', used).replace('{l}', left))
        elif st.get('phase') == 'lock':
            self.pc_status.setText(_('Time is up — the computer is shutting down.'))
        elif not os.path.exists(PARENTAL_HELPER):
            self.pc_status.setText(_('Parental Control works on Edukasaun OS (eduka-parental.service).'))
        else:
            self.pc_status.setText(_('Off: this computer can be used without a time limit.'))

    def preview_parental(self):
        from eduka_parental import ParentalLockScreen
        r=self.parental_request()
        self._pc_preview=ParentalLockScreen(r['message'], r['emoji'], preview=True); self._pc_preview.show_locked()

    def save_parental(self):
        if shutil.which('pkexec') is None or not os.path.exists(PARENTAL_HELPER):
            self.show_status('Parental Control can only be changed on Edukasaun OS (pkexec missing).', error=True); return
        try:
            out=subprocess.run(['pkexec', PARENTAL_HELPER], input=json.dumps(self.parental_request()), capture_output=True, text=True, timeout=180)
        except Exception as e:
            self.show_status(str(e), error=True); return
        if out.returncode == 0:
            self.show_status('Parental Control saved.'); QTimer.singleShot(1500, self.update_parental_status)
        else:
            self.show_status('Not saved (no administrator password).', error=True)

    def update_compositor_status(self):
        i=compositor_info()
        if i['running']:
            text=_('✓ In use: {n}').replace('{n}', i['name'])
            if i['backend']: text+=f" • {i['backend']}"
            if i['started_by']: text+=' • '+_('started by {x}').replace('{x}', i['started_by'])
        else:
            text=_('⚠ No compositor: transparency is off and Eduka uses its opaque look.')
            if picom_crash_count() >= 3:
                text+='\n'+_('picom stopped working several times, so it is not started again. Press "Restart compositor" to try again.')
        details=[_('Window manager: {w}').replace('{w}', i['wm'] or '?')]
        if i['vm']: details.append(_('Virtual machine: {v} (XRender is used)').replace('{v}', 'VirtualBox' if i['vm'] == 'oracle' else i['vm']))
        if not i['picom_installed']: details.append(_('picom is not installed'))
        self.comp_status.setText(text+'\n'+' • '.join(details))

    def restart_compositor(self):
        save_desktop_config({'compositor': self.compositor.currentData()})
        clear_picom_crashes(); stop_own_picom(); ensure_compositor()
        QTimer.singleShot(600, self.update_compositor_status)
        self.show_status('Compositor restarted.')

    # ------------------------------------------------------------ wallpaper
    def page_wallpaper(self):
        import eduka_wallpaper as ew
        self._ew=ew; cfg=ew.wallpaper_config(); self._wall=cfg
        p=Page('Wallpaper', 'Pictures from /usr/share/Edukasaun/Backgrounds and your own. Point at a picture to see it bigger; changes show on the desktop at once.')
        top=QHBoxLayout(); top.setSpacing(14)
        self.wall_preview=QLabel(); self.wall_preview.setFixedSize(256, 144); self.wall_preview.setObjectName('wallPreview'); self.wall_preview.setAlignment(Qt.AlignCenter)
        top.addWidget(self.wall_preview)
        side=QVBoxLayout(); side.setSpacing(8)
        f=form()
        self.wall_mode=QComboBox()
        for key, label in ew.MODES: self.wall_mode.addItem(label, key)
        f.addRow('Fit:', self.wall_mode)
        self.wall_color=QPushButton(''); self.wall_color.setObjectName('colorButton'); self.wall_color.setFixedSize(60, 28); self.wall_color.clicked.connect(self.pick_wall_color)
        f.addRow('Background color:', self.wall_color)
        side.addLayout(f)
        add=QPushButton('Add pictures…'); add.clicked.connect(self.add_wallpapers); side.addWidget(add, 0, Qt.AlignLeft)
        side.addStretch(1); top.addLayout(side, 1); p.v.addLayout(top)
        self.wall_grid=WallpaperGrid(); p.v.addWidget(self.wall_grid)
        self.wall_grid.hovered.connect(lambda path: self.update_wall_preview(path))
        self.wall_hint=hint_label(''); p.v.addWidget(self.wall_hint)
        sl=p.new_card('Slideshow')
        self.wall_slide=QCheckBox('Change the wallpaper by itself (choose several pictures above)'); sl.addWidget(self.wall_slide)
        fs=form()
        self.wall_interval=QSpinBox(); self.wall_interval.setRange(1, 1440); self.wall_interval.setSuffix(' min'); fs.addRow('Change every:', self.wall_interval)
        self.wall_transition=QComboBox()
        for key, label in ew.TRANSITIONS: self.wall_transition.addItem(label, key)
        fs.addRow('Transition speed:', self.wall_transition)
        self.wall_random=QCheckBox('Random order'); fs.addRow('', self.wall_random)
        sl.addLayout(fs)
        # Load the current choice, then follow every change at once.
        self.wall_mode.setCurrentIndex(max(0, self.wall_mode.findData(cfg['mode'])))
        self.set_wall_color(cfg['color'])
        self.wall_slide.setChecked(cfg['slideshow']); self.wall_interval.setValue(cfg['interval'])
        self.wall_transition.setCurrentIndex(max(0, self.wall_transition.findData(cfg['transition']))); self.wall_random.setChecked(cfg['random'])
        self.fill_wall_grid()
        self._wall_timer=QTimer(self); self._wall_timer.setSingleShot(True); self._wall_timer.timeout.connect(self.apply_wall)
        for sig in (self.wall_mode.currentIndexChanged, self.wall_interval.valueChanged, self.wall_transition.currentIndexChanged, self.wall_random.toggled):
            sig.connect(lambda *_: self._wall_timer.start(250))
        self.wall_slide.toggled.connect(self.wall_slide_toggled)
        self.wall_grid.itemSelectionChanged.connect(lambda: self._wall_timer.start(250))
        self.wall_slide_toggled(cfg['slideshow'], apply=False)
        return p.finish()

    def fill_wall_grid(self):
        cfg=self._wall; paths=self._ew.list_wallpapers(cfg['extra'] + [i for i in cfg['images'] if i not in cfg['extra']])
        self.wall_grid.blockSignals(True); self.wall_grid.set_images(paths)
        for i in range(self.wall_grid.count()):
            it=self.wall_grid.item(i); it.setSelected(it.data(Qt.UserRole) in cfg['images'])
        self.wall_grid.blockSignals(False)
        if not paths:
            self.wall_hint.setText(_('No pictures in /usr/share/Edukasaun/Backgrounds yet — press "Add pictures…". The background color is used meanwhile.'))
        else:
            self.wall_hint.setText(_('{n} pictures. Click one to use it; with the slideshow on, choose several.').replace('{n}', str(len(paths))))
        self.update_wall_preview()

    def wall_slide_toggled(self, on, apply=True):
        self.wall_grid.setSelectionMode(QAbstractItemView.MultiSelection if on else QAbstractItemView.SingleSelection)
        for w in (self.wall_interval, self.wall_transition, self.wall_random): w.setEnabled(on)
        if not on:
            sel=self.wall_grid.selectedItems()
            for it in sel[1:]: it.setSelected(False)
        if apply: self._wall_timer.start(250)

    def set_wall_color(self, color):
        self._wall_color=QColor(color).name()
        self.wall_color.setStyleSheet(f'QPushButton#colorButton{{background:{self._wall_color};border:2px solid #ffffff;border-radius:14px;}}')

    def pick_wall_color(self):
        c=QColorDialog.getColor(QColor(self._wall_color), self, 'Background color')
        if c.isValid(): self.set_wall_color(c.name()); self._wall_timer.start(100)

    def add_wallpapers(self):
        files, _f=QFileDialog.getOpenFileNames(self, 'Add pictures', str(Path.home()/'Pictures'), 'Pictures (*.png *.jpg *.jpeg *.webp *.bmp *.svg)')
        if files:
            self._wall['extra']=list(dict.fromkeys(self._wall['extra']+files)); self._ew.save_wallpaper_config(self._wall); self.fill_wall_grid()

    def wall_choice(self):
        cfg=dict(self._wall)
        cfg.update(mode=self.wall_mode.currentData(), color=self._wall_color, slideshow=self.wall_slide.isChecked(),
                   interval=self.wall_interval.value(), transition=self.wall_transition.currentData(), random=self.wall_random.isChecked(),
                   images=[it.data(Qt.UserRole) for it in self.wall_grid.selectedItems()] or ([] if self.wall_grid.count() else cfg['images']))
        return cfg

    def update_wall_preview(self, path=None):
        cfg=self.wall_choice(); img=path if path is not None else (cfg['images'][0] if cfg['images'] else '')
        sw, sh=self._ew.screen_size(); k=256.0/sw
        pix=QPixmap.fromImage(self._ew.render(img, cfg['mode'], cfg['color'], (int(sw*k), int(sh*k)))).scaled(256, 144, Qt.KeepAspectRatio, Qt.SmoothTransformation)
        self.wall_preview.setPixmap(pix)

    def apply_wall(self):
        cfg=self.wall_choice(); self._wall=cfg
        self._ew.save_wallpaper_config(cfg); self.update_wall_preview()
        self._ew.apply_wallpaper(cfg)
        touch_reload()   # Eduka-Panel starts or stops the slideshow
        self.show_status(_('Wallpaper applied.'))

    # ------------------------------------------------------------ desktop icons
    def page_desktop_icons(self):
        import eduka_wallpaper as ew
        self._ew=ew
        p=Page('Desktop Icons', 'Icons shown on the desktop. Every change appears at once.')
        shown=ew.desktop_shortcuts(); self.desk_icons={}
        labels={'Home': ('Home folder', 'user-home'), 'Trash': ('Trash', 'user-trash'), 'Computer': ('Computer', 'computer'), 'Network': ('Network', 'network-workgroup')}
        for key, _f in ew.SHORTCUTS:
            text, icon=labels[key]
            cb=QCheckBox(text); cb.setIcon(get_icon(icon, 'folder')); cb.setIconSize(QSize(22, 22)); cb.setChecked(key in shown)
            cb.toggled.connect(lambda *_: self._desk_timer.start(300)); p.v.addWidget(cb); self.desk_icons[key]=cb
        self.desk_drives=QCheckBox('USB sticks, memory cards and external disks (HDD / SSD) while they are plugged in')
        self.desk_drives.setIcon(get_icon('drive-removable-media', 'drive-harddisk')); self.desk_drives.setIconSize(QSize(22, 22))
        self.desk_drives.setChecked(bool(read_desktop_config().get('desktop_drives', True)))
        self.desk_drives.toggled.connect(lambda on: (save_desktop_config({'desktop_drives': bool(on)}), touch_reload(), self.show_status(_('Desktop icons updated.'))))
        p.v.addWidget(self.desk_drives)
        p.v.addWidget(hint_label('The desktop restarts for a moment when Home, Trash, Computer or Network change.'))
        self._desk_timer=QTimer(self); self._desk_timer.setSingleShot(True); self._desk_timer.timeout.connect(self.apply_desktop_icons)
        return p.finish()

    def apply_desktop_icons(self):
        names={k for k, cb in self.desk_icons.items() if cb.isChecked()}
        if self._ew.set_desktop_shortcuts(names):
            self.show_status(_('Desktop icons updated.'))

    # ------------------------------------------------------------ keyboard, mouse, touchpad
    def _input_slider(self, lo, hi, value, fmt, step=1):
        box=QHBoxLayout(); box.setSpacing(10)
        sl=QSlider(Qt.Horizontal); sl.setRange(lo, hi); sl.setSingleStep(step); sl.setPageStep(step*5); sl.setValue(int(value))
        lab=QLabel(fmt(sl.value())); lab.setObjectName('fieldHint'); lab.setMinimumWidth(92)
        sl.valueChanged.connect(lambda v: lab.setText(fmt(v)))
        box.addWidget(sl, 1); box.addWidget(lab)
        return sl, box

    def _input_changed(self, *_a):
        self._input_timer.start(250)

    def input_widgets_ready(self):
        if not hasattr(self, '_input_timer'):
            self._input_timer=QTimer(self); self._input_timer.setSingleShot(True); self._input_timer.timeout.connect(self.apply_input)
            import eduka_input
            self._ei=eduka_input; self.input_cfg=eduka_input.input_config()
        return self._ei, self.input_cfg

    def page_keyboard(self):
        ei, cfg=self.input_widgets_ready()
        p=Page('Keyboard', 'Keyboard layouts, the key that switches them and key repeat. Changes work at once.')
        f=form()
        self.kb_list=QListWidget(); self.kb_list.setObjectName('layoutList'); self.kb_list.setFixedHeight(112)
        names=dict(ei.keyboard_layouts()); self._kb_names=names
        for code in (cfg['layouts'] or ei.current_layouts() or ['us']):
            it=QListWidgetItem(get_icon('input-keyboard'), f"{names.get(code, code)}  ({code})"); it.setData(Qt.UserRole, code); self.kb_list.addItem(it)
        btns=QVBoxLayout(); btns.setSpacing(6)
        add=QPushButton(get_icon('list-add'), ' Add…'); add.clicked.connect(self.add_kb_layout); btns.addWidget(add)
        rem=QPushButton(get_icon('list-remove'), ' Remove'); rem.clicked.connect(self.remove_kb_layout); btns.addWidget(rem)
        up=QPushButton(get_icon('go-up'), ' First'); up.setToolTip('Make this the main layout'); up.clicked.connect(self.first_kb_layout); btns.addWidget(up)
        btns.addStretch(1)
        row=QHBoxLayout(); row.addWidget(self.kb_list, 1); row.addLayout(btns)
        f.addRow('Layouts:', row)
        f.addRow('', hint_label('The first layout is used when you log in. Eduka-Panel shows the active one (for example US).'))
        self.kb_switch=QComboBox()
        for key, label in ei.SWITCH_KEYS: self.kb_switch.addItem(label, key)
        self.kb_switch.setCurrentIndex(max(0, self.kb_switch.findData(cfg['switch'])))
        f.addRow('Switch layout with:', self.kb_switch)
        self.kb_delay, box=self._input_slider(150, 1000, cfg['repeat_delay'], lambda v: _('{n} ms').replace('{n}', str(v)), 10)
        f.addRow('Repeat delay:', box)
        self.kb_rate, box=self._input_slider(5, 60, cfg['repeat_rate'], lambda v: _('{n} per second').replace('{n}', str(v)))
        f.addRow('Repeat speed:', box)
        self.kb_numlock=QCheckBox('Turn on Num Lock when I log in'); self.kb_numlock.setChecked(bool(cfg['numlock'])); f.addRow('', self.kb_numlock)
        p.v.addLayout(f)
        test=QLineEdit(); test.setPlaceholderText(_('Type here to test the layout and the repeat speed')); p.v.addWidget(test)
        for sig in (self.kb_switch.currentIndexChanged, self.kb_delay.valueChanged, self.kb_rate.valueChanged, self.kb_numlock.toggled):
            sig.connect(self._input_changed)
        return p.finish()

    def kb_codes(self):
        return [self.kb_list.item(i).data(Qt.UserRole) for i in range(self.kb_list.count())]

    def add_kb_layout(self):
        dlg=QDialog(self); dlg.setWindowTitle(_('Add a keyboard layout')); v=QVBoxLayout(dlg)
        search=QLineEdit(); search.setPlaceholderText(_('Search, for example Portuguese')); v.addWidget(search)
        lst=QListWidget(); v.addWidget(lst, 1); dlg.resize(420, 460)
        have=set(self.kb_codes())
        for code, name in self._ei.keyboard_layouts():
            if code in have: continue
            it=QListWidgetItem(f'{name}  ({code})'); it.setData(Qt.UserRole, code); lst.addItem(it)
        search.textChanged.connect(lambda t: [lst.item(i).setHidden(t.lower() not in lst.item(i).text().lower()) for i in range(lst.count())])
        bb=QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel); bb.accepted.connect(dlg.accept); bb.rejected.connect(dlg.reject); v.addWidget(bb)
        lst.itemDoubleClicked.connect(lambda *_: dlg.accept())
        if dlg.exec_() == QDialog.Accepted and lst.currentItem() and self.kb_list.count() < 4:
            code=lst.currentItem().data(Qt.UserRole)
            it=QListWidgetItem(get_icon('input-keyboard'), f"{self._kb_names.get(code, code)}  ({code})"); it.setData(Qt.UserRole, code); self.kb_list.addItem(it)
            self._input_changed()

    def remove_kb_layout(self):
        if self.kb_list.count() > 1 and self.kb_list.currentRow() >= 0:
            self.kb_list.takeItem(self.kb_list.currentRow()); self._input_changed()

    def first_kb_layout(self):
        row=self.kb_list.currentRow()
        if row > 0:
            self.kb_list.insertItem(0, self.kb_list.takeItem(row)); self.kb_list.setCurrentRow(0); self._input_changed()

    def page_mouse(self):
        ei, cfg=self.input_widgets_ready()
        p=Page('Mouse', 'Pointer speed, buttons, double-click and the scroll wheel. Changes work at once.')
        f=form()
        speed=lambda v: _('Slow') if v < -40 else _('Fast') if v > 40 else _('Normal')
        self.ms_speed, box=self._input_slider(-100, 100, round(float(cfg['mouse_speed'])*100), speed, 5)
        f.addRow('Pointer speed:', box)
        self.ms_left=QCheckBox('Left-handed (swap the left and right buttons)'); self.ms_left.setChecked(bool(cfg['left_handed'])); f.addRow('', self.ms_left)
        self.ms_natural=QCheckBox('Natural scrolling (content follows the wheel)'); self.ms_natural.setChecked(bool(cfg['mouse_natural'])); f.addRow('', self.ms_natural)
        self.ms_middle=QCheckBox('Press both buttons together for a middle click'); self.ms_middle.setChecked(bool(cfg['middle_emulation'])); f.addRow('', self.ms_middle)
        self.ms_dclick, box=self._input_slider(200, 900, cfg['double_click'], lambda v: _('{n} ms').replace('{n}', str(v)), 10)
        f.addRow('Double-click time:', box)
        self.ms_wheel=QSpinBox(); self.ms_wheel.setRange(1, 10); self.ms_wheel.setValue(int(cfg['wheel_lines'])); self.ms_wheel.setSuffix(_(' lines'))
        f.addRow('Wheel scrolls:', self.ms_wheel)
        p.v.addLayout(f)
        test=QPushButton(get_icon('face-plain', 'emblem-default'), '  '+_('Double-click here to test')); test.setObjectName('dclickTest'); test.setMinimumHeight(54)
        self._dclick_state=False
        def dbl(e, b=test):
            self._dclick_state=not self._dclick_state
            b.setIcon(get_icon('face-smile' if self._dclick_state else 'face-plain', 'emblem-default')); b.setText('  '+(_('Well done!') if self._dclick_state else _('Double-click here to test')))
        test.mouseDoubleClickEvent=dbl; p.v.addWidget(test)
        found=[d['name'] for d in ei.pointer_devices() if not d['touchpad']]
        p.v.addWidget(hint_label(_('Found: {d}').replace('{d}', ', '.join(found)) if found else _('Settings are used by every mouse that is plugged in.')))
        self.ms_speed.valueChanged.connect(self._input_changed); self.ms_dclick.valueChanged.connect(self._input_changed); self.ms_wheel.valueChanged.connect(self._input_changed)
        for cb in (self.ms_left, self.ms_natural, self.ms_middle): cb.toggled.connect(self._input_changed)
        self.ms_dclick.valueChanged.connect(lambda v: QApplication.setDoubleClickInterval(v))
        return p.finish()

    def page_touchpad(self):
        ei, cfg=self.input_widgets_ready()
        pads=ei.touchpads()
        p=Page('Touchpad', 'The touchpad of a laptop. Changes work at once.')
        top=QHBoxLayout(); top.setSpacing(16)
        self.tp_view=ei.TouchpadView(accent=theme_accent()); self.tp_view.setFixedSize(150, 116)
        top.addWidget(self.tp_view)
        info=QVBoxLayout(); info.setSpacing(6)
        name=QLabel(', '.join(d['name'] for d in pads) if pads else _('No touchpad found on this computer.')); name.setObjectName('cardTitle'); name.setWordWrap(True); info.addWidget(name)
        info.addWidget(hint_label('Move a finger or click on the touchpad: the picture copies it.' if pads else 'The settings are kept and used when a laptop touchpad is found.'))
        info.addStretch(1); top.addLayout(info, 1); p.v.addLayout(top)
        f=form()
        self.tp_enabled=QCheckBox('Touchpad on'); self.tp_enabled.setChecked(bool(cfg['tp_enabled'])); f.addRow('', self.tp_enabled)
        self.tp_tap=QCheckBox('Tap to click (one finger left, two fingers right)'); self.tp_tap.setChecked(bool(cfg['tp_tap'])); f.addRow('', self.tp_tap)
        self.tp_natural=QCheckBox('Natural scrolling (content follows the fingers)'); self.tp_natural.setChecked(bool(cfg['tp_natural'])); f.addRow('', self.tp_natural)
        self.tp_dwt=QCheckBox('Turn off while typing'); self.tp_dwt.setChecked(bool(cfg['tp_dwt'])); f.addRow('', self.tp_dwt)
        self.tp_scroll=QComboBox()
        for key, label in ei.SCROLL_METHODS: self.tp_scroll.addItem(label, key)
        self.tp_scroll.setCurrentIndex(max(0, self.tp_scroll.findData(cfg['tp_scroll']))); f.addRow('Scrolling:', self.tp_scroll)
        speed=lambda v: _('Slow') if v < -40 else _('Fast') if v > 40 else _('Normal')
        self.tp_speed, box=self._input_slider(-100, 100, round(float(cfg['tp_speed'])*100), speed, 5); f.addRow('Pointer speed:', box)
        self.tp_icon=QCheckBox('Show the touchpad on Eduka-Panel'); self.tp_icon.setChecked(bool(cfg['tp_icon'])); f.addRow('', self.tp_icon)
        p.v.addLayout(f)
        for cb in (self.tp_enabled, self.tp_tap, self.tp_natural, self.tp_dwt, self.tp_icon): cb.toggled.connect(self._input_changed)
        self.tp_scroll.currentIndexChanged.connect(self._input_changed); self.tp_speed.valueChanged.connect(self._input_changed)
        self.tp_icon.toggled.connect(lambda *_: QTimer.singleShot(400, touch_reload))
        if pads and shutil.which('xinput'):
            self._tp_proc=QProcess(self); self._tp_state={}
            self._tp_proc.readyReadStandardOutput.connect(self._tp_events)
            self._tp_proc.start('xinput', ['test-xi2', '--root', str(pads[0]['id'])])
            QApplication.instance().aboutToQuit.connect(self._tp_proc.kill)
        return p.finish()

    def _tp_events(self):
        data=bytes(self._tp_proc.readAllStandardOutput()).decode('utf-8', 'ignore')
        for ev in self._ei.parse_xi2(data.splitlines(), self._tp_state):
            if ev[0] == 'move': self.tp_view.motion(ev[1], ev[2])
            elif ev[0] == 'press': self.tp_view.press(ev[1])
            else: self.tp_view.release(ev[1])

    def collect_input(self):
        cfg=dict(self.input_cfg)
        if hasattr(self, 'kb_list'):
            cfg.update(layouts=self.kb_codes(), switch=self.kb_switch.currentData() or '', repeat_delay=self.kb_delay.value(), repeat_rate=self.kb_rate.value(), numlock=self.kb_numlock.isChecked())
        if hasattr(self, 'ms_speed'):
            cfg.update(mouse_speed=self.ms_speed.value()/100.0, left_handed=self.ms_left.isChecked(), mouse_natural=self.ms_natural.isChecked(),
                       middle_emulation=self.ms_middle.isChecked(), double_click=self.ms_dclick.value(), wheel_lines=self.ms_wheel.value())
        if hasattr(self, 'tp_enabled'):
            cfg.update(tp_enabled=self.tp_enabled.isChecked(), tp_tap=self.tp_tap.isChecked(), tp_natural=self.tp_natural.isChecked(), tp_dwt=self.tp_dwt.isChecked(),
                       tp_scroll=self.tp_scroll.currentData(), tp_speed=self.tp_speed.value()/100.0, tp_icon=self.tp_icon.isChecked())
        return cfg

    def apply_input(self):
        if not hasattr(self, '_ei'): return
        cfg=self.collect_input(); self.input_cfg=cfg
        self._ei.save_input_config(cfg); self._ei.apply_all(cfg)
        if hasattr(self, 'tp_view'): self.tp_view.disabled=not cfg['tp_enabled']; self.tp_view.update()
        self.show_status(_('Keyboard, mouse and touchpad settings applied.'))

    THEME_INFO = {
        THEME_DEFAULT: 'Light and lightweight; recommended for older computers.',
        THEME_LOW: 'Eduka-Low-Theme (after Yaru-remix): flat and fully opaque. Transparency, the compositor and all effects are switched off — for very low spec computers.',
        THEME_TRANSPARENT: 'Eduka-Transparan (after Transparent-Shell-Theme): smoky dark glass. Needs a compositor; without one Edukasaun-Dark is used.',
        THEME_LIQUID: 'Soft milky glass with light rims. Needs a compositor (started automatically); without one the default theme is used.',
        THEME_DARK: 'Edukasaun-Dark (Orchis dark): Eduka-Panel, Eduka-Desktop, GTK and Qt applications and window borders turn dark.',
        THEME_MULTI: 'Eduka-MultiColor (after Graphite by vinceliuice): calm light grey for applications, and a different color for every menu category, Action Center tile and panel button.',
    }

    def update_theme_info(self):
        name=self.theme.currentText()
        self.theme_info.setText(self.THEME_INFO.get(name, ''))
        self.glass_blur.setEnabled(name in (THEME_LIQUID, THEME_TRANSPARENT))
        if hasattr(self, 'multicolor'):
            # Eduka-MultiColor is always multi-colored; Eduka-Low stays flat.
            self.multicolor.setEnabled(name not in (THEME_MULTI, THEME_LOW))
        opaque=name == THEME_LOW
        for w in (self.panel_trans, self.desktop_trans, self.shadow): w.setEnabled(not opaque)
        if hasattr(self, 'effects_on'): self.update_effects_state()

    def liquid_glass_capability(self):
        memory_gib=0.0
        try:
            for line in Path('/proc/meminfo').read_text(encoding='utf-8').splitlines():
                if line.startswith('MemTotal:'):
                    memory_gib=float(line.split()[1])/(1024*1024); break
        except Exception:
            pass
        cpu_threads=max(1, int(os.cpu_count() or 1))
        compositor=compositor_running(force=True) or shutil.which('picom') is not None
        # Glass without blur is cheap: 2 GB RAM and two CPU threads are enough.
        return memory_gib, cpu_threads, compositor, memory_gib >= 1.8 and cpu_threads >= 2

    def _leave_liquid(self):
        self.theme.blockSignals(True); self.theme.setCurrentText(THEME_DEFAULT); self.theme.blockSignals(False)
        self.low.setEnabled(True); self.low.setChecked(self._low_before_liquid); self.update_theme_info()

    def theme_changed(self, theme):
        self.update_theme_info(); self.mark_sddm_follow()
        if theme not in (THEME_LIQUID, THEME_TRANSPARENT):
            self._liquid_confirmed=False
            self.low.setEnabled(True)
            if theme == THEME_LOW: self.low.setChecked(True)
            return
        self._low_before_liquid=self.low.isChecked()
        self.low.setChecked(False); self.low.setEnabled(False)
        if self._liquid_confirmed:
            return
        memory_gib, cpu_threads, compositor, capable=self.liquid_glass_capability()
        detected=f'Memory: {memory_gib:.1f} GiB • CPU threads: {cpu_threads} • Compositor: {"running" if compositor_running(force=True) else ("will be started" if compositor else "none (default theme is used)")}'
        if not capable:
            QMessageBox.warning(self, theme, f'{theme} needs at least 2 GB of memory and two CPU threads.\n\n'+detected)
            self._leave_liquid(); return
        self._liquid_confirmed=True

