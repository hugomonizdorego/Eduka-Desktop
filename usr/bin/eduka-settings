        p.v.addLayout(f)
        comp=p.new_card('Compositor')
        comp.addWidget(hint_label('The compositor draws transparency and rounded corners. Without one Eduka uses an opaque look, never black corners.'))
        self.comp_status=QLabel(''); self.comp_status.setObjectName('capability'); self.comp_status.setWordWrap(True); self.comp_status.setTextInteractionFlags(Qt.TextSelectableByMouse)
        comp.addWidget(self.comp_status)
        fcomp=form()
        self.compositor=QComboBox(); self.compositor.setAccessibleName('Compositor')
        for key, label in COMPOSITOR_CHOICES: self.compositor.addItem(label, key)
        fcomp.addRow('Compositor:', self.compositor); comp.addLayout(fcomp)
        crow=QHBoxLayout()
        b=QPushButton('Restart compositor'); b.clicked.connect(self.restart_compositor); crow.addWidget(b)
        b=QPushButton('Copy report'); b.setToolTip('Copy the compositor report (for help and bug reports)'); b.clicked.connect(lambda: (QApplication.clipboard().setText(compositor_report()), self.show_status('Compositor report copied.')))
        crow.addWidget(b); crow.addStretch(1); comp.addLayout(crow)
        QTimer.singleShot(400, self.update_compositor_status)
        icons=p.new_card('Icons')
        fi=form()
