def check_icon_path():
    """White tick for checked check boxes (cached SVG like the arrows)."""
    path=CACHE_DIR/'ui'/'check-white.svg'
    if not path.exists():
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text('<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16">'
                            '<path d="M3.5 8.5l3 3 6-7" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>', encoding='utf-8')
        except Exception:
            pass
    return str(path)

