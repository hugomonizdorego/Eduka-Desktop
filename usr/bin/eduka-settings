class NavBar(QWidget):
    """Sidebar navigation: group headings with a line between groups and
    one button per page (rows are numbered in the order they are added)."""
    currentRowChanged=pyqtSignal(int)
    def __init__(self, parent=None):
        super().__init__(parent)
        self.lay=QVBoxLayout(self); self.lay.setContentsMargins(0,0,0,0); self.lay.setSpacing(2)
        self.buttons=[]; self.group=QButtonGroup(self); self.group.setExclusive(True)

    def add_group(self, title, first=False):
        if not first:
            line=QFrame(); line.setObjectName('navLine'); self.lay.addSpacing(6); self.lay.addWidget(line)
        lab=QLabel(title); lab.setObjectName('navGroup'); self.lay.addWidget(lab)

    def add_item(self, icon, text):
        b=QToolButton(); b.setObjectName('navItem'); b.setCheckable(True); b.setText('  '+text.replace('&', '&&')); b.setIcon(icon); b.setIconSize(QSize(20,20))
        b.setToolButtonStyle(Qt.ToolButtonTextBesideIcon); b.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed); b.setFixedHeight(36)
        b.setCursor(Qt.PointingHandCursor); b.setAccessibleName(text)
        row=len(self.buttons); b.clicked.connect(lambda _=False, r=row: self.setCurrentRow(r))
        self.group.addButton(b); self.buttons.append(b); self.lay.addWidget(b)
        return row

    def finish(self):
        self.lay.addStretch(1)

    def item(self, row):
        return self.buttons[row]

    def setCurrentRow(self, row):
        if 0 <= row < len(self.buttons):
            self.buttons[row].setChecked(True); self.currentRowChanged.emit(row)


class RowForm(QVBoxLayout):
    """Settings rows with a title on the left, the control on the right and a
    thin line between rows (replaces QFormLayout: rows are clearly separated).
    addRow('', hint) adds the hint under the previous row; addRow('', widget)
    makes a full-width row."""
    def __init__(self):
        super().__init__(); self.setSpacing(0); self.setContentsMargins(0,0,0,0); self._last=None; self._count=0

    def addRow(self, label, field):
        if isinstance(field, QLabel) and not label and field.objectName() == 'fieldHint' and self._last is not None:
            self._last.addWidget(field); return
        if self._count:
            line=QFrame(); line.setObjectName('rowLine'); self.addWidget(line)
        row=QFrame(); row.setObjectName('settingRow')
        h=QHBoxLayout(row); h.setContentsMargins(2,10,2,10); h.setSpacing(16)
        right=QVBoxLayout(); right.setSpacing(4)
        if label:
            t=QLabel(label.rstrip(':')); t.setObjectName('rowTitle'); t.setFixedWidth(170); t.setWordWrap(True)
            h.addWidget(t, 0, Qt.AlignTop if isinstance(field, QLayout) else Qt.AlignVCenter)
        if isinstance(field, QLayout):
            right.addLayout(field)
        else:
            right.addWidget(field)
        h.addLayout(right, 1)
        self.addWidget(row); self._last=right; self._count+=1


class WallpaperGrid(QListWidget):
    """Pictures as tiles; the tile under the pointer grows a little so the
    picture can be seen before choosing it. Thumbnails load in the
    background, a few at a time."""
    hovered=pyqtSignal(str)
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setViewMode(QListView.IconMode); self.setResizeMode(QListView.Adjust); self.setMovement(QListView.Static)
        self.setIconSize(QSize(150, 94)); self.setGridSize(QSize(172, 126)); self.setSpacing(4); self.setWordWrap(True)
        self.setMouseTracking(True); self.setUniformItemSizes(True); self.setObjectName('wallGrid')
        # Keep the delegate alive as long as the view (PyQt would free it first
        # at exit and the view would paint with a deleted delegate).
        self._delegate=WallpaperDelegate(self); self.setItemDelegate(self._delegate); self._hover=-1; self._queue=[]
        self.loader=QTimer(self); self.loader.timeout.connect(self.load_some)
        self.setMinimumHeight(290)

    def set_images(self, paths):
        self.clear(); self._queue=[]
        for path in paths:
            it=QListWidgetItem(Path(path).stem.replace('_', ' ').replace('-', ' ')[:22]); it.setData(Qt.UserRole, path); it.setToolTip(path)
            pm=QPixmap(150, 94); pm.fill(QColor('#d9e4e0')); it.setIcon(QIcon(pm)); self.addItem(it); self._queue.append(it)
        self.loader.start(15)

    def load_some(self):
        for _ in range(3):
            if not self._queue:
                self.loader.stop(); return
            it=self._queue.pop(0)
            reader=QImageReader(it.data(Qt.UserRole)); reader.setAutoTransform(True)
            size=reader.size()
            if size.isValid():
                size.scale(300, 188, Qt.KeepAspectRatioByExpanding); reader.setScaledSize(size)
            img=reader.read()
            if not img.isNull():
                img=img.copy(max(0, (img.width()-300)//2), max(0, (img.height()-188)//2), min(300, img.width()), min(188, img.height()))
                it.setIcon(QIcon(QPixmap.fromImage(img)))

    def release_delegate(self):
        try:
            self.loader.stop(); self.setItemDelegate(QStyledItemDelegate(self))
        except RuntimeError:
            pass

    def mouseMoveEvent(self, e):
        it=self.itemAt(e.pos()); row=self.row(it) if it else -1
        if row != self._hover:
            self._hover=row; self.viewport().update()
            if it: self.hovered.emit(it.data(Qt.UserRole))
        super().mouseMoveEvent(e)

    def leaveEvent(self, e):
        self._hover=-1; self.viewport().update(); super().leaveEvent(e)


class WallpaperDelegate(QStyledItemDelegate):
    def paint(self, p, option, index):
        grid=self.parent(); hover=index.row() == grid._hover; selected=bool(option.state & QStyle.State_Selected)
        p.save(); p.setRenderHint(QPainter.Antialiasing); p.setRenderHint(QPainter.SmoothPixmapTransform)
        r=QRectF(option.rect).adjusted(8, 6, -8, -24)
        if hover:      # grow a little under the pointer
            r=r.adjusted(-7, -5, 7, 5)
        path=QPainterPath(); path.addRoundedRect(r, 10, 10)
        pix=index.data(Qt.DecorationRole).pixmap(300, 188)
        p.setClipPath(path); p.drawPixmap(r.toRect(), pix); p.setClipping(False)
        accent=QColor(theme_accent())
        if selected:
            p.setPen(QPen(accent, 4)); p.setBrush(Qt.NoBrush); p.drawPath(path)
            badge=QRectF(r.right()-24, r.top()+6, 18, 18); p.setPen(Qt.NoPen); p.setBrush(accent); p.drawEllipse(badge)
            p.setPen(QPen(QColor('#ffffff'), 2)); p.drawPolyline(QPolygonF([QPointF(badge.left()+5, badge.center().y()), QPointF(badge.center().x()-1, badge.bottom()-5), QPointF(badge.right()-4, badge.top()+5)]))
        elif hover:
            p.setPen(QPen(accent, 2)); p.setBrush(Qt.NoBrush); p.drawPath(path)
        p.setPen(option.palette.color(QPalette.Text)); f=QFont(option.font); f.setPointSizeF(max(7.5, f.pointSizeF()*0.9)); p.setFont(f)
        p.drawText(QRectF(option.rect.x(), option.rect.bottom()-20, option.rect.width(), 18), Qt.AlignCenter, index.data(Qt.DisplayRole))
        p.restore()

    def sizeHint(self, option, index):
        return QSize(172, 126)


class Page(QWidget):
    """A settings page: title, hint and one or more rounded cards.
    `self.v` is the layout of the first card."""
    def __init__(self, title, hint=''):
        super().__init__()
        self.outer=QVBoxLayout(self); self.outer.setContentsMargins(26,22,26,10); self.outer.setSpacing(12)
        t=QLabel(title); t.setObjectName('pageTitle'); self.outer.addWidget(t)
        if hint:
            h=QLabel(hint); h.setWordWrap(True); h.setObjectName('pageHint'); self.outer.addWidget(h)
        self.v=self.new_card()

    def new_card(self, title=''):
        card=QFrame(); card.setObjectName('card')
        lay=QVBoxLayout(card); lay.setContentsMargins(18,14,18,14); lay.setSpacing(10)
        if title:
            t=QLabel(title); t.setObjectName('cardTitle'); lay.addWidget(t)
        self.outer.addWidget(card)
        return lay

    def finish(self):
        self.outer.addStretch(1)
        return self


def form():
    return RowForm()


def theme_preview(theme, w=132, h=78):
    """Tiny picture of a theme: desktop, Eduka-Desktop window and panel."""
    surface, panel, accent, text=THEME_SWATCHES[theme]
    pix=QPixmap(w, h); pix.fill(Qt.transparent)
    p=QPainter(pix); p.setRenderHint(QPainter.Antialiasing)
    g=QLinearGradient(0, 0, w, h); g.setColorAt(0, QColor('#9fd2b4')); g.setColorAt(1, QColor('#3f8f6a'))
    if theme in (THEME_DARK, THEME_TRANSPARENT): g.setColorAt(0, QColor('#3a4a46')); g.setColorAt(1, QColor('#101413'))
    path=QPainterPath(); path.addRoundedRect(QRectF(0, 0, w, h), 10, 10); p.setClipPath(path); p.fillRect(pix.rect(), g)
    win=QColor(surface)
    if theme in (THEME_LIQUID, THEME_TRANSPARENT): win.setAlpha(190)
    radius=3 if theme == THEME_LOW else 8
    p.setPen(QPen(QColor(255,255,255,90), 1)); p.setBrush(win); p.drawRoundedRect(QRectF(10, 8, w-20, h-30), radius, radius)
    p.setPen(Qt.NoPen); p.setBrush(QColor(accent)); p.drawRoundedRect(QRectF(16, 14, 28, 6), 3, 3)
    tc=QColor(text); tc.setAlpha(110); p.setBrush(tc)
    for i in range(3):
        if theme == THEME_MULTI: p.setBrush(QColor(MULTI_COLORS[i*3]))
        p.drawRoundedRect(QRectF(16+i*30, 26, 24, 16), 3, 3)
    pc=QColor(panel)
    if theme in (THEME_LIQUID, THEME_TRANSPARENT): pc.setAlpha(200)
    p.setBrush(pc); p.drawRoundedRect(QRectF(6, h-16, w-12, 11), 5, 5)
    if theme == THEME_MULTI:
        rb=QLinearGradient(9, 0, 27, 0)
        for i, c in enumerate(('#ef5350', '#ff9800', '#43a047', '#1e88e5', '#8e24aa')): rb.setColorAt(i/4, QColor(c))
        p.setBrush(rb)
    else:
        p.setBrush(QColor(accent))
    p.drawRoundedRect(QRectF(9, h-14, 18, 7), 3.5, 3.5)
    p.end()
    return pix


def position_preview(edge, w=96, h=60, accent='#00a879'):
    pix=QPixmap(w, h); pix.fill(Qt.transparent)
    p=QPainter(pix); p.setRenderHint(QPainter.Antialiasing)
    p.setPen(QPen(QColor('#7a8f89'), 1.5)); p.setBrush(QColor('#e9f2ee')); p.drawRoundedRect(QRectF(2, 2, w-4, h-4), 6, 6)
    p.setPen(Qt.NoPen); p.setBrush(QColor(accent))
    bar={'Bottom': QRectF(8, h-14, w-16, 7), 'Top': QRectF(8, 7, w-16, 7), 'Left': QRectF(7, 8, 7, h-16), 'Right': QRectF(w-14, 8, 7, h-16)}[edge]
    p.drawRoundedRect(bar, 3.5, 3.5)
    p.end()
    return pix


def hint_label(text):
    h=QLabel(text); h.setWordWrap(True); h.setObjectName('fieldHint')
    return h


def sddm_conf_value(section, key):
    """Value SDDM really uses: /etc/sddm.conf.d/*.conf in order, then /etc/sddm.conf."""
    value=None
    files=sorted(Path('/etc/sddm.conf.d').glob('*.conf')) if Path('/etc/sddm.conf.d').is_dir() else []
    for path in files+[Path('/etc/sddm.conf')]:
        v=_get_ini_value(path, section, key)
        if v is not None: value=v
    return value

def sddm_greeter():
    return shutil.which('sddm-greeter-qt6') or shutil.which('sddm-greeter')

def is_admin_user():
    try:
        import grp
        return grp.getgrnam('sudo').gr_gid in os.getgroups()
    except Exception:
        return False


class LoginPreview(QWidget):
    """Small live picture of the login screen: it changes as soon as a
    style, color, picture or text is changed on the Login Screen page."""
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setFixedSize(352, 198)
        self.cfg={}; self.bg=QPixmap(); self.logo=QPixmap()

    def set_config(self, cfg, background=None, logo=None):
        self.cfg=dict(cfg)
        if background is not None:
            self.bg=QPixmap(background) if background and os.path.isfile(background) else QPixmap()
        if logo is not None:
            self.logo=QPixmap(logo) if logo and os.path.isfile(logo) else QPixmap()
        self.update()

    def paintEvent(self, e):
        c=self.cfg; style=c.get('style','light'); accent=QColor(c.get('accent','#00a879'))
        dark=style == 'dark'; glass=style == 'glass'
        p=QPainter(self); p.setRenderHint(QPainter.Antialiasing); p.setRenderHint(QPainter.SmoothPixmapTransform)
        r=QRectF(self.rect()); path=QPainterPath(); path.addRoundedRect(r, 14, 14); p.setClipPath(path)
        if not self.bg.isNull():
            pm=self.bg.scaled(self.size(), Qt.KeepAspectRatioByExpanding, Qt.SmoothTransformation)
            p.drawPixmap(int((self.width()-pm.width())/2), int((self.height()-pm.height())/2), pm)
        else:
            g=QLinearGradient(0, 0, 0, self.height())
            stops={'dark': ('#2f3b39','#1f2a28','#121616'), 'glass': ('#bfe3f5','#7fb9dc','#2f6f9a')}.get(style, ('#e9f6c9','#8fcf7a','#1f6b45'))
            for pos, col in zip((0.0, 0.5, 1.0), stops): g.setColorAt(pos, QColor(col))
            p.fillRect(self.rect(), g)
        p.fillRect(self.rect(), QColor(0,0,0,140) if dark else QColor(255,255,255,38) if glass else QColor(0,0,0,20))
        cx=self.width()/2
        if c.get('show_clock', True):
            f=p.font(); f.setPixelSize(22); f.setWeight(QFont.Light); p.setFont(f); p.setPen(QColor('white'))
            p.drawText(QRectF(0, 10, self.width(), 26), Qt.AlignCenter, format_clock(QTime.currentTime(), '24h'))
        card=QRectF(cx-62, 44 if c.get('show_clock', True) else 34, 124, 118)
        p.setPen(QPen(QColor(255,255,255,60) if dark else QColor(255,255,255,230), 1))
        p.setBrush(QColor(38,38,38,235) if dark else QColor(255,255,255,140) if glass else QColor(255,255,255,245))
        p.drawRoundedRect(card, 12, 12)
        p.setBrush(QColor(255,255,255,30) if dark else QColor('white')); p.setPen(QPen(accent, 1.5))
        p.drawEllipse(QPointF(cx, card.top()+20), 13, 13)
        if not self.logo.isNull():
            lg=self.logo.scaled(18, 18, Qt.KeepAspectRatio, Qt.SmoothTransformation); p.drawPixmap(int(cx-lg.width()/2), int(card.top()+20-lg.height()/2), lg)
        f=p.font(); f.setPixelSize(10); f.setBold(True); p.setFont(f); p.setPen(QColor('white') if dark else QColor('#10231e'))
        p.drawText(QRectF(card.left(), card.top()+36, card.width(), 14), Qt.AlignCenter, c.get('title') or 'Edukasaun')
        field=QColor('#383838') if dark else QColor(255,255,255,220)
        for i in range(2):
            fr=QRectF(card.left()+12, card.top()+56+i*22, card.width()-24, 16)
            p.setPen(QPen(accent if i == 1 else QColor(0,0,0,40), 1)); p.setBrush(field); p.drawRoundedRect(fr, 8, 8)
        p.setPen(Qt.NoPen); p.setBrush(accent); p.drawEllipse(QPointF(card.right()-20, card.top()+86), 6, 6)
        f.setBold(False); f.setPixelSize(8); p.setFont(f); p.setPen(QColor(255,255,255,200) if dark else QColor('#5b6e69'))
        if c.get('default_user'):
            p.drawText(QRectF(card.left()+18, card.top()+56, 80, 16), Qt.AlignVCenter, c.get('default_user'))
        bar=QRectF(cx-110, self.height()-22, 220, 15)
        p.setPen(Qt.NoPen); p.setBrush(QColor(38,38,38,220) if dark else QColor(255,255,255,140) if glass else QColor(255,255,255,230)); p.drawRoundedRect(bar, 7.5, 7.5)
        p.setBrush(accent); p.drawRoundedRect(QRectF(bar.left()+3, bar.top()+2.5, 46, 10), 5, 5)


class Settings(QDialog):
    def __init__(self):
        super().__init__()
        ensure_dirs(); icon_theme_setup(force=True)
        self.setWindowFlags(Qt.Window | Qt.WindowTitleHint | Qt.WindowSystemMenuHint | Qt.WindowMinimizeButtonHint | Qt.WindowMaximizeButtonHint | Qt.WindowCloseButtonHint)
        self.setWindowTitle(f'Eduka-Settings — {VERSION}')
        self.setWindowIcon(get_icon(START_ICON, 'preferences-system'))
        avail=QApplication.primaryScreen().availableGeometry() if QApplication.primaryScreen() else QRect(0,0,1024,600)
        self.resize(min(940, max(760, avail.width()-80)), min(640, max(520, avail.height()-80)))
        self.setMinimumSize(760, 520)
        self.panel=read_panel_config(); self.menu=read_menu_config(); self.desktop=read_desktop_config()
        self._initial_orca_enabled=bool(self.desktop.get('orca_enabled', False))
        self._liquid_confirmed=normalize_theme_style(self.desktop.get('theme_style')) in (THEME_LIQUID, THEME_TRANSPARENT)
        self._sddm_dirty=False; self._sddm_background=''; self._sddm_logo=''
        self.sddm_timer=QTimer(self); self.sddm_timer.setSingleShot(True); self.sddm_timer.timeout.connect(self.realtime_sddm)
        self.build()
        self.panel_height.valueChanged.connect(self.update_preview)
        for edit in self.findChildren(QLineEdit):
            rounded_text_context_menu(edit)
        self.load_values()
        self.apply_theme_style()
        self.status_timer=QTimer(self); self.status_timer.setSingleShot(True); self.status_timer.timeout.connect(lambda: self.status.setText(''))
        for combo in self.findChildren(QComboBox):
            round_combo(combo)
            # Items with data are interface words: translate their labels.
            for i in range(combo.count()):
                if combo.itemData(i) is not None: combo.setItemText(i, _(combo.itemText(i)))
        translate_tree(self)

    # ------------------------------------------------------------------ layout
    def build(self):
        root=QHBoxLayout(self); root.setContentsMargins(0,0,0,0); root.setSpacing(0)

        side=QFrame(); side.setObjectName('sidebar'); side.setFixedWidth(232)
        sl=QVBoxLayout(side); sl.setContentsMargins(16,18,16,14); sl.setSpacing(12)
        brand=QHBoxLayout(); brand.setSpacing(10)
        self.logo=QLabel(); self.logo.setPixmap(get_icon(START_ICON,'start-here').pixmap(40,40)); brand.addWidget(self.logo)
        names=QVBoxLayout(); names.setSpacing(2)
        t=QLabel('Eduka Settings'); t.setObjectName('appTitle'); names.addWidget(t)
        chip=QLabel(VERSION); chip.setObjectName('versionChip'); chip.setAlignment(Qt.AlignCenter); chip.setFixedWidth(chip.sizeHint().width()+16)
        names.addWidget(chip); brand.addLayout(names, 1); sl.addLayout(brand)
        self.nav=NavBar()
        sl.addWidget(self.nav, 1)
        reset=QPushButton('Reset to Defaults'); reset.setObjectName('resetButton'); reset.clicked.connect(self.reset_defaults); sl.addWidget(reset)
        root.addWidget(side)

        content=QVBoxLayout(); content.setContentsMargins(0,0,0,0); content.setSpacing(0)
        self.stack=QStackedWidget()
        groups=[
            ('PERSONALIZE', [('appearance','Appearance','preferences-desktop-theme',self.page_appearance),
                             ('wallpaper','Wallpaper','preferences-desktop-wallpaper',self.page_wallpaper),
                             ('desktopicons','Desktop Icons','user-desktop',self.page_desktop_icons),
                             ('effects','Effects','applications-graphics',self.page_effects)]),
            ('DESKTOP', [('desktop','Eduka-Desktop','start-here',self.page_behavior),
                         ('panel','Eduka-Panel','preferences-desktop',self.page_icon_name),
                         ('clock','Clock','preferences-system-time',self.page_clock),
                         ('notifications','Notifications','preferences-system-notifications',self.page_notifications)]),
            ('DEVICES', [('keyboard','Keyboard','input-keyboard',self.page_keyboard),
                         ('mouse','Mouse','input-mouse',self.page_mouse),
                         ('touchpad','Touchpad','input-touchpad',self.page_touchpad)]),
            ('SYSTEM', [('general','Language & Startup','preferences-desktop-locale',self.page_general),
                        ('accessibility','Accessibility','preferences-desktop-accessibility',self.page_accessibility),
                        ('parental','Parental Control','preferences-system-parental-controls',self.page_parental),
                        ('login','Login Screen','system-users',self.page_login),
                        ('maintenance','Maintenance','applications-system',self.page_advanced)]),
        ]
        self.pages=[]; self.page_keys=[]; self.nav_rows={}
        for gi, (group, entries) in enumerate(groups):
            # Group heading and a line separate the sections.
            self.nav.add_group(group, first=gi == 0)
            for key, name, icon, builder in entries:
                page=builder()
                # Pages scroll on small (1024x600 / 1366x768) school screens.
                scroll=QScrollArea(); scroll.setObjectName('pageScroll'); scroll.setWidgetResizable(True); scroll.setFrameShape(QFrame.NoFrame); scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff); scroll.setWidget(page)
                nav_icon=get_icon(icon,'preferences-system')
                if key == 'touchpad':
                    nav_icon=self._ei.touchpad_icon(48, accent=theme_accent())
                self.nav_rows[key]=self.nav.add_item(nav_icon, name)
                self.pages.append((name, icon, page)); self.page_keys.append(key); self.stack.addWidget(scroll)
        self.nav.finish()
        self.nav.currentRowChanged.connect(self.stack.setCurrentIndex); self.nav.setCurrentRow(self.nav_rows['appearance'])
        content.addWidget(self.stack, 1)

        bar=QHBoxLayout(); bar.setContentsMargins(26,8,26,16); bar.setSpacing(8)
        # Status gets room on the left so long messages never squeeze the buttons.
        self.status=QLabel(''); self.status.setObjectName('statusLabel'); self.status.setAccessibleName('Settings status'); self.status.setWordWrap(True)
        bar.addWidget(self.status, 1)
        cancel=QPushButton('Close'); cancel.clicked.connect(self.reject); bar.addWidget(cancel)
        apply=QPushButton('Apply'); apply.clicked.connect(self.apply_settings); bar.addWidget(apply)
        save=QPushButton('Save && Close'); save.setObjectName('primary'); save.setDefault(True); save.clicked.connect(self.save_close); bar.addWidget(save)
        apply.setToolTip('Apply all changes now and keep this window open (Ctrl+S)')
        QShortcut(QKeySequence.Save, self, activated=self.apply_settings)
        content.addLayout(bar)
        root.addLayout(content, 1)
        # Every change is used at once (after a short pause, so dragging a
        # slider or typing does not restart the panel many times).
        QTimer.singleShot(0, self.enable_live_apply)

    LIVE_SKIP = ('login', 'parental', 'maintenance', 'wallpaper', 'desktopicons', 'keyboard', 'mouse', 'touchpad')

    def enable_live_apply(self):
        """Connects the controls of the pages to a debounced Apply. The login
        screen and Parental Control need an administrator password, so they keep
        their own Save button; wallpaper, desktop icons and the input devices
        apply themselves."""
        self._live_timer=QTimer(self); self._live_timer.setSingleShot(True); self._live_timer.timeout.connect(self.live_apply)
        self._live_busy=False
        kick=lambda *_a: (not self._live_busy) and self._live_timer.start(700)
        for key, (_name, _icon, page) in zip(self.page_keys, self.pages):
            if key in self.LIVE_SKIP: continue
            for w in page.findChildren(QWidget):
                if isinstance(w, (QCheckBox, QRadioButton)) or (isinstance(w, QToolButton) and w.isCheckable()):
                    w.toggled.connect(kick)
                elif isinstance(w, QComboBox) and w is not getattr(self, 'theme', None):
                    w.currentIndexChanged.connect(kick)
                elif isinstance(w, (QSpinBox, QDoubleSpinBox, QSlider)):
                    w.valueChanged.connect(kick)
                elif isinstance(w, QLineEdit) and not w.isReadOnly() and not isinstance(w.parent(), QAbstractSpinBox):
                    w.textChanged.connect(lambda *_a: (not self._live_busy) and self._live_timer.start(1200))
        if hasattr(self, 'theme'): self.theme.currentTextChanged.connect(kick)

    def live_apply(self):
        if self._live_busy: return
        self._live_busy=True
        try:
            self.apply_settings()
        finally:
            self._live_busy=False

