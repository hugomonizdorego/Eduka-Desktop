        if self.cursor_theme.count() == 0:
            self.cursor_theme.addItem('No cursor themes installed', ''); self.cursor_theme.setEnabled(False)
        fc.addRow('Cursor theme:', self.cursor_theme)
        self.cursor_size=QComboBox()
        for size in (24, 32, 48, 64): self.cursor_size.addItem(f'{size} px' + (' (normal)' if size == 24 else ' (large)' if size >= 48 else ''), size)
        fc.addRow('Cursor size:', self.cursor_size)
        fc.addRow('', hint_label('New windows use the cursor at once; everything else after logging in again. More cursors: install e.g. breeze-cursor-theme or dmz-cursor-theme.'))
        cursor.addLayout(fc)
        self.theme.currentTextChanged.connect(self.theme_changed)
        return p.finish()

    def set_accent(self, value, from_click=False):
        if value == 'custom':
            return
        self.accent_value=value or ''
        b=self.accent_swatches.get(self.accent_value) or self.accent_swatches['custom']
        b.setChecked(True)
        if self.accent_value and self.accent_value not in self.accent_swatches:
            self.accent_swatches['custom'].setStyleSheet(f'QToolButton#ledSwatch{{background:{self.accent_value};color:white;font-weight:800;font-size:15px;}}')

    def pick_accent(self):
        color=QColorDialog.getColor(QColor(self.accent_value or theme_accent()), self, 'Accent color')
        if color.isValid():
            self.set_accent(color.name())
        else:
            self.set_accent(self.accent_value)

    # ------------------------------------------------------------ parental control
    def page_parental(self):
        from eduka_parental import EMOJIS, PRESETS, read_state, minutes_text, emoji_icon
        p=Page('Parental Control', 'Limit how long this computer can be used. When the time is up your message appears over the whole screen, keyboard and mouse stop working and the computer shuts down.')
