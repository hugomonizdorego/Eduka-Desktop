        fp.addRow('Taskbar style:', self.taskbar_style)
        panel.addLayout(fp)
        return p.finish()

    # ------------------------------------------------------------------ clock
    def page_clock(self):
        p=Page('Clock', 'The clock of the Action Center (click the time on Eduka-Panel). Click the clock there to see the world globe.')
        f=form()
        self.clock_style=QComboBox()
        for key, label in (('digital','Digital'), ('analog','Analog'), ('led','LED (seven segments)')): self.clock_style.addItem(label, key)
        f.addRow('Clock face:', self.clock_style)
        self.clock_format=QComboBox(); self.clock_format.addItem('24 hours (14:30)', '24h'); self.clock_format.addItem('12 hours (2:30 PM)', '12h'); f.addRow('Time format:', self.clock_format)
        self.clock_seconds=QCheckBox('Show seconds'); f.addRow('', self.clock_seconds)
        self.clock_blink=QCheckBox('Blinking colon ( : )'); f.addRow('', self.clock_blink)
        swatches=QHBoxLayout(); swatches.setSpacing(8); self.led_swatches={}; lgroup=QButtonGroup(self)
        for value, name in [('', 'Theme color')]+LED_COLORS:
            b=QToolButton(); b.setObjectName('ledSwatch'); b.setCheckable(True); b.setFixedSize(26,26); b.setToolTip(name)
            if value:
                b.setStyleSheet(f'QToolButton#ledSwatch{{background:{value};}}')
            else:
                b.setText('A'); b.setStyleSheet('QToolButton#ledSwatch{background:qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #00a879,stop:1 #26a69a);color:white;font-weight:800;}')
            lgroup.addButton(b); swatches.addWidget(b); self.led_swatches[value]=b
        swatches.addStretch(); f.addRow('Clock color:', swatches)
        f.addRow('', hint_label('Used by the digital, analog and LED clock. "A" follows the theme.'))
        p.v.addLayout(f)
        self.clock_preview=QLabel(); self.clock_preview.setObjectName('capability'); self.clock_preview.setAlignment(Qt.AlignCenter)
        p.v.addWidget(self.clock_preview)
        for sig in (self.clock_style.currentIndexChanged, self.clock_format.currentIndexChanged, self.clock_seconds.toggled, self.clock_blink.toggled, lgroup.buttonClicked):
            sig.connect(lambda *_: self.update_clock_preview())
        t=QTimer(self); t.timeout.connect(self.update_clock_preview); t.start(1000)
        return p.finish()

    def led_color(self):
        for value, b in self.led_swatches.items():
            if b.isChecked(): return value
        return ''

    def update_clock_preview(self):
        if not hasattr(self, 'clock_preview'): return
        now=QTime.currentTime(); colon=':' if not self.clock_blink.isChecked() or now.second() % 2 == 0 else ' '
        text=format_clock(now, self.clock_format.currentData(), self.clock_seconds.isChecked(), colon)
        style=self.clock_style.currentData()
        color=self.led_color() or ('#00e676' if style == 'led' else '')
        self.clock_preview.setText(f'Preview: {text}')
        self.clock_preview.setStyleSheet(f'font-family:monospace;font-size:22px;font-weight:800;' + (f'color:{color};' if color else ''))
        pass

