    def page_effects(self):
        p=Page('Effects', 'Animations for Eduka-Desktop: movement when the pointer goes over a category, and an effect when an application starts.')
        mem, threads, ok=effects_capability()
        cap=QLabel(); cap.setObjectName('capability'); cap.setWordWrap(True)
        cap.setText((f'✓ This computer can use effects ({mem:.1f} GiB memory, {threads} CPU threads).' if ok else
                     f'Effects need at least 4 GB of memory and 4 CPU threads. This computer: {mem:.1f} GiB, {threads} threads — effects stay off to keep it fast.'))
        p.v.addWidget(cap)
        f=form()
        self.effects_on=QCheckBox('Enable effects in Eduka-Desktop'); f.addRow('', self.effects_on)
        self.effect_hover=QComboBox()
        for key, label in EFFECT_HOVER: self.effect_hover.addItem(label, key)
        f.addRow('Category pointer:', self.effect_hover)
        f.addRow('', hint_label('Wave lifts the category icon, Glow pulses a colored ring, Slide moves the name aside.'))
        self.effect_launch=QComboBox()
        for key, label in EFFECT_LAUNCH: self.effect_launch.addItem(label, key)
        f.addRow('Opening an application:', self.effect_launch)
        f.addRow('', hint_label('Bubbles rise from the tile, Zoom in grows the icon, Zoom out shrinks it, Ripple spreads rings, Bounce jumps the icon, Confetti scatters colors, Fade dissolves Eduka-Desktop.'))
        p.v.addLayout(f)
        self.effects_note=hint_label('Eduka-Low-Theme is chosen: effects stay off with this theme.'); p.v.addWidget(self.effects_note)
        self.effects_on.setEnabled(ok); self.effects_on.toggled.connect(lambda *_: self.update_effects_state())
        self._effects_capable=ok
        return p.finish()

    def update_effects_state(self):
        allowed=self._effects_capable and self.theme.currentText() != THEME_LOW
        self.effects_note.setVisible(self.theme.currentText() == THEME_LOW)
        self.effects_on.setEnabled(allowed)
        if not allowed: self.effects_on.setChecked(False)
        for w in (self.effect_hover, self.effect_launch): w.setEnabled(allowed and self.effects_on.isChecked())

