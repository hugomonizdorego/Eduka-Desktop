        row=QHBoxLayout(); row.addWidget(test); row.addStretch(); p.v.addLayout(row)
        return p.finish()

    def test_notification(self):
        sent=False
        try:
            from PyQt5.QtDBus import QDBusConnection, QDBusMessage, QDBusArgument
            m=QDBusMessage.createMethodCall('org.freedesktop.Notifications','/org/freedesktop/Notifications','org.freedesktop.Notifications','Notify')
            rid=QVariant(0); rid.convert(QVariant.UInt)
            acts=QDBusArgument(); acts.add([], QMetaType.QStringList)
            m.setArguments(['Eduka-Settings', rid, 'preferences-system-notifications', greeting_text()+'!', 'Notifications from your applications appear like this.', acts, {}, -1])
            sent=QDBusConnection.sessionBus().call(m).type() == QDBusMessage.ReplyMessage
        except Exception:
            sent=False
        self.show_status('Test notification sent.' if sent else 'No notification server answered (is Eduka-Panel running?).', error=not sent)

