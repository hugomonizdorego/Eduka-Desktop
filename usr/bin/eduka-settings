    def set_accent(self, value, from_click=False):
        if value == 'custom':
            return
        self.accent_value=value or ''
        b=self.accent_swatches.get(self.accent_value) or self.accent_swatches['custom']
        b.setChecked(True)
        if self.accent_value and self.accent_value not in self.accent_swatches:
            self.accent_swatches['custom'].setStyleSheet(f'QToolButton#ledSwatch{{background:{self.accent_value};color:white;font-weight:800;font-size:15px;}}')

    def pick_accent(self):
        color=QColorDialog.getColor(QColor(self.accent_value or theme_accent()), self, 'Accent color')
        if color.isValid():
            self.set_accent(color.name())
        else:
            self.set_accent(self.accent_value)

    # ------------------------------------------------------------ parental control
    def page_parental(self):
        from eduka_parental import EMOJIS, read_state, minutes_text
        p=Page('Parental Control', 'Limit how long this computer can be used. When the time is up your message appears over the whole screen, keyboard and mouse stop working and the computer shuts down.')
        self.pc_status=QLabel(''); self.pc_status.setObjectName('capability'); self.pc_status.setWordWrap(True); p.v.addWidget(self.pc_status)
        self.pc_enabled=QCheckBox('Use a time limit on this computer'); p.v.addWidget(self.pc_enabled)
        p.v.addWidget(self.card_title('Time allowed'))
        row=QHBoxLayout(); row.setSpacing(8); self.pc_presets={}; grp=QButtonGroup(self)
        for minutes, label in ((30, '30 min'), (60, '1 hour'), (120, '2 hours'), (180, '3 hours')):
            b=QPushButton(label); b.setObjectName('chip'); b.setCheckable(True); b.setCursor(Qt.PointingHandCursor)
            b.clicked.connect(lambda _=False, m=minutes: self.pc_minutes.setValue(m)); grp.addButton(b); row.addWidget(b); self.pc_presets[minutes]=b
        row.addWidget(QLabel('Other:'))
        self.pc_minutes=QSpinBox(); self.pc_minutes.setRange(5, 1440); self.pc_minutes.setSingleStep(5); self.pc_minutes.setSuffix(' min'); row.addWidget(self.pc_minutes)
        row.addStretch(1); p.v.addLayout(row)
        self.pc_minutes.valueChanged.connect(lambda v: [b.setChecked(m == v) for m, b in self.pc_presets.items()])
        f=form()
        self.pc_mode=QComboBox(); self.pc_mode.addItem('Each time the computer starts', 'boot'); self.pc_mode.addItem('In total per day', 'daily')
        f.addRow('Count:', self.pc_mode); p.v.addLayout(f)
        msg=p.new_card('Message before shutting down')
        self.pc_message=QPlainTextEdit(); self.pc_message.setPlaceholderText('It is time to rest. See you later!'); self.pc_message.setFixedHeight(76)
        self.pc_message.textChanged.connect(lambda: self.pc_message.toPlainText().__len__() > 300 and self.pc_message.setPlainText(self.pc_message.toPlainText()[:300]))
        msg.addWidget(self.pc_message)
        er=QHBoxLayout(); er.setSpacing(6); self.pc_emojis={}; eg=QButtonGroup(self)
        for e in EMOJIS:
            b=QToolButton(); b.setObjectName('emojiChip'); b.setText(e); b.setCheckable(True); b.setFixedSize(34,34); b.setCursor(Qt.PointingHandCursor)
            eg.addButton(b); er.addWidget(b); self.pc_emojis[e]=b
        er.addStretch(1); msg.addLayout(er)
        btns=QHBoxLayout()
        prev=QPushButton('Preview message'); prev.clicked.connect(self.preview_parental); btns.addWidget(prev)
        btns.addStretch(1)
        self.pc_save=QPushButton('Save Parental Control'); self.pc_save.setObjectName('primary'); self.pc_save.clicked.connect(self.save_parental); btns.addWidget(self.pc_save)
        msg.addLayout(btns)
        msg.addWidget(hint_label('Saving always asks for an administrator password, so only parents and teachers can change or switch off the limit. On the message screen a parent can press Ctrl+Alt+P to add 30 minutes.'))
        self.load_parental()
        t=QTimer(self); t.timeout.connect(self.update_parental_status); t.start(5000); self.update_parental_status()
        return p.finish()

    def load_parental(self):
        try:
            with open(PARENTAL_CONF, encoding='utf-8') as f: conf=json.load(f)
        except Exception:
            conf={}
        self.pc_enabled.setChecked(bool(conf.get('enabled', False)))
        self.pc_minutes.setValue(int(conf.get('minutes', 60) or 60))
        idx=self.pc_mode.findData(conf.get('mode', 'boot')); self.pc_mode.setCurrentIndex(max(0, idx))
        self.pc_message.setPlainText(str(conf.get('message', '')))
        b=self.pc_emojis.get(conf.get('emoji', '😊')) or next(iter(self.pc_emojis.values())); b.setChecked(True)

    def parental_request(self):
        emoji=next((e for e, b in self.pc_emojis.items() if b.isChecked()), '😊')
        return {'enabled': self.pc_enabled.isChecked(), 'minutes': self.pc_minutes.value(), 'mode': self.pc_mode.currentData(),
                'message': self.pc_message.toPlainText().strip()[:300], 'emoji': emoji, 'reset': True}

    def update_parental_status(self):
        from eduka_parental import read_state, minutes_text
        st=read_state()
        if st.get('enabled') and st.get('phase') in ('ok', 'warn'):
            used=minutes_text(st.get('used', 0)); left=minutes_text(st.get('remaining', 0))
            self.pc_status.setText(_('✓ On: {u} used, {l} left.').replace('{u}', used).replace('{l}', left))
        elif st.get('phase') == 'lock':
            self.pc_status.setText(_('Time is up — the computer is shutting down.'))
        elif not os.path.exists(PARENTAL_HELPER):
            self.pc_status.setText(_('Parental Control works on Edukasaun OS (eduka-parental.service).'))
        else:
            self.pc_status.setText(_('Off: this computer can be used without a time limit.'))

    def preview_parental(self):
        from eduka_parental import ParentalLockScreen
        r=self.parental_request()
        self._pc_preview=ParentalLockScreen(r['message'], r['emoji'], preview=True); self._pc_preview.show_locked()

    def save_parental(self):
        if shutil.which('pkexec') is None or not os.path.exists(PARENTAL_HELPER):
            self.show_status('Parental Control can only be changed on Edukasaun OS (pkexec missing).', error=True); return
        try:
            out=subprocess.run(['pkexec', PARENTAL_HELPER], input=json.dumps(self.parental_request()), capture_output=True, text=True, timeout=180)
        except Exception as e:
            self.show_status(str(e), error=True); return
        if out.returncode == 0:
            self.show_status('Parental Control saved.'); QTimer.singleShot(1500, self.update_parental_status)
        else:
            self.show_status('Not saved (no administrator password).', error=True)

    THEME_INFO = {
        THEME_DEFAULT: 'Light and lightweight; recommended for older computers.',
        THEME_LOW: 'Eduka-Low-Theme (after Yaru-remix): flat and fully opaque. Transparency, the compositor and all effects are switched off — for very low spec computers.',
        THEME_TRANSPARENT: 'Eduka-Transparan (after Transparent-Shell-Theme): smoky dark glass. Needs a compositor; without one Edukasaun-Dark is used.',
        THEME_LIQUID: 'Soft milky glass with light rims. Needs a compositor (started automatically); without one the default theme is used.',
        THEME_DARK: 'Edukasaun-Dark (Orchis dark): Eduka-Panel, Eduka-Desktop, GTK and Qt applications and window borders turn dark.',
    }

    def update_theme_info(self):
        name=self.theme.currentText()
        self.theme_info.setText(self.THEME_INFO.get(name, ''))
        self.glass_blur.setEnabled(name in (THEME_LIQUID, THEME_TRANSPARENT))
        opaque=name == THEME_LOW
        for w in (self.panel_trans, self.desktop_trans, self.shadow): w.setEnabled(not opaque)
        if hasattr(self, 'effects_on'): self.update_effects_state()

    def liquid_glass_capability(self):
        memory_gib=0.0
        try:
            for line in Path('/proc/meminfo').read_text(encoding='utf-8').splitlines():
                if line.startswith('MemTotal:'):
                    memory_gib=float(line.split()[1])/(1024*1024); break
        except Exception:
            pass
        cpu_threads=max(1, int(os.cpu_count() or 1))
        compositor=compositor_running(force=True) or shutil.which('picom') is not None
        # Glass without blur is cheap: 2 GB RAM and two CPU threads are enough.
        return memory_gib, cpu_threads, compositor, memory_gib >= 1.8 and cpu_threads >= 2

    def _leave_liquid(self):
        self.theme.blockSignals(True); self.theme.setCurrentText(THEME_DEFAULT); self.theme.blockSignals(False)
        self.low.setEnabled(True); self.low.setChecked(self._low_before_liquid); self.update_theme_info()

    def theme_changed(self, theme):
        self.update_theme_info(); self.mark_sddm_follow()
        if theme not in (THEME_LIQUID, THEME_TRANSPARENT):
            self._liquid_confirmed=False
            self.low.setEnabled(True)
            if theme == THEME_LOW: self.low.setChecked(True)
            return
        self._low_before_liquid=self.low.isChecked()
        self.low.setChecked(False); self.low.setEnabled(False)
        if self._liquid_confirmed:
            return
        memory_gib, cpu_threads, compositor, capable=self.liquid_glass_capability()
        detected=f'Memory: {memory_gib:.1f} GiB • CPU threads: {cpu_threads} • Compositor: {"running" if compositor_running(force=True) else ("will be started" if compositor else "none (default theme is used)")}'
        if not capable:
            QMessageBox.warning(self, theme, f'{theme} needs at least 2 GB of memory and two CPU threads.\n\n'+detected)
            self._leave_liquid(); return
        self._liquid_confirmed=True

    def page_accessibility(self):
        p=Page('Accessibility', 'Clearer vision, spoken navigation and visible status information.')
        f=form()
        self.visual_access=QCheckBox('High contrast, opaque surfaces and larger text'); f.addRow('Vision:', self.visual_access)
        self.hearing_access=QCheckBox('Show network, sound and alert status as text on Eduka-Panel'); f.addRow('Hearing:', self.hearing_access)
        self.orca=QCheckBox('Orca screen reader — speaks focused applications and menus'); f.addRow('Screen reader:', self.orca)
        voice=QPushButton(get_icon('preferences-desktop-accessibility'), ' Orca Voice Settings'); voice.clicked.connect(self.open_orca_voice_settings)
        row=QHBoxLayout(); row.addWidget(voice); row.addStretch(); f.addRow('Voice:', row)
        p.v.addLayout(f)
        orca_status='Orca is ready.' if orca_available() else 'Orca is not available in this session.'
        p.v.addWidget(hint_label(orca_status+' Pointer announcements use a short dwell so speech stays smooth.'))
        return p.finish()

    def page_icon_name(self):
        p=Page('Eduka-Panel', 'The start button, the panel size and taskbar, and the clock of the Action Center.')
        p.v.addWidget(self.card_title('Start button'))
        f=form()
        # Preview is drawn on a strip with the real panel height, so the icon
        # appears exactly as large as it will on Eduka-Panel.
        self.preview_strip=QFrame(); self.preview_strip.setObjectName('previewStrip')
        strip=QHBoxLayout(self.preview_strip); strip.setContentsMargins(10,4,10,4)
        self.preview=QPushButton(); self.preview.setObjectName('previewButton'); self.preview.setFocusPolicy(Qt.NoFocus)
