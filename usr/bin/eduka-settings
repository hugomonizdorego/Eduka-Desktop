                b.setText('+'); b.setStyleSheet('QToolButton#ledSwatch{background:qconicalgradient(cx:0.5,cy:0.5,angle:0,stop:0 #ff3b30,stop:0.33 #ffd60a,stop:0.66 #0a84ff,stop:1 #ff3b30);color:white;font-weight:800;font-size:15px;}')
                b.clicked.connect(self.pick_accent)
            else:
                b.setStyleSheet(f'QToolButton#ledSwatch{{background:{value};}}')
            self.accent_group.addButton(b); acc.addWidget(b, i//9, i%9); self.accent_swatches[value]=b
        accw=QWidget(); accw.setLayout(acc); p.v.addWidget(accw, 0, Qt.AlignLeft)
        self.accent_value=''
        self.accent_group.buttonClicked.connect(lambda b: self.set_accent(next((v for v, w in self.accent_swatches.items() if w is b), ''), from_click=True))
        p.v.addWidget(hint_label('Eduka-Panel, Eduka-Desktop, the Action Center, Eduka-Settings and the leave screen use this color. "A" keeps the color of the theme.'))
        f=form()
        self.theme_info=hint_label(''); p.v.addWidget(self.theme_info)
        # Ranges match what Eduka-Panel (0.50) and Eduka-Desktop (0.45) accept.
        self.panel_trans=QDoubleSpinBox(); self.panel_trans.setRange(0.50,1.0); self.panel_trans.setDecimals(2); self.panel_trans.setSingleStep(0.01); self.panel_trans.setToolTip('Lower is more transparent; 1.00 is fully opaque'); f.addRow('Panel opacity:', self.panel_trans)
        self.desktop_trans=QDoubleSpinBox(); self.desktop_trans.setRange(0.45,1.0); self.desktop_trans.setDecimals(2); self.desktop_trans.setSingleStep(0.01); self.desktop_trans.setToolTip('Lower is more transparent; 1.00 is fully opaque'); f.addRow('Desktop opacity:', self.desktop_trans)
        self.glass_blur=QCheckBox('Blur behind Liquid Glass (needs 3D graphics; off in VirtualBox)'); f.addRow('', self.glass_blur)
        self.low=QCheckBox('Low resource mode for older computers'); f.addRow('', self.low)
        self.shadow=QCheckBox('Window shadow for Eduka-Desktop'); f.addRow('', self.shadow)
