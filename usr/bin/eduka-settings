        p.v.addLayout(grid)
        self.theme.currentTextChanged.connect(lambda n: self.theme_cards[n].setChecked(True) if n in self.theme_cards else None)
        # Accent color: replaces the green (or the theme's color) everywhere.
        p.v.addWidget(self.card_title('Accent color'))
        acc=QGridLayout(); acc.setHorizontalSpacing(8); acc.setVerticalSpacing(8); self.accent_swatches={}; self.accent_group=QButtonGroup(self)
        for i, (value, name) in enumerate(ACCENT_CHOICES+[('custom', 'Other color…')]):
            b=QToolButton(); b.setObjectName('ledSwatch'); b.setCheckable(True); b.setFixedSize(30,30); b.setToolTip(name); b.setAccessibleName(name)
            b.setCursor(Qt.PointingHandCursor)
