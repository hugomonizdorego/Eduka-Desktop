        self.icon_theme=QComboBox(); self.icon_theme.setAccessibleName('Icon theme')
        for name, label in list_icon_themes():
            self.icon_theme.addItem(label if label == name else f'{label}  ({name})', name)
        fi.addRow('Icon theme:', self.icon_theme)
        fi.addRow('', hint_label('Used by the whole desktop. Install more icon themes (e.g. papirus-icon-theme) for more choices.'))
        icons.addLayout(fi)
        cursor=p.new_card('Mouse cursor')
        fc=form()
        self.cursor_theme=QComboBox(); self.cursor_theme.setAccessibleName('Cursor theme')
