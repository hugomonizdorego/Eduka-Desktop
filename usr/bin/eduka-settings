    def _thumb(self, w, h):
        lab=QLabel(); lab.setObjectName('thumb'); lab.setFixedSize(w, h); lab.setAlignment(Qt.AlignCenter)
        return lab

    @staticmethod
    def human_users():
        try:
            return sorted(u.pw_name for u in pwd.getpwall() if 1000 <= u.pw_uid < 60000 and u.pw_shell not in ('/usr/sbin/nologin','/bin/false'))
        except Exception:
            return []

    def mark_sddm_dirty(self, *_):
        self.update_login_preview()
        if getattr(self, '_loading', False): return
        self._sddm_dirty=True
        if self.realtime:
            # Administrators: saved automatically, without a password prompt
            # (polkit rule 50-edukasaun-desktop.rules).
            self.set_saved_text('Saving…'); self.sddm_timer.start(900)
        else:
            self.set_saved_text('Not saved yet — press "Save Login Screen".', error=True)

    def set_saved_text(self, text, error=False):
        self.sddm_saved.setText(text); self.sddm_saved.setProperty('error', bool(error))
        self.sddm_saved.style().unpolish(self.sddm_saved); self.sddm_saved.style().polish(self.sddm_saved)

    def realtime_sddm(self):
        if self._sddm_dirty and self.apply_sddm(show=False, quiet=True):
            self.set_saved_text('✓ Saved — the login screen shows this now.')

    def update_login_preview(self):
        if not hasattr(self, 'login_preview') or not hasattr(self, 'theme'):
            return
        req=self.sddm_request()
        cfg=self.read_sddm_config()
        bg=None if self._sddm_background == '' else ('' if self._sddm_background == 'reset' else self._sddm_background)
        logo=None if self._sddm_logo == '' else ('/usr/share/Edukasaun/Logo/Edukasaun Logo.png' if self._sddm_logo == 'reset' else self._sddm_logo)
        if getattr(self, '_preview_init', False) is False:
            bg=cfg.get('background','') if bg is None else bg; logo=cfg.get('logo','') if logo is None else logo; self._preview_init=True
        self.login_preview.set_config(req, bg, logo)

    def update_sddm_state(self):
        active=sddm_conf_value('Theme', 'Current') or '(SDDM default)'
        greeter=sddm_greeter()
        ok=active == 'edukasaun'
        lines=[('✓ ' if ok else '⚠ ')+f'Login theme in use: {active}']
        lines.append(f"Greeter: {os.path.basename(greeter) + (' (Qt 6)' if greeter.endswith('qt6') else ' (Qt 5)') if greeter else 'SDDM is not installed'}")
        auto=sddm_conf_value('Autologin', 'User')
        lines.append(f'Automatic login: {auto}' if auto else 'Automatic login: off (live session: always on)')
        lines.append('Changes are saved automatically.' if self.realtime else 'Saving asks for an administrator password.')
        self.sddm_state.setText('\n'.join(_(l) for l in lines))
        self.sddm_fix.setVisible(not ok and greeter is not None)
        self.sddm_apply.setVisible(not self.realtime)

    def mark_sddm_follow(self):
        if getattr(self, '_loading', False) or not hasattr(self, 'sddm_style'): return
        if self.sddm_style.currentData() == 'follow':
            self._sddm_dirty=True

    def read_sddm_config(self):
        cfg={'style':'light','accent':'#00a879','title':'Edukasaun','defaultUser':'edukasaun','showClock':'true',
             'background':'/usr/share/Edukasaun/SDDM/Default.png','logo':'/usr/share/Edukasaun/Logo/Edukasaun Logo.png'}
        for name in ('theme.conf','theme.conf.user'):
            parser=configparser.ConfigParser(interpolation=None)
            try:
                parser.read(SDDM_THEME_DIR/name, encoding='utf-8')
                if parser.has_section('General'):
                    cfg.update({k: v for k, v in parser.items('General')})
            except Exception:
                pass
        cfg['defaultUser']=cfg.get('defaultuser', cfg.get('defaultUser', ''))
        cfg['showClock']=cfg.get('showclock', cfg.get('showClock', 'true'))
        return cfg

    def autologin_user(self):
        for path in ('/etc/sddm.conf.d/20-eduka-autologin.conf',):
            try:
                for line in Path(path).read_text(encoding='utf-8').splitlines():
                    if line.strip().startswith('User='):
                        return line.split('=',1)[1].strip()
            except Exception:
                pass
        return ''

    def set_thumb(self, label, path, fallback_text):
        pix=QPixmap(path) if path and os.path.isfile(path) else QPixmap()
        if pix.isNull():
            label.setPixmap(QPixmap()); label.setText(fallback_text)
        else:
            label.setText(''); label.setPixmap(pix.scaled(label.size()-QSize(6,6), Qt.KeepAspectRatioByExpanding if label.width() > 100 else Qt.KeepAspectRatio, Qt.SmoothTransformation))

    def set_sddm_background(self, path):
        self._sddm_background=path; self.mark_sddm_dirty()
        self.set_thumb(self.sddm_bg_thumb, '' if path == 'reset' else path, 'Green gradient')

    def set_sddm_logo(self, path):
        self._sddm_logo=path; self.mark_sddm_dirty()
        self.set_thumb(self.sddm_logo_thumb, '/usr/share/Edukasaun/Logo/Edukasaun Logo.png' if path == 'reset' else path, 'Logo')

    def choose_sddm_background(self):
        f,_=QFileDialog.getOpenFileName(self,'Login screen background',str(Path.home()/'Pictures'),'Pictures (*.png *.jpg *.jpeg *.webp *.bmp)')
        if f: self.set_sddm_background(f)

    def choose_sddm_logo(self):
        f,_=QFileDialog.getOpenFileName(self,'Login screen logo',str(Path.home()/'Pictures'),'Pictures (*.png *.jpg *.jpeg *.webp *.bmp)')
        if f: self.set_sddm_logo(f)

    def use_wallpaper_for_sddm(self):
        wallpaper=None
        for conf in (Path.home()/'.config/pcmanfm-qt/lxqt/settings.conf', Path.home()/'.config/pcmanfm-qt/default/settings.conf'):
            value=_get_ini_value(conf, 'Desktop', 'Wallpaper')
            if value and os.path.isfile(value):
                wallpaper=value; break
        if wallpaper:
            self.set_sddm_background(wallpaper)
        else:
            self.show_status('No desktop wallpaper found. Choose a picture instead.', error=True)

    @property
    def realtime(self):
        return is_admin_user() and shutil.which('pkexec') is not None and os.path.exists(SDDM_HELPER)

    def pick_sddm_accent(self):
        color=QColorDialog.getColor(QColor(self.sddm_accent_value), self, 'Accent color')
        if color.isValid():
            self.set_sddm_accent(color.name()); self.mark_sddm_dirty()

    def set_sddm_accent(self, value):
        self.sddm_accent_value=value
        self.sddm_accent.setStyleSheet(f'QPushButton#swatch{{background:{value};border:2px solid rgba(255,255,255,200);}}')

    def sddm_request(self):
        style=self.sddm_style.currentData()
        accent=self.sddm_accent_value
        if style == 'follow':
            style={THEME_DARK:'dark', THEME_TRANSPARENT:'dark', THEME_LIQUID:'glass'}.get(self.theme.currentText(), 'light')
            accent=SDDM_ACCENTS[style]
        return {'style': style, 'accent': accent, 'title': self.sddm_title.text().strip() or 'Edukasaun',
                'default_user': self.sddm_user.currentText().strip(), 'show_clock': self.sddm_clock.isChecked(),
                'background': self._sddm_background, 'logo': self._sddm_logo,
                'autologin_user': self.sddm_autologin_user.currentText() if self.sddm_autologin.isChecked() else ''}

    def apply_sddm(self, show=False, quiet=False):
        if shutil.which('pkexec') is None or not os.path.exists(SDDM_HELPER):
            if quiet: self.set_saved_text('Not saved: this computer has no pkexec / Eduka login helper.', error=True)
            if not show:
                return False    # automatic sync: nothing to do outside Edukasaun OS
            self.show_status('The login screen can only be changed on Edukasaun OS (pkexec missing).', error=True); return False
        request=json.dumps(self.sddm_request())
        try:
            out=subprocess.run(['pkexec', SDDM_HELPER], input=request, capture_output=True, text=True, timeout=180)
        except Exception as exc:
            self.show_status(f'Login screen not changed: {exc}', error=True); return False
        if out.returncode != 0:
            reason=(out.stderr or out.stdout).strip().splitlines()
            if out.returncode in (126, 127):
                reason=['administrator password was not given']
            self.show_status('Login screen not changed: '+(reason[-1] if reason else 'unknown error'), error=True); return False
        self._sddm_dirty=False; self._sddm_background=''; self._sddm_logo=''
        if not quiet:
            self.load_sddm_values()
        self.update_sddm_state()
        if show: self.show_status('Login screen updated.'); self.set_saved_text('✓ Saved.')
        return True

    def preview_sddm(self):
        greeter=shutil.which('sddm-greeter-qt6') or shutil.which('sddm-greeter')
        if not greeter or not SDDM_THEME_DIR.exists():
            self.show_status('SDDM is not installed on this computer.', error=True); return
        safe_popen([greeter, '--test-mode', '--theme', str(SDDM_THEME_DIR)])
        self.show_status('Preview opened (shows the applied settings). Close it with Alt+F4.')

    def load_sddm_values(self):
        self._loading=True
        cfg=self.read_sddm_config()
        follow=bool(self.menu.get('sddm_follow', True))
        style='follow' if follow else cfg.get('style','light')
        idx=self.sddm_style.findData(style); self.sddm_style.setCurrentIndex(max(0, idx))
        self.sddm_accent.setEnabled(style != 'follow')
        self.set_sddm_accent(cfg.get('accent','#00a879'))
        self.sddm_title.setText(cfg.get('title','Edukasaun'))
        self.sddm_clock.setChecked(str(cfg.get('showClock','true')).lower() != 'false')
        self.sddm_user.setCurrentText(cfg.get('defaultUser',''))
        auto=self.autologin_user()
        self.sddm_autologin.setChecked(bool(auto))
        if auto: self.sddm_autologin_user.setCurrentText(auto)
        self.set_thumb(self.sddm_bg_thumb, cfg.get('background',''), 'Green gradient')
        self.set_thumb(self.sddm_logo_thumb, cfg.get('logo',''), 'Logo')
        self._preview_init=False; self.update_login_preview()
        self.update_sddm_state()
        self._loading=False

    # ------------------------------------------------------------------ maintenance
    def page_advanced(self):
        p=Page('Maintenance', 'Recovery actions. They never change your saved settings.')
        actions=[
            ('view-refresh','Rebuild application list','Use after installing or removing applications.', self.rebuild_apps),
            ('start-here','Reload Eduka-Desktop','Reload the start menu applications and style.', self.reload_desktop),
            ('system-reboot','Restart Eduka-Panel','Restart the bottom panel if it stops responding.', self.restart_panel),
            ('edit-clear','Repair LXQt theme and session','Use if LXQt asks for a window manager or the theme looks wrong. Your old settings are kept as a backup.', self.repair_lxqt),
            ('help-about','About Edukasaun Desktop','Version and credits.', lambda: safe_popen(['eduka-about'])),
        ]
        for icon, text, hint, handler in actions:
            b=QPushButton(get_icon(icon), '  '+text); b.setObjectName('maintButton'); b.setIconSize(QSize(22,22)); b.setToolTip(hint); b.setAccessibleDescription(hint); b.clicked.connect(handler); p.v.addWidget(b)
            h=hint_label(hint); h.setSizePolicy(QSizePolicy.Ignored, QSizePolicy.Preferred); h.setContentsMargins(6,0,0,4); p.v.addWidget(h)
        return p.finish()

    def rebuild_apps(self):
        safe_popen(['eduka-app-cache','--warm'])
        QTimer.singleShot(1500, lambda: send_menu_command('reload-apps'))
        self.show_status('Application list is being rebuilt.')

    def reload_desktop(self):
        if menu_daemon_alive():
            send_menu_command('reload-apps')
        else:
            ensure_menu_daemon(show=False)
        self.show_status('Eduka-Desktop reloaded.')

    def restart_panel(self):
        safe_popen('pkill -x eduka-panel; sleep 0.3; env QT_LINUX_ACCESSIBILITY_ALWAYS_ON=1 eduka-panel', shell=True)
        self.show_status('Eduka-Panel is restarting.')

    def repair_lxqt(self):
        if QMessageBox.question(self, 'Repair LXQt settings',
                'Move your LXQt settings aside so LXQt recreates them from the Edukasaun defaults?\n\n'
                'Nothing is deleted: the old settings are kept in ~/.config/lxqt.backup-… . '
                'Log out and log in again afterwards.') != QMessageBox.Yes:
            return
        try:
            out=subprocess.run(['eduka-lxqt-repair'], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=10)
            ok=out.returncode == 0; text=out.stdout.strip().splitlines()
        except Exception as exc:
            ok=False; text=[str(exc)]
        self.show_status(('LXQt settings repaired. Log out and log in again.' if ok else 'Repair failed: '+(text[-1] if text else 'unknown error')), error=not ok)

    def show_status(self, text, error=False):
        self.status.setText(text); self.status.setProperty('error', bool(error))
        self.status.style().unpolish(self.status); self.status.style().polish(self.status)
        self.status_timer.start(8000)

    # ------------------------------------------------------------------ preview / theme
    def update_preview(self, *_):
        if not hasattr(self, 'panel_height'):
            return
        label=self.label.text().strip() or 'Edukasaun'
        icon=self.icon.text().strip() or START_ICON
        panel_h=self.panel_height.value()
        usable=panel_h-8
        requested=self.icon_size.value()
        shown=max(16, min(requested, usable))
        size=menu_button_icon_size(icon, shown, self.keep_aspect.isChecked())
        self.preview.setText((' '+label) if self.show_text.isChecked() else '')
        self.preview.setIcon(get_icon(icon, 'start-here')); self.preview.setIconSize(size)
        self.preview_strip.setFixedHeight(panel_h)
        radius=max(12, int(panel_h/2)); btn_radius=max(10, int(panel_h/2.4))
        theme=self.theme.currentText() if hasattr(self, 'theme') else THEME_DEFAULT
        if theme == THEME_DARK:
            strip_bg='qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #343434,stop:1 #212121)'; strip_border='rgba(255,255,255,40)'
            btn_bg='#26a69a'; btn_border='#26a69a'; btn_text='#ffffff'
        else:
            strip_bg='qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #ffffff,stop:1 #e6f2ee)'; strip_border='#cfe3dc'
            btn_bg='qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #12b98a,stop:1 #00936a)'; btn_border='#00936a'; btn_text='#ffffff'
        self.preview_strip.setStyleSheet(f'QFrame#previewStrip{{background:{strip_bg};border:1px solid {strip_border};border-radius:{radius}px;}}'
                                         f'QPushButton#previewButton{{background:{btn_bg};border:1px solid {btn_border};border-radius:{btn_radius}px;padding:2px 14px;font-weight:700;color:{btn_text};}}')
        info=f'Shown at {size.width()}×{size.height()} px on a {panel_h} px panel.'
        if requested > usable:
            info+=f' Larger than {usable} px needs a taller panel (Behavior → Panel height).'
        if os.path.isfile(icon):
            real=QImageReader(icon).size()
            if real.isValid():
                info=f'Picture {real.width()}×{real.height()} px. '+info
        self.preview_info.setText(info)

    def apply_theme_style(self):
        """The Settings window follows the Eduka theme; spin boxes and combo
        boxes get their arrows in every theme."""
        theme=current_theme()
        self.setStyleSheet(settings_qss(theme) + arrow_qss(theme in DARK_THEMES))
        if hasattr(self, 'theme_cards'):
            for name, card in self.theme_cards.items(): card.setIcon(QIcon(theme_preview(name)))
        # Icons follow the (possibly just changed) icon theme.
        for key, (name, icon, _page) in zip(self.page_keys, self.pages):
            self.nav.item(self.nav_rows[key]).setIcon(get_icon(icon, 'preferences-system'))
        self.logo.setPixmap(get_icon(START_ICON,'start-here').pixmap(40,40))

    def load_values(self):
        """Fill every control from the saved configuration."""
        self._loading=True
        panel, desktop, menu = self.panel, self.desktop, self.menu
        self.start_login.setChecked(menu_daemon_autostart_enabled())
        idx=self.language.findData(menu.get('language','system')); self.language.setCurrentIndex(max(0, idx))
        self.default_section.setCurrentIndex(max(0, self.default_section.findData(desktop.get('last_category','Edukasaun'))))
        theme=normalize_theme_style(desktop.get('theme_style'))
        self.theme.blockSignals(True); self.theme.setCurrentText(theme); self.theme.blockSignals(False)
        current_icons=icon_theme_setup(force=True)
        idx=self.icon_theme.findData(current_icons)
        if idx >= 0: self.icon_theme.setCurrentIndex(idx)
        self._initial_icon_theme=self.icon_theme.currentData()
        idx=self.cursor_theme.findData(current_cursor_theme())
        if idx >= 0: self.cursor_theme.setCurrentIndex(idx)
        idx=self.cursor_size.findData(current_cursor_size()); self.cursor_size.setCurrentIndex(max(0, idx))
        self._initial_cursor=(self.cursor_theme.currentData(), self.cursor_size.currentData())
        self._initial_theme=theme
        self._liquid_confirmed = theme in (THEME_LIQUID, THEME_TRANSPARENT)
        self.panel_trans.setValue(float(panel.get('transparency',0.54)))
        self.desktop_trans.setValue(float(desktop.get('transparency',0.51)))
        self.glass_blur.setChecked(bool(desktop.get('glass_blur', False)))
        self._low_before_liquid=bool(desktop.get('low_resource_mode',True))
        self.low.setChecked(False if theme in (THEME_LIQUID, THEME_TRANSPARENT) else self._low_before_liquid)
        self.low.setEnabled(theme not in (THEME_LIQUID, THEME_TRANSPARENT))
        if theme in self.theme_cards: self.theme_cards[theme].setChecked(True)
        self.shadow.setChecked(bool(desktop.get('enable_shadows',False)))
        self.set_accent(str(desktop.get('accent_color','') or ''))
        self.visual_access.setChecked(bool(desktop.get('visual_accessibility',False)))
        self.hearing_access.setChecked(bool(desktop.get('hearing_accessibility',False)))
        self.orca.setChecked(bool(desktop.get('orca_enabled',False)))
        self.label.setText(panel.get('menu_label','Edukasaun'))
        self.icon.setText(panel.get('menu_icon',START_ICON)); self.icon.setCursorPosition(0)
        self.show_text.setChecked(bool(panel.get('show_menu_text',True)))
        self.icon_size.setValue(int(panel.get('menu_icon_size',26)))
        self.keep_aspect.setChecked(bool(panel.get('menu_icon_keep_aspect',True)))
        self.layout_default.setCurrentIndex(max(0, self.layout_default.findData(desktop.get('layout','Grid'))))
        self.width.setValue(int(desktop.get('width_percent',98)))
        self.height.setValue(int(desktop.get('height_percent',92)))
        self.panel_height.setValue(int(panel.get('height',42)))
        self.panel_width.setValue(int(panel.get('width_percent',96)))
        self.taskbar_style.setCurrentIndex(max(0, self.taskbar_style.findData(panel.get('taskbar_style','Icon and Text'))))
        self.clock_style.setCurrentIndex(max(0, self.clock_style.findData(panel.get('clock_style','digital'))))
        self.clock_format.setCurrentIndex(max(0, self.clock_format.findData(panel.get('clock_format','24h'))))
        self.clock_seconds.setChecked(bool(panel.get('clock_seconds', False))); self.clock_blink.setChecked(bool(panel.get('clock_blink', False)))
        (self.led_swatches.get(str(panel.get('clock_color','') or '').lower()) or self.led_swatches['']).setChecked(True)
        self.pos_cards[panel_position(panel)].setChecked(True)
        self.effects_on.setChecked(bool(desktop.get('effects_enabled', False)))
        self.effect_hover.setCurrentIndex(max(0, self.effect_hover.findData(desktop.get('effect_hover','wave'))))
        self.effect_launch.setCurrentIndex(max(0, self.effect_launch.findData(desktop.get('effect_launch','bubble'))))
        self.update_effects_state(); self.update_clock_preview()
        self.notify_seconds.setValue(int(panel.get('notify_seconds', 7)))
        self.notify_history.setChecked(bool(panel.get('notify_history', True)))
        try:
            self.dnd.setChecked(bool(json.loads((BASE_CONFIG/'panel-state.json').read_text(encoding='utf-8')).get('dnd', False)))
        except Exception:
            self.dnd.setChecked(False)
        self.update_theme_info()
        self._loading=False
        self.load_sddm_values()
        self.update_preview()

    # About is intentionally centralized in Eduka-Desktop.

    def browse_icon(self):
        f,_=QFileDialog.getOpenFileName(self,'Choose panel icon','/usr/share/icons','Images (*.png *.svg *.xpm *.jpg)')
        if f:
            self.icon.setText(f)

    def open_orca_voice_settings(self):
        if not orca_available():
            QMessageBox.warning(self, 'Orca unavailable', 'Orca is not installed or is not available in this desktop session.')
            return
        if not safe_popen(['orca','--setup']):
            QMessageBox.warning(self, 'Orca settings', 'Orca Voice Settings could not be opened in this desktop session.')

    def open_page(self, key):
        if key in self.nav_rows:
            self.nav.setCurrentRow(self.nav_rows[key])

    def activate_existing_window(self):
        if self.isMinimized():
            self.setWindowState(self.windowState() & ~Qt.WindowMinimized)
        self.show(); self.raise_(); self.activateWindow()

    # ------------------------------------------------------------------ save / apply
    def collect(self):
        panel={'menu_label':self.label.text().strip() or 'Edukasaun','menu_icon':self.icon.text().strip() or START_ICON,'show_menu_text':self.show_text.isChecked(),'menu_icon_size':self.icon_size.value(),'menu_icon_keep_aspect':self.keep_aspect.isChecked(),'height':self.panel_height.value(),'width_percent':self.panel_width.value(),'transparency':self.panel_trans.value(),'taskbar_style':self.taskbar_style.currentData(),'position':next((e for e, c in self.pos_cards.items() if c.isChecked()), 'Bottom'),'theme_style':self.theme.currentText(),'clock_style':self.clock_style.currentData(),'clock_format':self.clock_format.currentData(),'clock_seconds':self.clock_seconds.isChecked(),'clock_blink':self.clock_blink.isChecked(),'clock_color':self.led_color(),'notify_seconds':self.notify_seconds.value(),'notify_history':self.notify_history.isChecked()}
        desktop={'layout':self.layout_default.currentData(),'last_category':self.default_section.currentData(),'width_percent':self.width.value(),'height_percent':self.height.value(),'transparency':self.desktop_trans.value(),'low_resource_mode':self.low.isChecked(),'enable_shadows':self.shadow.isChecked(),'theme_style':self.theme.currentText(),'glass_blur':self.glass_blur.isChecked(),'show_right_panel':True,'visual_accessibility':self.visual_access.isChecked(),'hearing_accessibility':self.hearing_access.isChecked(),'orca_enabled':self.orca.isChecked(),'effects_enabled':self.effects_on.isChecked(),'effect_hover':self.effect_hover.currentData(),'effect_launch':self.effect_launch.currentData(),'accent_color':self.accent_value}
        menu={'mode':'Eduka-Desktop','language':self.language.currentData(),'sddm_follow': self.sddm_style.currentData() == 'follow'}
        return panel, desktop, menu

    def save_all(self):
        panel, desktop, menu = self.collect()
        save_panel_config(panel); save_desktop_config(desktop); save_menu_config(menu)
        self.panel, self.desktop, self.menu = read_panel_config(), read_desktop_config(), read_menu_config()
        set_menu_daemon_autostart(self.start_login.isChecked())
        # Theme for the whole desktop: GTK, Qt palette and window borders.
        if desktop['theme_style'] != self._initial_theme or desktop['theme_style'] in SYSTEM_THEMES:
            apply_desktop_theme(desktop['theme_style'])
            self._initial_theme=desktop['theme_style']
        chosen_icons=self.icon_theme.currentData()
        if chosen_icons and chosen_icons != getattr(self, '_initial_icon_theme', None):
            if set_icon_theme(chosen_icons):
                self._initial_icon_theme=chosen_icons
        cursor=(self.cursor_theme.currentData(), self.cursor_size.currentData())
        if cursor[0] and cursor != getattr(self, '_initial_cursor', None):
            if set_cursor_theme(*cursor):
                self._initial_cursor=cursor
        # Do Not Disturb lives in Eduka-Panel's state file (also the Action Center tile).
        try:
            state_path=BASE_CONFIG/'panel-state.json'
            state=json.loads(state_path.read_text(encoding='utf-8')) if state_path.exists() else {}
            if bool(state.get('dnd', False)) != self.dnd.isChecked():
                state['dnd']=self.dnd.isChecked(); write_json(state_path, state)
        except Exception:
            pass
        # Compositor mode follows the theme (picom with blur for Liquid Glass).
        ensure_compositor()
        icon_theme_setup(force=True)
        self.apply_theme_style(); self.update_preview()
        ok, message = self.sync_orca(desktop)
        touch_reload(); send_menu_command('reload-style')
        if self._sddm_dirty:
            self.apply_sddm(show=False)
        if not ok:
            QMessageBox.warning(self,'Orca unavailable',message)
        return ok, message

    def apply_settings(self):
        ok, message = self.save_all()
        if ok:
            # Inline confirmation instead of a dialog after every Apply.
            if not self.status.property('error') or not self.status.text():
                self.show_status('Settings applied. '+message if message else 'Applied: Eduka-Panel, Eduka-Desktop and the desktop theme are updated.')
        else:
            self.show_status('Settings applied, but Orca could not be enabled.', error=True)

    def save_close(self):
        ok, _message = self.save_all()
        if ok:
            self.accept()

    def sync_orca(self, desktop):
        enabled=bool(desktop.get('orca_enabled', False))
        if enabled or enabled != self._initial_orca_enabled:
            ok, message=configure_orca(enabled)
            if not ok:
                desktop['orca_enabled']=False
                self.orca.setChecked(False)
                save_desktop_config(desktop)
                return False, message
            self._initial_orca_enabled=enabled
            return True, message
        return True, ''

    def reset_defaults(self):
        if QMessageBox.question(self,'Reset settings',f'Restore the {VERSION} defaults for Eduka-Desktop, Eduka-Menu and Eduka-Panel?\n\nTheme, transparency, size, layout and the menu button are reset. Favorites, pinned applications and the login screen are kept.') != QMessageBox.Yes:
            return
        if self._initial_orca_enabled:
            configure_orca(False); self._initial_orca_enabled=False
        sddm_follow=self.menu.get('sddm_follow', True)
        write_json(panel_config_path(), DEFAULT_PANEL); write_json(desktop_config_path(), DEFAULT_DESKTOP)
        write_json(menu_config_path(), dict(DEFAULT_MENU, sddm_follow=sddm_follow))
        set_menu_daemon_autostart(True)
        apply_desktop_theme(THEME_DEFAULT)
        ensure_compositor()
        # 'reset' makes Eduka-Desktop also drop its remembered layout,
        # category, search and colors, not only re-read the style.
        touch_reload(); send_menu_command('reset')
        self.panel, self.desktop, self.menu = read_panel_config(), read_desktop_config(), read_menu_config()
        self.load_values(); self.apply_theme_style()
        self.show_status('Default settings restored for Eduka-Desktop, Eduka-Menu and Eduka-Panel.')

def requested_page():
    args=sys.argv[1:]
    if '--page' in args and args.index('--page')+1 < len(args):
        return args[args.index('--page')+1]
    return ''

def activate_running_settings(socket_name, page=''):
    socket=QLocalSocket(); socket.connectToServer(socket_name)
    if socket.waitForConnected(500):
        socket.write(f'activate {page}\n'.encode()); socket.flush(); socket.waitForBytesWritten(300); socket.disconnectFromServer(); return True
    if shutil.which('xdotool'):
        return safe_popen(['xdotool','search','--name','Eduka-Settings','windowmap','windowactivate'])
    return False

def run_single_instance():
    ensure_dirs(); app=QApplication(sys.argv); install_translations(app); app.setApplicationName('eduka-settings'); app.setDesktopFileName('eduka-settings'); socket_name=f'eduka-settings-{os.getuid()}'
    lock_file=open(SETTINGS_LOCK, 'w')
    try:
        fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        activate_running_settings(socket_name, requested_page())
        return 0
    QLocalServer.removeServer(socket_name)
    server=QLocalServer()
    if not server.listen(socket_name):
        fcntl.flock(lock_file, fcntl.LOCK_UN)
        return 1
    window=Settings(); window.open_page(requested_page())
    def accept_activation():
        connection=server.nextPendingConnection(); page=''
        if connection:
            connection.waitForReadyRead(80); data=bytes(connection.readAll()).decode('utf-8','ignore').split()
            page=data[1] if len(data) > 1 else ''
            connection.disconnectFromServer()
        window.open_page(page); window.activate_existing_window()
    server.newConnection.connect(accept_activation)
    window.show(); result=app.exec_(); server.close(); QLocalServer.removeServer(socket_name)
    try: fcntl.flock(lock_file, fcntl.LOCK_UN)
    except Exception: pass
    return result

if __name__ == '__main__':
    sys.exit(run_single_instance())
