#!/usr/bin/env python3
"""Which compositor does Eduka-Desktop use?

  eduka-compositor              report: window manager, compositor, picom
                                backend, who started it, virtual machine and
                                OpenGL renderer
  eduka-compositor restart      start the compositor again (after a crash)
  eduka-compositor set MODE     auto | xrender | glx | wm | off
                                (same as Eduka-Settings → Appearance → Compositor)
"""
import sys
sys.path.insert(0, '/usr/lib/edukasaun-desktop')
from eduka_common import (compositor_report, clear_picom_crashes, ensure_compositor, stop_own_picom, save_desktop_config,
                          COMPOSITOR_CHOICES, in_eduka_session)


def main(args):
    if not args or args[0] in ('status', 'report'):
        print(compositor_report()); return 0
    if args[0] == 'restart':
        clear_picom_crashes(); stop_own_picom(); ok=ensure_compositor()
        print(compositor_report())
        if not in_eduka_session():
            print('(not an Eduka-Desktop session: picom is only managed inside Eduka-Desktop)')
        return 0
    if args[0] == 'set' and len(args) == 2 and args[1] in dict(COMPOSITOR_CHOICES):
        save_desktop_config({'compositor': args[1]}); stop_own_picom(); ensure_compositor()
        print(compositor_report()); return 0
    print(__doc__.strip()); return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
