        self.preview_info=QLabel(''); self.preview_info.setObjectName('fieldHint'); self.preview_info.setWordWrap(True); self.preview_info.setSizePolicy(QSizePolicy.Ignored, QSizePolicy.Preferred); self.preview_info.setMinimumHeight(30)
