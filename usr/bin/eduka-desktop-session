#!/bin/sh
# Start an Eduka-Desktop login session on top of LXQt.
#   eduka-desktop-session            -> X11 (startlxqt)
#   eduka-desktop-session --wayland  -> Wayland (startlxqtwayland), not listed
#                                        on the login screen; for testing only
# Used by /usr/share/xsessions/edukasaun-desktop.desktop.
#
# IMPORTANT: do not export XDG_CONFIG_DIRS here. startlxqt only adds the
# LXQt default configuration directory (/usr/share/lxqt: window manager,
# theme, icons) when XDG_CONFIG_DIRS is unset.

mode=x11
[ "${1:-}" = "--wayland" ] && mode=wayland

# Eduka-Panel reads this to know it runs inside an Eduka-Desktop session
# (startlxqt resets XDG_CURRENT_DESKTOP to "LXQt").
export EDUKA_DESKTOP_SESSION="$mode"
export QT_LINUX_ACCESSIBILITY_ALWAYS_ON=1

if [ "$mode" = wayland ]; then
    export XDG_SESSION_TYPE=wayland
    if command -v startlxqtwayland >/dev/null 2>&1; then
        exec startlxqtwayland
    fi
    echo "eduka-desktop-session: startlxqtwayland not found; install lxqt-wayland-session" >&2
    exit 1
fi

if [ -r /usr/lib/edukasaun-desktop/lxqt-defaults.sh ]; then
    . /usr/lib/edukasaun-desktop/lxqt-defaults.sh
    eduka_ensure_window_manager "${XDG_CONFIG_HOME:-$HOME/.config}" || :
fi

exec startlxqt
