            QPushButton#segLeft{border-top-right-radius:0;border-bottom-right-radius:0;border-top-left-radius:14px;border-bottom-left-radius:14px;}
            QPushButton#segRight{border-top-left-radius:0;border-bottom-left-radius:0;border-top-right-radius:14px;border-bottom-right-radius:14px;border-left:0;}
