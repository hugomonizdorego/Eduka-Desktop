        """
        # apply_visual_settings() sets the one window stylesheet (base + theme);
        # setting base_qss first as well left Qt with stale theme rules.
        self.apply_visual_settings()
        for button in self.findChildren(QPushButton):
            button.installEventFilter(self)

    def apply_visual_settings(self, initial=False):
        dcfg = getattr(self, 'desktop_cfg', read_desktop_config())
        accessibility=bool(dcfg.get('visual_accessibility', False))
        composited=getattr(self, '_composited', True)
        theme=effective_theme(dcfg.get('theme_style'))
        liquid=theme == THEME_LIQUID and composited
        dark=theme == THEME_DARK and not accessibility
        UI['dark']=dark
        alpha = max(0.45, min(1.0, float(dcfg.get('transparency', 0.51))))
        set_surface_from_transparency(alpha, accessibility)
        if accessibility or not composited:
            alpha=1.0 if not composited else 0.98
        bg_alpha = int(alpha * 255)
        radius = 22 if composited else 0
        if dark:
            self.bg.setStyleSheet(f'QFrame#menuBg{{background:rgba(44,44,44,{bg_alpha});border:1px solid rgba(255,255,255,40);border-radius:{radius}px;}} QLabel{{color:rgba(255,255,255,222);}}')
        elif liquid and not accessibility:
            self.bg.setStyleSheet('QFrame#menuBg{'+liquid_glass_surface(alpha/0.51, 28, 2)+'} QLabel{color:#132a2f;}')
        else:
            self.bg.setStyleSheet(f'QFrame#menuBg{{background:rgba(250,253,250,{bg_alpha});border:1px solid rgba(220,235,230,230);border-radius:{radius}px;}} QLabel{{color:#1f2d2a;}}')
        if hasattr(self, 'cats'):
            self.cats.setProperty('accessibilityMode', accessibility)
            self.cats.viewport().update()
        if hasattr(self, 'base_qss'):
            accessibility_qss = """
                QFrame#contentCard,QFrame#sideCard{background:rgba(255,255,255,252);border:2px solid #344d47;}
                QListWidget#categoryList{background:rgba(255,255,255,255);border:2px solid #344d47;}
                QLineEdit,QPushButton{background:white;color:#101817;border:2px solid #344d47;font-size:13px;}
                QLabel#sectionTitle{color:#101817;font-size:16px;font-weight:900;}
            """ if accessibility else ''
            liquid_qss = (
                'QFrame#contentCard{background:rgba(255,255,255,30);border:1px solid rgba(255,255,255,150);border-radius:22px;}'
                'QFrame#sideCard{'+liquid_glass_surface(1.0, 22, 1)+'}'
                'QListWidget#categoryList{'+liquid_glass_surface(1.1, 20, 1)+'}'
                'QLineEdit{background:rgba(255,255,255,215);border:1px solid rgba(255,255,255,240);}'
                'QPushButton{'+liquid_glass_surface(1.3, 12, 1)+'}'
                'QPushButton:hover{background:rgba(255,255,255,230);}'
                'QPushButton#segLeft:checked,QPushButton#segRight:checked{background:rgba(30,155,215,215);color:white;border:1px solid rgba(255,255,255,200);}'
                'QLineEdit#searchBox:focus{border:1px solid #1e9bd7;}'
            ) if liquid and not accessibility else ''
            dark_qss = (
                'QLineEdit{background:rgba(56,56,56,235);border:1px solid rgba(255,255,255,40);color:#ffffff;selection-background-color:#26A69A;}'
                'QLineEdit:focus{border:1px solid #4DB6AC;background:#383838;}'
                'QPushButton{background:rgba(255,255,255,20);color:rgba(255,255,255,225);border:1px solid rgba(255,255,255,30);}'
                'QPushButton:hover{background:rgba(255,255,255,40);border:1px solid #4DB6AC;}'
                'QPushButton:pressed{background:rgba(77,182,172,60);}'
                'QToolButton{background:rgba(255,255,255,20);color:#ffffff;border:1px solid rgba(255,255,255,30);}'
                'QFrame#contentCard{background:transparent;border:1px solid rgba(255,255,255,26);}'
                'QFrame#sideCard{background:rgba(56,56,56,170);border:1px solid rgba(255,255,255,30);}'
                'QListWidget#categoryList{background:rgba(33,33,33,170);border:1px solid rgba(255,255,255,30);}'
                'QScrollBar:vertical{background:rgba(255,255,255,20);}'
                'QScrollBar::handle:vertical{background:rgba(77,182,172,150);}'
                'QLabel{color:rgba(255,255,255,222);}'
                'QLabel#sectionTitle,QLabel#brandTitle,QLabel#infoTitle,QLabel#infoValue{color:#ffffff;}'
                'QLabel#brandSub,QLabel#mutedText,QLabel#mutedSmall,QLabel#emptyText,QLabel#infoKey{color:rgba(255,255,255,153);}'
                'QFrame#sysInfoCard{background:rgba(66,66,66,200);border:1px solid rgba(255,255,255,30);}'
                'QPushButton#segLeft:checked,QPushButton#segRight:checked{background:#26A69A;color:white;border:1px solid #26A69A;}'
                'QPushButton#closeButton{background:rgba(239,154,154,30);color:#EF9A9A;}'
            ) if dark else ''
            # The application stylesheet (tooltips) must change before the
            # window stylesheet; the other order leaves window rules stale.
            app=QApplication.instance()
            if app is not None and app.styleSheet() != tooltip_qss():
                app.setStyleSheet(tooltip_qss())
            self.setStyleSheet(self.base_qss + liquid_qss + dark_qss + accessibility_qss)
        self.apply_blur_hint(liquid and not accessibility)
        # The drop shadow re-renders the whole window on every repaint; only
        # when the user asked for shadows and a compositor can show them.
        if composited and dcfg.get('enable_shadows', False) and not dcfg.get('low_resource_mode', True):
            if self.bg.graphicsEffect() is None:
                sh=QGraphicsDropShadowEffect(); sh.setBlurRadius(18); sh.setOffset(0,6); sh.setColor(QColor(37,61,83,40)); self.bg.setGraphicsEffect(sh)
        else:
            self.bg.setGraphicsEffect(None)

    def apply_blur_hint(self, enabled):
        """Ask compatible X11 compositors for background blur; others use the safe Qt fallback."""
        if shutil.which('xprop') is None:
            return
        try:
            wid=str(int(self.winId()))
            if enabled:
                safe_popen(['xprop','-id',wid,'-f','_KDE_NET_WM_BLUR_BEHIND_REGION','32c','-set','_KDE_NET_WM_BLUR_BEHIND_REGION','0'])
            else:
                safe_popen(['xprop','-id',wid,'-remove','_KDE_NET_WM_BLUR_BEHIND_REGION'])
        except Exception:
            pass

    def category_hovered(self, item):
        row=self.cats.row(item)
        if row != getattr(self, '_hover_row', None):
            self._hover_row=row
            self.cats.itemDelegate().rerandomize(row); self.cats.viewport().update()
        self._orca_category_hover(item)

    def _orca_category_hover(self, item):
        if bool(getattr(self, 'desktop_cfg', {}).get('orca_enabled', False)):
            self._orca_hover_item=item
            self.orca_hover_timer.start(320)

    def _focus_hovered_category(self):
        item=self._orca_hover_item
        point=self.cats.viewport().mapFromGlobal(QCursor.pos())
        if item is not None and self.cats.itemAt(point) is item:
            self.cats.setFocus(Qt.MouseFocusReason)
            self.cats.setCurrentItem(item)

    def eventFilter(self, obj, event):
        if event.type() == QEvent.Leave and hasattr(self, 'cats') and obj is self.cats.viewport():
            self._hover_row=None
        if event.type() == QEvent.Enter and isinstance(obj, QAbstractButton):
            if bool(getattr(self, 'desktop_cfg', {}).get('orca_enabled', False)):
                QTimer.singleShot(320, lambda w=obj: w.setFocus(Qt.MouseFocusReason) if w.underMouse() else None)
        return super().eventFilter(obj, event)

    def open_about(self, checked=False):
        """Open the suite About dialog independently from update utilities."""
        self.hide_menu(force=True)
        if not launch_app('eduka-about'):
            QMessageBox.information(
                None,
                'About Edukasaun Desktop',
                f'Edukasaun Desktop Suite {VERSION}\n\n'
                'Eduka-Desktop, Eduka-Panel, Eduka-Menu and '
                'Eduka-Menu-Settings\n\nDeveloper: Hugo Moniz do Rego'
            )

    def position(self):
        screen=QApplication.primaryScreen().availableGeometry(); panel=read_panel_config(); dcfg=read_desktop_config(); ph=int(panel.get('height',42))+18
        wp=max(94, min(99, int(dcfg.get('width_percent',98)))) / 100.0
        hp=max(78, min(95, int(dcfg.get('height_percent',92)))) / 100.0
        available_h = max(520, screen.height() - ph - 14)
        desired_h = int(screen.height() * hp)
        self.resize(int(screen.width()*wp), min(available_h, max(560, desired_h)))
        x = screen.x()+int((screen.width()-self.width())/2)
        y = screen.y()+8
        self.move(x, y)

    def rebuild_categories(self, preserve=True):
        current = self.current_category if preserve else 'Edukasaun'
        self.cats.blockSignals(True)
        self.cats.clear()
        for name, icon, _ in self.category_entries():
            self.cats.addItem(QListWidgetItem(get_icon(icon), '  '+name))
        names = [self.cats.item(i).text().strip() for i in range(self.cats.count())]
        if current not in names:
            current = self.desktop_cfg.get('last_category','Edukasaun') if self.desktop_cfg.get('last_category','Edukasaun') in names else 'Edukasaun'
        if current not in names and names:
            current = names[0]
        for i in range(self.cats.count()):
            if self.cats.item(i).text().strip() == current:
                self.cats.setCurrentRow(i); break
        self.cats.blockSignals(False)
        self.current_category = current

    def add_favorite(self, app):
        key=pin_app_key(app)
        favs=read_favorites()
        if key and key not in favs and len(favs) >= MAX_FAVORITES:
            QMessageBox.information(self, 'Favorites limit', 'Favorites are limited to 5 selected apps only. Remove one favorite before adding another app.')
            return
        if not favorite_app(app):
            QMessageBox.information(self, 'Favorites limit', 'Favorites are limited to 5 selected apps only. Remove one favorite before adding another app.')
            return
        self.refresh_side()
        self.rebuild_categories(preserve=True)
        QTimer.singleShot(10, self.refresh_apps)


    def select_category(self, cat):
        for i in range(self.cats.count()):
            if self.cats.item(i).text().strip()==cat:
                self.cats.setCurrentRow(i); return
        self.cats.setCurrentRow(0)

    def change_category(self):
        if getattr(self, '_built', False) and self.cats.currentRow() >= 0:
            self.cats.itemDelegate().rerandomize(self.cats.currentRow())
        if not getattr(self, '_built', False): return
        item=self.cats.currentItem(); self.current_category=item.text().strip() if item else 'All'
        self.desktop_cfg['last_category']=self.current_category
        registry_update('desktop', {'last_category': self.current_category})
        self.refresh_timer.start(35)

    def set_layout(self, mode):
        if mode == self.layout_mode:
            return
        self.layout_mode=mode; self.desktop_cfg['layout']=mode; save_desktop_config(self.desktop_cfg)
        self.refresh_timer.start(35)

    def clear_apps(self):
        while self.stack_layout.count():
            item=self.stack_layout.takeAt(0)
            w=item.widget(); lay=item.layout()
            if w:
                w.setParent(None); w.deleteLater()
            elif lay:
                while lay.count():
                    child=lay.takeAt(0)
                    if child.widget(): child.widget().deleteLater()
                lay.deleteLater()

    def clear_layout(self, lay):
        while lay.count():
            item=lay.takeAt(0)
            if item.widget(): item.widget().deleteLater()
            elif item.layout(): self.clear_layout(item.layout())

    def refresh_side(self):
        self.clear_layout(self.side_layout)
        fav_title=QLabel('★  Favorites')
        fav_title.setStyleSheet('font-weight:900;color:#d49a00;font-size:14px;')
        self.side_layout.addWidget(fav_title)
        apps_by_key={}
        for a in getattr(self, 'apps', []) or []:
            apps_by_key[pin_app_key(a)] = a
            if a.get('path'): apps_by_key[a.get('path')] = a
            if a.get('desktop_id'): apps_by_key[a.get('desktop_id')] = a
            if a.get('name'): apps_by_key[a.get('name')] = a
        fav_apps=[apps_by_key.get(k) or app_by_pin_key(k) for k in read_favorites()]
        fav_apps=[a for a in fav_apps if a]
        if not fav_apps:
            lab=QLabel('No favorites yet. Right-click an app and choose Add to Favorites.')
            lab.setWordWrap(True); lab.setObjectName('mutedText')
            self.side_layout.addWidget(lab)
        for app in fav_apps[:MAX_FAVORITES]:
            btn=QPushButton(' '+app.get('name','Application')[:23])
            btn.setIcon(get_icon(app.get('icon')))
            btn.setAccessibleName(app.get('name','Application')); btn.setFocusPolicy(Qt.StrongFocus); btn.installEventFilter(self)
            btn.setContextMenuPolicy(Qt.CustomContextMenu)
            btn.clicked.connect(lambda _,a=app: (self.hide_menu(force=True), launch_app(a.get('exec',''), a.get('name',''))))
            btn.customContextMenuRequested.connect(lambda pos,a=app,b=btn: self.favorite_context(a,b,pos))
            self.side_layout.addWidget(btn)
        if len(fav_apps) > MAX_FAVORITES:
            note=QLabel('Only 5 favorites are shown to keep the launcher clean.')
            note.setWordWrap(True); note.setObjectName('mutedSmall')
            self.side_layout.addWidget(note)

        # Keep System Information fixed at the bottom of the right column.
        self.side_layout.addStretch(1)
        info_title=QLabel('ⓘ  System Information')
        info_title.setObjectName('infoTitle')
        self.side_layout.addWidget(info_title)
        di=distro_info()
        info=QFrame(); info.setObjectName('sysInfoCard')
        grid=QGridLayout(info); grid.setContentsMargins(10,8,10,8); grid.setHorizontalSpacing(8); grid.setVerticalSpacing(7)
        rows=[('OS:', di['os']), ('Version:', di['version']), ('Codename:', di['codename']), ('Base OS:', di['base']), ('Desktop:', di['desktop'])]
        for r,(k,v) in enumerate(rows):
            lk=QLabel(k); lk.setObjectName('infoKey')
            lv=QLabel(str(v)); lv.setWordWrap(True); lv.setObjectName('infoValue')
            grid.addWidget(lk,r,0,Qt.AlignTop); grid.addWidget(lv,r,1)
        # Card look comes from the window stylesheet (light or Edukasaun-Dark).
        self.side_layout.addWidget(info)

    def desktop_context(self, pos):
        """Context menu for empty Eduka-Desktop launcher space."""
        m=RoundedMenu(self)
        m.addAction(get_icon('view-app-grid'), 'Arrange Applications A-Z', lambda: (self.search.clear(), self.rebuild_categories(preserve=True), self.refresh_apps()))
        m.addAction(get_icon('view-grid'), 'Grid View', lambda: self.set_layout('Grid'))
        m.addAction(get_icon('view-list-details'), 'List View', lambda: self.set_layout('List'))
        m.addSeparator()
        m.addAction(get_icon('view-refresh'), 'Refresh Applications', lambda: (setattr(self, 'apps', load_apps(force=True)), self.rebuild_categories(preserve=True), self.refresh_apps()))
        m.addAction(get_icon('preferences-system'), 'Eduka-Menu Settings', lambda: launch_app('eduka-menu-settings'))
        try:
            sender = self.sender()
            m.exec_(sender.mapToGlobal(pos) if hasattr(sender, 'mapToGlobal') else self.mapToGlobal(pos))
        except Exception:
            m.exec_(QCursor.pos())

    def add_to_desktop(self, app):
        ok, msg = add_app_to_desktop(app)
        if ok:
            QMessageBox.information(self, 'Add to Desktop', f"Shortcut added to Desktop:\n{msg}")
        else:
            QMessageBox.warning(self, 'Add to Desktop', f"Could not add shortcut:\n{msg}")

    def favorite_context(self, app, button, pos):
        m=RoundedMenu(self)
        m.addAction(get_icon('system-run'), 'Open', lambda a=app: (self.hide_menu(force=True), launch_app(a.get('exec',''), a.get('name',''))))
        m.addAction(get_icon('list-remove'), 'Remove from Favorites', lambda a=app: self.remove_favorite(a))
        if is_app_pinned(app):
            m.addAction(get_icon('list-remove'), 'Unpin from Taskbar', lambda a=app: unpin_app(a))
        else:
            m.addAction(get_icon('list-add'), 'Pin to Taskbar', lambda a=app: pin_app(a))
        m.exec_(button.mapToGlobal(pos))

    def remove_favorite(self, app):
        unfavorite_app(app)
        self.refresh_side()
        self.rebuild_categories(preserve=True)
        QTimer.singleShot(10, self.refresh_apps)
        registry_update('desktop', {'favorites_changed': True, 'favorite_removed': app.get('name',''), 'version': VERSION})

    def refresh_apps(self):
        if self._loading_apps and not self.apps:
            self.clear_apps(); lab=QLabel('Loading applications...'); lab.setAlignment(Qt.AlignCenter); lab.setObjectName('emptyText'); self.stack_layout.addWidget(lab); return
        self.clear_apps()
        query=self.search.text().strip() if hasattr(self,'search') else ''
        # Searching always covers every application, not only the selected category.
        category='All' if query else self.current_category
        self.category_title.setText(f'Search results for “{query}”' if query else self.current_category)
        self.grid_btn.setChecked(self.layout_mode=='Grid'); self.list_btn.setChecked(self.layout_mode=='List')
        apps=filter_apps(self.apps, category, query)
        high_contrast=bool(self.desktop_cfg.get('visual_accessibility', False))
        orca_enabled=bool(self.desktop_cfg.get('orca_enabled', False))
        registry_update('desktop', {'visible_apps': len(apps), 'category': self.current_category, 'layout': self.layout_mode, 'version': VERSION})
        if not apps:
            empty=QLabel('No applications found' if not self._loading_apps else 'Loading applications...')
            empty.setAlignment(Qt.AlignCenter); empty.setObjectName('emptyText')
            self.stack_layout.addWidget(empty); self.refresh_side(); return
        if self.layout_mode=='Grid':
            grid=QGridLayout(); grid.setContentsMargins(0,0,0,0); self.stack_layout.addLayout(grid)
            width=max(420, self.scroll.viewport().width() or self.scroll.width() or 700)
            large_grid = width >= 1180
            if large_grid:
                # Large monitors gain extra columns and evenly use the available
                # width. Normal laptop/small-screen spacing remains unchanged.
                cell_w=142
                cols=max(1, min(16, max(7, width//145), len(apps)))
                grid.setHorizontalSpacing(10); grid.setVerticalSpacing(12); grid.setAlignment(Qt.AlignTop)
                for column in range(cols):
                    grid.setColumnMinimumWidth(column, cell_w)
                    grid.setColumnStretch(column, 1)
            else:
                cell_w=136 if width < 950 else 148
                cols=max(3, min(7, width//cell_w))
                grid.setSpacing(12); grid.setAlignment(Qt.AlignTop|Qt.AlignLeft)
            for i,app in enumerate(apps):
                pos=(i % cols) + (i // cols) * 3
                accent=app_highlight_color(app, category, pos)
                b=AppButton(app, accent); b._color_pos=pos; b.setIconSize(QSize(48,48)); b.setFixedSize(cell_w-10,112)
                b.set_accessibility_mode(high_contrast, orca_enabled)
                grid.addWidget(b,i//cols,i%cols, Qt.AlignTop|Qt.AlignHCenter if large_grid else Qt.AlignTop|Qt.AlignLeft)
        else:
            for i,app in enumerate(apps):
                accent=app_highlight_color(app, category, i)
                item=AppListItem(app, accent); item._color_pos=i; item.set_accessibility_mode(high_contrast, orca_enabled); self.stack_layout.addWidget(item)
        self.stack_layout.addStretch(); self.refresh_side()

    def ensure_apps_loaded(self):
        if self._loading_apps: return
        self._loading_apps = True
        if not self.apps: self.refresh_apps()
        try:
            apps = load_apps(force=False)
            if apps:
                self.apps = apps
                self.rebuild_categories(preserve=True)
        except Exception: pass
        self._loading_apps = False
        self.refresh_apps()
        registry_update('apps', {'loaded_in_menu': len(self.apps), 'version': VERSION})

    def resizeEvent(self,e):
        super().resizeEvent(e)
        if getattr(self,'layout_mode','Grid')=='Grid' and hasattr(self,'refresh_timer'):
            self.refresh_timer.start(150)

    def show_menu(self):
        now=time.time()
        if self.isVisible() and now - self._last_toggle_time < 0.20: return
        self._last_toggle_time=now
        icon_theme_setup()
        self.panel_cfg=read_panel_config(); self.desktop_cfg=read_desktop_config()
        self._show_guard_until = time.time() + 0.35
        self.update_greeting(); self.position(); self.apply_visual_settings(); self.show(); self.raise_(); self.activateWindow()
        QTimer.singleShot(30, self.raise_)
        # Typing right after opening the menu searches, like other start menus.
        QTimer.singleShot(40, lambda: self.search.setFocus(Qt.PopupFocusReason))
        (RUNTIME_DIR/'menu.pid').write_text(str(os.getpid()))
        registry_update('menu', {'visible': True, 'show_time': now, 'internal_name': 'Eduka-Desktop', 'version': VERSION})
        if not self.apps: QTimer.singleShot(10, self.ensure_apps_loaded)

    def hide_menu(self, force=False):
        now=time.time()
        if (not self.isVisible()) and not force: return
        self._last_toggle_time=now
        registry_update('menu', {'visible': False, 'hide_time': now, 'internal_name': 'Eduka-Desktop', 'version': VERSION})
        self.hide()
        QTimer.singleShot(0, self.recolor)
        if self.search.text():
            # Start the next opening from the full category view.
            self.search.blockSignals(True); self.search.clear(); self.search.blockSignals(False)
            self.refresh_timer.start(60)
        try: (RUNTIME_DIR/'menu.pid').unlink(missing_ok=True)
        except Exception: pass
        if not self.daemon: self.close()

    def toggle_menu(self):
        now=time.time()
        if now - self._last_toggle_time < 0.16: return
        if self.isVisible(): self.hide_menu(force=True)
        else: self.show_menu()

    def check_command(self):
        # Polled every 35 ms: compare the file stamp first and only parse JSON
        # when the panel actually wrote a new command.
        try:
            st=MENU_COMMAND_PATH.stat(); stamp=(st.st_mtime_ns, st.st_size)
        except OSError:
            return
        if stamp == self._last_cmd_stamp:
            return
        self._last_cmd_stamp=stamp
        try:
            data=json.loads(MENU_COMMAND_PATH.read_text(encoding='utf-8'))
            cmd_id=data.get('id')
            if cmd_id == self._last_cmd_id: return
            self._last_cmd_id=cmd_id
            action=data.get('action','toggle')
            if action in ('show','force-show'): self.show_menu()
            elif action in ('hide','force-hide'): self.hide_menu(force=True)
            elif action in ('reload-style', 'reset'):
                self.reload_style(reset=action == 'reset')
            elif action == 'reload-apps':
                self.apps=load_apps(force=True); self.rebuild_categories(preserve=True); self.refresh_apps()
            else: self.toggle_menu()
        except Exception: pass

    def reload_style(self, reset=False):
        """Re-read every setting written by Eduka-Menu Settings and apply it
        right away: theme, icon theme, size, layout and default section.
        With reset=True the remembered search, colors and category are
        dropped too, so Eduka-Desktop looks exactly like a fresh install."""
        self.panel_cfg=read_panel_config(); self.desktop_cfg=read_desktop_config()
        icon_theme_setup(force=True)
        QApplication.instance().setStyleSheet(tooltip_qss())
        self.layout_mode=self.desktop_cfg.get('layout','Grid')
        if reset:
            self.search.blockSignals(True); self.search.clear(); self.search.blockSignals(False)
            reshuffle_palette(); self.cats.itemDelegate().row_colors.clear(); self._hover_row=None
        self.current_category=self.desktop_cfg.get('last_category','Edukasaun') or 'Edukasaun'
        self.position(); self.apply_visual_settings()
        self.rebuild_categories(preserve=True); self.refresh_side()
        self.refresh_apps()

    def recolor(self):
        """Apply a new palette to the hidden menu (no rebuild needed)."""
        if self.isVisible():
            return
        reshuffle_palette()
        self.cats.itemDelegate().row_colors.clear(); self._hover_row=None
        self.cats.viewport().update()
        category='All' if self.search.text().strip() else self.current_category
        tiles=[w for w in self.content.findChildren(QWidget) if isinstance(w, (AppButton, AppListItem)) and w.parent() is self.content]
        for w in tiles:
            w.set_accent(app_highlight_color(w.app, category, getattr(w, '_color_pos', 0)))

    def launch_first_result(self):
        """Enter in the search box opens the first matching application."""
        query=self.search.text().strip()
        apps=filter_apps(self.apps, 'All' if query else self.current_category, query)
        if not apps:
            return
        app=apps[0]
        self.hide_menu(force=True)
        QTimer.singleShot(35, lambda a=app: launch_app(a.get('exec',''), a.get('name','')))

    def keyPressEvent(self, e):
        if e.key() == Qt.Key_Escape:
            if self.search.text():
                self.search.clear()
            else:
                self.hide_menu(force=True)
            e.accept(); return
        super().keyPressEvent(e)

    def closeEvent(self,e):
        try: (RUNTIME_DIR/'menu.pid').unlink(missing_ok=True)
        except Exception: pass
        if self.daemon:
            e.ignore(); self.hide_menu(force=True)
        else: super().closeEvent(e)

    def maybe_hide_after_deactivate(self):
        if not self.isVisible() or self._launching: return
        if time.time() < self._show_guard_until: return
        if QApplication.activePopupWidget() is not None: return
        if QApplication.activeWindow() is self: return
        self.hide_menu(force=True)

    def changeEvent(self,e):
        if e.type() == QEvent.ActivationChange and self.isVisible() and not self._launching:
            QTimer.singleShot(140, self.maybe_hide_after_deactivate)
        return super().changeEvent(e)

def start_daemon(start_visible=False):
    ensure_dirs()
    lock_file = open(MENU_DAEMON_LOCK, 'w')
    try:
        fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        send_menu_command('show' if start_visible else 'toggle')
        return 0
    if in_eduka_session(): wait_for_compositor()
    app=QApplication(sys.argv); app.setStyleSheet(tooltip_qss()); icon_theme_setup(); w=EdukaMenu(daemon=True, start_visible=start_visible)
    ret=app.exec_()
    try: fcntl.flock(lock_file, fcntl.LOCK_UN)
    except Exception: pass
    return ret

if __name__ == '__main__':
    ensure_dirs()
    if '--daemon' in sys.argv:
        sys.exit(start_daemon(start_visible='--show' in sys.argv))
    action = 'show' if '--show' in sys.argv else ('hide' if '--hide' in sys.argv else 'toggle')
    if not menu_daemon_alive():
        safe_popen(['eduka-menu','--daemon','--show'] if action != 'hide' else ['eduka-menu','--daemon'])
    else:
        send_menu_command(action)
    sys.exit(0)
