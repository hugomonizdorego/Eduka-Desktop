        seg=QHBoxLayout(); seg.setSpacing(0); seg.addWidget(self.grid_btn); seg.addWidget(self.list_btn); hdr.addLayout(seg)
        close=QPushButton('✕'); close.setObjectName('closeButton'); close.setToolTip('Close (Esc)'); close.setAccessibleName('Close Eduka-Desktop'); close.clicked.connect(lambda: self.hide_menu(force=True)); close.setFixedSize(38,38)
        hdr.addWidget(close); main.addLayout(hdr)
        body=QHBoxLayout(); body.setSpacing(12); main.addLayout(body,1)
        self.cats=QListWidget(); self.cats.setObjectName('categoryList'); self.cats.setIconSize(QSize(25,25)); self.cats.setFixedWidth(210); self.cats.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff); self.cats.setAccessibleName('Application categories')
        self.cats.setItemDelegate(CategoryDelegate(self.cats)); self.cats.setMouseTracking(True); self.cats.setUniformItemSizes(True); self.cats.viewport().installEventFilter(self); self._hover_row=None
        self._orca_hover_item=None
        self.orca_hover_timer=QTimer(self); self.orca_hover_timer.setSingleShot(True); self.orca_hover_timer.timeout.connect(self._focus_hovered_category)
        for name,icon,_ in self.category_entries():
            self.cats.addItem(QListWidgetItem(get_icon(icon), '  '+name))
        self.cats.currentItemChanged.connect(self.change_category); self.cats.itemEntered.connect(self.category_hovered); body.addWidget(self.cats)
        center=QFrame(); center.setObjectName('contentCard'); center.setContextMenuPolicy(Qt.CustomContextMenu); center.customContextMenuRequested.connect(self.desktop_context); center_lay=QVBoxLayout(center); center_lay.setContentsMargins(14,12,14,12); center_lay.setSpacing(10)
        self.category_title=QLabel('Applications'); self.category_title.setObjectName('sectionTitle'); center_lay.addWidget(self.category_title)
        self.scroll=QScrollArea(); self.scroll.setWidgetResizable(True); self.scroll.setFrameShape(QFrame.NoFrame); self.scroll.setAutoFillBackground(False); self.scroll.viewport().setAutoFillBackground(False); self.scroll.viewport().setAttribute(Qt.WA_TranslucentBackground); self.scroll.setContextMenuPolicy(Qt.CustomContextMenu); self.scroll.customContextMenuRequested.connect(self.desktop_context)
        self.content=QWidget(); self.content.setAutoFillBackground(False); self.content.setAttribute(Qt.WA_TranslucentBackground); self.content.setStyleSheet('background:transparent;'); self.content.setContextMenuPolicy(Qt.CustomContextMenu); self.content.customContextMenuRequested.connect(self.desktop_context); self.stack_layout=QVBoxLayout(self.content); self.stack_layout.setAlignment(Qt.AlignTop); self.stack_layout.setContentsMargins(0,0,0,0); self.stack_layout.setSpacing(10)
        self.scroll.setWidget(self.content); center_lay.addWidget(self.scroll,1); body.addWidget(center,1)
        self.side=QFrame(); self.side.setObjectName('sideCard'); self.side.setFixedWidth(230)
