        for label, icon, cmd in [('About','help-about','eduka-about'),('Lock Screen','system-lock-screen','eduka-session-action lock'),('Logout','system-log-out','eduka-session-action logout'),('Restart','system-reboot','eduka-session-action restart'),('Shut Down','system-shutdown','eduka-session-action shutdown')]:
