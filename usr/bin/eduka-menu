        body.addWidget(self.side)
        # Footer: places on the left, round session buttons on the right.
        foot=QHBoxLayout(); foot.setSpacing(8); main.addLayout(foot)
        for label, icon, cmd in [('File Manager','system-file-manager','pcmanfm-qt'),('Terminal','utilities-terminal','qterminal'),('Settings','preferences-system','eduka-menu-settings')]:
            b=QPushButton(' '+label); b.setObjectName('footChip'); b.setIcon(get_icon(icon)); b.setIconSize(QSize(20,20))
            b.setAccessibleName(label); b.setFocusPolicy(Qt.StrongFocus)
            b.clicked.connect(lambda _,c=cmd: (self.hide_menu(force=True), launch_app(c)))
            foot.addWidget(b)
