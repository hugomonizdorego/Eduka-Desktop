def qcolor(value):
    """QColor from '#rrggbb' or 'rgba(r,g,b,a)' (QColor cannot parse rgba())."""
    m=re.match(r'rgba?\((\d+),(\d+),(\d+)(?:,(\d+))?\)', str(value).replace(' ',''))
    if m:
        r,g,b,a=m.groups(); return QColor(int(r),int(g),int(b),int(a) if a is not None else 255)
    return QColor(value)

