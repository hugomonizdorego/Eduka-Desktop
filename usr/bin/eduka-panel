            ta=max(120, min(242, int(bg_alpha*0.95)))
            self.bg.setStyleSheet(self.bg.styleSheet()+f'''QFrame#panelBg{{background:rgba(26,26,26,{ta});border:1px solid rgba(255,255,255,18);border-radius:{radius}px;}}
            QPushButton#startButton{{background:rgba(217,217,217,30);border:1px solid rgba(255,255,255,26);color:#f2f2f2;}} QPushButton#startButton:hover{{background:rgba(217,217,217,52);}}
