        self.next.clicked.connect(self.calendar.showNextMonth)
        today.clicked.connect(lambda: (self.calendar.setSelectedDate(QDate.currentDate()), self.calendar.showToday()))
        self.calendar.currentPageChanged.connect(lambda *_: self.update_title())
