        self.sound_more.setIcon(QIcon(arrow_icon_path('right', self.ink))); self.sound_more.setIconSize(QSize(12,12))
        self.sound_more.setAccessibleName('Sound output and settings'); self.sound_more.setToolTip('Output device and sound settings'); self.sound_more.clicked.connect(self.sound_menu)
        self.bri_icon=QLabel(); self.bri_icon.setFixedSize(34,34); self.bri_icon.setAlignment(Qt.AlignCenter); self.bri_icon.setPixmap(get_icon('display-brightness','video-display').pixmap(18,18))
        self.bri_slider=QSlider(Qt.Horizontal); self.bri_slider.setRange(5,100); self.bri_slider.setAccessibleName('Screen brightness'); self.bri_value=QLabel('')
        for w in (self.vol_value, self.bri_value): w.setFixedWidth(40); w.setAlignment(Qt.AlignRight|Qt.AlignVCenter)
        cl.addWidget(self.mute,0,0); cl.addWidget(self.vol_slider,0,1); cl.addWidget(self.vol_value,0,2); cl.addWidget(self.sound_more,0,3)
        cl.addWidget(self.bri_icon,1,0); cl.addWidget(self.bri_slider,1,1); cl.addWidget(self.bri_value,1,2)
        self.battery_label=QLabel(''); cl.addWidget(self.battery_label,2,0,1,4)
        self.battery_label.setObjectName('popHint')
        self._vol_timer=QTimer(self); self._vol_timer.setSingleShot(True); self._vol_timer.timeout.connect(self.apply_volume)
        self._bri_timer=QTimer(self); self._bri_timer.setSingleShot(True); self._bri_timer.timeout.connect(self.apply_brightness)
        self.vol_slider.valueChanged.connect(lambda v: (self.vol_value.setText(f'{v}%'), self.update_sound_icon(), self._vol_timer.start(70)))
        self.bri_slider.valueChanged.connect(lambda v: (self.bri_value.setText(f'{v}%'), self._bri_timer.start(90)))

        # Latest notification (the full history opens with "All").
        self.notif_card=QFrame(); self.notif_card.setObjectName('acCard'); nl=QHBoxLayout(self.notif_card); nl.setContentsMargins(10,8,8,8); nl.setSpacing(8)
        self.notif_icon=QLabel(); self.notif_icon.setFixedSize(26,26); nl.addWidget(self.notif_icon)
        self.notif_text=QLabel(''); self.notif_text.setWordWrap(True); self.notif_text.setTextFormat(Qt.PlainText); nl.addWidget(self.notif_text, 1)
        self.notif_open=QPushButton('All'); self.notif_open.setObjectName('linkButton'); self.notif_open.clicked.connect(lambda: (self.close(), panel.notification_popup())); nl.addWidget(self.notif_open)
        self.bv.addWidget(self.notif_card)
        panel.notifications.changed.connect(self.update_notifications); self.update_notifications()

        # Month calendar in a holder whose height follows the grip.
        self.cal_holder=QWidget(); hl=QVBoxLayout(self.cal_holder); hl.setContentsMargins(0,0,0,0)
        self.calendar_card=CalendarCard(); self.calendar=self.calendar_card.calendar; hl.addWidget(self.calendar_card)
        self.cal_full=self.calendar_card.sizeHint().height()
        self.calendar_card.changed.connect(self.agenda_changed)
        self.bv.addWidget(self.cal_holder)
        self.v.addWidget(self.scroll)
        self.v.addWidget(card)

        # Session: Lock, Log Out, Restart, Shut Down.
        session=QHBoxLayout(); session.setSpacing(6)
        for action in ('lock', 'logout', 'restart', 'shutdown'):
            b=QToolButton(); b.setObjectName('acSession'); b.setText(tr(action)); b.setIcon(get_icon(SESSION_ICONS[action], 'system-shutdown')); b.setIconSize(QSize(20,20))
            b.setToolButtonStyle(Qt.ToolButtonTextUnderIcon); b.setFixedHeight(52); b.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
            b.setProperty('danger', action == 'shutdown'); b.setCursor(Qt.PointingHandCursor); b.setAccessibleName(tr(action))
            b.clicked.connect(lambda _=False, a=action: self.session(a)); session.addWidget(b)
        self.v.addLayout(session)

        self.update_time()
        self.refresh(panel.last_status or {})
        self.weather_bg.set_weather(panel.weather)
        self.compact=None
        self.apply_clock_style()
        self.set_compact(bool(read_panel_state().get('action_center_compact', False)) or self.too_tall())

    # -------------------------------------------------------------- size
    def too_tall(self):
        """Small screens (1024x600 netbooks) start in compact mode."""
        return QApplication.primaryScreen().availableGeometry().height() < 640

    def room(self):
        screen=QApplication.primaryScreen().availableGeometry()
        return self.panel.y()-8-(screen.y()+4)

    def set_clock_layout(self, dense):
        """With the month calendar: one row (clock left, greeting and date
        right). Without it: a big clock in the middle."""
        # A wide face (LED or seconds) leaves no room beside it: greeting and
        # date then go under the clock instead of wrapping into a narrow column.
        o=self.clock_opts
        if dense and (o.get('style') == 'led' or o.get('seconds')):
            dense=False
        if dense == self._dense:
            return
        self._dense=dense
        for w in (self.face, self.greeting, self.date_label):
            self.ck.removeWidget(w)
        self.face.set_options(self.clock_opts, big=not dense)
        if dense:
            self.ck.addWidget(self.face, 0, 0, 2, 1, Qt.AlignVCenter)
            self.ck.addWidget(self.greeting, 0, 1, Qt.AlignBottom); self.ck.addWidget(self.date_label, 1, 1, Qt.AlignTop)
            self.ck.setColumnStretch(1, 1)
            for w in (self.greeting, self.date_label): w.setAlignment(Qt.AlignLeft | Qt.AlignVCenter)
        else:
            self.ck.addWidget(self.face, 0, 0, 1, 2, Qt.AlignHCenter)
            self.ck.addWidget(self.greeting, 1, 0, 1, 2); self.ck.addWidget(self.date_label, 2, 0, 1, 2)
            self.ck.setColumnStretch(1, 0)
            for w in (self.greeting, self.date_label): w.setAlignment(Qt.AlignCenter)
        self.update_time()

    def _stack_sizes(self, index):
        for i in range(self.clock_stack.count()):
            self.clock_stack.widget(i).setSizePolicy(QSizePolicy.Preferred if i == index else QSizePolicy.Ignored,
                                                     QSizePolicy.Preferred if i == index else QSizePolicy.Ignored)
        self.clock_stack.updateGeometry(); self.clock_stack.adjustSize(); self.clock_card.updateGeometry()

    def show_globe(self):
        self.clock_stack.setCurrentIndex(1); self.update_time(); self.replace_soon()

    def show_clock(self):
        self.clock_stack.setCurrentIndex(0); self.replace_soon()

    def show_zones(self):
        self.clock_stack.setCurrentIndex(2); self.update_time(); self.replace_soon()

    def replace_soon(self):
        # The clock card learns its new height only after Qt handles the
        # layout events; measure again then, so the Action Center keeps its
        # place above Eduka-Panel instead of growing past the screen.
        if self.isVisible():
            self.place(); QTimer.singleShot(0, self.place); QTimer.singleShot(60, self.place)

    def set_compact(self, compact, remember=False):
        compact=bool(compact)
        self.compact=compact
        self.set_clock_layout(not compact)
        self.set_calendar_height(0 if compact else self.cal_full)
        self.cal_holder.setVisible(not compact)
        self.mode_button.setIcon(QIcon(arrow_icon_path('up' if compact else 'down', self.ink)))
        tip='Show the calendar (drag the handle up)' if compact else 'Smaller: hide the calendar (drag the handle down)'
        self.mode_button.setToolTip(tip); self.mode_button.setAccessibleName(tip); self.grip.setToolTip(tip)
        if remember:
            save_panel_state(action_center_compact=compact)
        if self.isVisible():
            self.place(); QTimer.singleShot(0, self.place)

    CAL_MIN=128   # smallest calendar that still shows all six weeks

    def agenda_changed(self):
        # The agenda below the month grows or shrinks the calendar card.
        self.calendar_card.layout().activate()
        self.cal_full=self.calendar_card.sizeHint().height()
        if not self.compact:
            self.set_calendar_height(self.cal_full)
        self.replace_soon()
        self.panel.check_agenda()

    def set_calendar_height(self, h):
        """Calendar holder height; the month grid shrinks with it."""
        h=max(0, min(self.cal_full, int(h)))
        self.cal_holder.setMinimumHeight(h); self.cal_holder.setMaximumHeight(h)
        grid=max(90, 160-(self.cal_full-h)) if h < self.cal_full else 166
        if self.calendar.height() != grid: self.calendar.setFixedHeight(grid)

    def drag_start(self):
        self._drag_from=self.cal_holder.maximumHeight() if self.cal_holder.isVisible() else 0
        self.set_clock_layout(True)
        self.cal_holder.setVisible(True)

    def drag_move(self, dy):
        h=max(0, min(self.cal_full, self._drag_from-dy, self.room()-self.base_height()))
        self.set_calendar_height(h)
        self.place(check_room=False)

    def drag_end(self, dy):
        self.set_compact(self.cal_holder.maximumHeight() < self.CAL_MIN*0.7, remember=True)

    def settle(self):
        # Layout changes are applied lazily: settle them before measuring.
        QApplication.sendPostedEvents(None, QEvent.LayoutRequest)
        self.ck.activate(); self.bv.activate(); self.v.activate(); self.layout().activate()
        self.body.adjustSize()

    def fixed_height(self):
        """Height of everything except the scrolling body."""
        self.settle()
        # The layout counts the scroll area with its fixed height, not its hint.
        sh=self.scroll.sizeHint().height()
        sh=max(self.scroll.minimumHeight(), min(self.scroll.maximumHeight(), sh))
        return self.sizeHint().height()-sh

    def body_height(self):
        self.settle()
        return self.body.sizeHint().height()

    def base_height(self):
        """Height of the Action Center without the calendar."""
        return self.fixed_height()+self.body_height()-(self.cal_holder.maximumHeight() if self.cal_holder.isVisible() else 0)

    def room(self):
        return self.panel.popup_room()

    def place(self, check_room=True):
        """Open next to Eduka-Panel (any edge). When the full calendar does
        not fit, it is made smaller first; only on very small screens the
        Action Center switches to the compact view."""
        if check_room:
            self.notif_card.setVisible(True)
        if check_room and not self.compact:
            free=self.room()-self.base_height()
            if free < self.CAL_MIN:
                # Make room for the calendar the user asked for: the latest
                # notification is still behind the bell on the panel.
                self.notif_card.setVisible(False); free=self.room()-self.base_height()
            # The calendar the user asked for always stays; when it does not
            # fit completely the body scrolls instead of folding it away.
            # The body scrolls when space is short, so the calendar (with its
            # agenda) keeps its full height instead of being squeezed.
            self.set_calendar_height(self.cal_full); self.cal_holder.setVisible(True)
        if self.fixed_height()+self.body_height() > self.room() and self.notif_card.isVisible():
            self.notif_card.setVisible(False)
        # The body takes the room that is left; it scrolls when that is less.
        avail=max(90, self.room()-self.fixed_height())
        scrolls=self.body_height() > avail
        # Keep the cards clear of the scroll bar.
        self.bv.setContentsMargins(0, 0, 10 if scrolls else 0, 0)
        self.scroll.setFixedHeight(min(self.body_height(), avail))
        self.scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOn if scrolls else Qt.ScrollBarAlwaysOff)
        self.settle(); self.box.adjustSize(); self.adjustSize()
        h=self.sizeHint().height()
        anchor=self.panel.clock.mapToGlobal(QPoint(self.panel.clock.width()//2, self.panel.clock.height()//2))
        pos=self.panel.popup_position(self.width(), h, anchor)
        self.setGeometry(pos.x(), pos.y(), self.width(), h)

    def wheelEvent(self, e):
        # Scrolling on the clock or the handle also changes the size.
        if self.grip.underMouse() or self.clock_card.underMouse():
            self.set_compact(e.angleDelta().y() < 0, remember=True); return
        super().wheelEvent(e)

    # -------------------------------------------------------------- clock
    def apply_clock_style(self):
        self.clock_opts=clock_options(); self.clock_format=self.clock_opts['format']
        self._dense=None
        self.set_clock_layout(not self.compact if self.compact is not None else False)

    def clock_menu(self, pos):
        o=clock_options()
        m=RoundedMenu(self)
        for label, key, value, current in [('Digital clock','clock_style','digital',o['style']), ('Analog clock','clock_style','analog',o['style']),
                                           ('LED clock','clock_style','led',o['style']), (None,None,None,None),
                                           ('24 hours (14:30)','clock_format','24h',o['format']), ('12 hours (2:30 PM)','clock_format','12h',o['format'])]:
            if label is None:
                m.addSeparator(); continue
            act=m.addAction(label); act.setCheckable(True); act.setChecked(value == current)
            act.triggered.connect(lambda _=False, k=key, v=value: self.set_clock(k, v))
        m.addSeparator()
        sec=m.addAction('Show seconds'); sec.setCheckable(True); sec.setChecked(o['seconds']); sec.triggered.connect(lambda on: self.set_clock('clock_seconds', bool(on)))
        blink=m.addAction('Blinking colon'); blink.setCheckable(True); blink.setChecked(o['blink']); blink.triggered.connect(lambda on: self.set_clock('clock_blink', bool(on)))
        colors=m.addMenu('Clock color')
        auto=colors.addAction('Theme color'); auto.setCheckable(True); auto.setChecked(not o['color']); auto.triggered.connect(lambda: self.set_clock('clock_color', ''))
        for value, name in LED_COLORS:
            pix=QPixmap(14,14); pix.fill(QColor(value))
            act=colors.addAction(QIcon(pix), name); act.setCheckable(True); act.setChecked(o['color'].casefold() == value)
            act.triggered.connect(lambda _=False, v=value: self.set_clock('clock_color', v))
        m.addSeparator()
        m.addAction(get_icon('applications-internet', 'globe'), 'World globe', self.show_globe)
        m.addAction(get_icon('preferences-system'), 'Clock settings…', lambda: self.launch('eduka-settings --page clock'))
        m.exec_(self.clock_card.mapToGlobal(pos))

    def set_clock(self, key, value):
        save_panel_config({key: value})
        self.apply_clock_style(); self.panel.update_clock()
        if self.isVisible(): self.place()

    def update_time(self):
        now=QDateTime.currentDateTime(); loc=QLocale()
        self.greeting.setText(f'{greeting_text(now.time().hour(), self.lang)}, {user_display_name()}'.rstrip(', '))
        date=loc.toString(now.date(), QLocale.LongFormat)
        if self.clock_opts['style'] == 'analog':
            date=format_clock(now.time(), self.clock_format)+' • '+date
        self.date_label.setText(date)
        self.face.update()
        if self.clock_stack.currentIndex() == 1:
            utc=QDateTime.currentDateTimeUtc()
            self.globe_info.setText(f"{format_clock(now.time(), self.clock_format)} here • UTC {utc.toString('HH:mm')} • lit side is day")
        elif self.clock_stack.currentIndex() == 2:
            z=zone_info()
            if z['dst_now']: dst=_('Daylight saving time now')
            elif z['uses_dst']: dst=_('Daylight saving time later in the year')
            else: dst=_('No daylight saving time here')
            name=z['name'].replace('_', ' ')
            self.zone_info.setText(f"{name} • {format_clock(now.time(), self.clock_format)} • {z['offset']} {z['abbr'] if not z['abbr'].startswith(('+','-')) else ''}".rstrip()+f"\n{dst}")

    # -------------------------------------------------------------- tiles
    def set_tile(self, key, on, enabled=True, tip=''):
        t=self.tiles[key]
        if bool(t.property('on')) != bool(on):
            t.setProperty('on', bool(on)); t.style().unpolish(t); t.style().polish(t)
        t.setEnabled(enabled)
        t.setToolTip(tip or t.text())
        if key in ('network','bluetooth','airplane','dnd'):
            t.setAccessibleDescription('On' if on else 'Off')

    def update_network_tile(self, st):
        net=st.get('net','offline'); t=self.tiles['network']
        self._net_kind={'wifi':'wifi','ethernet':'ethernet'}.get(net, 'wifi-off' if st.get('wifi_hw') and st.get('wifi_on') else 'offline')
        self._net_signal=st.get('signal')
        if net == 'wifi':
            name=st.get('connection') or 'Wi-Fi'
            t.setText(name if len(name) <= 13 else name[:12]+'…')
            tip=f"{tr('net_wifi', self.lang)}: {name}" + (f" ({st.get('signal')}%)" if st.get('signal') else '')
        elif net == 'ethernet':
            t.setText('Ethernet'); tip=tr('net_lan', self.lang)
        else:
            t.setText(tr('offline', self.lang)); tip=tr('net_off', self.lang)
        self.set_tile('network', net in ('wifi','ethernet'), True, tip+' — right-click: network settings')
        t.setAccessibleName(tip)
        alert=net not in ('wifi','ethernet')
        if bool(t.property('alert')) != alert:
            t.setProperty('alert', alert); t.style().unpolish(t); t.style().polish(t)
        self._led=True; self.paint_network_icon()
        if self._net_kind == 'ethernet':
            if not self.blink.isActive(): self.blink.start(600)
        else:
            self.blink.stop()

    def paint_network_icon(self):
        t=self.tiles['network']
        color='#ffffff' if t.property('on') else self.ink
        t.setIcon(QIcon(network_pixmap(self._net_kind, self._led, 24, color, self._net_signal)))

    def blink_led(self):
        if not self.isVisible():
            self.blink.stop(); return
        self._led=not self._led; self.paint_network_icon()

    def update_sound_icon(self):
        v=self.vol_slider.value(); muted=self.mute.isChecked()
        name='audio-volume-muted' if muted or v == 0 else ('audio-volume-low' if v < 34 else 'audio-volume-medium' if v < 67 else 'audio-volume-high')
        self.mute.setIcon(get_icon(name,'audio-volume-high'))
        self.mute.setAccessibleDescription('Muted' if muted else 'Sound on')

    def refresh(self, st):
        self.update_network_tile(st)
        wifi_on=st.get('wifi_on')
        bt_on=st.get('bt_on')
        self.set_tile('bluetooth', bool(bt_on), bool(st.get('bt_hw')) and bt_on is not None, 'Bluetooth — right-click for devices' if st.get('bt_hw') else 'No Bluetooth adapter found')
        # No Bluetooth adapter: no Bluetooth tile (the others close the gap).
        want=bool(st.get('bt_hw'))
        if self.tiles['bluetooth'].isVisibleTo(self) != want or not hasattr(self, '_tiles_laid'):
            self._tiles_laid=True; self.tiles['bluetooth'].setVisible(want)
            shown=[t for k, t in self.tiles.items() if k != 'bluetooth' or want]
            for t in self.tiles.values(): self.tile_grid.removeWidget(t)
            for i, t in enumerate(shown): self.tile_grid.addWidget(t, i//3, i%3)
        self.set_tile('airplane', bool(st.get('airplane')), wifi_on is not None, 'Turn all wireless radios off')
        self.set_tile('display', False, True, 'Monitor and resolution settings')
        self.set_tile('dnd', dnd_enabled(), True, tr('dnd', self.lang)+': only urgent notifications pop up')
        self.set_tile('settings', False, True, 'Eduka-Settings — right-click for LXQt Settings')
        vol=st.get('volume')
        self.vol_slider.blockSignals(True); self.vol_slider.setEnabled(vol is not None); self.vol_slider.setValue(int(vol or 0)); self.vol_slider.blockSignals(False)
        self.vol_value.setText(f'{vol}%' if vol is not None else '—')
        self.mute.blockSignals(True); self.mute.setChecked(bool(st.get('muted'))); self.mute.setEnabled(vol is not None); self.mute.blockSignals(False)
        self.update_sound_icon()
        self.update_media(st.get('streams') or [], st.get('players') or [])
        bri=st.get('brightness'); method=st.get('brightness_method')
        self.bri_slider.blockSignals(True)
        self.bri_slider.setMinimum(SOFTWARE_BRIGHTNESS_MIN if method == 'software' else 5)
        self.bri_slider.setEnabled(bri is not None); self.bri_slider.setValue(int(bri or 100))
        self.bri_slider.blockSignals(False)
        self.bri_value.setText(f'{bri}%' if bri is not None else '—')
        self.bri_slider.setToolTip({'backlight':'Screen brightness','software':'Screen brightness (display has no backlight control; adjusted by Eduka)'}.get(method, 'Brightness is not available on this display'))
        bat=st.get('battery')
        info=[f"Battery {bat['capacity']}% ({bat['status']})" if bat else 'Power: AC', f"Keyboard {st.get('layout','EN')}"]
        if st.get('printers'): info.append('Printer ready')
        pc=getattr(self.panel, 'parental', {}) or {}
        if pc.get('enabled') and pc.get('phase') in ('ok', 'warn'):
            from eduka_parental import minutes_text
            info.append('⏳ '+minutes_text(pc.get('remaining', 0)))
        self.battery_label.setText('  •  '.join(_(x) for x in info))
        count=int(self.panel.eus_status.get('count',0) or 0) if self.panel.eus_status else 0
        self.update_button.setVisible(count > 0)
        if count: self.update_button.setText(f'  {count} update{"s" if count != 1 else ""} available'); self.update_button.setIcon(get_icon(str(EUS_ICON_DIR/'eus-update-available.png'),'system-software-update'))

    def update_media(self, streams, players):
        rows=[]; used=set()
        for stream in streams:
            pl=match_player(stream, players)
            if pl: used.add(pl['name'])
            rows.append((f"s{stream['id']}", stream, pl))
        for pl in players:
            if pl['name'] not in used and pl['status'] in ('Playing', 'Paused'):
                rows.append((pl['name'], None, pl))
        rows=rows[:4]
        keys={k for k, _s, _p in rows}
        for k in list(self.media_rows):
            if k not in keys:
                w=self.media_rows.pop(k); self.media_lay.removeWidget(w); w.deleteLater()
        for k, stream, pl in rows:
            if k not in self.media_rows:
                w=MediaRow(self, k); self.media_rows[k]=w; self.media_lay.addWidget(w)
            self.media_rows[k].set_data(stream, pl)
        had=self.media_box.isVisible(); self.media_box.setVisible(bool(rows))
        if had != bool(rows) and self.isVisible():
            QTimer.singleShot(0, self.place)

    def update_notifications(self):
        items=self.panel.notifications.items
        if items:
            n=items[0]; text=n.get('summary') or n.get('body') or ''
            self.notif_text.setText(f"{n.get('app','')}: {text}"[:90] + (f"   (+{len(items)-1})" if len(items) > 1 else ''))
            self.notif_icon.setPixmap(notification_icon(n, 22))
        else:
            self.notif_text.setText(tr('no_notif', self.lang))
            self.notif_icon.setPixmap(get_icon('preferences-system-notifications','dialog-information').pixmap(22,22))
        self.notif_open.setVisible(bool(items))

    def launch(self, cmd):
        self.close(); launch_app(cmd)

    def session(self, action):
        self.close()
        QTimer.singleShot(120, lambda: confirm_session_action(action))

    def tile_clicked(self, key):
        st=self.panel.last_status or {}
        if key == 'network':
            self.close(); QTimer.singleShot(80, self.panel.network_popup); return
        elif key == 'bluetooth':
            safe_popen(['bluetoothctl','power','off' if st.get('bt_on') else 'on'])
        elif key == 'airplane':
            if st.get('airplane'):
                safe_popen(['nmcli','radio','all','on'])
            else:
                safe_popen(['nmcli','radio','all','off'])
                if st.get('bt_on'): safe_popen(['bluetoothctl','power','off'])
        elif key == 'display':
            self.launch('lxqt-config-monitor'); return
        elif key == 'dnd':
            save_panel_state(dnd=not dnd_enabled()); self.set_tile('dnd', dnd_enabled(), True, self.tiles['dnd'].toolTip())
            self.panel.update_notification_badge(); return
        elif key == 'settings':
            self.launch('eduka-settings'); return
        # Optimistic feedback, then confirm with a fresh status read.
        t=self.tiles[key]; self.set_tile(key, not bool(t.property('on')), t.isEnabled(), t.toolTip())
        QTimer.singleShot(700, self.panel.update_status_icons)

    def tile_settings(self, key):
        cmd={'network':'nm-connection-editor','airplane':'nm-connection-editor','bluetooth':'blueman-manager','display':'lxqt-config-monitor','settings':'lxqt-config','dnd':'eduka-settings --page notifications'}.get(key)
        if cmd: self.launch(cmd)

    def toggle_mute(self, on):
        safe_popen(['pactl','set-sink-mute','@DEFAULT_SINK@','1' if on else '0'])
        self.panel.last_status['muted']=bool(on); self.update_sound_icon()
        QTimer.singleShot(400, self.panel.update_status_icons)

    def sound_menu(self):
        m=RoundedMenu(self)
        sinks=[]; current=None
        for line in (_run_text(['pactl','list','short','sinks'], timeout=2) or '').splitlines():
            parts=line.split('\t')
            if len(parts) >= 2: sinks.append(parts[1])
        default=(_run_text(['pactl','get-default-sink']) or '').strip()
        names={}
        for line in (_run_text(['pactl','list','sinks'], timeout=3) or '').splitlines():
            line=line.strip()
            if line.startswith('Name:'): current=line.split(':',1)[1].strip()
            elif line.startswith('Description:') and current: names[current]=line.split(':',1)[1].strip()
        if sinks:
            header=m.addAction('Output'); header.setEnabled(False)
            for sink in sinks:
                act=m.addAction(names.get(sink, sink)); act.setCheckable(True); act.setChecked(sink == default)
                act.triggered.connect(lambda _=False, s=sink: (safe_popen(['pactl','set-default-sink',s]), QTimer.singleShot(400, self.panel.update_status_icons)))
            m.addSeparator()
        m.addAction(get_icon('preferences-desktop-sound','audio-card'),'Sound Settings…', lambda: self.launch('pavucontrol-qt'))
        m.exec_(self.sound_more.mapToGlobal(QPoint(self.sound_more.width(), 0)))

    def apply_volume(self):
        value=self.vol_slider.value()
        self.panel.last_status['volume']=value
        safe_popen(['pactl','set-sink-volume','@DEFAULT_SINK@',f'{value}%'])
        QTimer.singleShot(400, self.panel.update_status_icons)

    def apply_brightness(self):
        value=self.bri_slider.value()
        method=(self.panel.last_status or {}).get('brightness_method') or 'software'
        set_brightness(value, method)
        self.panel.last_status['brightness']=value

    def hideEvent(self, e):
        MEDIA_WANTED['on']=False
        self.blink.stop()
        self.panel._action_center_closed_at=time.monotonic()
        self.panel.set_tray_compact(False)
        self.panel.clock.set_ac_open(False); self.panel.clock.setToolTip('Click to open the Action Center\nCalendar, Wi-Fi, Bluetooth, sound and brightness')
        super().hideEvent(e)

SESSION_ICONS = {'lock': 'system-lock-screen', 'logout': 'system-log-out', 'restart': 'system-reboot', 'shutdown': 'system-shutdown'}


def _nm_split(line):
    """Split an `nmcli -t` line; SSIDs may contain escaped colons."""
    fields=re.split(r'(?<!\\):', line)
    return [f.replace('\\:', ':').replace('\\\\', '\\') for f in fields]


class SinkWorker(QThread):
    ready=pyqtSignal(object)
    def run(self):
        sinks=[]; current={}
        for line in (_run_text(['pactl','list','sinks'], timeout=3) or '').splitlines():
            line=line.strip()
            if line.startswith('Sink #'):
                current={}; sinks.append(current)
            elif line.startswith('Name:') and sinks:
                current['name']=line.split(':',1)[1].strip()
            elif line.startswith('Description:') and sinks:
                current['description']=line.split(':',1)[1].strip()
        default=(_run_text(['pactl','get-default-sink']) or '').strip()
        self.ready.emit({'sinks':[x for x in sinks if x.get('name')], 'default':default})


# --- Removable drives -------------------------------------------------------
# USB sticks, memory cards and external HDD / SSD. The live system's own boot
# stick and every disk with a system folder are never listed, so they can not
# be ejected by mistake.
SYSTEM_MOUNTS = ('/', '/boot', '/boot/efi', '/home', '/usr', '/var', '/opt', '/srv', '[SWAP]')

def _system_mount(mp):
    return bool(mp) and (mp in SYSTEM_MOUNTS or mp.startswith(('/run/live', '/lib/live', '/cdrom', '/usr/', '/var/', '/boot/')))

def removable_drives():
    """[{name, path, label, kind, size, icon, parts: [{path, label, mountpoint, fstype, uuid}]}]"""
    out=_run_text(['lsblk', '-J', '-b', '-o', 'NAME,PATH,LABEL,SIZE,TYPE,TRAN,RM,HOTPLUG,ROTA,MOUNTPOINT,FSTYPE,MODEL,VENDOR,UUID'], timeout=3)
    try:
        devices=json.loads(out or '{}').get('blockdevices', [])
    except Exception:
        return []
    drives=[]
    for d in devices:
        if d.get('type') != 'disk': continue
        name=str(d.get('name') or ''); tran=str(d.get('tran') or '')
        if not (d.get('hotplug') or d.get('rm') or tran in ('usb', 'mmc') or name.startswith('mmcblk')): continue
        if name.startswith(('loop', 'zram', 'sr', 'ram')): continue
        parts=[]; system=False
        for c in [d]+list(d.get('children') or []):
            if c is not d and c.get('type') not in ('part', 'crypt', 'lvm'): continue
            mp=c.get('mountpoint') or ''
            if _system_mount(mp): system=True
            if c is d and d.get('children'): continue
            if c.get('fstype') or mp:
                parts.append({'path': c.get('path'), 'label': c.get('label') or '', 'mountpoint': mp, 'fstype': c.get('fstype') or '', 'uuid': c.get('uuid') or ''})
        if system or not parts: continue
        model=' '.join(x for x in (str(d.get('vendor') or '').strip(), str(d.get('model') or '').strip()) if x and not x.startswith('0x')).strip()
        size=int(d.get('size') or 0)
        if name.startswith('mmcblk') or tran == 'mmc' or re.search(r'card|sd/mmc|sdxc|sdhc', model, re.I):
            kind, icon='card', 'media-flash'
        elif d.get('rota'):
            kind, icon='hdd', 'drive-harddisk-usb'
        elif re.search(r'ssd|nvme', model, re.I) or size > 300*10**9:
            kind, icon='ssd', 'drive-harddisk-solidstate'
        else:
            kind, icon='usb', 'drive-removable-media-usb'
        label=next((p['label'] for p in parts if p['label']), '') or model or name
        drives.append({'name': name, 'path': d.get('path'), 'label': label, 'model': model, 'kind': kind, 'icon': icon, 'size': size,
                       'parts': parts, 'mountpoint': next((p['mountpoint'] for p in parts if p['mountpoint']), ''),
                       'uuid': next((p['uuid'] for p in parts if p['uuid']), '')})
    return drives

DRIVE_KINDS = {'usb': 'USB flash drive', 'card': 'Memory card', 'hdd': 'External hard disk (HDD)', 'ssd': 'External SSD'}

def human_size(n):
    n=float(n or 0)
    for unit in ('B', 'KB', 'MB', 'GB', 'TB'):
        if n < 1000 or unit == 'TB':
            return f'{n:.0f} {unit}' if unit in ('B', 'KB') or n >= 100 else f'{n:.1f} {unit}'
        n/=1000.0


class DriveAction(QThread):
    """mount, unmount or power off with udisksctl (no root password: the
    person sitting at the computer may do this), without blocking the panel."""
    done=pyqtSignal(bool, str, str)
    def __init__(self, parent, action, drive):
        super().__init__(parent); self.action=action; self.drive=drive
    def run(self):
        ok=True; msg=''; opened=''
        tool=shutil.which('udisksctl')
        try:
            if self.action == 'open':
                part=next((p for p in self.drive['parts'] if p['mountpoint']), None)
                if part:
                    opened=part['mountpoint']
                elif tool:
                    p=self.drive['parts'][0]
                    r=subprocess.run([tool, 'mount', '-b', p['path'], '--no-user-interaction'], capture_output=True, text=True, timeout=30)
                    m=re.search(r' at (.+?)\.?$', r.stdout.strip())
                    ok=r.returncode == 0; msg=(r.stderr or r.stdout).strip(); opened=m.group(1) if m else ''
                else:
                    ok=False; msg='udisksctl is missing (package udisks2).'
            else:
                for p in self.drive['parts']:
                    if not p['mountpoint']: continue
                    if tool:
                        r=subprocess.run([tool, 'unmount', '-b', p['path'], '--no-user-interaction'], capture_output=True, text=True, timeout=60)
                    else:
                        r=subprocess.run(['gio', 'mount', '-u', p['mountpoint']], capture_output=True, text=True, timeout=60)
                    if r.returncode != 0:
                        ok=False; msg=(r.stderr or r.stdout).strip(); break
                if ok and self.action == 'remove' and tool:
                    r=subprocess.run([tool, 'power-off', '-b', self.drive['path'], '--no-user-interaction'], capture_output=True, text=True, timeout=60)
                    if r.returncode != 0: ok=False; msg=(r.stderr or r.stdout).strip()
        except Exception as e:
            ok=False; msg=str(e)
        self.done.emit(ok, msg, opened)


class DrivesPopup(PopupFrame):
    """USB sticks, memory cards and external disks: name, size and free
    space, Open, Eject and Safely remove."""
    def __init__(self, panel):
        super().__init__(panel); self.panel=panel; self.actions=[]
        self.box.setFixedWidth(420); self.setAccessibleName('Removable drives')
        head, _icon, self.subtitle=popup_header('drive-removable-media', 'Removable drives', '')
        self.v.addLayout(head)
        self.list=QVBoxLayout(); self.list.setSpacing(6); self.v.addLayout(self.list)
        self.status=QLabel(''); self.status.setObjectName('popHint'); self.status.setWordWrap(True); self.status.hide(); self.v.addWidget(self.status)
        tip=QLabel('Eject before pulling a drive out. "Safely remove" also switches it off, so its light goes out.')
        tip.setObjectName('popHint'); tip.setWordWrap(True); self.v.addWidget(tip)
        foot=QHBoxLayout()
        fm=QPushButton(get_icon('system-file-manager'), ' File Manager'); fm.clicked.connect(lambda: (self.close(), launch_app('pcmanfm-qt computer:///')))
        foot.addWidget(fm); foot.addStretch(1); self.v.addLayout(foot)
        self.fill(panel.drives)

    def fill(self, drives):
        while self.list.count():
            w=self.list.takeAt(0).widget()
            if w: w.deleteLater()
        self.subtitle.setText(_('{n} connected').replace('{n}', str(len(drives))) if drives else _('Nothing connected'))
        for d in drives:
            card=QFrame(); card.setObjectName('acCard'); g=QGridLayout(card); g.setContentsMargins(10,8,10,8); g.setHorizontalSpacing(10); g.setVerticalSpacing(4)
            ic=QLabel(); ic.setPixmap(get_icon(d['icon'], 'drive-removable-media').pixmap(34,34)); g.addWidget(ic, 0, 0, 3, 1, Qt.AlignTop)
            title=QLabel(d['label']); title.setObjectName('popTitle'); title.setTextFormat(Qt.PlainText); g.addWidget(title, 0, 1, 1, 3)
            info=_(DRIVE_KINDS.get(d['kind'], 'USB flash drive'))+' • '+human_size(d['size'])
            if d['mountpoint']:
                try:
                    st=os.statvfs(d['mountpoint']); free=st.f_bavail*st.f_frsize; total=st.f_blocks*st.f_frsize
                    info+=' • '+_('{f} free').replace('{f}', human_size(free))
                    bar=QProgressBar(); bar.setRange(0, 100); bar.setValue(int(100-free*100/max(1, total))); bar.setTextVisible(False); bar.setFixedHeight(6); bar.setObjectName('driveBar')
                    g.addWidget(bar, 2, 1, 1, 3)
                except Exception:
                    pass
            else:
                info+=' • '+_('not opened yet')
            sub=QLabel(info); sub.setObjectName('popHint'); g.addWidget(sub, 1, 1, 1, 3)
            row=QHBoxLayout(); row.setSpacing(6)
            for key, label, icon in (('open', 'Open', 'document-open'), ('eject', 'Eject', 'media-eject'), ('remove', 'Safely remove', 'media-eject')):
                b=QPushButton(get_icon(icon, 'media-eject'), ' '+_(label)); b.setCursor(Qt.PointingHandCursor); b.setStyleSheet('padding:5px 8px;')
                if key == 'remove': b.setObjectName('primaryButton')
                b.setEnabled(key == 'open' or bool(d['mountpoint']) or key == 'remove')
                b.clicked.connect(lambda _=False, k=key, dr=d: self.run(k, dr)); row.addWidget(b)
            g.addLayout(row, 3, 1, 1, 3)
            self.list.addWidget(card)
        self.adjustSize()

    def run(self, action, drive):
        self.status.show(); self.status.setText({'open': _('Opening…'), 'eject': _('Ejecting… wait a moment.'), 'remove': _('Ejecting and switching off…')}[action])
        t=DriveAction(self, action, drive); self.actions.append(t)
        t.done.connect(lambda ok, msg, opened, a=action, d=drive: self.finished_action(a, d, ok, msg, opened)); t.start()

    def finished_action(self, action, drive, ok, msg, opened):
        if not ok:
            busy='busy' in msg.lower() or 'target is busy' in msg.lower()
            self.status.setText(_('Close the files and windows that use this drive, then try again.') if busy else (_('Could not do this: {m}').replace('{m}', msg[:160])))
            return
        if action == 'open':
            if opened:
                try:
                    subprocess.Popen(['pcmanfm-qt', opened], env=child_env(), start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                except Exception:
                    pass
            self.close(); return
        text=_('{d} can be pulled out now.').replace('{d}', drive['label'])
        self.status.setText('✓ '+text)
        try:
            self.panel.notify_server.notify(_('Removable drives'), 0, drive['icon'], '✓ '+_('Safe to remove'), text, [], {}, -1)
        except Exception:
            pass
        QTimer.singleShot(400, self.panel.update_drives)


class InputWorker(QThread):
    """Applies the keyboard, mouse and touchpad settings (xinput, setxkbmap)
    off the GUI thread and reports the pointer devices it found."""
    done=pyqtSignal(object)
    def __init__(self, parent, cfg=None, keyboard=True):
        super().__init__(parent); self.cfg=cfg; self.keyboard=keyboard
    def run(self):
        try:
            import eduka_input as ei
            cfg=self.cfg or ei.input_config()
            if self.keyboard: ei.apply_keyboard(cfg)
            self.done.emit(ei.apply_pointers(cfg))
        except Exception:
            self.done.emit([])


class TouchpadPopup(PopupFrame):
    """The touchpad: a live picture and the most used switches."""
    def __init__(self, panel):
        super().__init__(panel); self.panel=panel
        import eduka_input as ei
        self.ei=ei; self.cfg=ei.input_config()
        self.box.setFixedWidth(330); self.setAccessibleName('Touchpad')
        names=', '.join(d['name'] for d in panel.touchpad_devices) or _('Touchpad')
        head, _icon, sub=popup_header('input-touchpad', 'Touchpad', names); self.v.addLayout(head)
        _icon.setPixmap(ei.touchpad_icon(60, accent=theme_accent()).pixmap(30, 30))
        sub.setWordWrap(True)
        self.view=ei.TouchpadView(accent=theme_accent()); self.view.setFixedSize(200, 140); self.view.disabled=not self.cfg['tp_enabled']
        self.v.addWidget(self.view, 0, Qt.AlignHCenter)
        hint=QLabel('Move a finger or click: the picture copies the touchpad.'); hint.setObjectName('popHint'); hint.setWordWrap(True); hint.setAlignment(Qt.AlignCenter); self.v.addWidget(hint)
        self.checks={}
        for key, text in (('tp_enabled', 'Touchpad on'), ('tp_tap', 'Tap to click'), ('tp_natural', 'Natural scrolling'), ('tp_dwt', 'Turn off while typing')):
            cb=QCheckBox(text); cb.setChecked(bool(self.cfg[key])); cb.toggled.connect(lambda on, k=key: self.changed(k, on)); self.v.addWidget(cb); self.checks[key]=cb
        foot=QHBoxLayout()
        more=QPushButton(get_icon('preferences-desktop-peripherals', 'input-touchpad'), ' Touchpad settings'); more.setObjectName('linkButton')
        more.clicked.connect(lambda: (self.close(), launch_app('eduka-settings --page touchpad')))
        foot.addWidget(more); foot.addStretch(1); self.v.addLayout(foot)

    def changed(self, key, on):
        self.cfg=self.ei.input_config(); self.cfg[key]=bool(on); self.ei.save_input_config(self.cfg)
        if key == 'tp_enabled': self.view.disabled=not on; self.view.update(); self.panel.touchpad_view.disabled=not on; self.panel.touchpad_view.update()
        w=InputWorker(self.panel, self.cfg, keyboard=False); self.panel._input_workers.append(w)
        w.finished.connect(lambda w=w: self.panel._input_workers.remove(w) if w in self.panel._input_workers else None); w.start()


class ToggleSwitch(QAbstractButton):
    """A small on/off switch (track and round knob) in the accent color."""
    def __init__(self, parent=None):
        super().__init__(parent); self.setCheckable(True); self.setCursor(Qt.PointingHandCursor)
        self.setFixedSize(46, 24); self._pos=0.0
        self._anim=QVariantAnimation(self); self._anim.setDuration(140); self._anim.valueChanged.connect(self._moved)
        self.toggled.connect(self._animate)
    def _moved(self, v): self._pos=float(v); self.update()
    def _animate(self, on):
        self._anim.stop(); self._anim.setStartValue(self._pos); self._anim.setEndValue(1.0 if on else 0.0); self._anim.start()
    def setChecked(self, on):
        super().setChecked(on); self._anim.stop(); self._pos=1.0 if on else 0.0; self.update()
    def sizeHint(self): return QSize(46, 24)
    def paintEvent(self, e):
        p=QPainter(self); p.setRenderHint(QPainter.Antialiasing)
        u=ui_colors(); acc=qcolor(u['accent']); off=qcolor(u['switch_off'])
        if not self.isEnabled(): acc.setAlpha(90); off.setAlpha(90)
        track=QColor(int(off.red()+(acc.red()-off.red())*self._pos), int(off.green()+(acc.green()-off.green())*self._pos), int(off.blue()+(acc.blue()-off.blue())*self._pos), max(off.alpha(), acc.alpha()) if self.isEnabled() else 90)
        r=QRectF(1, 2, self.width()-2, self.height()-4); p.setPen(Qt.NoPen); p.setBrush(track); p.drawRoundedRect(r, r.height()/2, r.height()/2)
        d=r.height()-4; x=r.x()+2+(r.width()-d-4)*self._pos
        p.setBrush(QColor('#ffffff')); p.drawEllipse(QRectF(x, r.y()+2, d, d))
        if self._pos > 0.5:
            p.setPen(QPen(QColor('#ffffff'), 1.8, Qt.SolidLine, Qt.RoundCap))
            p.drawLine(QPointF(r.x()+8, r.center().y()), QPointF(r.x()+11, r.center().y()+3)); p.drawLine(QPointF(r.x()+11, r.center().y()+3), QPointF(r.x()+16, r.center().y()-3))


def switch_row(title, subtitle=''):
    """A row with a bold title (and grey subtitle) on the left and a switch."""
    row=QFrame(); row.setObjectName('switchRow'); lay=QHBoxLayout(row); lay.setContentsMargins(6,4,4,4); lay.setSpacing(8)
    text=QVBoxLayout(); text.setSpacing(0)
    t=QLabel(title); t.setObjectName('popTitle'); t.setStyleSheet('font-size:13px;'); text.addWidget(t)
    sub=QLabel(subtitle); sub.setObjectName('popSub'); sub.setVisible(bool(subtitle)); text.addWidget(sub)
    lay.addLayout(text, 1); sw=ToggleSwitch(); lay.addWidget(sw)
    return row, sw, sub


def eye_icon(opened, color, size=18):
    """Eye (show password) or crossed eye (hide), drawn so it is never missing."""
    pix=QPixmap(size*2, size*2); pix.setDevicePixelRatio(2.0); pix.fill(Qt.transparent)
    p=QPainter(pix); p.setRenderHint(QPainter.Antialiasing); c=QColor(color)
    p.setPen(QPen(c, 1.6)); p.setBrush(Qt.NoBrush)
    path=QPainterPath(); path.moveTo(size*0.08, size*0.5); path.quadTo(size*0.5, size*0.08, size*0.92, size*0.5); path.quadTo(size*0.5, size*0.92, size*0.08, size*0.5)
    p.drawPath(path); p.setBrush(c); p.drawEllipse(QPointF(size*0.5, size*0.5), size*0.14, size*0.14)
    if not opened:
        p.setPen(QPen(c, 1.8, Qt.SolidLine, Qt.RoundCap)); p.drawLine(QPointF(size*0.15, size*0.85), QPointF(size*0.85, size*0.15))
    p.end()
    return QIcon(pix)


def link_row(text, icon=None):
    b=QPushButton((' ' if icon else '')+text); b.setObjectName('menuLink'); b.setCursor(Qt.PointingHandCursor)
    if icon: b.setIcon(get_icon(icon, 'preferences-system'))
    return b


def signal_pixmap(signal, secure, color, size=20):
    """Wi-Fi fan with 1-4 lit arcs and a small lock for secured networks."""
    pix=QPixmap(size*2, size*2); pix.setDevicePixelRatio(2.0); pix.fill(Qt.transparent)
    p=QPainter(pix); p.setRenderHint(QPainter.Antialiasing)
    lit=1 if signal < 25 else 2 if signal < 50 else 3 if signal < 75 else 4
    c=QPointF(size*0.5, size*0.86)
    for i in range(4):
        col=QColor(color); col.setAlpha(255 if i < lit else 70)
        r=size*(0.12+0.2*i)
        if i == 0:
            p.setPen(Qt.NoPen); p.setBrush(col); p.drawEllipse(c, size*0.08, size*0.08); continue
        p.setPen(QPen(col, size*0.1, Qt.SolidLine, Qt.RoundCap)); p.setBrush(Qt.NoBrush)
        p.drawArc(QRectF(c.x()-r, c.y()-r, 2*r, 2*r), 45*16, 90*16)
    if secure:
        lc=QColor(color); w=size*0.34; x=size*0.64; y=size*0.58
        p.setPen(QPen(lc, size*0.07)); p.setBrush(Qt.NoBrush); p.drawArc(QRectF(x+w*0.18, y-w*0.45, w*0.64, w*0.8), 0, 180*16)
        p.setPen(Qt.NoPen); p.setBrush(lc); p.drawRoundedRect(QRectF(x, y, w, w*0.72), 1.5, 1.5)
    p.end()
    return pix


class WifiScanWorker(QThread):
    ready=pyqtSignal(object)
    def run(self):
        result={'nm': shutil.which('nmcli') is not None, 'networks': [], 'known': set(), 'wired': []}
        if result['nm']:
            for line in (_run_text(['nmcli','-t','-f','DEVICE,TYPE,STATE','device'], timeout=4) or '').splitlines():
                f=_nm_split(line)
                if len(f) >= 3 and f[1] == 'ethernet':
                    result['wired'].append({'device': f[0], 'connected': f[2].startswith('connected'), 'state': f[2]})
            out=_run_text(['nmcli','-t','-f','IN-USE,SSID,SIGNAL,SECURITY','device','wifi','list','--rescan','auto'], timeout=12)
            seen={}
            for line in (out or '').splitlines():
                f=_nm_split(line)
                if len(f) < 4 or not f[1]: continue
                ssid=f[1]; active=f[0].strip() == '*'
                try: signal=int(f[2] or 0)
                except ValueError: signal=0
                secure=bool(f[3].strip() and f[3].strip() != '--')
                old=seen.get(ssid)
                if old is None or active or signal > old['signal']:
                    seen[ssid]={'ssid':ssid,'active':active or (old or {}).get('active',False),'signal':signal,'secure':secure}
            result['networks']=sorted(seen.values(), key=lambda n: (not n['active'], -n['signal'], n['ssid'].casefold()))
            known=_run_text(['nmcli','-t','-f','NAME,TYPE','connection','show'])
            result['known']={_nm_split(l)[0] for l in (known or '').splitlines() if 'wireless' in l}
        self.ready.emit(result)


def _signal_icon(signal):
    if signal >= 75: return 'network-wireless-signal-excellent'
    if signal >= 50: return 'network-wireless-signal-good'
    if signal >= 25: return 'network-wireless-signal-ok'
    return 'network-wireless-signal-weak'


class NetworkPopup(PopupFrame):
    """Wired and Wireless switches, the Wi-Fi list with signal and lock, and
    connecting right here: click a network, type the password (show/hide)
    and press Connect — no extra window."""
    def __init__(self, panel):
        super().__init__(panel); self.panel=panel; self.proc=None; self.editor=None
        self.box.setFixedWidth(360); self.setAccessibleName('Network')
        st=panel.last_status or {}
        self.wired_row, self.wired_switch, self.wired_sub=switch_row('Wired')
        self.wired_row.setVisible(False); self.wired_switch.clicked.connect(self.toggle_wired); self.v.addWidget(self.wired_row)
        self.wifi_row, self.switch, self.wifi_sub=switch_row('Wireless', self.status_text(st))
        self.switch.setChecked(bool(st.get('wifi_on'))); self.switch.setEnabled(st.get('wifi_on') is not None); self.switch.setAccessibleName('Wi-Fi')
        self.switch.clicked.connect(self.toggle_wifi); self.v.addWidget(self.wifi_row)
        line=QFrame(); line.setObjectName('popLine'); line.setFixedHeight(1); self.v.addWidget(line)
        self.list_widget=QWidget(); self.list_layout=QVBoxLayout(self.list_widget); self.list_layout.setContentsMargins(0,0,0,0); self.list_layout.setSpacing(2)
        self.scroll=QScrollArea(); self.scroll.setWidgetResizable(True); self.scroll.setFrameShape(QFrame.NoFrame); self.scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self.scroll.setWidget(self.list_widget); self.scroll.setFixedHeight(min(300, max(200, panel.popup_room()-200))); self.v.addWidget(self.scroll)
        self.message=QLabel(''); self.message.setObjectName('popHint'); self.message.setWordWrap(True); self.message.hide(); self.v.addWidget(self.message)
        line=QFrame(); line.setObjectName('popLine'); line.setFixedHeight(1); self.v.addWidget(line)
        refresh=link_row('Refresh', 'view-refresh'); refresh.clicked.connect(self.scan); self.v.addWidget(refresh)
        conns=link_row('Network Connections', 'preferences-system-network'); conns.clicked.connect(lambda: (self.close(), launch_app('nm-connection-editor'))); self.v.addWidget(conns)
        self.worker=None; self.scan()

    @staticmethod
    def status_text(st):
        if st.get('net') == 'wifi': return _('Connected to {n}').replace('{n}', st.get('connection') or 'Wi-Fi')
        if st.get('net') == 'ethernet': return _('Ethernet connected')
        return _('Not connected')

    def note(self, text, error=False):
        self.message.setVisible(bool(text)); self.message.setText(text)
        self.message.setStyleSheet('color:#d93f3f;' if error else '')
        QTimer.singleShot(0, self.refit)

    def show_message(self, text):
        self.clear_list(); lab=QLabel(text); lab.setObjectName('popSub'); lab.setAlignment(Qt.AlignCenter); lab.setWordWrap(True)
        self.list_layout.addWidget(lab); self.list_layout.addStretch()

    def clear_list(self):
        self.editor=None
        while self.list_layout.count():
            item=self.list_layout.takeAt(0)
            if item.widget(): item.widget().deleteLater()

    def scan(self):
        if self.worker is not None: return
        if self.panel.last_status.get('wifi_on') is False:
            self.show_message(_('Wi-Fi is off.'))
        else:
            self.show_message(_('Searching for Wi-Fi networks…'))
        # Parented to the panel: the popup may close while nmcli still scans.
        worker=WifiScanWorker(self.panel); self.worker=worker
        worker.ready.connect(self.fill); worker.finished.connect(self._scan_done); worker.finished.connect(worker.deleteLater); worker.start()

    def _scan_done(self):
        self.worker=None

    def closeEvent(self, e):
        if self.worker is not None:
            try:
                self.worker.ready.disconnect(self.fill); self.worker.finished.disconnect(self._scan_done)
            except (TypeError, RuntimeError):
                pass
            self.worker=None
        super().closeEvent(e)

    def fill(self, result):
        wired=result.get('wired') or []
        self.wired=wired
        self.wired_row.setVisible(bool(wired))
        if wired:
            on=any(w['connected'] for w in wired); self.wired_switch.setChecked(on)
            self.wired_sub.setVisible(True); self.wired_sub.setText(_('Connected') if on else _('Cable not connected') if all('unavailable' in w['state'] for w in wired) else _('Off'))
        QTimer.singleShot(0, self.refit)
        if not result.get('nm'):
            self.show_message(_('NetworkManager is not available.')); return
        if self.panel.last_status.get('wifi_on') is False:
            self.show_message(_('Wi-Fi is off.')); return
        nets=result.get('networks') or []
        if not nets:
            self.show_message(_('No Wi-Fi networks found.')); return
        self.clear_list(); self.known=result.get('known') or set()
        ink=qcolor(ui_colors()['text'])
        for n in nets[:24]:
            row=QPushButton(); row.setObjectName('netRow'); row.setProperty('active', n['active']); row.setCursor(Qt.PointingHandCursor)
            row.setAccessibleName(f"{n['ssid']}, signal {n['signal']} percent" + (', secured' if n['secure'] else '') + (', connected' if n['active'] else ''))
            lay=QHBoxLayout(row); lay.setContentsMargins(8,3,8,3); lay.setSpacing(8)
            name=QLabel(n['ssid']); name.setTextFormat(Qt.PlainText); name.setStyleSheet('font-weight:%s;' % ('800' if n['active'] else '600')); lay.addWidget(name,1)
            if n['active']:
                tag=QLabel(_('Connected')); tag.setStyleSheet(f"color:{ui_colors()['accent']};font-weight:700;font-size:11px;"); lay.addWidget(tag)
            pct=QLabel(f"{n['signal']}%"); pct.setObjectName('popSub'); pct.setFixedWidth(38); pct.setAlignment(Qt.AlignRight | Qt.AlignVCenter); lay.addWidget(pct)
            ic=QLabel(); ic.setPixmap(signal_pixmap(n['signal'], n['secure'], ink)); lay.addWidget(ic)
            for w in row.findChildren(QLabel): w.setAttribute(Qt.WA_TransparentForMouseEvents)
            row.setMinimumHeight(34)
            row.clicked.connect(lambda _=False, net=n, r=row: self.choose(net, r))
            self.list_layout.addWidget(row)
        self.list_layout.addStretch()

    def toggle_wifi(self, on):
        safe_popen(['nmcli','radio','wifi','on' if on else 'off'])
        self.panel.last_status['wifi_on']=on
        if on: QTimer.singleShot(2500, self.scan)
        else: self.show_message(_('Wi-Fi is off.'))
        QTimer.singleShot(800, self.panel.update_status_icons)

    def toggle_wired(self, on):
        for w in getattr(self, 'wired', []):
            self.run(['nmcli','device','connect' if on else 'disconnect', w['device']], _('Wired network on.') if on else _('Wired network off.'))

    def run(self, cmd, success, after=None):
        """nmcli without blocking; the result is written in the popup."""
        if self.proc is not None: return
        self.note(_('Connecting…') if 'connect' in cmd or 'up' in cmd else _('Working…'))
        proc=QProcess(self); proc.setProcessChannelMode(QProcess.MergedChannels); self.proc=proc
        def done(code, _status, p=proc):
            out=bytes(p.readAll()).decode('utf-8','replace').strip(); self.proc=None
            if code == 0:
                self.note('✓ '+success); QTimer.singleShot(600, self.scan)
            else:
                last=out.splitlines()[-1] if out else _('unknown error')
                if 'Secrets were required' in out or 'password' in out.lower():
                    last=_('Wrong password, try again.')
                self.note(_('Could not connect: {e}').replace('{e}', last), error=True)
            if after: after(code == 0)
            QTimer.singleShot(300, self.panel.update_status_icons)
            p.deleteLater()
        proc.finished.connect(done); proc.start(cmd[0], cmd[1:])

    def choose(self, net, row):
        ssid=net['ssid']
        if self.editor is not None:
            self.editor.deleteLater(); self.editor=None
        if net['active']:
            self.inline(row, ssid, disconnect=True); return
        if ssid in getattr(self, 'known', set()):
            self.run(['nmcli','connection','up','id',ssid], _('Connected to {n}').replace('{n}', ssid)); return
        if net['secure']:
            self.inline(row, ssid); return
        self.run(['nmcli','device','wifi','connect',ssid], _('Connected to {n}').replace('{n}', ssid))

    def inline(self, row, ssid, disconnect=False):
        """Password field (or Disconnect) right under the network."""
        box=QFrame(); box.setObjectName('acCard'); lay=QVBoxLayout(box); lay.setContentsMargins(10,8,10,8); lay.setSpacing(6)
        btns=QHBoxLayout(); btns.setSpacing(6)
        if disconnect:
            lab=QLabel(_('Connected to {n}').replace('{n}', ssid)); lab.setObjectName('popSub'); lay.addWidget(lab)
            b=QPushButton(get_icon('network-disconnect','process-stop'), ' '+_('Disconnect')); b.clicked.connect(lambda: self.run(['nmcli','connection','down','id',ssid], _('Disconnected from {n}.').replace('{n}', ssid)))
            btns.addStretch(1); btns.addWidget(b)
        else:
            field=QHBoxLayout(); field.setSpacing(4)
            pw=QLineEdit(); pw.setEchoMode(QLineEdit.Password); pw.setPlaceholderText(_('Password')); pw.setAccessibleName(_('Password for {n}').replace('{n}', ssid)); field.addWidget(pw, 1)
            ink=ui_colors()['text']
            eye=QToolButton(); eye.setObjectName('roundIcon'); eye.setCheckable(True); eye.setIcon(eye_icon(True, qcolor(ink))); eye.setToolTip(_('Show password')); eye.setAccessibleName(_('Show password'))
            def show(on):
                pw.setEchoMode(QLineEdit.Normal if on else QLineEdit.Password)
                eye.setIcon(eye_icon(not on, '#ffffff' if on else qcolor(ink))); eye.setToolTip(_('Hide password') if on else _('Show password'))
            eye.toggled.connect(show); field.addWidget(eye); lay.addLayout(field)
            ok=QPushButton(_('Connect')); ok.setObjectName('primaryButton'); ok.setEnabled(False)
            pw.textChanged.connect(lambda t: ok.setEnabled(len(t) >= 8 or (0 < len(t) and len(t) in (5, 13))))
            def go():
                if not ok.isEnabled(): return
                self.run(['nmcli','device','wifi','connect',ssid,'password',pw.text()], _('Connected to {n}').replace('{n}', ssid),
                         after=lambda success: (pw.clear(), pw.setFocus()) if not success else None)
            ok.clicked.connect(go); pw.returnPressed.connect(go)
            cancel=QPushButton(_('Cancel')); cancel.clicked.connect(lambda: (box.deleteLater(), setattr(self, 'editor', None), self.note('')))
            btns.addStretch(1); btns.addWidget(cancel); btns.addWidget(ok)
            QTimer.singleShot(0, pw.setFocus)
        lay.addLayout(btns)
        idx=self.list_layout.indexOf(row); self.list_layout.insertWidget(idx+1, box); self.editor=box
        translate_tree(box)
        QTimer.singleShot(50, lambda: self.scroll.ensureWidgetVisible(box))


def media_player_apps():
    """Installed music and video players for "Launch player"."""
    wanted=re.compile(r'(^|;)(AudioVideo|Audio|Video|Player|Music)(;|$)')
    skip=re.compile(r'settings|mixer|pavucontrol|volume|recorder|editor|audacity|kdenlive|openshot|shotcut|obs|cheese|webcam|sound-?converter|equalizer|easyeffects', re.I)
    seen=set(); out=[]
    for app in read_app_registry_fast() or load_apps(force=False):
        cats=app.get('categories','')
        if not wanted.search(cats) or skip.search(app.get('name','')+' '+app.get('exec','')): continue
        key=app.get('name','').casefold()
        if key in seen: continue
        seen.add(key); out.append(app)
    order=['vlc','celluloid','rhythmbox','audacious','clementine','strawberry','lollypop','elisa','mpv','totem','spotify']
    out.sort(key=lambda a: next((i for i, k in enumerate(order) if k in (a.get('exec','')+a.get('name','')).casefold()), 50))
    return out[:6]


class SoundPopup(PopupFrame):
    """Launch player, volume with mute, output device and sound settings."""
    def __init__(self, panel):
        super().__init__(panel); self.panel=panel
        self.box.setFixedWidth(340); self.setAccessibleName('Sound')
        st=panel.last_status or {}
        players=media_player_apps()
        if players:
            head=QPushButton(_('Launch player')); head.setObjectName('menuLink'); head.setCheckable(True); head.setChecked(True)
            head.setStyleSheet('font-weight:800;')
            self.v.addWidget(head)
            self.player_box=QWidget(); pl=QVBoxLayout(self.player_box); pl.setContentsMargins(0,0,0,0); pl.setSpacing(2)
            for app in players:
                b=QPushButton(); b.setObjectName('netRow'); b.setCursor(Qt.PointingHandCursor); b.setAccessibleName(app.get('name',''))
                lay=QHBoxLayout(b); lay.setContentsMargins(10,3,8,3)
                name=QLabel(app.get('name','')); name.setAttribute(Qt.WA_TransparentForMouseEvents); lay.addWidget(name, 1)
                ic=QLabel(); ic.setPixmap(get_icon(app.get('icon'), 'multimedia-player').pixmap(26,26)); ic.setAttribute(Qt.WA_TransparentForMouseEvents); lay.addWidget(ic)
                b.setMinimumHeight(36); b.clicked.connect(lambda _=False, a=app: (self.close(), launch_app(a.get('exec',''), a.get('name',''))))
                pl.addWidget(b)
            self.v.addWidget(self.player_box)
            head.toggled.connect(lambda on: (self.player_box.setVisible(on), self.refit()))
            line=QFrame(); line.setObjectName('popLine'); line.setFixedHeight(1); self.v.addWidget(line)
        row=QHBoxLayout(); row.setSpacing(10)
        self.mute=QToolButton(); self.mute.setObjectName('roundIcon'); self.mute.setCheckable(True); self.mute.setIconSize(QSize(20,20)); self.mute.setAccessibleName('Mute')
        self.mute.setChecked(bool(st.get('muted'))); self.mute.toggled.connect(self.toggle_mute); row.addWidget(self.mute)
        self.slider=QSlider(Qt.Horizontal); self.slider.setRange(0,100); self.slider.setAccessibleName('Volume'); row.addWidget(self.slider,1)
        self.value=QLabel(''); self.value.setFixedWidth(42); self.value.setAlignment(Qt.AlignRight|Qt.AlignVCenter); row.addWidget(self.value)
        vol=st.get('volume'); self.slider.setEnabled(vol is not None); self.slider.setValue(50 if vol is None else int(vol)); self.value.setText(f'{self.slider.value()}%' if vol is not None else '—')
        self.v.addLayout(row)
        self.subtitle=QLabel(''); self.subtitle.setObjectName('popSub'); self.v.addWidget(self.subtitle)
        self.devices=QComboBox(); self.devices.setAccessibleName('Output device'); self.devices.setVisible(False); self.devices.activated.connect(self.choose_device); self.v.addWidget(self.devices)
        line=QFrame(); line.setObjectName('popLine'); line.setFixedHeight(1); self.v.addWidget(line)
        settings=link_row('Sound Settings', 'preferences-desktop-sound'); settings.clicked.connect(lambda: (self.close(), launch_app('pavucontrol-qt' if shutil.which('pavucontrol-qt') else 'pavucontrol'))); self.v.addWidget(settings)
        self._timer=QTimer(self); self._timer.setSingleShot(True); self._timer.timeout.connect(self.apply_volume)
        self.slider.valueChanged.connect(lambda v: (self.value.setText(f'{v}%'), self.update_icons(), self._timer.start(60)))
        self.update_icons()
        worker=SinkWorker(panel); self.worker=worker
        worker.ready.connect(self.fill_devices); worker.finished.connect(worker.deleteLater); worker.start()

    def update_icons(self):
        muted=self.mute.isChecked(); v=self.slider.value()
        name='audio-volume-muted' if muted or v == 0 else ('audio-volume-low' if v < 34 else 'audio-volume-medium' if v < 67 else 'audio-volume-high')
        self.mute.setIcon(get_icon(name,'audio-volume-high'))

    def fill_devices(self, data):
        sinks=data.get('sinks') or []
        current=next((s for s in sinks if s.get('name') == data.get('default')), sinks[0] if sinks else None)
        self.subtitle.setText((current or {}).get('description') or (_('No output device') if not sinks else ''))
        if len(sinks) > 1:
            self.subtitle.hide()
            for sink in sinks:
                self.devices.addItem(get_icon('audio-card','audio-speakers'), sink.get('description') or sink['name'], sink['name'])
            self.devices.setCurrentIndex(max(0, self.devices.findData(data.get('default'))))
            self.devices.setVisible(True); self.refit()

    def choose_device(self, index):
        name=self.devices.itemData(index)
        if name:
            safe_popen(['pactl','set-default-sink',name])
            QTimer.singleShot(400, self.panel.update_status_icons)

    def toggle_mute(self, on):
        safe_popen(['pactl','set-sink-mute','@DEFAULT_SINK@','1' if on else '0'])
        self.panel.last_status['muted']=on; self.update_icons(); QTimer.singleShot(300, self.panel.update_status_icons)

    def apply_volume(self):
        v=self.slider.value(); self.panel.last_status['volume']=v
        safe_popen(['pactl','set-sink-volume','@DEFAULT_SINK@',f'{v}%'])
        QTimer.singleShot(400, self.panel.update_status_icons)

    def closeEvent(self, e):
        try: self.worker.ready.disconnect(self.fill_devices)
        except (TypeError, RuntimeError): pass
        super().closeEvent(e)


def battery_model():
    for b in sorted(Path('/sys/class/power_supply').glob('BAT*')):
        parts=[]
        for f in ('manufacturer', 'model_name'):
            try:
                v=(b/f).read_text().strip()
                if v and v not in parts: parts.append(v)
            except Exception:
                pass
        return ' '.join(parts)
    return ''


def duration_words(minutes):
    h, m=divmod(int(minutes), 60)
    if h and m: return _('{h} hours {m} minutes').replace('{h}', str(h)).replace('{m}', str(m)) if h > 1 else _('1 hour {m} minutes').replace('{m}', str(m))
    if h: return _('{h} hours').replace('{h}', str(h)) if h > 1 else _('1 hour')
    return _('{m} minutes').replace('{m}', str(m))


def power_profiles():
    """(['power-saver', 'balanced', 'performance'], 'balanced') or ([], '')."""
    if not shutil.which('powerprofilesctl'): return [], ''
    out=_run_text(['powerprofilesctl', 'list'], timeout=2) or ''
    names=[]; current=''
    for line in out.splitlines():
        m=re.match(r'^(\*?)\s*([a-z-]+):\s*$', line.strip())
        if m:
            names.append(m.group(2))
            if m.group(1): current=m.group(2)
    return names, current


class BatteryPopup(PopupFrame):
    """Battery level, model and time left, screen brightness and the power
    profile (power-profiles-daemon), like the power menu of other desktops."""
    PROFILE_LABELS={'power-saver': 'Power Saver', 'balanced': 'Balanced', 'performance': 'Performance'}
    def __init__(self, panel):
        super().__init__(panel); self.panel=panel
        self.box.setFixedWidth(360); self.setAccessibleName('Battery')
        info=battery_info()
        head=QHBoxLayout(); head.setSpacing(10)
        ic=QLabel(); ic.setPixmap(get_icon('battery-good-charging' if info and 'charg' in info['status'].lower() and 'dis' not in info['status'].lower() else 'battery-good', 'battery').pixmap(28,28)); head.addWidget(ic)
        title=QLabel((f"{info['capacity']}%  " if info else '')+(battery_model() or _('Battery'))); title.setObjectName('popTitle'); head.addWidget(title, 1)
        self.v.addLayout(head)
        sub=QLabel(self.status_text(info)); sub.setObjectName('popSub'); sub.setWordWrap(True); self.v.addWidget(sub)
        level, method=read_brightness()
        if method:
            row=QHBoxLayout(); row.setSpacing(10)
            sun=QLabel(); sun.setPixmap(get_icon('display-brightness-symbolic','video-display').pixmap(20,20)); row.addWidget(sun)
            self.bright=QSlider(Qt.Horizontal); self.bright.setRange(SOFTWARE_BRIGHTNESS_MIN if method == 'xrandr' else 5, 100); self.bright.setValue(int(level or 100)); self.bright.setAccessibleName(_('Brightness'))
            row.addWidget(self.bright, 1); self.v.addLayout(row)
            self._bt=QTimer(self); self._bt.setSingleShot(True); self._bt.timeout.connect(lambda m=method: set_brightness(self.bright.value(), m))
            self.bright.valueChanged.connect(lambda *_: self._bt.start(60))
        names, current=power_profiles()
        if names:
            line=QFrame(); line.setObjectName('popLine'); line.setFixedHeight(1); self.v.addWidget(line)
            self.profile_buttons={}
            for name in names:
                b=QPushButton(('●  ' if name == current else '     ')+_(self.PROFILE_LABELS.get(name, name.title())))
                b.setObjectName('menuLink'); b.setCursor(Qt.PointingHandCursor)
                if name == current: b.setStyleSheet('font-weight:800;')
                b.clicked.connect(lambda _=False, n=name: self.set_profile(n)); self.v.addWidget(b); self.profile_buttons[name]=b
        line=QFrame(); line.setObjectName('popLine'); line.setFixedHeight(1); self.v.addWidget(line)
        settings=link_row('Power Settings', 'preferences-system-power-management')
        settings.clicked.connect(lambda: (self.close(), launch_app('lxqt-config-powermanagement'))); self.v.addWidget(settings)

    @staticmethod
    def status_text(info):
        if not info: return _('No battery detected')
        st=info['status'].lower(); m=info.get('minutes')
        if 'dis' in st:
            return _('Using battery power')+(' – '+_('{t} remaining').replace('{t}', duration_words(m)) if m else '')
        if 'charg' in st:
            return _('Charging')+(' – '+_('{t} until full').replace('{t}', duration_words(m)) if m else '')
        if 'full' in st: return _('Fully charged')
        return _('Plugged in')

    def set_profile(self, name):
        safe_popen(['powerprofilesctl', 'set', name])
        for n, b in self.profile_buttons.items():
            b.setText(('●  ' if n == name else '     ')+_(self.PROFILE_LABELS.get(n, n.title()))); b.setStyleSheet('font-weight:800;' if n == name else '')


class BluetoothWorker(QThread):
    """Adapter state and the known / found devices (bluetoothctl)."""
    ready=pyqtSignal(object)
    def __init__(self, parent, scan=False):
        super().__init__(parent); self.scan=scan
    def run(self):
        res={'tool': shutil.which('bluetoothctl') is not None, 'powered': False, 'devices': []}
        if res['tool']:
            if self.scan:
                _run_text(['bluetoothctl', '--timeout', '8', 'scan', 'on'], timeout=12)
            show=_run_text(['bluetoothctl', 'show'], timeout=3) or ''
            res['powered']='Powered: yes' in show
            devices={}
            for line in (_run_text(['bluetoothctl', 'devices'], timeout=3) or '').splitlines():
                m=re.match(r'Device ([0-9A-F:]{17}) (.*)', line.strip())
                if m: devices[m.group(1)]={'mac': m.group(1), 'name': m.group(2), 'paired': False, 'connected': False, 'icon': 'bluetooth'}
            for mac, d in list(devices.items())[:20]:
                info=_run_text(['bluetoothctl', 'info', mac], timeout=3) or ''
                d['paired']='Paired: yes' in info; d['connected']='Connected: yes' in info
                m=re.search(r'Icon: (\S+)', info)
                if m: d['icon']=m.group(1)
                m=re.search(r'Alias: (.+)', info)
                if m: d['name']=m.group(1).strip()
            res['devices']=sorted(devices.values(), key=lambda d: (not d['connected'], not d['paired'], d['name'].casefold()))
        self.ready.emit(res)


class BluetoothPopup(PopupFrame):
    """Bluetooth on/off, devices (connect, disconnect, pair) and searching,
    all inside the popup. Blueman opens only for its own settings."""
    def __init__(self, panel):
        super().__init__(panel); self.panel=panel; self.proc=None; self.worker=None
        self.box.setFixedWidth(360); self.setAccessibleName('Bluetooth')
        st=panel.last_status or {}
        row, self.switch, self.sub=switch_row('Bluetooth', '')
        self.switch.setChecked(bool(st.get('bt_on'))); self.switch.clicked.connect(self.toggle_power); self.v.addWidget(row)
        line=QFrame(); line.setObjectName('popLine'); line.setFixedHeight(1); self.v.addWidget(line)
        self.list_widget=QWidget(); self.list_layout=QVBoxLayout(self.list_widget); self.list_layout.setContentsMargins(0,0,0,0); self.list_layout.setSpacing(2)
        scroll=QScrollArea(); scroll.setWidgetResizable(True); scroll.setFrameShape(QFrame.NoFrame); scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        scroll.setWidget(self.list_widget); scroll.setFixedHeight(220); self.v.addWidget(scroll)
        self.message=QLabel(''); self.message.setObjectName('popHint'); self.message.setWordWrap(True); self.message.hide(); self.v.addWidget(self.message)
        line=QFrame(); line.setObjectName('popLine'); line.setFixedHeight(1); self.v.addWidget(line)
        self.search=link_row('Search for devices', 'edit-find'); self.search.clicked.connect(lambda: self.refresh(scan=True)); self.v.addWidget(self.search)
        if shutil.which('blueman-manager'):
            more=link_row('Bluetooth Settings', 'preferences-system-bluetooth'); more.clicked.connect(lambda: (self.close(), launch_app('blueman-manager'))); self.v.addWidget(more)
        self.refresh()

    def note(self, text, error=False):
        self.message.setVisible(bool(text)); self.message.setText(text); self.message.setStyleSheet('color:#d93f3f;' if error else '')
        QTimer.singleShot(0, self.refit)

    def clear(self):
        while self.list_layout.count():
            it=self.list_layout.takeAt(0)
            if it.widget(): it.widget().deleteLater()

    def placeholder(self, text):
        self.clear(); lab=QLabel(text); lab.setObjectName('popSub'); lab.setAlignment(Qt.AlignCenter); lab.setWordWrap(True)
        self.list_layout.addWidget(lab); self.list_layout.addStretch()

    def refresh(self, scan=False):
        if self.worker is not None: return
        self.placeholder(_('Searching for devices…') if scan else _('Loading…'))
        self.search.setEnabled(False)
        w=BluetoothWorker(self.panel, scan); self.worker=w
        w.ready.connect(self.fill); w.finished.connect(lambda: (setattr(self, 'worker', None), self.search.setEnabled(True) if not sip_deleted(self.search) else None)); w.finished.connect(w.deleteLater); w.start()

    def closeEvent(self, e):
        if self.worker is not None:
            try: self.worker.ready.disconnect(self.fill)
            except (TypeError, RuntimeError): pass
        super().closeEvent(e)

    def fill(self, res):
        if not res.get('tool'):
            self.placeholder(_('bluetoothctl is not installed.')); return
        self.switch.setChecked(res['powered']); self.sub.setVisible(True)
        if not res['powered']:
            self.sub.setText(_('Off')); self.placeholder(_('Bluetooth is off.')); return
        connected=[d['name'] for d in res['devices'] if d['connected']]
        self.sub.setText(_('Connected to {n}').replace('{n}', ', '.join(connected)) if connected else _('On'))
        if not res['devices']:
            self.placeholder(_('No devices yet. Switch the device to pairing mode and press "Search for devices".')); return
        self.clear()
        for d in res['devices']:
            b=QPushButton(); b.setObjectName('netRow'); b.setProperty('active', d['connected']); b.setCursor(Qt.PointingHandCursor)
            lay=QHBoxLayout(b); lay.setContentsMargins(8,3,8,3); lay.setSpacing(8)
            ic=QLabel(); ic.setPixmap(get_icon(d['icon'], 'bluetooth').pixmap(20,20)); lay.addWidget(ic)
            name=QLabel(d['name']); name.setTextFormat(Qt.PlainText); name.setStyleSheet('font-weight:%s;' % ('800' if d['connected'] else '600')); lay.addWidget(name, 1)
            state=QLabel(_('Connected') if d['connected'] else _('Paired') if d['paired'] else _('New')); state.setObjectName('popSub'); lay.addWidget(state)
            for w in b.findChildren(QLabel): w.setAttribute(Qt.WA_TransparentForMouseEvents)
            b.setMinimumHeight(34); b.setAccessibleName(d['name']+', '+state.text())
            b.clicked.connect(lambda _=False, dev=d: self.choose(dev))
            self.list_layout.addWidget(b)
        self.list_layout.addStretch()

    def choose(self, d):
        mac=d['mac']; name=d['name']
        if d['connected']:
            self.run([['disconnect', mac]], _('{n} disconnected.').replace('{n}', name))
        elif d['paired']:
            self.run([['connect', mac]], _('Connected to {n}').replace('{n}', name))
        else:
            # Pair, trust (reconnects by itself next time) and connect.
            self.run([['pair', mac], ['trust', mac], ['connect', mac]], _('Connected to {n}').replace('{n}', name))

    def run(self, steps, success):
        if self.proc is not None: return
        self.note(_('Working…'))
        steps=list(steps)
        def next_step():
            if not steps:
                self.note('✓ '+success); QTimer.singleShot(500, self.refresh); QTimer.singleShot(800, self.panel.update_status_icons); return
            args=steps.pop(0)
            proc=QProcess(self); proc.setProcessChannelMode(QProcess.MergedChannels); self.proc=proc
            def done(code, _st, p=proc, a=args):
                out=bytes(p.readAll()).decode('utf-8', 'replace'); self.proc=None; p.deleteLater()
                bad=code != 0 or re.search(r'Failed|not available|Error', out)
                if bad and a[0] != 'trust':
                    last=[l for l in out.splitlines() if l.strip()][-1:] or [_('unknown error')]
                    self.note(_('Could not do this: {m}').replace('{m}', last[0].strip())+('\n'+_('Devices that show a code need Bluetooth Settings.') if a[0] == 'pair' else ''), error=True)
                    return
                next_step()
            proc.finished.connect(done)
            proc.start('bluetoothctl', ['--agent', 'NoInputNoOutput', '--timeout', '20']+args if args[0] == 'pair' else args)
        next_step()

    def toggle_power(self, on):
        if on and shutil.which('rfkill'):
            safe_popen(['rfkill', 'unblock', 'bluetooth'])
        QTimer.singleShot(300 if on else 0, lambda: safe_popen(['bluetoothctl', 'power', 'on' if on else 'off']))
        self.panel.last_status['bt_on']=on
        QTimer.singleShot(1500, self.refresh); QTimer.singleShot(1200, self.panel.update_status_icons)


def sip_deleted(obj):
    try:
        from PyQt5 import sip
        return sip.isdeleted(obj)
    except Exception:
        return False


class HoverCard(QFrame):
    """Small card that appears when the pointer rests on a button of
    Eduka-Panel: a picture of the window (task buttons) or the icon, the
    title and the details. Clicking a window picture opens that window."""
    clicked=pyqtSignal()
    def __init__(self, panel):
        super().__init__(None, Qt.ToolTip | Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint)
        self.panel=panel
        composited=compositor_running()
        if composited: self.setAttribute(Qt.WA_TranslucentBackground)
        u=ui_colors()
        self.setStyleSheet(f"""
            QFrame#hoverBox{{background:{u['cal']};border:1px solid {u['btn_border']};border-radius:14px;}}
            QLabel{{background:transparent;color:{u['text']};}}
            QLabel#hoverTitle{{font-size:12px;font-weight:800;color:{u['title']};}}
            QLabel#hoverSub{{font-size:11px;color:{u['sub']};}}
            QLabel#hoverShot{{background:{u['tile']};border:1px solid {u['btn_border']};border-radius:8px;}}
        """)
        outer=QVBoxLayout(self); outer.setContentsMargins(*((4,4,4,4) if composited else (0,0,0,0)))
        self.box=QFrame(); self.box.setObjectName('hoverBox'); outer.addWidget(self.box)
        v=QVBoxLayout(self.box); v.setContentsMargins(10,8,10,10); v.setSpacing(6)
        self.shot=QLabel(); self.shot.setObjectName('hoverShot'); self.shot.setAlignment(Qt.AlignCenter); v.addWidget(self.shot)
        row=QHBoxLayout(); row.setSpacing(8)
        self.icon=QLabel(); self.icon.setFixedSize(22,22); row.addWidget(self.icon)
        texts=QVBoxLayout(); texts.setSpacing(0)
        self.title=QLabel(''); self.title.setObjectName('hoverTitle'); self.title.setTextFormat(Qt.PlainText)
        self.sub=QLabel(''); self.sub.setObjectName('hoverSub'); self.sub.setTextFormat(Qt.PlainText); self.sub.setWordWrap(True)
        texts.addWidget(self.title); texts.addWidget(self.sub); row.addLayout(texts, 1); v.addLayout(row)
        if not composited: round_window_shape(self, 14)

    def show_for(self, anchor, title, sub='', icon=None, shot=None):
        fm=self.title.fontMetrics()
        self.title.setText(fm.elidedText(title, Qt.ElideRight, 230))
        self.sub.setText(sub); self.sub.setVisible(bool(sub))
        self.icon.setPixmap(icon.pixmap(22,22) if icon is not None and not icon.isNull() else QPixmap()); self.icon.setVisible(icon is not None and not icon.isNull())
        if shot is not None and not shot.isNull():
            self.shot.setPixmap(shot); self.shot.setFixedSize(shot.width()+6, shot.height()+6); self.shot.setVisible(True)
        else:
            self.shot.setVisible(False)
        self.setCursor(Qt.PointingHandCursor if not self.shot.isHidden() else Qt.ArrowCursor)
        # Shrink back after a window picture (the card is reused).
        self.box.layout().activate(); self.layout().activate(); self.resize(self.sizeHint())
        g=anchor.mapToGlobal(QPoint(anchor.width()//2, anchor.height()//2))
        self.move(self.panel.popup_position(self.width(), self.height(), g, gap=6))
        if not self.isVisible():
            self.show(); fade_in(self, 120)

    def mouseReleaseEvent(self, e):
        if e.button() == Qt.LeftButton: self.clicked.emit()
        super().mouseReleaseEvent(e)

    def leaveEvent(self, e):
        self.panel.hide_hover_soon(); super().leaveEvent(e)

    def enterEvent(self, e):
        self.panel._hover_hide.stop(); super().enterEvent(e)


class ClockButton(QPushButton):
    """Panel clock in the style of the Action Center clock: digital (time in
    bold, date below), LED digits or a small analog dial with the date.
    A new minute slides in; a new style fades in; an agenda alarm makes it
    blink in the accent color."""
    def __init__(self, parent=None):
        super().__init__(parent)
        self.colon_on=True
        self.lines=['', '']; self.old=''; self.slide=1.0; self.fade=1.0; self.alarm=False; self.ac_open=False; self._hot=False
        self.opts=clock_options(); self.vertical=False
        self.anim=QTimer(self); self.anim.setInterval(16); self.anim.timeout.connect(self.step); self._clock=QElapsedTimer()
        self.setSizePolicy(QSizePolicy.Preferred, QSizePolicy.Expanding); self.setMinimumHeight(24)

    def set_ac_open(self, on):
        """While the Action Center is open it shows the time and date itself:
        the panel button then just says "Action Center"."""
        on=bool(on)
        if on != self.ac_open:
            self.ac_open=on; self.fade=0.0; self.start(); self.updateGeometry(); self.update()

    def enterEvent(self, e): self._hot=True; self.update(); super().enterEvent(e)
    def leaveEvent(self, e): self._hot=False; self.update(); super().leaveEvent(e)

    def set_options(self, opts):
        key=(opts['style'], opts['color'], opts['format'])
        if key != (self.opts['style'], self.opts['color'], self.opts['format']):
            self.opts=dict(opts); self.fade=0.0; self.start(); self.updateGeometry()
        self.opts=dict(opts)

    def set_lines(self, lines):
        lines=list(lines)
        if lines != self.lines:
            minute=lambda t: re.sub(r'\D', '', t)[:4]
            # Only a new minute slides in (not every second).
            if self.lines[0] and minute(lines[0]) != minute(self.lines[0]) and not self.vertical:
                self.old=self.lines[0]; self.slide=0.0; self.start()
            self.lines=lines; self.updateGeometry(); self.update()

    def start(self):
        self._clock.restart()
        if not self.anim.isActive(): self.anim.start()

    def step(self):
        dt=self._clock.restart()/1000.0
        self.slide=min(1.0, self.slide+dt/0.35); self.fade=min(1.0, self.fade+dt/0.45)
        if self.slide >= 1.0 and self.fade >= 1.0: self.anim.stop()
        self.update()

    def fonts(self):
        """Time and date always fit inside the box: the font sizes follow the
        real height of the button and the metrics of the system font (fonts
        with tall ascent/descent were cut at the top and bottom)."""
        h=self.height() if self.height() > 10 else 34
        key=(h, self.font().family(), self.font().pointSizeF(), len(self.lines))
        if getattr(self, '_font_key', None) == key:
            return self._fonts
        room=h-4                       # inside the frame
        bs=max(9, min(16, int(h*0.40))); ss=max(8, min(13, int(h*0.29)))
        while True:
            big=QFont(self.font()); big.setBold(True); big.setPixelSize(bs)
            small=QFont(self.font()); small.setBold(False); small.setPixelSize(ss)
            need=QFontMetrics(big).height()+QFontMetrics(small).height()*max(1, len(self.lines)-1)
            if need <= room or (bs <= 9 and ss <= 7): break
            if bs-ss > 2 or ss <= 7: bs-=1
            else: ss-=1
        self._font_key=key; self._fonts=(big, small)
        return big, small

    def led_width(self, h):
        t=self.lines[0].split(' ')[0]
        return sum(h*0.22 if ch == ':' else h*0.52 for ch in t)+h*0.16*max(0, len(t)-1)

    def sizeHint(self):
        big, small=self.fonts(); style=self.opts.get('style')
        if self.ac_open and not self.vertical:
            return QSize(max(QFontMetrics(big).horizontalAdvance(_('Action Center')), QFontMetrics(small).horizontalAdvance(_('click to close')))+26, 34)
        date_w=max([0]+[QFontMetrics(small).horizontalAdvance(t) for t in self.lines[1:]])
        if self.vertical or style == 'digital' or style not in ('led', 'analog'):
            w=max([QFontMetrics(big).horizontalAdvance(self.lines[0]), date_w])
            return QSize(w+20, 34)
        if style == 'analog':
            return QSize(26+8+max(QFontMetrics(big).horizontalAdvance(self.lines[0]), date_w)+18, 34)
        return QSize(int(max(self.led_width(17)+(16 if 'M' in self.lines[0] else 0), date_w))+22, 34)

    def ink(self):
        if self.alarm: return QColor('#ffffff')
        c=self.opts.get('color'); return QColor(c) if c else self.palette().color(QPalette.ButtonText)

    def paintEvent(self, e):
        super().paintEvent(e)
        p=QPainter(self); p.setRenderHint(QPainter.Antialiasing); p.setRenderHint(QPainter.TextAntialiasing)
        # A framed box shows that the clock is a button (opens the Action Center).
        box=QRectF(self.rect()).adjusted(1.5, 1.0, -1.5, -1.0); ink=self.palette().color(QPalette.ButtonText); acc=QColor(theme_accent())
        frame=QColor(acc if (self._hot or self.ac_open) else ink); frame.setAlpha(200 if (self._hot or self.ac_open) else 70)
        fill=QColor(acc); fill.setAlpha(46 if self.ac_open else (26 if self._hot else 10))
        p.setPen(QPen(frame, 1.2)); p.setBrush(fill); p.drawRoundedRect(box, 11, 11)
        if self.alarm:
            p.setPen(Qt.NoPen); p.setBrush(acc); p.drawRoundedRect(box, 11, 11)
        p.setOpacity(0.25+0.75*self.fade)
        if self.ac_open and not self.vertical:
            big, small=self.fonts(); fm_b=QFontMetrics(big); fm_s=QFontMetrics(small); y=(self.height()-fm_b.height()-fm_s.height())/2
            p.setFont(big); p.setPen(acc.darker(115) if not is_dark_theme() else acc.lighter(130)); p.drawText(QRectF(0, y, self.width(), fm_b.height()), Qt.AlignCenter, _('Action Center'))
            soft=QColor(ink); soft.setAlpha(160); p.setFont(small); p.setPen(soft); p.drawText(QRectF(0, y+fm_b.height(), self.width(), fm_s.height()), Qt.AlignCenter, _('click to close'))
            return
        style=self.opts.get('style')
        if self.vertical or style not in ('led', 'analog'):
            self.paint_text(p, QRectF(self.rect()), Qt.AlignCenter)
        elif style == 'analog':
            self.paint_dial(p, QRectF(8, (self.height()-26)/2, 26, 26))
            self.paint_text(p, QRectF(42, 0, self.width()-48, self.height()), Qt.AlignLeft | Qt.AlignVCenter)
        else:
            self.paint_led(p)

    def resizeEvent(self, e):
        self._font_key=None; super().resizeEvent(e)

    def paint_text(self, p, rect, align):
        big, small=self.fonts(); ink=self.ink()
        fm_b=QFontMetrics(big); fm_s=QFontMetrics(small)
        total=fm_b.height()+sum(fm_s.height() for _ in self.lines[1:])
        y=rect.y()+(rect.height()-total)/2; h=fm_b.height()
        p.save(); p.setClipRect(QRectF(rect.x(), y, rect.width(), h)); p.setFont(big)
        # The new minute slides up into place, the old one leaves upwards.
        off=(1.0-self.slide)*h
        if self.slide < 1.0 and self.old:
            c=QColor(ink); c.setAlphaF(1.0-self.slide); p.setPen(c)
            p.drawText(QRectF(rect.x(), y+off-h, rect.width(), h), align, self.old)
        self.draw_time(p, QRectF(rect.x(), y+off, rect.width(), h), align, self.lines[0], ink, fm_b); p.restore()
        y+=h; soft=QColor(ink); soft.setAlpha(170); p.setFont(small); p.setPen(soft)
        for t in self.lines[1:]:
            p.drawText(QRectF(rect.x(), y, rect.width(), fm_s.height()), align, t); y+=fm_s.height()

    def draw_time(self, p, r, align, text, ink, fm):
        """The time; with the blinking option the colons fade out and in
        without moving the digits."""
        if self.colon_on or ':' not in text:
            p.setPen(ink); p.drawText(r, align, text); return
        w=fm.horizontalAdvance(text)
        x=r.x() if align & Qt.AlignLeft else (r.right()-w if align & Qt.AlignRight else r.x()+(r.width()-w)/2)
        faint=QColor(ink); faint.setAlpha(40)
        for ch in text:
            p.setPen(faint if ch == ':' else ink)
            cw=fm.horizontalAdvance(ch); p.drawText(QRectF(x, r.y(), cw+2, r.height()), Qt.AlignLeft | Qt.AlignVCenter, ch); x+=cw

    def paint_dial(self, p, r):
        now=QTime.currentTime(); ink=self.ink(); acc=QColor(self.opts.get('color') or theme_accent()) if not self.alarm else QColor('#ffffff')
        c=r.center(); rad=r.width()/2
        p.setPen(QPen(acc, 2)); p.setBrush(Qt.NoBrush); p.drawEllipse(c, rad-1, rad-1)
        for i in range(12):
            a=math.radians(i*30); p.setPen(QPen(ink, 1.4 if i % 3 == 0 else 0.8))
            p.drawLine(QPointF(c.x()+math.sin(a)*(rad-4), c.y()-math.cos(a)*(rad-4)), QPointF(c.x()+math.sin(a)*(rad-6), c.y()-math.cos(a)*(rad-6)))
        def hand(angle, length, width, color):
            a=math.radians(angle); p.setPen(QPen(color, width, Qt.SolidLine, Qt.RoundCap))
            p.drawLine(c, QPointF(c.x()+math.sin(a)*length, c.y()-math.cos(a)*length))
        hand(30.0*((now.hour()%12)+now.minute()/60.0), rad*0.5, 2.2, ink)
        hand(6.0*now.minute(), rad*0.75, 1.6, ink)
        p.setPen(Qt.NoPen); p.setBrush(acc); p.drawEllipse(c, 1.8, 1.8)

    def paint_led(self, p):
        h=17; color=self.ink(); off=QColor(color); off.setAlpha(28)
        t=self.lines[0]; ap=''
        if ' ' in t: t, ap=t.split(' ', 1)
        tw=self.led_width(h)+(16 if ap else 0); x=(self.width()-tw)/2; y=(self.height()-h)/2
        big, small=self.fonts()
        if self.lines[1:]:
            y=(self.height()-h-QFontMetrics(small).height()-1)/2
        for ch in t:
            if ch == ':':
                p.setPen(Qt.NoPen); p.setBrush(color); d=h*0.1
                p.drawEllipse(QPointF(x+h*0.11, y+h*0.32), d, d); p.drawEllipse(QPointF(x+h*0.11, y+h*0.70), d, d); x+=h*0.22+h*0.16
            else:
                ClockFace.seven(ClockFace, p, ch, x, y, h*0.52, h, color, off); x+=h*0.52+h*0.16
        if ap:
            f=QFont(big); f.setPixelSize(9); p.setFont(f); p.setPen(color); p.drawText(QPointF(x+1, y+h), ap)
        if self.lines[1:]:
            soft=QColor(self.ink()); soft.setAlpha(170); p.setFont(small); p.setPen(soft)
            p.drawText(QRectF(0, y+h+1, self.width(), QFontMetrics(small).height()), Qt.AlignHCenter, self.lines[1])


class EdukaPanel(QWidget):
    def __init__(self):
        super().__init__(); ensure_dirs(); icon_theme_setup(); self.setWindowTitle('Eduka-Panel')
        self.setWindowFlags(Qt.FramelessWindowHint | Qt.Window | Qt.WindowStaysOnTopHint); self.setAttribute(Qt.WA_ShowWithoutActivating)
        # Transparent only with a compositor; otherwise X11 paints the
        # transparent parts black. watch_compositor() restarts the panel when
        # a compositor starts or stops.
        self._composited=compositor_running(force=True)
        if self._composited: self.setAttribute(Qt.WA_TranslucentBackground)
        try: self.setAttribute(Qt.WA_X11DoNotAcceptFocus, True)
        except (AttributeError, TypeError): pass
        self.tasks={}; self.buttons={}; self.pinned_buttons={}; self.quick_launchers={}; self.icon_geometry_cache={}; self.current_cfg={}; self._last_active_wid=''; self._fullscreen_hidden=False; self._fullscreen_wid=''; self._hidden_reason=''; self.hearing_accessibility=False; self.eus_status={}; self._ewmh_cache={}
        self._tray_compact=False; self._showing_desktop=False; self._spy=None
        self.edge='Bottom'; self.vertical=False; self.thickness=42
        self.last_status={}; self._status_worker=None; self._status_again=False; self.action_center=None; self._action_center_closed_at=0.0
        self._app_match_cache={}; self._app_match_stamp=None; self._task_order=[]; self._button_seq=0
        self.notifications=NotificationCenter(self); self.notifications.changed.connect(self.update_notification_badge)
        self.build_ui(); translate_tree(self); self.load_config(); self.setup_watcher(); self.setup_screen_tracking()
        QApplication.instance().aboutToQuit.connect(self.notifications.stop)
        # Eduka-Panel shows every notification itself (LXQt's daemon is stopped).
        self.notify_server=NotificationServer(self, self.notifications)
        self.clock_timer=QTimer(self); self.clock_timer.timeout.connect(self.update_clock); self.clock_timer.start(1000); self.update_clock()
        self.task_timer=QTimer(self); self.task_timer.timeout.connect(self.update_tasks); self.task_timer.start(900); self.update_tasks()
        self.status_timer=QTimer(self); self.status_timer.timeout.connect(self.update_status_icons); self.status_timer.start(2500); self.update_status_icons()
        # Weather for the clock card: cached, refreshed every 30 minutes when online.
        self.weather=cached_weather(); self._weather_worker=None
        self.weather_timer=QTimer(self); self.weather_timer.timeout.connect(self.update_weather); self.weather_timer.start(30*60*1000)
        QTimer.singleShot(8000, self.update_weather)
        # Parental Control: warnings and the message screen when time is up.
        self._parental_lock=None; self._parental_warned=set(); self.parental={}
        self.parental_timer=QTimer(self); self.parental_timer.timeout.connect(self.check_parental); self.parental_timer.start(5000)
        QTimer.singleShot(3000, self.check_parental)
        # Removable drives (checked every 3 seconds; lsblk takes a few ms).
        self.drives=[]; self._drive_keys=None
        self.drive_timer=QTimer(self); self.drive_timer.timeout.connect(self.update_drives); self.drive_timer.start(3000)
        QTimer.singleShot(1500, self.update_drives)
        # Keyboard, mouse and touchpad (Eduka-Settings → Devices): applied at
        # login and again whenever a device is plugged in.
        self.touchpad_devices=[]; self._input_sig=None; self._input_workers=[]; self._tp_proc=None; self._tp_id=None; self._tp_state={}
        self.input_timer=QTimer(self); self.input_timer.timeout.connect(self.check_input_devices); self.input_timer.start(5000)
        QTimer.singleShot(1200, lambda: self.check_input_devices(first=True))
        # White text on a white menu in Qt programs (pcmanfm-qt desktop menu)?
        QTimer.singleShot(900, lambda: repair_qt_palette())
        # Wallpaper slideshow (Eduka-Settings → Wallpaper).
        self._slide_last=''; self._wall_fade=None
        self.slide_timer=QTimer(self); self.slide_timer.timeout.connect(self.next_wallpaper)
        QTimer.singleShot(2000, self.setup_slideshow)
        # Agenda alarms of the calendar.
        self._alarm_blink=QTimer(self); self._alarm_blink.timeout.connect(self.blink_alarm); self._alarm_phase=False
        self.agenda_timer=QTimer(self); self.agenda_timer.timeout.connect(self.check_agenda); self.agenda_timer.start(15000)
        QTimer.singleShot(4000, self.check_agenda)
        self.workarea_timer=QTimer(self); self.workarea_timer.timeout.connect(self.enforce_window_space); self.workarea_timer.start(1400)
        self.start_window_spy()
        # Software brightness (no backlight) is lost at logout: re-apply it.
        QTimer.singleShot(1500, restore_software_brightness)
        # Openbox has no compositor: start picom so transparency works.
        QTimer.singleShot(0, ensure_compositor)
        self._compositor_watch=watch_compositor(self, before_restart=self.stop_window_spy, initial=self._composited)
        # Eduka-Panel replaces lxqt-panel, but only in Eduka-Desktop sessions.
        QTimer.singleShot(2500, stop_lxqt_panel_in_eduka_session)
        QTimer.singleShot(9000, stop_lxqt_panel_in_eduka_session)
        QTimer.singleShot(2500, stop_lxqt_notifications_in_eduka_session)
        QTimer.singleShot(500, lambda: safe_popen(['eduka-app-cache','--warm']))
        QTimer.singleShot(900, lambda: safe_popen(['eduka-menu','--daemon']))
    def build_ui(self):
        outer=QVBoxLayout(self); outer.setContentsMargins(0,0,0,0); self.bg=QFrame(); self.bg.setObjectName('panelBg'); outer.addWidget(self.bg)
        # Panel shadow is optional. Default OFF for 512MB/old CPU target.
        self.bg.setGraphicsEffect(None)
        self.layout=QBoxLayout(QBoxLayout.LeftToRight, self.bg); self.layout.setContentsMargins(10,3,10,3); self.layout.setSpacing(7)
        self.bg.setContextMenuPolicy(Qt.CustomContextMenu); self.bg.customContextMenuRequested.connect(self.panel_context)
        self.start=QPushButton(); self.start.setObjectName('startButton'); self.start.setAccessibleName('Edukasaun application menu'); self.start.clicked.connect(self.toggle_menu); self.start.setContextMenuPolicy(Qt.CustomContextMenu); self.start.customContextMenuRequested.connect(self.start_context); self.layout.addWidget(self.start)
        for kind, name, icon, cmd in [('files','File Manager','system-file-manager','pcmanfm-qt'),('terminal','Terminal','utilities-terminal','qterminal')]:
            b=QPushButton(); b.setToolTip(name); b.setAccessibleName(name); b.setObjectName('launcherButton'); b.setIcon(get_icon(icon)); b.clicked.connect(lambda _,c=cmd: launch_app(c))
            b.setContextMenuPolicy(Qt.CustomContextMenu)
            b.customContextMenuRequested.connect(lambda pos,k=kind,w=b: self.launcher_context(k,w,pos))
            self.quick_launchers[kind]=b; self.layout.addWidget(b)
        self.task_area=QWidget(); self.task_area.setObjectName('taskArea'); self.task_area.setStyleSheet('QWidget#taskArea{background:transparent;}'); self.task_area.setMinimumWidth(80); self.task_area.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed); self.task_area.setContextMenuPolicy(Qt.CustomContextMenu); self.task_area.customContextMenuRequested.connect(self.panel_context); self.task_layout=QBoxLayout(QBoxLayout.LeftToRight, self.task_area); self.task_layout.setContentsMargins(0,0,0,0); self.task_layout.setSpacing(6); self.task_layout.setAlignment(Qt.AlignLeft | Qt.AlignVCenter); self.layout.addWidget(self.task_area,1)
        self.net=QPushButton(); self.net.setObjectName('trayButton'); self.net.clicked.connect(self.network_popup); self.net.setContextMenuPolicy(Qt.CustomContextMenu); self.net.customContextMenuRequested.connect(self.network_context)
        self.bt=QPushButton(); self.bt.setObjectName('trayButton'); self.bt.clicked.connect(self.bluetooth_popup); self.bt.setContextMenuPolicy(Qt.CustomContextMenu); self.bt.customContextMenuRequested.connect(self.bluetooth_context)
        self.printer=QPushButton(); self.printer.setObjectName('trayButton'); self.printer.clicked.connect(lambda: launch_app('system-config-printer')); self.printer.setContextMenuPolicy(Qt.CustomContextMenu); self.printer.customContextMenuRequested.connect(self.printer_context)
        self.battery=QPushButton(); self.battery.setObjectName('batteryButton'); self.battery.clicked.connect(self.battery_popup); self.battery.setContextMenuPolicy(Qt.CustomContextMenu); self.battery.customContextMenuRequested.connect(self.battery_context)
        self.vol=QPushButton(); self.vol.setObjectName('trayButton'); self.vol.clicked.connect(self.volume_popup); self.vol.setContextMenuPolicy(Qt.CustomContextMenu); self.vol.customContextMenuRequested.connect(self.volume_context)
        self.eus=QPushButton(); self.eus.setObjectName('updateButton'); self.eus.setVisible(False); self.eus.clicked.connect(self.open_eus); self.eus.setContextMenuPolicy(Qt.CustomContextMenu); self.eus.customContextMenuRequested.connect(self.eus_context)
        self.notif=QPushButton(); self.notif.setObjectName('trayButton'); self.notif.setIcon(get_icon('preferences-system-notifications')); self.notif.clicked.connect(self.notification_popup); self.notif.setContextMenuPolicy(Qt.CustomContextMenu); self.notif.customContextMenuRequested.connect(self.notification_context)
        self.lang=QLabel('EN'); self.lang.setObjectName('langLabel'); self.lang.setContextMenuPolicy(Qt.CustomContextMenu); self.lang.customContextMenuRequested.connect(self.language_context)
        # Removable drives and the touchpad stay on Eduka-Panel while the
        # Action Center is open (they are not in tray_status_widgets()).
        self.drives_button=QPushButton(); self.drives_button.setObjectName('trayButton'); self.drives_button.setVisible(False)
        self.drives_button.setIcon(get_icon('drive-removable-media', 'drive-harddisk')); self.drives_button.clicked.connect(self.drives_popup)
        self.drives_button.setAccessibleName('Removable drives')
        self.touchpad_button=QPushButton(); self.touchpad_button.setObjectName('trayButton'); self.touchpad_button.setVisible(False)
        self.touchpad_button.setAccessibleName('Touchpad'); self.touchpad_button.setToolTip('Touchpad\nClick for tap to click, scrolling and on/off')
        tl=QHBoxLayout(self.touchpad_button); tl.setContentsMargins(3,3,3,3)
        import eduka_input
        self.touchpad_view=eduka_input.TouchpadView(self.touchpad_button, accent=theme_accent()); self.touchpad_view.setFixedSize(24, 20); tl.addWidget(self.touchpad_view, 0, Qt.AlignCenter)
        self.touchpad_button.setMinimumWidth(30); self.touchpad_button.clicked.connect(self.touchpad_popup)
        self.clock=ClockButton(); self.clock.setObjectName('clockButton'); self.clock.clicked.connect(self.toggle_action_center); self.clock.setContextMenuPolicy(Qt.CustomContextMenu); self.clock.customContextMenuRequested.connect(self.clock_context)
        for button,name in [(self.net,'Network'),(self.bt,'Bluetooth'),(self.printer,'Printers'),(self.battery,'Battery'),(self.vol,'Volume'),(self.eus,'Eduka Update System'),(self.notif,'Notifications'),(self.clock,'Clock and calendar')]: button.setAccessibleName(name)
        # Status icons and the clock sit together in one rounded tray group.
        self.tray=QFrame(); self.tray.setObjectName('trayGroup'); self.tray.setContextMenuPolicy(Qt.CustomContextMenu); self.tray.customContextMenuRequested.connect(self.panel_context)
        tray_layout=QBoxLayout(QBoxLayout.LeftToRight, self.tray); tray_layout.setContentsMargins(6,0,4,0); tray_layout.setSpacing(2); self.tray_layout=tray_layout
        for w in [self.drives_button,self.touchpad_button,self.net,self.bt,self.printer,self.battery,self.vol,self.eus,self.notif,self.lang,self.clock]: tray_layout.addWidget(w)
        self.clock.setToolTip('Click to open the Action Center\nCalendar, Wi-Fi, Bluetooth, sound and brightness')
        self.clock.setAccessibleName('Clock. Opens Action Center')
        self.layout.addWidget(self.tray)
        # Thin corner button like other taskbars: show / restore the desktop.
        self.desktop_button=QPushButton(); self.desktop_button.setObjectName('desktopButton'); self.desktop_button.setFixedWidth(10)
        self.desktop_button.setToolTip('Show desktop'); self.desktop_button.setAccessibleName('Show desktop'); self.desktop_button.clicked.connect(self.toggle_show_desktop)
        self.layout.addWidget(self.desktop_button)
        # Hover cards instead of plain tooltips (window pictures on tasks).
        self.hover=None; self._hover_target=None; self.thumbs={}; self._thumb_at=0.0
        self._hover_show=QTimer(self); self._hover_show.setSingleShot(True); self._hover_show.timeout.connect(self.show_hover)
        self._hover_hide=QTimer(self); self._hover_hide.setSingleShot(True); self._hover_hide.timeout.connect(self.hide_hover)
        for w in [self.start, *self.quick_launchers.values(), self.drives_button, self.touchpad_button, self.net, self.bt, self.printer, self.battery, self.vol, self.eus, self.notif, self.clock, self.desktop_button]:
            w.installEventFilter(self)
    def setup_screen_tracking(self):
        """Re-layout when the resolution changes or a projector is connected."""
        self._screen_timer=QTimer(self); self._screen_timer.setSingleShot(True); self._screen_timer.timeout.connect(self.screen_changed)
        def watch(screen):
            if screen is None:
                return
            screen.geometryChanged.connect(lambda _g: self._screen_timer.start(300))
        watch(QApplication.primaryScreen())
        QApplication.instance().primaryScreenChanged.connect(lambda scr: (watch(scr), self._screen_timer.start(300)))

    def screen_changed(self):
        self.load_config()
        # picom 12.0 stopped drawing correctly after a monitor change (#1338).
        restart_picom_after_screen_change()

    def setup_watcher(self):
        self.watcher=QFileSystemWatcher(self)
        watch_paths=[str(panel_config_path()), str(RUNTIME_DIR/'reload')]
        watch_paths += [str(p) for p in lxqt_appearance_files()]
        for pth in watch_paths:
            try:
                Path(pth).parent.mkdir(parents=True, exist_ok=True)
                if not Path(pth).exists() and ('eduka-desktop' in pth or '.config' in pth):
                    Path(pth).touch(exist_ok=True)
                if Path(pth).exists() and pth not in self.watcher.files():
                    self.watcher.addPath(pth)
            except Exception:
                pass
        self.watcher.fileChanged.connect(lambda p: QTimer.singleShot(120,self.reload_from_watcher))

    def reload_from_watcher(self):
        # Settings are written with os.replace(): the watched inode is gone,
        # so watch the new file again or later changes would be missed.
        for pth in [str(panel_config_path()), str(RUNTIME_DIR/'reload')]+[str(p) for p in lxqt_appearance_files()]:
            if Path(pth).exists() and pth not in self.watcher.files():
                self.watcher.addPath(pth)
        ensure_compositor()
        icon_theme_setup(force=True)
        QTimer.singleShot(200, self.setup_slideshow); QTimer.singleShot(300, lambda: (setattr(self, '_drive_keys', None), self.update_drives()))
        QTimer.singleShot(400, lambda: self.input_devices_ready(self.touchpad_devices, refresh=True))
        for kind, icon in (('files','system-file-manager'),('terminal','utilities-terminal')):
            if kind in self.quick_launchers: self.quick_launchers[kind].setIcon(get_icon(icon))
        self.update_notification_badge(); self.update_clock()
        if self.action_center is not None and self.action_center.isVisible():
            self.action_center.lang=ui_language(); self.action_center.apply_clock_style()
        app=QApplication.instance()
        if app is not None and app.styleSheet() != tooltip_qss():
            app.setStyleSheet(tooltip_qss())
        self.load_config()
        self.update_tasks()
        self.update_status_icons()
    def load_config(self):
        icon_theme_setup(force=True); cfg=read_panel_config(); self.current_cfg=cfg
        desktop_cfg=read_desktop_config(); high_contrast=bool(desktop_cfg.get('visual_accessibility', False)); self.hearing_accessibility=bool(desktop_cfg.get('hearing_accessibility', False)); theme=effective_theme(cfg.get('theme_style')); liquid=theme == THEME_LIQUID and self._composited; dark=theme in DARK_THEMES; low=theme == THEME_LOW; trans=theme == THEME_TRANSPARENT and self._composited
        if low: alpha_override=1.0
        else: alpha_override=None
        h=max(34, min(58, int(cfg.get('height',40)))); icon_size=max(18, min(42, int(cfg.get('icon_size',24))))
        width=max(45, min(100, int(cfg.get('width_percent',96)))); alpha=max(0.50, min(1.0, float(cfg.get('transparency',0.54))))
        if high_contrast or not self._composited or alpha_override: alpha=1.0
        self.apply_orientation(cfg, h)
        screen=QApplication.primaryScreen().geometry(); edge=self.edge
        shape=panel_style(cfg); self.shape=shape
        gap=0 if shape == 'full' else 5
        if self.vertical:
            th=max(48, h)
            if shape == 'full': length=screen.height()
            elif shape == 'short': length=int(screen.height()*min(width, 64)/100)
            elif shape == 'dock': length=self.dock_length(screen.height())
            else: length=int(screen.height()*width/100)
            w, hh = th, min(length, screen.height()-(0 if shape == 'full' else 10))
            x=screen.x()+gap if edge == 'Left' else screen.x()+screen.width()-th-gap
            y=screen.y()+int((screen.height()-hh)/2)
            self.setGeometry(x,y,w,hh); self.setFixedSize(w,hh); self.thickness=th
        else:
            if shape == 'full': w=screen.width()
            elif shape == 'short': w=int(screen.width()*min(width, 64)/100)
            elif shape == 'dock': w=self.dock_length(screen.width())
            else: w=int(screen.width()*width/100)
            x=screen.x()+int((screen.width()-w)/2)
            y=screen.y()+gap if edge == 'Top' else screen.y()+screen.height()-h-gap
            self.setGeometry(x,y,w,h); self.setFixedSize(w,h); self.thickness=h
        radius=0 if shape == 'full' else int(min(self.width(), self.height())/2.3); bg_alpha=int(alpha*255)
        if self._composited:
            self.clearMask()
        else:
            # No compositor: the panel is opaque, its rounded ends are cut with a mask.
            path=QPainterPath(); path.addRoundedRect(QRectF(0, 0, self.width(), self.height()), radius, radius)
            self.setMask(QRegion(path.toFillPolygon().toPolygon()))
        sb=max(13,int(h/2.7)); fs=11 if h < 46 else 12
        # 0.9.16 look: bright surface, accent start button, flat task buttons
        # with an accent indicator. Plain stylesheets only (no effects), so it
        # stays smooth on 2 GB / 2017 computers.
        self.bg.setStyleSheet(f'''QFrame#panelBg{{background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 rgba(255,255,255,{min(255,bg_alpha+16)}),stop:1 rgba(240,247,244,{bg_alpha}));border:1px solid rgba(255,255,255,235);border-bottom:1px solid rgba(120,160,148,110);border-radius:{radius}px;}}
        QPushButton#startButton{{background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #14bd8e,stop:1 #00966c);border:1px solid #00916a;border-radius:{sb}px;padding:4px 14px;font-weight:800;color:#ffffff;}} QPushButton#startButton:hover{{background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #22cc9c,stop:1 #00a879);}} QPushButton#startButton:pressed{{background:#00845f;}}
        QPushButton#launcherButton,QPushButton#trayButton,QPushButton#updateButton{{background:transparent;border:0;border-radius:10px;padding:4px;color:#183c35;}} QPushButton#launcherButton:hover,QPushButton#trayButton:hover,QPushButton#updateButton:hover{{background:rgba(0,168,121,26);}} QPushButton#launcherButton:pressed,QPushButton#trayButton:pressed{{background:rgba(0,168,121,48);}} QPushButton#clockButton:hover{{background:rgba(0,168,121,26);}} QPushButton#clockButton:pressed{{background:rgba(0,168,121,48);}}
        QPushButton#taskButton{{background:transparent;border:1px solid transparent;border-bottom:3px solid transparent;border-radius:11px;padding:5px 10px;color:#183c35;font-weight:600;text-align:left;}} QPushButton#taskButton:hover{{background:rgba(0,168,121,22);border:1px solid rgba(0,168,121,40);border-bottom:3px solid rgba(0,168,121,90);}} QPushButton#taskButton:pressed{{background:rgba(0,168,121,40);}} QPushButton#taskButton[activeTask="true"]{{background:rgba(0,168,121,34);border:1px solid rgba(0,168,121,70);border-bottom:3px solid #00a879;color:#0f2c26;}}
        QPushButton#desktopButton{{background:transparent;border:0;border-left:1px solid rgba(90,130,120,80);border-radius:0;margin:6px 0;}} QPushButton#desktopButton:hover{{background:rgba(0,168,121,60);}}
        QFrame#trayGroup{{background:rgba(255,255,255,{min(210, bg_alpha+40)});border:1px solid rgba(0,120,90,28);border-radius:{max(12,int(h/2.6))}px;}}
