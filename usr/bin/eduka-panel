            QPushButton#taskButton:hover,QPushButton#launcherButton:hover,QPushButton#trayButton:hover,QPushButton#updateButton:hover,QPushButton#clockButton:hover{{background:rgba(255,255,255,150);border:1px solid rgba(255,255,255,200);}}
