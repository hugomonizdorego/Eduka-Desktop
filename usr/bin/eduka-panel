    def bluetooth_context(self, pos):
        """The usual Bluetooth commands (Blueman when it is installed)."""
        m=RoundedMenu(self)
        on=bool((self.last_status or {}).get('bt_on'))
        m.addAction(get_icon('bluetooth'), 'Bluetooth Devices', self.bluetooth_popup)
        m.addAction(get_icon('system-shutdown' if on else 'bluetooth'), 'Turn Bluetooth Off' if on else 'Turn Bluetooth On', lambda: self.set_bluetooth(not on))
        m.addSeparator()
        for cmd, icon, label in (('blueman-manager', 'preferences-system-bluetooth', 'Bluetooth Manager'), ('blueman-sendto', 'document-send', 'Send Files to Device…'),
                                 ('blueman-adapters', 'preferences-system', 'Adapter Settings'), ('blueman-services', 'preferences-system-network', 'Local Services')):
            if shutil.which(cmd):
                m.addAction(get_icon(icon, 'bluetooth'), label, lambda c=cmd: launch_app(c))
        self._show_context(m, self.bt, pos)

    def set_bluetooth(self, on):
        if on and shutil.which('rfkill'): safe_popen(['rfkill', 'unblock', 'bluetooth'])
        QTimer.singleShot(300 if on else 0, lambda: safe_popen(['bluetoothctl', 'power', 'on' if on else 'off']))
        QTimer.singleShot(1200, self.update_status_icons)

