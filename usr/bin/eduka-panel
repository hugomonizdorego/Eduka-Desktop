        self.update_button.setCursor(Qt.PointingHandCursor); self.update_button.clicked.connect(lambda: (self.close(), panel.open_eus()))
        self.bv.addWidget(self.update_button)

        # Sound and brightness at the bottom, always in reach (not scrolled).
        card=QFrame(); card.setObjectName('acCard'); self.sound_card=card; cl=QGridLayout(card); cl.setContentsMargins(10,8,10,10); cl.setHorizontalSpacing(8); cl.setVerticalSpacing(6)
