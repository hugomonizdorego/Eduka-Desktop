            f'QLabel#popSub{{font-size:12px;color:{u["sub"]};}}'
            f'QLabel#popHint{{font-size:11px;color:{u["sub"]};}}'
            f'QPushButton{{border:1px solid {u["btn_border"]};border-radius:11px;padding:7px 10px;background:{u["btn_bg"]};color:{u["text"]};font-weight:700;}}'
            f'QPushButton:hover{{background:{u["btn_hover"]};border:1px solid {u["accent"]};}}'
            f'QPushButton#menuLink{{background:transparent;border:0;border-radius:9px;padding:7px 8px;text-align:left;font-weight:600;color:{u["text"]};}}'
            f'QPushButton#menuLink:hover{{background:{u["row_hover"]};border:0;}}'
            f'QPushButton#menuLink:disabled{{color:{u["sub"]};}}'
            f'QFrame#popLine{{background:{u["btn_border"]};border:0;}}'
