    def battery_context(self, pos):
        m=RoundedMenu(self)
        show=m.addMenu('Show')
        mode=self.current_cfg.get('battery_display', 'percent')
        for key, label in (('percent', 'Percentage (57%)'), ('time', 'Time left (2:15)'), ('both', 'Percentage and time')):
            act=show.addAction(label); act.setCheckable(True); act.setChecked(mode == key)
            act.triggered.connect(lambda _=False, k=key: (save_panel_config({'battery_display': k}), self.current_cfg.update(battery_display=k), self.apply_status(self.last_status or {})))
        m.addSeparator()
        m.addAction(get_icon('battery'), 'Battery Information', self.battery_popup)
        m.addAction(get_icon('preferences-system-power-management'), 'Power Settings', lambda: launch_app('lxqt-config-powermanagement'))
        self._show_context(m, self.battery, pos)

