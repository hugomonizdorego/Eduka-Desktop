def ui_colors():
    theme=current_theme()
    if theme == THEME_LOW: return LOW_UI
    if theme == THEME_TRANSPARENT: return TRANS_UI
    return DARK_UI if theme in DARK_THEMES else LIGHT_UI


def popup_qss():
    """Popup look that follows the transparency and theme chosen in
    Eduka-Settings (a little more opaque than the panel so text stays
    readable), high contrast for vision accessibility."""
    cfg=read_panel_config(); dcfg=read_desktop_config(); ui=ui_colors()
    t=max(0.50, min(1.0, float(cfg.get('transparency', 0.54))))
    a=int(255*max(0.80, min(0.97, t+0.36))); c=min(255, a+14)
    theme=effective_theme(dcfg.get('theme_style'))
    if dcfg.get('visual_accessibility', False):
        box='background:#ffffff;border:2px solid #344d47;'
        card='background:#ffffff;border:2px solid #344d47;'
    elif theme == THEME_LOW:
        box='background:#f7f7f7;border:1px solid #d0d0d0;'
        card='background:#ffffff;border:1px solid #dcdcdc;'
    elif theme == THEME_TRANSPARENT:
        box=f'background:rgba(26,26,26,{max(200, a)});border:1px solid rgba(255,255,255,18);'
        card='background:rgba(217,217,217,16);border:1px solid rgba(255,255,255,14);'
    elif theme == THEME_DARK:
        box=f'background:rgba(44,44,44,{a});border:1px solid rgba(255,255,255,40);'
        card=f'background:rgba(56,56,56,{c});border:1px solid rgba(255,255,255,22);'
    elif theme == THEME_LIQUID:
        # Popups need more opacity than the panel to stay readable.
        box=liquid_glass_surface(1.55, 18, 1).replace('border-radius:18px;','')
        card=f'background:rgba(255,255,255,{c});border:1px solid rgba(0,120,90,30);'
    else:
        box=(f'background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 rgba(255,255,255,{a}),stop:1 rgba(236,248,242,{a}));'
             'border:1px solid rgba(255,255,255,220);')
        card=f'background:rgba(255,255,255,{c});border:1px solid rgba(0,120,90,30);'
    u=ui
    return ('QFrame#popupBox{'+box+'border-radius:18px;}'
            'QFrame#acCard{'+card+'border-radius:14px;}'
            f'QLabel{{color:{u["text"]};font-size:13px;background:transparent;}}'
            f'QLabel#popTitle{{font-size:15px;font-weight:800;color:{u["title"]};}}'
            f'QLabel#popSub{{font-size:12px;color:{u["sub"]};}}'
            f'QLabel#popHint{{font-size:11px;color:{u["sub"]};}}'
            f'QPushButton{{border:1px solid {u["btn_border"]};border-radius:11px;padding:7px 10px;background:{u["btn_bg"]};color:{u["text"]};font-weight:700;}}'
            f'QPushButton:hover{{background:{u["btn_hover"]};border:1px solid {u["accent"]};}}'
            f'QPushButton#switch{{min-width:52px;padding:5px 8px;border-radius:13px;background:{u["switch_off"]};color:{u["switch_off_text"]};}}'
            f'QPushButton#switch:checked{{background:{u["accent"]};color:#ffffff;border:1px solid {u["accent_border"]};}}'
            'QPushButton#netRow{text-align:left;padding:8px 10px;border-radius:12px;background:transparent;border:1px solid transparent;}'
            f'QPushButton#netRow:hover{{background:{u["row_hover"]};border:1px solid {u["accent"]};}}'
            f'QPushButton#netRow[active="true"]{{background:{u["row_active"]};border:1px solid {u["accent"]};}}'
            f'QToolButton#roundIcon{{background:{u["btn_bg"]};border:1px solid {u["btn_border"]};border-radius:16px;padding:5px;}}'
            f'QToolButton#roundIcon:hover{{background:{u["btn_hover"]};border:1px solid {u["accent"]};}}'
            f'QToolButton#roundIcon:checked{{background:{u["accent"]};border:1px solid {u["accent_border"]};}}'
            f'QComboBox{{background:{u["field"]};border:1px solid {u["btn_border"]};border-radius:10px;padding:5px 8px;color:{u["text"]};}}'
            f'QComboBox QAbstractItemView{{background:{u["cal"]};color:{u["text"]};selection-background-color:{u["accent"]};selection-color:#ffffff;border:1px solid {u["btn_border"]};outline:0;}}'
            'QScrollArea,QScrollArea>QWidget>QWidget{background:transparent;border:0;}'
            'QScrollBar:vertical{background:transparent;width:8px;margin:2px;}'
            f'QScrollBar::handle:vertical{{background:{u["scroll"]};border-radius:4px;min-height:24px;}}'
            'QScrollBar::add-line:vertical,QScrollBar::sub-line:vertical{height:0px;}'
            f'QSlider::groove:horizontal{{height:6px;border-radius:3px;background:{u["groove"]};}}'
            f'QSlider::sub-page:horizontal{{background:{u["accent"]};border-radius:3px;}}'
