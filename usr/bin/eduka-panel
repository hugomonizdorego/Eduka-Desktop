        elif liquid:
            glass=liquid_glass_surface(alpha/0.54, radius, 1)
            pill=liquid_glass_surface(1.15, max(12,int(h/2.7)), 1)
            self.bg.setStyleSheet(self.bg.styleSheet()+f'''QFrame#panelBg{{{glass}}}
