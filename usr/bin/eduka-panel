        clear=m.addAction(get_icon('edit-clear-all','edit-clear'), 'Clear All Notifications', self.notifications.clear); clear.setEnabled(bool(self.notifications.items))
        m.addAction(get_icon('preferences-system'), 'Notification Settings', lambda: launch_app('lxqt-config-notificationd'))
        self._show_context(m, self.notif, pos)

    def open_eus(self):
        launch_app('/usr/local/bin/eduka-update-system --ui', 'Eduka Update System')

    def eus_context(self, pos):
        m=RoundedMenu(self)
        m.addAction(get_icon(str(EUS_ICON_DIR/'eus-update-available.png'),'system-software-update'), 'Open Eduka Update System', self.open_eus)
        count=max(0, int(self.eus_status.get('count',0) or 0))
        status=m.addAction(f'{count} update{"s" if count != 1 else ""} available')
        status.setEnabled(False)
        self._show_context(m, self.eus, pos)

    def update_eus_status(self):
        """Consume the stable EUS v1 panel protocol without owning EUS state."""
        data={}
        try:
            if EUS_PANEL_STATUS_PATH.is_file() and EUS_PANEL_STATUS_PATH.stat().st_size <= 65536:
                candidate=json.loads(EUS_PANEL_STATUS_PATH.read_text(encoding='utf-8'))
                if isinstance(candidate, dict) and int(candidate.get('version',0)) == 1:
                    data=candidate
        except Exception:
            data={}
        state=str(data.get('state','hidden')).strip().casefold()
        try: count=max(0, int(data.get('count',0) or 0))
        except (TypeError, ValueError): count=0
        visible=state == 'available' and count > 0
        self.eus_status=data if visible else {}
        self.eus.setVisible(visible and not self._tray_compact)
        if not visible:
            self.eus.setText('')
            return
        icon_path=EUS_ICON_DIR/'eus-update-available.png'
        self.eus.setIcon(get_icon(str(icon_path),'system-software-update'))
        message=str(data.get('message','')).strip() or f'{count} update{"s" if count != 1 else ""} available'
        self.eus.setToolTip(message+' — Click to open Eduka Update System')
        self.eus.setAccessibleName(f'Eduka Update System: {count} update{"s" if count != 1 else ""} available')
        self.eus.setText(f' {count} Updates' if self.hearing_accessibility else '')

    def language_context(self, pos):
        m=RoundedMenu(self)
        m.addAction(get_icon('preferences-desktop-locale'), 'Language Settings', lambda: launch_app('lxqt-config-locale'))
        m.addAction(get_icon('input-keyboard'), 'Keyboard Settings', lambda: launch_app('lxqt-config-input'))
        self._show_context(m, self.lang, pos)

    def clock_context(self, pos):
        m=RoundedMenu(self)
        m.addAction(get_icon('office-calendar'), 'Action Center', self.toggle_action_center)
        m.addSeparator()
        cfg=read_panel_config()
        for key, label in (('panel_clock_seconds', 'Show seconds'), ('panel_clock_blink', 'Blinking colon')):
            act=m.addAction(label); act.setCheckable(True); act.setChecked(bool(cfg.get(key, False)))
            act.toggled.connect(lambda on, k=key: (save_panel_config({k: bool(on)}), self.current_cfg.update({k: bool(on)}), self.update_clock()))
        m.addSeparator()
        m.addAction(get_icon('preferences-system-time'), 'Date and Time Settings', lambda: launch_app('lxqt-admin-time'))
        self._show_context(m, self.clock, pos)

    def update_status_icons(self):
        """Refresh tray state in a worker thread (nmcli/pactl can be slow)."""
        self.update_eus_status()
        if self._status_worker is not None:
            self._status_again=True
            return
        worker=StatusWorker(self); worker.ready.connect(self.apply_status); worker.finished.connect(self._status_finished)
        self._status_worker=worker; worker.start()

    def _status_finished(self):
        if self._status_worker is not None:
            self._status_worker.deleteLater(); self._status_worker=None
        if self._status_again:
            self._status_again=False; QTimer.singleShot(0, self.update_status_icons)

    def apply_status(self, st):
        self.last_status=st
        text=st.get('layout','EN')
        if self.lang.text() != text: self.lang.setText(text)
        self.lang.setToolTip(f'Keyboard layout: {text}'); self.lang.setAccessibleName(f'Keyboard layout {text}')
        net=st.get('net','offline')
        kind={'wifi':'wifi','ethernet':'ethernet'}.get(net, 'wifi-off' if st.get('wifi_hw') and st.get('wifi_on') else 'offline')
        tip={'wifi':tr('net_wifi')+(f": {st.get('connection')}" if st.get('connection') else ''),'ethernet':tr('net_lan')}.get(net, tr('net_off'))
        ink='#e0e0e0' if is_dark_theme() else '#183c35'
        size=self.net.iconSize().width() if self.net.iconSize().width() > 0 else 22
        self.net.setIcon(QIcon(network_pixmap(kind, True, size, ink, st.get('signal')))); self.net.setToolTip(tip); self.net.setAccessibleName(tip)
        self.net.setText((' '+(st.get('connection') if net == 'wifi' else 'LAN' if net == 'ethernet' else tr('offline'))) if self.hearing_accessibility else '')
        info=st.get('battery'); self.battery.setVisible(info is not None)
        if info:
            status=str(info['status']).lower(); self.battery.setIcon(get_icon('battery-good-charging' if 'charg' in status else 'battery-good', 'battery'))
            # Percentage, time left (or until full) or both (right-click → Show).
            mode=self.current_cfg.get('battery_display', 'percent'); left=battery_time_text(info)
            if mode == 'time' and left: text=f' {left}'
            elif mode == 'both' and left: text=f" {info['capacity']}% • {left}"
            else: text=f" {info['capacity']}%"
            self.battery.setText(text)
            extra=''
            if left: extra=' • '+(_('{t} until full') if 'charg' in status and 'dis' not in status else _('{t} left')).replace('{t}', left)
            self.battery.setToolTip(f"Battery {info['capacity']}% ({info['status']})"+extra)
        self.bt.setVisible(bool(st.get('bt_hw'))); self.bt.setIcon(get_icon('bluetooth','preferences-system-bluetooth'))
        self.bt.setToolTip('Bluetooth on' if st.get('bt_on') else 'Bluetooth off')
        self.printer.setVisible(bool(st.get('printers'))); self.printer.setIcon(get_icon('printer','printer'))
        muted=bool(st.get('muted')); vol=st.get('volume')
        volume_status=('Muted' if muted else 'Volume')+(f': {vol}%' if vol is not None else '')
        # Same level icon as the Action Center: muted, low, medium or high.
        level='audio-volume-muted' if muted or vol == 0 else ('audio-volume-high' if vol is None else 'audio-volume-low' if vol < 34 else 'audio-volume-medium' if vol < 67 else 'audio-volume-high')
        self.vol.setIcon(get_icon(level,'audio-volume-medium')); self.vol.setToolTip(volume_status); self.vol.setAccessibleName(volume_status); self.vol.setText(' '+volume_status if self.hearing_accessibility else '')
        self.notif.setText(((f' {self.notifications.unread} new' if self.notifications.unread else ' Alerts')) if self.hearing_accessibility else '')
        if self.action_center is not None and self.action_center.isVisible():
            self.action_center.refresh(st)
        if self._tray_compact:
            for w in self.tray_status_widgets(): w.hide()

    def tray_status_widgets(self):
        return [self.net,self.bt,self.printer,self.battery,self.vol,self.eus,self.notif,self.lang]

    def set_tray_compact(self, compact):
        """While the Action Center is open its tiles show network, sound,
        Bluetooth and battery, so the tray keeps only the clock."""
        compact=bool(compact)
        if compact == self._tray_compact: return
        self._tray_compact=compact
        if compact:
            for w in self.tray_status_widgets(): w.hide()
        else:
            self.lang.show(); self.net.show(); self.vol.show(); self.notif.show()
            self.apply_status(self.last_status or {}); self.update_eus_status()

    def toggle_action_center(self):
        if self.action_center is not None and self.action_center.isVisible():
            self.action_center.close(); return
        # Clicking the clock while the popup is open first closes the popup
        # (Qt.Popup); do not reopen it from that same click.
        if time.monotonic() - self._action_center_closed_at < 0.3:
            return
        ac=ActionCenter(self); self.action_center=ac
        ac.destroyed.connect(lambda *_: setattr(self, 'action_center', None))
        ac.place(); ac.show(); ac.activateWindow()
        QTimer.singleShot(0, ac.place)   # final size is known once shown
        self.clock.set_ac_open(True); self.clock.setToolTip('Click to close the Action Center')
        self.set_tray_compact(True)
        self.update_status_icons()

    def wheelEvent(self,e):
        if self.vol.underMouse(): self.change_volume(5 if e.angleDelta().y()>0 else -5)
    def change_volume(self,delta):
        # Stay within 0-100 % so scrolling over the icon cannot distort speakers.
        current=self.last_status.get('volume')
        current=50 if current is None else int(current)
        target=max(0, min(100, current+delta))
        self.last_status['volume']=target
        self.vol.setToolTip(f'Volume: {target}%')
        safe_popen(['pactl','set-sink-volume','@DEFAULT_SINK@',f'{target}%']); QTimer.singleShot(250, self.update_status_icons)
    def show_popup_above(self,popup,anchor):
        popup.adjustSize(); g=anchor.mapToGlobal(QPoint(anchor.width()//2, anchor.height()//2))
        popup._anchor=(self, g)
        popup.move(self.popup_position(popup.width(), popup.height(), g)); popup.show()
    def volume_popup(self):
        self.show_popup_above(SoundPopup(self), self.vol)
    def notification_popup(self):
        self.show_popup_above(NotificationPopup(self), self.notif if self.notif.isVisible() else self.clock)

    def update_notification_badge(self):
        """Bell icon with an accent dot and count while notifications are unread."""
        count=self.notifications.unread
        size=self.notif.iconSize() if self.notif.iconSize().width() > 0 else QSize(22,22)
        dnd=dnd_enabled()
        base=get_icon('notifications-disabled' if dnd else 'preferences-system-notifications','preferences-system-notifications').pixmap(size)
        if base.isNull():
            base=QPixmap(size); base.fill(Qt.transparent)
        if dnd:
            # Do Not Disturb: a diagonal line over the bell when the icon
            # theme has no "notifications-disabled" picture.
            if not QIcon.hasThemeIcon('notifications-disabled'):
                base=QPixmap(base); painter=QPainter(base); painter.setRenderHint(QPainter.Antialiasing)
                w=base.width()/base.devicePixelRatio(); painter.setPen(QPen(QColor('#e5484d'), max(2.0, w/10), Qt.SolidLine, Qt.RoundCap))
                painter.drawLine(QPointF(w*0.15, w*0.85), QPointF(w*0.85, w*0.15)); painter.end()
        if count:
            pix=QPixmap(base); painter=QPainter(pix); painter.setRenderHint(QPainter.Antialiasing)
            d=max(9, int(size.width()*0.55)); r=QRectF(pix.width()/pix.devicePixelRatio()-d, 0, d, d)
            painter.setPen(Qt.NoPen); painter.setBrush(QColor('#e5484d')); painter.drawEllipse(r)
            font=painter.font(); font.setPixelSize(max(7, int(d*0.72))); font.setBold(True); painter.setFont(font); painter.setPen(QColor('#ffffff'))
            painter.drawText(r, Qt.AlignCenter, str(count) if count < 10 else '9+'); painter.end()
            self.notif.setIcon(QIcon(pix))
        else:
            self.notif.setIcon(QIcon(base))
        label=f'{count} unread notification{"s" if count != 1 else ""}' if count else 'Notifications'
        if dnd: label+=' — '+tr('dnd')
        self.notif.setToolTip(label); self.notif.setAccessibleName(label)
        if self.hearing_accessibility:
            self.notif.setText(f' {count} new' if count else ' Alerts')
    def battery_info(self):
        return battery_info()
    def battery_popup(self):
        self.show_popup_above(BatteryPopup(self), self.battery)
    def bluetooth_popup(self):
        self.show_popup_above(BluetoothPopup(self), self.bt)
    def network_popup(self):
        self.show_popup_above(NetworkPopup(self), self.net)

    def run_network(self, cmd, success):
        """Run an nmcli action without blocking the panel and report the result."""
        proc=QProcess(self); proc.setProcessChannelMode(QProcess.MergedChannels)
        def done(code, _status, p=proc):
            out=bytes(p.readAll()).decode('utf-8','replace').strip()
            text=success if code == 0 else ('Could not connect: '+(out.splitlines()[-1] if out else 'unknown error'))
            QToolTip.showText(self.net.mapToGlobal(QPoint(0,-30)) if self.net.isVisible() else QCursor.pos(), text, self.net, QRect(), 6000)
            p.deleteLater(); QTimer.singleShot(300, self.update_status_icons)
        proc.finished.connect(done)
        proc.start(cmd[0], cmd[1:])
        QToolTip.showText(QCursor.pos(), 'Connecting…' if 'up' in cmd or 'connect' in cmd else 'Working…', self.net, QRect(), 3000)

    def calendar_popup(self):
        self.toggle_action_center()

PANEL_LOCK = RUNTIME_DIR/'panel.lock'

def acquire_panel_lock(wait_seconds=3.0):
    """Keep one Eduka-Panel per session.

    'Restart Eduka-Panel' starts the new panel right after pkill, so wait a
    moment for the old process to release the lock instead of giving up.
    """
    ensure_dirs()
    lock_file=open(PANEL_LOCK, 'w')
    deadline=time.monotonic()+wait_seconds
    while True:
        try:
            fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return lock_file
        except OSError:
            if time.monotonic() >= deadline:
                lock_file.close(); return None
            time.sleep(0.1)

if __name__ == '__main__':
    panel_lock=acquire_panel_lock()
    if panel_lock is None:
        print('Eduka-Panel is already running.', file=sys.stderr); sys.exit(0)
    install_crash_log('eduka-panel')
    if in_eduka_session(): wait_for_compositor()
    app=QApplication(sys.argv); install_translations(app); app.setApplicationName('eduka-panel'); app.setStyleSheet(tooltip_qss()); icon_theme_setup(); panel=EdukaPanel()
    if not panel._fullscreen_hidden: panel.show()
    registry_update('panel', {'pid': os.getpid(), 'running': True}); exit_now(app.exec_())
