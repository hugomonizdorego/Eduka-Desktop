def popup_header(icon, title, subtitle=''):
    """Icon + title + subtitle row shared by the Sound and Network popups."""
    row=QHBoxLayout(); row.setSpacing(10)
    pic=QLabel(); pic.setPixmap(get_icon(icon,'preferences-system').pixmap(30,30)); row.addWidget(pic)
    text=QVBoxLayout(); text.setSpacing(0)
    t=QLabel(title); t.setObjectName('popTitle'); sub=QLabel(subtitle); sub.setObjectName('popSub')
    text.addWidget(t); text.addWidget(sub); row.addLayout(text, 1)
    return row, pic, sub


class PopupFrame(QFrame):
    def __init__(self, parent=None):
        super().__init__(parent, Qt.Popup | Qt.FramelessWindowHint | Qt.NoDropShadowWindowHint); self.setAttribute(Qt.WA_DeleteOnClose)
        composited=compositor_running()
        if composited: self.setAttribute(Qt.WA_TranslucentBackground)
        self.box=QFrame(self); self.box.setObjectName('popupBox'); lay=QVBoxLayout(self); lay.setContentsMargins(*((6,6,6,6) if composited else (0,0,0,0))); lay.addWidget(self.box)
        self.v=QVBoxLayout(self.box); self.v.setContentsMargins(16,14,16,14); self.v.setSpacing(10)
        # Without a compositor a translucent popup gets black corners: the
        # popup stays opaque and its corners are cut off with a mask.
        self.setStyleSheet(popup_qss())
        if not composited:
            round_window_shape(self, 18)
        self._fade=None
        # Popup shadows disabled in low resource mode to avoid sluggish LXQt/QEMU sessions.
        if read_panel_config().get('enable_shadows', False) and not read_panel_config().get('low_resource_mode', True):
            sh=QGraphicsDropShadowEffect(); sh.setBlurRadius(18); sh.setOffset(0,6); sh.setColor(QColor(0,0,0,45)); self.box.setGraphicsEffect(sh)

    def refit(self):
        """Grow or shrink with new content and stay beside the panel (a
        popup that grew downwards covered Eduka-Panel)."""
        anchor=getattr(self, '_anchor', None)
        self.adjustSize()
        if anchor:
            panel, g=anchor
            QTimer.singleShot(0, lambda: self.move(panel.popup_position(self.width(), self.height(), g)) if self.isVisible() else None)

    def showEvent(self, e):
        super().showEvent(e)
        translate_tree(self)
        # A short fade makes popups feel smooth; without a compositor Qt
        # simply shows the popup at full opacity.
        self._fade=fade_in(self, 130)

    def keyPressEvent(self, e):
        if e.key() == Qt.Key_Escape:
            self.close(); return
        super().keyPressEvent(e)


def _run_text(cmd, timeout=1.5):
    """Run a status command; None when missing, failing or too slow."""
    if shutil.which(cmd[0]) is None:
        return None
    try:
        return subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=timeout).stdout
    except Exception:
        return None

def battery_info():
    """Capacity, status and the minutes left (discharging) or until full
    (charging) from the battery's energy or charge and its power or current."""
    def num(path):
        try: return float(path.read_text().strip())
        except Exception: return None
    for b in sorted(Path('/sys/class/power_supply').glob('BAT*')):
        try:
            info={'capacity':int((b/'capacity').read_text().strip()),'status':(b/'status').read_text().strip(), 'minutes': None}
        except Exception:
            continue
        now=num(b/'energy_now') or num(b/'charge_now'); full=num(b/'energy_full') or num(b/'charge_full')
        rate=num(b/'power_now') or num(b/'current_now')
        if now is not None and rate and rate > 0:
            st=info['status'].lower()
            if st == 'discharging': info['minutes']=int(now/rate*60)
            elif st == 'charging' and full: info['minutes']=int(max(0.0, full-now)/rate*60)
        return info
    return None

def battery_time_text(info):
    m=info.get('minutes') if info else None
    if m is None or m <= 0 or m > 48*60: return ''
    return f'{m//60}:{m%60:02d}'


# --- Brightness ---------------------------------------------------------------
# Laptops: the backlight (brightnessctl, xbacklight). Desktops, projectors and
# virtual machines (VirtualBox) have no backlight: there Eduka dims the picture
# with xrandr (software brightness), never below 30 % so the screen stays usable.
BRIGHTNESS_STATE = PANEL_CONFIG_DIR/'brightness.json'
SOFTWARE_BRIGHTNESS_MIN = 30

def backlight_device():
    for d in sorted(Path('/sys/class/backlight').glob('*')):
        if (d/'brightness').exists() and (d/'max_brightness').exists():
            return d
    return None

def xrandr_outputs():
    out=_run_text(['xrandr','--verbose','--current'], timeout=3)
    outputs=[]; current=None
    for line in (out or '').splitlines():
        m=re.match(r'^(\S+) connected', line)
        if m:
            current={'name': m.group(1), 'brightness': 1.0}; outputs.append(current); continue
        if line and not line[0].isspace():
            current=None; continue
        b=re.match(r'\s+Brightness:\s*([0-9.]+)', line)
        if current is not None and b:
            # Some drivers report 0.0 before anything was set; that means 100 %.
            current['brightness']=float(b.group(1)) or 1.0
    return outputs

def read_brightness():
    """Return (percent, method); method is 'backlight', 'software' or None."""
    d=backlight_device()
    if d is not None:
        try:
            cur=int((d/'brightness').read_text().strip()); mx=int((d/'max_brightness').read_text().strip())
            if mx > 0:
                return int(round(cur*100/mx)), 'backlight'
        except Exception:
            pass
    outputs=xrandr_outputs()
    if outputs:
        return max(SOFTWARE_BRIGHTNESS_MIN, min(100, int(round(outputs[0]['brightness']*100)))), 'software'
    return None, None

def set_brightness(value, method):
    value=max(1, min(100, int(value)))
    if method == 'backlight':
        if shutil.which('brightnessctl'):
            return safe_popen(['brightnessctl','-q','set',f'{value}%'])
        if shutil.which('xbacklight'):
            return safe_popen(['xbacklight','-set',str(value)])
    value=max(SOFTWARE_BRIGHTNESS_MIN, value)
    ok=False
    for out in xrandr_outputs():
        ok=safe_popen(['xrandr','--output',out['name'],'--brightness',f'{value/100:.2f}']) or ok
    try:
        write_json(BRIGHTNESS_STATE, {'software': value})
    except Exception:
        pass
    return ok

def restore_software_brightness():
    """xrandr brightness is lost at logout; re-apply the user's last value."""
    try:
        value=int(read_json(BRIGHTNESS_STATE, {'software': 100}).get('software', 100))
    except Exception:
        return
    if value < 100 and backlight_device() is None and shutil.which('xrandr'):
        set_brightness(value, 'software')


MEDIA_WANTED={'on': False}   # only while the Action Center is open
QUIET_STREAMS={'speech-dispatcher', 'libcanberra', 'lxqt-notificationd', 'eduka-panel', 'pavucontrol', 'pavucontrol-qt'}

def sink_inputs():
    """Applications playing sound right now (pactl list sink-inputs):
    id, app name, title, icon, process id, volume and mute."""
    out=_run_text(['pactl','list','sink-inputs'], timeout=2)
    streams=[]; cur=None
    for line in (out or '').splitlines():
        m=re.match(r'^Sink Input #(\d+)', line)
        if m:
            cur={'id': int(m.group(1)), 'volume': 100, 'muted': False, 'corked': False, 'props': {}}; streams.append(cur); continue
        if cur is None: continue
        t=line.strip()
        if t.startswith('Mute:'): cur['muted']='yes' in t
        elif t.startswith('Corked:'): cur['corked']='yes' in t
        elif t.startswith('Volume:'):
            m=re.search(r'(\d+)%', t)
            if m: cur['volume']=int(m.group(1))
        else:
            m=re.match(r'^([\w.]+) = "(.*)"$', t)
            if m: cur['props'][m.group(1)]=m.group(2)
    result=[]
    for st in streams:
        pr=st.pop('props')
        app=pr.get('application.name') or pr.get('application.process.binary') or 'Application'
        if app.casefold() in QUIET_STREAMS or pr.get('media.role') in ('event', 'phone') or pr.get('application.id') == 'org.PulseAudio.pavucontrol':
            continue
        title=pr.get('media.name') or ''
        if title.casefold() in ('playback', 'audio stream', 'output', 'playstream', app.casefold()): title=''
        st.update(app=app, title=title, icon=pr.get('application.icon_name') or pr.get('application.process.binary') or '',
                  pid=pr.get('application.process.id') or '', binary=(pr.get('application.process.binary') or '').casefold())
        result.append(st)
    return result

def _dbus(dest, path, method, *args, timeout=1.0):
    if shutil.which('dbus-send') is None: return None
    return _run_text(['dbus-send','--session','--print-reply',f'--reply-timeout={int(timeout*1000)}',f'--dest={dest}',path,method,*args], timeout=timeout+0.5)

def mpris_players():
    """Media players that speak MPRIS (VLC, SMPlayer, Celluloid, Audacious,
    Rhythmbox, Spotify, Firefox and Chromium for YouTube, ...)."""
    names=re.findall(r'string "(org\.mpris\.MediaPlayer2\.[^"]+)"', _dbus('org.freedesktop.DBus','/org/freedesktop/DBus','org.freedesktop.DBus.ListNames') or '')
    players=[]
    for name in names[:8]:
        props=_dbus(name,'/org/mpris/MediaPlayer2','org.freedesktop.DBus.Properties.GetAll','string:org.mpris.MediaPlayer2.Player') or ''
        if not props: continue
        status=re.search(r'string "PlaybackStatus"\s+variant\s+string "(\w+)"', props)
        title=re.search(r'string "xesam:title"\s+variant\s+string "(.*)"', props)
        artist=re.search(r'string "xesam:artist"\s+variant\s+array \[\s+string "(.*)"', props)
        volume=re.search(r'string "Volume"\s+variant\s+double ([\d.eE+-]+)', props)
        ident=re.search(r'variant\s+string "(.*)"', _dbus(name,'/org/mpris/MediaPlayer2','org.freedesktop.DBus.Properties.Get','string:org.mpris.MediaPlayer2','string:Identity') or '')
        pid=re.search(r'uint32 (\d+)', _dbus('org.freedesktop.DBus','/org/freedesktop/DBus','org.freedesktop.DBus.GetConnectionUnixProcessID',f'string:{name}') or '')
        players.append({'name': name, 'status': status.group(1) if status else 'Stopped',
                        'title': title.group(1) if title else '', 'artist': artist.group(1) if artist else '',
                        'volume': float(volume.group(1)) if volume else None, 'identity': ident.group(1) if ident else name.split('.')[3],
                        'pid': pid.group(1) if pid else ''})
    return players

def match_player(stream, players):
    key=stream['app'].casefold(); binary=stream.get('binary','')
    for pl in players:
        if stream.get('pid') and pl['pid'] == stream['pid']: return pl
    for pl in players:
        ident=pl['identity'].casefold(); short=pl['name'].split('.')[3].casefold()
        if key and (key in ident or ident in key or short in key or (binary and short in binary)): return pl
    return None

def collect_status():
    """Gather tray/Action Center state. Runs in a worker thread."""
    st={}
    out=_run_text(['nmcli','-t','-f','TYPE,STATE,CONNECTION','device'])
    st['nm']=out is not None
    net='offline'; conn=''; wifi_hw=False
    for line in (out or '').splitlines():
        parts=line.split(':', 2)
        if len(parts) < 3: continue
        kind, state, name = parts
        if kind == 'wifi': wifi_hw=True
        if state == 'connected':
            if kind == 'wifi': net='wifi'; conn=name
            elif kind == 'ethernet' and net != 'wifi': net='ethernet'; conn=name
    st.update(net=net, connection=conn, wifi_hw=wifi_hw, signal=None)
    if net == 'wifi':
        o=_run_text(['nmcli','-t','-f','ACTIVE,SIGNAL','device','wifi','list','--rescan','no'])
        for line in (o or '').splitlines():
            if line.startswith('yes:'):
                try: st['signal']=int(line.split(':')[1])
                except ValueError: pass
    radio=_run_text(['nmcli','-t','radio','all'])
    fields=(radio or '').strip().split(':')
    st['wifi_on']=(fields[1] == 'enabled') if len(fields) >= 2 else None
    st['airplane']=bool(len(fields) >= 4 and fields[1] == 'disabled' and fields[3] == 'disabled')
    bt_dir=Path('/sys/class/bluetooth')
    st['bt_hw']=bt_dir.exists() and any(bt_dir.iterdir())
    st['bt_on']=None
    if st['bt_hw']:
        o=_run_text(['bluetoothctl','show'])
        if o is not None: st['bt_on']='Powered: yes' in o
    o=_run_text(['pactl','get-sink-volume','@DEFAULT_SINK@']); m=re.search(r'(\d+)%', o or '')
    st['volume']=int(m.group(1)) if m else None
    o=_run_text(['pactl','get-sink-mute','@DEFAULT_SINK@']); st['muted']='yes' in (o or '').lower()
    o=_run_text(['lpstat','-p']); st['printers']=bool((o or '').strip())
    o=_run_text(['setxkbmap','-query']); m=re.search(r'^layout:\s*([^\s,]+)', o or '', re.M)
    st['layout']=(m.group(1) if m else 'en')[:3].upper()
    st['brightness'], st['brightness_method']=read_brightness()
    st['streams']=sink_inputs() if MEDIA_WANTED['on'] else []
    st['players']=mpris_players() if MEDIA_WANTED['on'] else []
    st['battery']=battery_info()
    return st


class StatusWorker(QThread):
    """Keeps nmcli/pactl/bluetoothctl off the GUI thread so the panel never stutters."""
    ready=pyqtSignal(object)
    def run(self):
        try: self.ready.emit(collect_status())
        except Exception: pass


class ModernCalendar(QCalendarWidget):
    """Flat, rounded calendar: today as an accent circle, the selected day as
    a ring, days of other months faded, compact weekday initials."""
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setNavigationBarVisible(False)
        self.setGridVisible(False)
        self.setVerticalHeaderFormat(QCalendarWidget.NoVerticalHeader)
        self.setHorizontalHeaderFormat(QCalendarWidget.ShortDayNames)
        self.setSelectedDate(QDate.currentDate())
        u=ui_colors()
        self._accent=qcolor(u['accent']); self._text=qcolor(u['text']); self._muted=qcolor(u['muted']); self._weekend=qcolor(u['weekend'])
        header=QTextCharFormat(); header.setForeground(qcolor(u['sub']))
        f=header.font(); f.setPointSizeF(max(7.0, f.pointSizeF()*0.9 if f.pointSizeF() > 0 else 8.5)); header.setFont(f)
        self.setHeaderTextFormat(header)
        for day in (Qt.Saturday, Qt.Sunday):
            weekend=QTextCharFormat(); weekend.setForeground(self._weekend); self.setWeekdayTextFormat(day, weekend)
        for view in self.findChildren(QAbstractItemView):
            view.setMouseTracking(True)
        self.agenda_days=set(); self.reload_agenda()

    def reload_agenda(self):
        self.agenda_days={e['date'] for e in read_agenda()}
        self.updateCells()

    def paintCell(self, painter, rect, date):
        painter.save()
        painter.setRenderHint(QPainter.Antialiasing, True)
        in_month = date.month() == self.monthShown()
        today = date == QDate.currentDate()
        selected = date == self.selectedDate() and not today
        size=min(rect.width(), rect.height())-6
        circle=QRectF(rect.center().x()-size/2+0.5, rect.center().y()-size/2+0.5, size, size)
        color=self._text
        if not in_month:
            color=self._muted
        elif date.dayOfWeek() in (6, 7):
            color=self._weekend
        font=painter.font()
        if today:
            painter.setPen(Qt.NoPen); painter.setBrush(self._accent); painter.drawEllipse(circle)
            color=QColor('#ffffff'); font.setBold(True)
        elif selected:
            painter.setPen(QPen(self._accent, 1.6)); painter.setBrush(Qt.NoBrush); painter.drawEllipse(circle)
            font.setBold(True)
        painter.setFont(font); painter.setPen(color)
        painter.drawText(rect, Qt.AlignCenter, str(date.day()))
        if date.toString('yyyy-MM-dd') in self.agenda_days:
            # A small dot under the number marks a day with an agenda.
            painter.setPen(Qt.NoPen); painter.setBrush(QColor('#ffffff') if today else self._accent)
            painter.drawEllipse(QPointF(rect.center().x()+0.5, circle.bottom()-3.5), 2.2, 2.2)
        painter.restore()


class CalendarCard(QFrame):
    """Calendar with a modern header: month title, today button, chevrons."""
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setObjectName('acCard')
        lay=QVBoxLayout(self); lay.setContentsMargins(10,8,10,6); lay.setSpacing(4)
        head=QHBoxLayout(); head.setSpacing(4)
        self.title=QLabel(''); self.title.setObjectName('calTitle'); head.addWidget(self.title, 1)
        today=QPushButton('Today'); today.setObjectName('calToday'); today.setCursor(Qt.PointingHandCursor); head.addWidget(today)
        color='#e0e0e0' if is_dark_theme() else '#2d4a43'
        self.prev=QToolButton(); self.prev.setObjectName('calNav'); self.prev.setIcon(QIcon(arrow_icon_path('left', color))); self.prev.setAccessibleName('Previous month')
        self.next=QToolButton(); self.next.setObjectName('calNav'); self.next.setIcon(QIcon(arrow_icon_path('right', color))); self.next.setAccessibleName('Next month')
        for b in (self.prev, self.next): b.setIconSize(QSize(14,14)); b.setCursor(Qt.PointingHandCursor); head.addWidget(b)
        lay.addLayout(head)
        self.calendar=ModernCalendar(); self.calendar.setFixedHeight(166); lay.addWidget(self.calendar)
        self.prev.clicked.connect(self.calendar.showPreviousMonth)
        self.next.clicked.connect(self.calendar.showNextMonth)
        today.clicked.connect(lambda: (self.calendar.setSelectedDate(QDate.currentDate()), self.calendar.showToday()))
        self.calendar.currentPageChanged.connect(lambda *_: self.update_title())
        # Agenda of the chosen day: the entries, and a small form to add one.
        self.agenda=QWidget(); av=QVBoxLayout(self.agenda); av.setContentsMargins(2,2,2,2); av.setSpacing(4)
        ah=QHBoxLayout(); ah.setSpacing(6)
        self.agenda_title=QLabel(''); self.agenda_title.setObjectName('agendaTitle'); ah.addWidget(self.agenda_title, 1)
        self.agenda_add=QPushButton('+ Agenda'); self.agenda_add.setObjectName('calToday'); self.agenda_add.setCursor(Qt.PointingHandCursor)
        self.agenda_add.setToolTip('Write an agenda for this day'); ah.addWidget(self.agenda_add)
        av.addLayout(ah)
        self.agenda_list=QVBoxLayout(); self.agenda_list.setSpacing(2); av.addLayout(self.agenda_list)
        self.form=QFrame(); self.form.setObjectName('agendaForm'); fl=QGridLayout(self.form); fl.setContentsMargins(8,8,8,8); fl.setSpacing(6)
        self.form_text=QLineEdit(); self.form_text.setPlaceholderText('What is on this day?'); self.form_text.setMaxLength(200)
        self.form_time=QTimeEdit(QTime(7, 0)); self.form_time.setDisplayFormat('HH:mm'); self.form_time.setButtonSymbols(QAbstractSpinBox.NoButtons); self.form_time.setAccessibleName('Alarm time')
        self.form_alarm=QComboBox()
        for key, label in AGENDA_ALARMS: self.form_alarm.addItem(_(label), key)
        self.form_alarm.setSizeAdjustPolicy(QComboBox.AdjustToMinimumContentsLengthWithIcon); self.form_alarm.setMinimumContentsLength(8)
        self.form_alarm.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed); self.form_text.setMinimumWidth(10)
        round_combo(self.form_alarm)
        save=QPushButton('Save'); save.setObjectName('agendaSave'); save.setCursor(Qt.PointingHandCursor)
        cancel=QPushButton('Cancel'); cancel.setObjectName('calToday'); cancel.setCursor(Qt.PointingHandCursor)
        fl.addWidget(self.form_text, 0, 0, 1, 3)
        fl.addWidget(QLabel('Alarm:'), 1, 0); fl.addWidget(self.form_time, 1, 1); fl.addWidget(self.form_alarm, 1, 2)
        btns=QHBoxLayout(); btns.addStretch(1); btns.addWidget(cancel); btns.addWidget(save); fl.addLayout(btns, 2, 0, 1, 3)
        self.form.setVisible(False); av.addWidget(self.form)
        lay.addWidget(self.agenda)
        self.agenda_add.clicked.connect(self.open_form)
        cancel.clicked.connect(lambda: self.show_form(False))
        save.clicked.connect(self.save_entry); self.form_text.returnPressed.connect(self.save_entry)
        self.calendar.selectionChanged.connect(self.update_agenda)
        self.update_title(); self.update_agenda()

    changed=pyqtSignal()

    def show_form(self, on):
        self.form.setVisible(on); self.agenda_add.setVisible(not on)
        if on: self.form_text.setFocus()
        self.changed.emit()

    def open_form(self):
        self.form_text.clear()
        day=self.calendar.selectedDate()
        t=QTime.currentTime().addSecs(3600) if day == QDate.currentDate() else QTime(7, 0)
        self.form_time.setTime(QTime(t.hour(), 0)); self.show_form(True)

    def save_entry(self):
        text=self.form_text.text().strip()
        if not text:
            self.form_text.setFocus(); return
        add_agenda(self.calendar.selectedDate().toString('yyyy-MM-dd'), self.form_time.time().toString('HH:mm'), text, self.form_alarm.currentData() or 'notify')
        self.show_form(False); self.calendar.reload_agenda(); self.update_agenda()

    def remove(self, item_id):
        remove_agenda(item_id); self.calendar.reload_agenda(); self.update_agenda()

    def update_agenda(self):
        day=self.calendar.selectedDate()
        self.agenda_title.setText(_('Agenda') + ' • ' + QLocale().toString(day, 'ddd d MMM'))
        while self.agenda_list.count():
            w=self.agenda_list.takeAt(0).widget()
            if w: w.deleteLater()
        key=day.toString('yyyy-MM-dd')
        entries=[e for e in read_agenda() if e['date'] == key]
        icons={'notify': '🔔', 'sound': '⏰', 'blink': '✨'}
        for e in entries[:5]:
            row=QFrame(); row.setObjectName('agendaRow'); rl=QHBoxLayout(row); rl.setContentsMargins(8,3,3,3); rl.setSpacing(6)
            when=QLabel(e['time'] or '—'); when.setObjectName('agendaTime'); rl.addWidget(when)
            text=QLabel(e['text']); text.setTextFormat(Qt.PlainText); text.setWordWrap(True); rl.addWidget(text, 1)
            kind=QLabel(icons.get(e['alarm'], '🔔')); kind.setToolTip(_(dict(AGENDA_ALARMS).get(e['alarm'], 'Notification'))); rl.addWidget(kind)
            x=QToolButton(); x.setObjectName('calNav'); x.setText('✕'); x.setToolTip('Delete'); x.setCursor(Qt.PointingHandCursor)
            x.clicked.connect(lambda _=False, i=e['id']: self.remove(i)); rl.addWidget(x)
            self.agenda_list.addWidget(row)
        if not entries:
            none=QLabel('No agenda for this day.'); none.setObjectName('popHint'); self.agenda_list.addWidget(none)
        self.changed.emit()

    def update_title(self):
        page=QDate(self.calendar.yearShown(), self.calendar.monthShown(), 1)
        self.title.setText(QLocale().toString(page, 'MMMM yyyy'))


NOTIFY_HISTORY = BASE_CONFIG/'notifications.json'
NOTIFY_MAX = 40
PANEL_STATE = BASE_CONFIG/'panel-state.json'
NOTIFY_PATH = '/org/freedesktop/Notifications'
NOTIFY_NAME = 'org.freedesktop.Notifications'

def read_panel_state():
    try:
        data=json.loads(PANEL_STATE.read_text(encoding='utf-8'))
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}

def save_panel_state(**values):
    data=read_panel_state(); data.update(values)
    try: write_json(PANEL_STATE, data)
    except Exception: pass

def dnd_enabled():
    return bool(read_panel_state().get('dnd', False))


def _dbus_string(chunk):
    m=re.match(r'string "(.*)"\s*$', chunk, re.S)
    return m.group(1).replace('\\"', '"') if m else ''

def parse_notify_call(block):
    """Arguments of one org.freedesktop.Notifications.Notify call printed by
    dbus-monitor: app_name, replaces_id, app_icon, summary, body, ..."""
    args=re.split(r'\n   (?=[a-z]+[0-9]*[ \[]|array \[)', '\n'+block.split('\n',1)[1] if '\n' in block else '')
    args=[a for a in args if a.strip()]
    if len(args) < 5:
        return None
    app=_dbus_string(args[0]); icon=_dbus_string(args[2]); summary=_dbus_string(args[3]); body=_dbus_string(args[4])
    return make_notification(app, icon, summary, body)

def make_notification(app, icon, summary, body):
    body=re.sub(r'<[^>]+>', '', str(body or '')).replace('&amp;', '&').replace('&lt;', '<').replace('&gt;', '>').strip()
    summary=str(summary or '').strip()
    if not (summary or body):
        return None
    return {'app': str(app or '') or 'Application', 'icon': str(icon or ''), 'summary': summary[:120], 'body': body[:300], 'time': time.time()}

def notification_icon(item, size=26):
    icon=str(item.get('icon') or '')
    if icon.startswith('file://'):
        icon=QUrl(icon).toLocalFile()
    return get_icon(icon or 'preferences-system-notifications', 'dialog-information').pixmap(size, size)


class NotificationCenter(QObject):
    """History of desktop notifications (newest first) and the unread count.

    Normally Eduka-Panel is the notification server itself (see
    NotificationServer). When another server owns the bus name (e.g. outside
    an Eduka-Desktop session) the Notify calls are only watched with
    dbus-monitor so the history stays complete."""
    changed=pyqtSignal()
    def __init__(self, parent=None):
        super().__init__(parent)
        try:
            data=json.loads(NOTIFY_HISTORY.read_text(encoding='utf-8'))
            self.items=data.get('items', [])[:NOTIFY_MAX]; self.unread=int(data.get('unread', 0))
        except Exception:
            self.items=[]; self.unread=0
        self._buffer=''; self._block=None; self.proc=None
        self._save_timer=QTimer(self); self._save_timer.setSingleShot(True); self._save_timer.timeout.connect(self.save)
        self._flush_timer=QTimer(self); self._flush_timer.setSingleShot(True); self._flush_timer.timeout.connect(self._finish)

    def add(self, item):
        if not item:
            return
        self.items.insert(0, item); del self.items[NOTIFY_MAX:]
        self.unread=min(99, self.unread+1)
        self._save_timer.start(400); self.changed.emit()

    def start_monitor(self):
        if self.proc is not None or shutil.which('dbus-monitor') is None or not os.environ.get('DBUS_SESSION_BUS_ADDRESS'):
            return
        self.proc=QProcess(self)
        self.proc.setProcessChannelMode(QProcess.SeparateChannels)
        self.proc.readyReadStandardOutput.connect(self._read)
        self.proc.start('dbus-monitor', ["interface='org.freedesktop.Notifications',member='Notify'"])

    def stop(self):
        if self.proc is not None and self.proc.state() != QProcess.NotRunning:
            self.proc.kill(); self.proc.waitForFinished(500)
        self.proc=None

    def _read(self):
        self._buffer+=bytes(self.proc.readAllStandardOutput()).decode('utf-8', 'replace')
        lines=self._buffer.split('\n'); self._buffer=lines.pop()
        for line in lines:
            if re.match(r'^(method call|method return|signal|error) ', line):
                self._finish()
                self._block=line if 'member=Notify' in line else None
            elif self._block is not None:
                self._block+='\n'+line
        # A message may arrive in several reads: finish it once output pauses.
        if self._block is not None:
            self._flush_timer.start(120)

    def _finish(self):
        if self._block is None:
            return
        item=parse_notify_call(self._block); self._block=None
        self.add(item)

    def mark_read(self):
        if self.unread:
            self.unread=0; self._save_timer.start(400); self.changed.emit()

    def remove(self, index):
        if 0 <= index < len(self.items):
            del self.items[index]; self._save_timer.start(400); self.changed.emit()

    def clear(self):
        self.items=[]; self.unread=0; self._save_timer.start(100); self.changed.emit()

    def save(self):
        try: write_json(NOTIFY_HISTORY, {'items': self.items, 'unread': self.unread})
        except Exception: pass


NOTIFY_INTROSPECTION = '''<interface name="org.freedesktop.Notifications">
  <method name="Notify">
    <arg direction="in" type="s" name="app_name"/><arg direction="in" type="u" name="replaces_id"/>
    <arg direction="in" type="s" name="app_icon"/><arg direction="in" type="s" name="summary"/>
    <arg direction="in" type="s" name="body"/><arg direction="in" type="as" name="actions"/>
    <arg direction="in" type="a{sv}" name="hints"/><arg direction="in" type="i" name="expire_timeout"/>
    <arg direction="out" type="u" name="id"/>
  </method>
  <method name="CloseNotification"><arg direction="in" type="u" name="id"/></method>
  <method name="GetCapabilities"><arg direction="out" type="as" name="capabilities"/></method>
  <method name="GetServerInformation">
    <arg direction="out" type="s" name="name"/><arg direction="out" type="s" name="vendor"/>
    <arg direction="out" type="s" name="version"/><arg direction="out" type="s" name="spec_version"/>
  </method>
  <signal name="NotificationClosed"><arg type="u" name="id"/><arg type="u" name="reason"/></signal>
  <signal name="ActionInvoked"><arg type="u" name="id"/><arg type="s" name="action_key"/></signal>
</interface>'''


class NotificationsAdaptor(QDBusAbstractAdaptor):
    Q_CLASSINFO('D-Bus Interface', NOTIFY_NAME)
    Q_CLASSINFO('D-Bus Introspection', NOTIFY_INTROSPECTION)
    def __init__(self, server):
        super().__init__(server)
        self.server=server
        self.setAutoRelaySignals(False)

    @pyqtSlot(str, 'uint', str, str, str, 'QStringList', 'QVariantMap', int, result='uint')
    def Notify(self, app_name, replaces_id, app_icon, summary, body, actions, hints, expire_timeout):
        return self.server.notify(app_name, int(replaces_id), app_icon, summary, body, list(actions), dict(hints or {}), int(expire_timeout))

    @pyqtSlot('uint')
    def CloseNotification(self, nid):
        self.server.close_bubble(int(nid), 3)

    @pyqtSlot(result='QStringList')
    def GetCapabilities(self):
        return ['body', 'actions', 'icon-static', 'persistence']

    @pyqtSlot(QDBusMessage)
    def GetServerInformation(self, message):
        message.setDelayedReply(True)
        QDBusConnection.sessionBus().send(message.createReply(['Eduka-Panel', 'Edukasaun OS', VERSION, '1.2']))


def _uint(value):
    v=QVariant(int(value)); v.convert(QVariant.UInt)
    return v


class NotificationBubble(QFrame):
    """One notification on screen, above Eduka-Panel at the right."""
    WIDTH=360
    def __init__(self, server, nid, app, icon_item, summary, body, actions, timeout, critical):
        super().__init__(None, Qt.Tool | Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint | Qt.X11BypassWindowManagerHint)
        self.server=server; self.nid=nid; self.actions=actions
        self.setAttribute(Qt.WA_ShowWithoutActivating); self.setAttribute(Qt.WA_DeleteOnClose)
        composited=compositor_running()
        if composited: self.setAttribute(Qt.WA_TranslucentBackground)
        u=ui_colors(); dark=is_dark_theme()
        card='rgba(44,44,44,242)' if dark else 'rgba(255,255,255,246)'
        radius=18
        if not composited: round_window_shape(self, radius)   # rounded without a compositor too
        self.setStyleSheet(f"""
            QFrame#bubble{{background:{card};border:1px solid {u['btn_border']};border-radius:{radius}px;}}
            QFrame#bubble[critical="true"]{{border:1px solid #e5484d;}}
            QLabel{{background:transparent;color:{u['text']};}}
            QLabel#bApp{{font-size:11px;font-weight:700;color:{u['sub']};}}
            QLabel#bSummary{{font-size:13px;font-weight:800;color:{u['title']};}}
            QLabel#bBody{{font-size:12px;}}
            QToolButton#bClose{{background:transparent;border:0;border-radius:10px;padding:2px 6px;color:{u['sub']};}}
            QToolButton#bClose:hover{{background:{u['btn_hover']};color:{u['title']};}}
            QPushButton{{background:{u['tile']};border:1px solid {u['btn_border']};border-radius:10px;padding:5px 10px;font-weight:700;color:{u['text']};}}
            QPushButton:hover{{border:1px solid {u['accent']};}}
        """)
        outer=QVBoxLayout(self); outer.setContentsMargins(*((6,6,6,6) if composited else (0,0,0,0)))
        self.box=QFrame(); self.box.setObjectName('bubble'); self.box.setProperty('critical', bool(critical)); outer.addWidget(self.box)
        lay=QHBoxLayout(self.box); lay.setContentsMargins(12,10,8,10); lay.setSpacing(10)
        pic=QLabel(); pic.setFixedSize(36,36); pic.setPixmap(notification_icon(icon_item, 34)); lay.addWidget(pic, 0, Qt.AlignTop)
        text=QVBoxLayout(); text.setSpacing(2)
        head=QHBoxLayout(); a=QLabel(app or 'Notification'); a.setObjectName('bApp'); head.addWidget(a, 1)
        close=QToolButton(); close.setObjectName('bClose'); close.setText('✕'); close.setCursor(Qt.PointingHandCursor); close.setAccessibleName('Close notification')
        close.clicked.connect(lambda: self.server.close_bubble(self.nid, 2)); head.addWidget(close)
        text.addLayout(head)
        if summary:
            s=QLabel(summary); s.setObjectName('bSummary'); s.setWordWrap(True); s.setTextFormat(Qt.PlainText); text.addWidget(s)
        if body:
            b=QLabel(body if len(body) < 260 else body[:257]+'…'); b.setObjectName('bBody'); b.setWordWrap(True); b.setTextFormat(Qt.PlainText); text.addWidget(b)
        pairs=[(actions[i], actions[i+1]) for i in range(0, len(actions)-1, 2)]
        buttons=[(k, l) for k, l in pairs if k != 'default'][:3]
        if buttons:
            row=QHBoxLayout(); row.setSpacing(6)
            for key, label in buttons:
                btn=QPushButton(label or key); btn.setCursor(Qt.PointingHandCursor)
                btn.clicked.connect(lambda _=False, k=key: self.server.invoke(self.nid, k)); row.addWidget(btn)
            row.addStretch(); text.addLayout(row)
        text.addStretch(1)
        lay.addLayout(text, 1)
        self.setFixedWidth(self.WIDTH)
        self.timer=QTimer(self); self.timer.setSingleShot(True); self.timer.timeout.connect(lambda: self.server.close_bubble(self.nid, 1))
        self.timeout=timeout
        if timeout > 0: self.timer.start(timeout)
        self.setCursor(Qt.PointingHandCursor)

    def enterEvent(self, e):
        self.timer.stop(); super().enterEvent(e)

    def leaveEvent(self, e):
        if self.timeout > 0: self.timer.start(2500)
        super().leaveEvent(e)

    def mouseReleaseEvent(self, e):
        if e.button() == Qt.LeftButton:
            keys=self.actions[0::2]
            if 'default' in keys: self.server.invoke(self.nid, 'default')
            else: self.server.close_bubble(self.nid, 2)
        super().mouseReleaseEvent(e)

    def show_animated(self):
        translate_tree(self)
        self.setWindowOpacity(0.0); self.show()
        self._fade=fade_in(self, 160)


class NotificationServer(QObject):
    """Eduka-Panel is the notification server of Eduka-Desktop sessions
    (org.freedesktop.Notifications). LXQt's notification daemon is stopped,
    so every notification appears in the Eduka style and goes to the
    history; Do Not Disturb keeps them silent (urgent ones still show)."""
    MAX_VISIBLE=3
    def __init__(self, panel, center):
        super().__init__(panel)
        self.panel=panel; self.center=center
        self.bubbles={}; self.order=[]; self.next_id=1; self.registered=False; self._tries=0
        self.adaptor=NotificationsAdaptor(self)
        self.bus=QDBusConnection.sessionBus()
        if not self.bus.isConnected():
            return
        self.bus.registerObject(NOTIFY_PATH, self)
        self.retry=QTimer(self); self.retry.timeout.connect(self.try_register)
        self.try_register()
        if not self.registered:
            center.start_monitor()
            if in_eduka_session():
                stop_lxqt_notifications_in_eduka_session()
                self.retry.start(400)

    def try_register(self):
        self._tries+=1
        iface=self.bus.interface()
        owner=iface.serviceOwner(NOTIFY_NAME)
        if not (owner.isValid() and owner.value() == self.bus.baseService()):
            iface.registerService(NOTIFY_NAME, QDBusConnectionInterface.ReplaceExistingService, QDBusConnectionInterface.DontAllowReplacement)
            owner=iface.serviceOwner(NOTIFY_NAME)
        was=self.registered
        self.registered=owner.isValid() and owner.value() == self.bus.baseService()
        if self.registered:
            if not was: self.center.stop()
        else:
            if was: self.center.start_monitor()
            if self._tries % 3 == 0 and in_eduka_session():
                stop_lxqt_notifications_in_eduka_session()
        if hasattr(self, 'retry') and in_eduka_session():
            # Quick at first, then keep watching the whole session: LXQt may
            # start its daemon late, or D-Bus may activate it.
            self.retry.setInterval(400 if (not self.registered and self._tries < 15) else (5000 if not self.registered else 15000))
            if not self.retry.isActive(): self.retry.start()

    def notify(self, app, replaces_id, app_icon, summary, body, actions, hints, timeout):
        nid=replaces_id if replaces_id > 0 else self.next_id
        if replaces_id <= 0: self.next_id+=1
        icon=app_icon or str(hints.get('image-path') or hints.get('image_path') or '') or str(hints.get('desktop-entry') or '')
        try: urgency=int(hints.get('urgency', 1))
        except Exception: urgency=1
        item=make_notification(app, icon, summary, body)
        transient=bool(hints.get('transient', False))
        cfg=read_panel_config()
        if item and not transient and cfg.get('notify_history', True):
            self.center.add(item)
        if item is None:
            return nid
        if dnd_enabled() and urgency < 2:
            return nid
        if timeout < 0: timeout=0 if urgency >= 2 else int(max(3, min(30, int(cfg.get('notify_seconds', 7))))*1000)
        elif timeout > 0: timeout=max(2500, min(30000, timeout))
        if nid in self.bubbles:
            self.close_bubble(nid, None)
        bubble=NotificationBubble(self, nid, item['app'], item, item['summary'], item['body'], actions, timeout, urgency >= 2)
        self.bubbles[nid]=bubble; self.order.append(nid)
        while len(self.order) > self.MAX_VISIBLE:
            self.close_bubble(self.order[0], 1)
        bubble.adjustSize(); self.layout_bubbles(); bubble.show_animated()
        return nid

    def layout_bubbles(self):
        full=QApplication.primaryScreen().geometry()
        panel=self.panel; edge=getattr(panel, 'edge', 'Bottom'); shown=panel.isVisible()
        right=full.x()+full.width()-10
        if shown and edge == 'Right': right=panel.x()-10
        x=right-NotificationBubble.WIDTH
        if edge == 'Top':
            top=(panel.y()+panel.height()+8) if shown else full.y()+8
            for nid in reversed(self.order):
                b=self.bubbles.get(nid)
                if b is None: continue
                h=b.sizeHint().height(); b.setGeometry(x, top, NotificationBubble.WIDTH, h); top+=h+4
            return
        bottom=(panel.y()-8) if shown and edge == 'Bottom' else (full.y()+full.height()-10)
        for nid in reversed(self.order):
            b=self.bubbles.get(nid)
            if b is None: continue
            h=b.sizeHint().height()
            b.setGeometry(x, bottom-h, NotificationBubble.WIDTH, h)
            bottom-=h+4

    def close_bubble(self, nid, reason):
        b=self.bubbles.pop(nid, None)
        if nid in self.order: self.order.remove(nid)
        if b is not None:
            b.close()
            self.layout_bubbles()
        if reason is not None and self.registered:
            msg=QDBusMessage.createSignal(NOTIFY_PATH, NOTIFY_NAME, 'NotificationClosed')
            msg.setArguments([_uint(nid), _uint(reason)]); self.bus.send(msg)

    def invoke(self, nid, key):
        if self.registered:
            msg=QDBusMessage.createSignal(NOTIFY_PATH, NOTIFY_NAME, 'ActionInvoked')
            msg.setArguments([_uint(nid), key]); self.bus.send(msg)
        self.close_bubble(nid, 2)


def notification_age(stamp):
    delta=max(0, time.time()-float(stamp or 0))
    if delta < 60: return 'now'
    if delta < 3600: return f'{int(delta//60)} min'
    if delta < 86400: return f'{int(delta//3600)} h'
    return QDateTime.fromSecsSinceEpoch(int(stamp)).toString('d MMM')


class NotificationRow(QFrame):
    """One notification: app icon, summary, body, age and a dismiss button."""
    def __init__(self, item, on_dismiss, parent=None):
        super().__init__(parent)
        self.setObjectName('notifRow')
        lay=QHBoxLayout(self); lay.setContentsMargins(10,8,6,8); lay.setSpacing(10)
        pic=QLabel(); pic.setFixedSize(28,28); pic.setPixmap(notification_icon(item, 26)); lay.addWidget(pic, 0, Qt.AlignTop)
        text=QVBoxLayout(); text.setSpacing(1)
        head=QHBoxLayout(); head.setSpacing(6)
        app=QLabel(item.get('app','')); app.setObjectName('notifApp'); head.addWidget(app, 1)
        age=QLabel(notification_age(item.get('time'))); age.setObjectName('notifAge'); head.addWidget(age)
        text.addLayout(head)
        if item.get('summary'):
            summary=QLabel(item['summary']); summary.setObjectName('notifSummary'); summary.setWordWrap(True); summary.setTextFormat(Qt.PlainText); text.addWidget(summary)
        if item.get('body'):
            body=QLabel(item['body']); body.setObjectName('notifBody'); body.setWordWrap(True); body.setTextFormat(Qt.PlainText); text.addWidget(body)
        lay.addLayout(text, 1)
        close=QToolButton(); close.setObjectName('notifClose'); close.setText('✕'); close.setAccessibleName('Dismiss notification'); close.setCursor(Qt.PointingHandCursor); close.clicked.connect(on_dismiss)
        lay.addWidget(close, 0, Qt.AlignTop)


def notif_qss():
    u=ui_colors()
    return f"""
QFrame#notifRow{{background:{u['tile']};border:1px solid {u['btn_border']};border-radius:12px;}}
QFrame#notifRow:hover{{border:1px solid {u['accent']};}}
QLabel#notifApp{{font-size:11px;font-weight:700;color:{u['sub']};}}
QLabel#notifAge{{font-size:11px;color:{u['sub']};}}
QLabel#notifSummary{{font-size:13px;font-weight:700;color:{u['title']};}}
QLabel#notifBody{{font-size:12px;color:{u['text']};}}
QToolButton#notifClose{{background:transparent;border:0;border-radius:10px;padding:2px 6px;color:{u['sub']};}}
QToolButton#notifClose:hover{{background:{u['btn_hover']};color:{u['title']};}}
QPushButton#linkButton{{background:transparent;border:0;padding:3px 6px;color:{u['accent']};font-weight:700;}}
QPushButton#primaryButton{{background:{u['accent']};color:#ffffff;border:1px solid {u['accent_border']};}}
QPushButton#primaryButton:hover{{background:{u['accent_hover']};}}
QProgressBar#driveBar{{background:{u['groove']};border:0;border-radius:3px;}}
QProgressBar#driveBar::chunk{{background:{u['accent']};border-radius:3px;}}
QPushButton#linkButton:hover{{text-decoration:underline;background:transparent;border:0;}}
"""


class NotificationPopup(PopupFrame):
    """Notification history: newest first, dismiss one or clear all."""
    def __init__(self, panel):
        super().__init__(panel)
        self.panel=panel; self.center=panel.notifications
        self.setAccessibleName('Notifications')
        self.box.setFixedWidth(360)
        self.setStyleSheet(self.styleSheet()+notif_qss())
        row, self.pic, self.sub=popup_header('preferences-system-notifications', 'Notifications', '')
        self.dnd=QPushButton(tr('dnd')); self.dnd.setObjectName('switch'); self.dnd.setCheckable(True); self.dnd.setChecked(dnd_enabled())
        self.dnd.toggled.connect(lambda on: (save_panel_state(dnd=bool(on)), panel.update_notification_badge()))
        row.addWidget(self.dnd)
        self.v.addLayout(row)
        self.list_widget=QWidget(); self.list_layout=QVBoxLayout(self.list_widget); self.list_layout.setContentsMargins(0,0,4,0); self.list_layout.setSpacing(6)
        self.scroll=QScrollArea(); self.scroll.setWidgetResizable(True); self.scroll.setFrameShape(QFrame.NoFrame); self.scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff); self.scroll.setWidget(self.list_widget)
        self.v.addWidget(self.scroll)
        foot=QHBoxLayout()
        settings=QPushButton('Settings'); settings.setObjectName('linkButton'); settings.clicked.connect(lambda: (self.close(), launch_app('eduka-settings --page notifications')))
        self.clear_button=QPushButton('Clear all'); self.clear_button.setObjectName('linkButton'); self.clear_button.clicked.connect(self.center.clear)
        foot.addWidget(settings); foot.addStretch(); foot.addWidget(self.clear_button)
        self.v.addLayout(foot)
        self.center.changed.connect(self.fill)
        self.fill(); self.center.mark_read()

    def fill(self):
        while self.list_layout.count():
            item=self.list_layout.takeAt(0); w=item.widget()
            if w: w.setParent(None); w.deleteLater()
        items=self.center.items
        self.sub.setText(f'{len(items)} notification{"s" if len(items) != 1 else ""}' if items else tr('no_notif'))
        self.clear_button.setEnabled(bool(items))
        if not items:
            empty=QLabel(tr('no_notif')); empty.setAlignment(Qt.AlignCenter); empty.setObjectName('popHint'); empty.setMinimumHeight(70)
            self.list_layout.addWidget(empty)
        for i, item in enumerate(items[:20]):
            self.list_layout.addWidget(NotificationRow(item, lambda _=False, idx=i: self.center.remove(idx)))
        self.list_layout.addStretch()
        self.list_widget.adjustSize()
        self.scroll.setFixedHeight(min(380, max(80, self.list_layout.sizeHint().height()+4)))


# ---------------------------------------------------------------------------
# Action Center
# ---------------------------------------------------------------------------

class ClockFace(QWidget):
    """The Action Center clock: digital, analog or LED (seven segments in a
    chosen color), with optional seconds and a blinking colon. Drawn with
    QPainter, so it costs nothing while the Action Center is closed."""
    clicked=pyqtSignal()
    SEGMENTS={'0':'abcfed','1':'bc','2':'abged','3':'abgcd','4':'fgbc','5':'afgcd','6':'afgedc','7':'abc','8':'abcdefg','9':'abcdfg',' ':''}

    def __init__(self, parent=None):
        super().__init__(parent)
        self.opts=clock_options(); self.big=True
        u=ui_colors(); self.ink=qcolor(u['title']); self.sub=qcolor(u['sub']); self.accent=qcolor(u['accent']); self.face=qcolor(u['cal'])
        self.setCursor(Qt.PointingHandCursor)
        self.setToolTip('Click: world globe • Right-click: clock style')
        self.setAccessibleName('Clock')

    def set_options(self, opts, big):
        self.opts=dict(opts); self.big=big
        u=ui_colors(); chosen=self.opts.get('color')
        self.ink=QColor(chosen) if chosen else qcolor(u['title'])
        self.accent=QColor(chosen) if chosen else qcolor(u['accent'])
        self.setFixedSize(self.sizeHint()); self.update()

    def sizeHint(self):
        style=self.opts['style']; secs=self.opts['seconds']; twelve=self.opts['format'] == '12h'
        if style == 'analog':
            d=132 if self.big else 64
            return QSize(d, d)
        h=60 if self.big else 42
        chars=(8 if secs else 5)
        w=int(h*0.62*chars) + (int(h*0.9) if twelve else 0)
        if style == 'led': w=int(w*1.05)+12
        return QSize(min(330, w), h+(8 if style == 'led' else 0))

    def mouseReleaseEvent(self, e):
        if e.button() == Qt.LeftButton and self.rect().contains(e.pos()):
            self.clicked.emit()
        super().mouseReleaseEvent(e)

    def text_parts(self):
        now=QTime.currentTime(); o=self.opts
        colon=':' if (not o['blink'] or now.second() % 2 == 0) else ' '
        if o['format'] == '12h':
            t=now.toString('hh:mm:ss' if o['seconds'] else 'hh:mm'); ap=now.toString('AP')
            if t.startswith('0'): t=' '+t[1:]
        else:
            t=now.toString('HH:mm:ss' if o['seconds'] else 'HH:mm'); ap=''
        return t.replace(':', colon), ap

    def paintEvent(self, e):
        p=QPainter(self); p.setRenderHint(QPainter.Antialiasing)
        style=self.opts['style']
        if style == 'analog': self.paint_analog(p)
        elif style == 'led': self.paint_led(p)
        else: self.paint_digital(p)

    def paint_digital(self, p):
        t, ap=self.text_parts()
        f=QFont(self.font()); f.setPixelSize(int(self.height()*0.78)); f.setBold(True)
        f.setStyleHint(QFont.Monospace); f.setFamilies(['DejaVu Sans Mono', 'Noto Sans Mono', 'Monospace'])
        p.setFont(f); p.setPen(self.ink)
        fm=QFontMetrics(f); tw=fm.horizontalAdvance(t)
        if ap:
            f2=QFont(f); f2.setPixelSize(int(self.height()*0.3)); fm2=QFontMetrics(f2); total=tw+6+fm2.horizontalAdvance(ap)
        else:
            total=tw
        x=(self.width()-total)/2; base=(self.height()+fm.ascent()-fm.descent())/2
        p.drawText(QPointF(x, base), t)
        if ap:
            p.setFont(f2); p.setPen(self.accent); p.drawText(QPointF(x+tw+6, base), ap)

    def paint_led(self, p):
        t, ap=self.text_parts()
        color=QColor(self.opts['led_color']); off=QColor(color); off.setAlpha(22)
        # No panel behind the digits: the segments float on the card.
        h=self.height()-16; dw=h*0.52; gap=h*0.16; colw=h*0.22
        widths=[colw if ch in ': ' and i in (2, 5) else dw for i, ch in enumerate(t)]
        total=sum(widths)+gap*(len(t)-1)+(h*0.7 if ap else 0)
        x=(self.width()-total)/2; y=8
        for i, ch in enumerate(t):
            if i in (2, 5):
                # colon position (blinks when ' ')
                c=color if ch == ':' else off
                p.setPen(Qt.NoPen); p.setBrush(c); d=h*0.11
                p.drawEllipse(QPointF(x+colw/2, y+h*0.32), d, d); p.drawEllipse(QPointF(x+colw/2, y+h*0.70), d, d)
            else:
                self.seven(p, ch, x, y, dw, h, color, off)
            x+=widths[i]+gap
        if ap:
            f=QFont(self.font()); f.setPixelSize(int(h*0.3)); f.setBold(True); p.setFont(f); p.setPen(color)
            p.drawText(QRectF(x, y, h*0.7, h), Qt.AlignVCenter | Qt.AlignLeft, ap)

    def seven(self, p, ch, x, y, w, h, on, off):
        lit=self.SEGMENTS.get(ch, '')
        t=max(2.5, w*0.17); hh=h/2
        segs={'a': QRectF(x+t*0.6, y, w-t*1.2, t), 'g': QRectF(x+t*0.6, y+hh-t/2, w-t*1.2, t), 'd': QRectF(x+t*0.6, y+h-t, w-t*1.2, t),
              'f': QRectF(x, y+t*0.6, t, hh-t*0.9), 'b': QRectF(x+w-t, y+t*0.6, t, hh-t*0.9),
              'e': QRectF(x, y+hh+t*0.3, t, hh-t*0.9), 'c': QRectF(x+w-t, y+hh+t*0.3, t, hh-t*0.9)}
        p.setPen(Qt.NoPen)
        for name, rect in segs.items():
            p.setBrush(on if name in lit else off); p.drawRoundedRect(rect, t/2, t/2)

    def paint_analog(self, p):
        now=QTime.currentTime(); side=min(self.width(), self.height())
        p.translate(self.width()/2, self.height()/2); p.scale(side/200.0, side/200.0)
        p.setPen(QPen(self.accent, 5)); p.setBrush(self.face); p.drawEllipse(QPointF(0,0), 94, 94)
        for i in range(60):
            p.save(); p.rotate(i*6)
            if i % 5 == 0:
                p.setPen(QPen(self.ink, 4, Qt.SolidLine, Qt.RoundCap)); p.drawLine(QPointF(0,-80), QPointF(0,-70))
            elif self.big:
                p.setPen(QPen(self.sub, 1.5, Qt.SolidLine, Qt.RoundCap)); p.drawLine(QPointF(0,-80), QPointF(0,-76))
            p.restore()
        def hand(angle, length, width, color):
            p.save(); p.rotate(angle); p.setPen(QPen(color, width, Qt.SolidLine, Qt.RoundCap)); p.drawLine(QPointF(0, 12), QPointF(0, -length)); p.restore()
        hand(30.0*((now.hour()%12)+now.minute()/60.0), 46, 7, self.ink)
        hand(6.0*(now.minute()+now.second()/60.0), 66, 5, self.ink)
        if self.opts['seconds'] or self.big:
            hand(6.0*now.second(), 72, 2, QColor('#e5484d') if self.opts.get('color') else self.accent)
        p.setPen(Qt.NoPen); p.setBrush(self.accent); p.drawEllipse(QPointF(0,0), 6, 6)


class WeatherWorker(QThread):
    """Fetch the weather without blocking Eduka-Panel."""
    ready=pyqtSignal(object)
    def run(self):
        try:
            self.ready.emit(fetch_weather())
        except Exception:
            self.ready.emit(None)


class WeatherBackdrop(QWidget):
    """Background of the clock card: a small animated sky for the weather
    of today — sun with turning rays, a moon and stars at night, drifting
    clouds with a friendly face, rain, drizzle, snow, fog or lightning."""
    def __init__(self, parent=None):
        super().__init__(parent)
        self.weather=None; self.t=0.0
        self.timer=QTimer(self); self.timer.setInterval(40); self.timer.timeout.connect(self.tick)
        rnd=__import__('random').Random(7)
        self.drops=[(rnd.random(), rnd.random(), 0.7+rnd.random()*0.6) for _ in range(46)]
        self.stars=[(rnd.random(), rnd.random()*0.6, rnd.random()*6.28) for _ in range(18)]
        u=ui_colors(); self.dark=is_dark_theme(); self.ink=qcolor(u['sub'])

    def set_weather(self, w):
        self.weather=w; self.update(); self.sync_timer()
        # The weather chip gets its own line at the bottom of the card.
        lay=self.layout()
        if lay is not None: lay.setContentsMargins(12, 10, 12, 30 if w else 12)
        tip=weather_summary(w)
        self.setToolTip(tip)

    def sync_timer(self):
        if self.weather and self.isVisible() and not self.timer.isActive(): self.timer.start()
        elif not (self.weather and self.isVisible()): self.timer.stop()

    def showEvent(self, e): self.sync_timer(); super().showEvent(e)
    def hideEvent(self, e): self.timer.stop(); super().hideEvent(e)

    def tick(self):
        self.t+=0.04; self.update()

    def paintEvent(self, e):
        w=self.weather
        if not w: return
        p=QPainter(self); p.setRenderHint(QPainter.Antialiasing)
        W=self.width(); H=self.height(); kind=w.get('kind', 'clear'); day=bool(w.get('is_day', True)); t=self.t
        clip=QPainterPath(); clip.addRoundedRect(QRectF(1, 1, W-2, H-2), 17, 17); p.setClipPath(clip)
        # Soft sky tint so the clock stays easy to read.
        g=QLinearGradient(0, 0, 0, H)
        if not day:
            g.setColorAt(0, QColor(40, 52, 110, 70 if not self.dark else 120)); g.setColorAt(1, QColor(40, 52, 110, 10))
        elif kind in ('rain', 'drizzle', 'thunder', 'cloudy', 'fog'):
            g.setColorAt(0, QColor(120, 140, 160, 60)); g.setColorAt(1, QColor(120, 140, 160, 8))
        else:
            g.setColorAt(0, QColor(120, 200, 255, 60)); g.setColorAt(1, QColor(255, 236, 170, 25))
        p.fillRect(self.rect(), g)
        sx, sy = W-24, 22   # sun and moon peek in at the top right corner
        if not day:
            for x, y, ph in self.stars:
                a=int(90+80*math.sin(t*2+ph)); p.setPen(Qt.NoPen); p.setBrush(QColor(255, 244, 200, max(0, a))); p.drawEllipse(QPointF(x*W, 6+y*H*0.6), 1.3, 1.3)
            p.setBrush(QColor(255, 236, 170, 230)); p.drawEllipse(QPointF(sx, sy), 15, 15)
            p.setBrush(QColor(60, 72, 130, 255) if self.dark else QColor(225, 230, 245, 255)); p.drawEllipse(QPointF(sx+7, sy-5), 13, 13)
        elif kind in ('clear', 'partly'):
            p.save(); p.translate(sx, sy); p.rotate(t*12)
            p.setPen(QPen(QColor(255, 190, 40, 200), 3, Qt.SolidLine, Qt.RoundCap))
            for i in range(10):
                p.drawLine(QPointF(0, 21), QPointF(0, 27+2*math.sin(t*3+i))); p.rotate(36)
            p.restore()
            p.setPen(Qt.NoPen); p.setBrush(QColor(255, 200, 50, 240)); p.drawEllipse(QPointF(sx, sy), 16, 16)
            # A little smile on the sun.
            p.setBrush(QColor(120, 70, 0, 200)); p.drawEllipse(QPointF(sx-5, sy-3), 1.8, 1.8); p.drawEllipse(QPointF(sx+5, sy-3), 1.8, 1.8)
            p.setPen(QPen(QColor(120, 70, 0, 200), 1.6, Qt.SolidLine, Qt.RoundCap)); p.setBrush(Qt.NoBrush)
            p.drawArc(QRectF(sx-5, sy-2, 10, 7), 200*16, 140*16)
        clouds={'partly': 1, 'cloudy': 3, 'fog': 1, 'drizzle': 2, 'rain': 3, 'snow': 2, 'thunder': 3}.get(kind, 0)
        dark_cloud=kind in ('rain', 'thunder')
        for i in range(clouds):
            speed=6+i*3; cw=58-i*8
            x=((t*speed+i*137) % (W+cw*2))-cw; y=10+i*16
            self.cloud(p, x, y, cw, dark_cloud, face=(i == 0))
        if kind in ('rain', 'thunder', 'drizzle'):
            small=kind == 'drizzle'; n=22 if small else 46
            p.setPen(QPen(QColor(70, 140, 230, 170 if not small else 140), 1.3 if small else 1.8, Qt.SolidLine, Qt.RoundCap))
            for x, y, sp in self.drops[:n]:
                yy=((y+t*sp*(0.45 if small else 0.9)) % 1.0)*(H-24)+24; xx=x*W-(yy-24)*0.18
                p.drawLine(QPointF(xx, yy), QPointF(xx-1.5, yy+(3 if small else 7)))
        if kind == 'snow':
            p.setPen(Qt.NoPen); p.setBrush(QColor(255, 255, 255, 230) if self.dark else QColor(150, 180, 220, 220))
            for x, y, sp in self.drops[:30]:
                yy=((y+t*sp*0.18) % 1.0)*(H-20)+20; xx=x*W+6*math.sin(t*1.5+y*9)
                p.drawEllipse(QPointF(xx, yy), 2.2, 2.2)
        if kind == 'fog':
            p.setPen(Qt.NoPen)
            for i in range(4):
                y=H*0.35+i*14; off=math.sin(t*0.6+i)*20
                p.setBrush(QColor(170, 180, 190, 70)); p.drawRoundedRect(QRectF(-20+off+i*15, y, W*0.8, 7), 3.5, 3.5)
        if kind == 'thunder':
            phase=(t*0.5) % 4.0
            if phase < 0.18:
                p.fillRect(self.rect(), QColor(255, 255, 230, int(120*(1-phase/0.18))))
                bolt=QPolygonF([QPointF(W*0.62, 30), QPointF(W*0.56, 52), QPointF(W*0.61, 52), QPointF(W*0.55, 76), QPointF(W*0.68, 46), QPointF(W*0.63, 46), QPointF(W*0.68, 30)])
                p.setPen(Qt.NoPen); p.setBrush(QColor(255, 210, 40, 230)); p.drawPolygon(bolt)
        # Small chip: temperature and place.
        text=weather_chip(w)
        f=QFont(self.font()); f.setPixelSize(11); f.setBold(True); p.setFont(f); fm=QFontMetrics(f)
        tw=fm.horizontalAdvance(text)+16; r=QRectF(W-tw-8, H-24, tw, 18)
        p.setPen(Qt.NoPen); p.setBrush(QColor(255, 255, 255, 170) if not self.dark else QColor(0, 0, 0, 110)); p.drawRoundedRect(r, 9, 9)
        p.setPen(self.ink); p.drawText(r, Qt.AlignCenter, text)

    def cloud(self, p, x, y, w, dark, face=False):
        c=QColor(150, 160, 175, 210) if dark else QColor(255, 255, 255, 235)
        edge=QColor(120, 130, 150, 120)
        path=QPainterPath(); h=w*0.42
        path.addRoundedRect(QRectF(x, y+h*0.45, w, h*0.55), h*0.27, h*0.27)
        path.addEllipse(QRectF(x+w*0.12, y+h*0.12, w*0.42, h*0.75)); path.addEllipse(QRectF(x+w*0.40, y, w*0.45, h*0.85))
        path=path.simplified()
        p.setPen(QPen(edge, 1)); p.setBrush(c); p.drawPath(path)
        if face:
            p.setPen(Qt.NoPen); p.setBrush(QColor(70, 80, 100, 200))
            p.drawEllipse(QPointF(x+w*0.42, y+h*0.62), 1.6, 1.6); p.drawEllipse(QPointF(x+w*0.62, y+h*0.62), 1.6, 1.6)
            p.setPen(QPen(QColor(70, 80, 100, 200), 1.3, Qt.SolidLine, Qt.RoundCap)); p.setBrush(Qt.NoBrush)
            p.drawArc(QRectF(x+w*0.46, y+h*0.62, w*0.12, h*0.22), 200*16, 140*16)
            p.setPen(Qt.NoPen); p.setBrush(QColor(255, 140, 160, 120))
            p.drawEllipse(QPointF(x+w*0.34, y+h*0.75), 2.4, 1.6); p.drawEllipse(QPointF(x+w*0.70, y+h*0.75), 2.4, 1.6)


WEATHER_ICON = {'clear': '☀', 'partly': '⛅', 'cloudy': '☁', 'fog': '🌫', 'drizzle': '🌦', 'rain': '🌧', 'snow': '❄', 'thunder': '⛈'}

def weather_chip(w):
    icon=WEATHER_ICON.get(w.get('kind'), '☁')
    if not w.get('is_day', True) and w.get('kind') in ('clear', 'partly'): icon='☾'
    return f"{icon} {round(w.get('temp', 0))}°  {w.get('city', '')}".strip()

def weather_summary(w):
    if not w: return ''
    rng=''
    if w.get('tmin') is not None and w.get('tmax') is not None:
        rng=f" • {round(w['tmin'])}° – {round(w['tmax'])}°"
    return f"{_(WEATHER_TEXT.get(w.get('kind'), 'Cloudy'))}, {round(w.get('temp', 0))}°C{rng} • {w.get('city', '')}\n" + _('Weather: Open-Meteo (open source)')


WORLD_MAP = Path('/usr/share/edukasaun-desktop/assets/world-map.png')
if not WORLD_MAP.exists():
    WORLD_MAP=Path(__file__).resolve().parents[1]/'share'/'edukasaun-desktop'/'assets'/'world-map.png'

# Cities shown on the time zone map (name, zone).
WORLD_CITIES = [('Dili', 'Asia/Dili'), ('Jakarta', 'Asia/Jakarta'), ('Manila', 'Asia/Manila'), ('Bangkok', 'Asia/Bangkok'),
                ('Beijing', 'Asia/Shanghai'), ('Tokyo', 'Asia/Tokyo'), ('Sydney', 'Australia/Sydney'), ('Lisbon', 'Europe/Lisbon'),
                ('London', 'Europe/London'), ('New York', 'America/New_York'), ('São Paulo', 'America/Sao_Paulo'), ('Nairobi', 'Africa/Nairobi')]


class TimeZoneMap(QWidget):
    """Flat world map with the 24 time zones: night side shaded, the zone
    of this computer highlighted, a pulsing dot at its city and the time of
    other cities (daylight saving follows each country's rules)."""
    clicked=pyqtSignal()
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setFixedSize(340, 178); self.setCursor(Qt.PointingHandCursor); self.setMouseTracking(True)
        img=QImage(str(WORLD_MAP)) if WORLD_MAP.exists() else QImage()
        self.map=img.scaled(340, 170, Qt.IgnoreAspectRatio, Qt.SmoothTransformation) if not img.isNull() else QImage()
        self.zone=local_timezone_name(); self.pulse=0.0
        u=ui_colors(); self.accent=qcolor(u['accent']); self.ink=qcolor(u['title'])
        self.timer=QTimer(self); self.timer.setInterval(60); self.timer.timeout.connect(self.tick)
        self.setToolTip(_('Click to go back to the clock'))

    def showEvent(self, e): self.timer.start(); super().showEvent(e)
    def hideEvent(self, e): self.timer.stop(); super().hideEvent(e)
    def tick(self): self.pulse=(self.pulse+0.05) % 1.0; self.update()

    def xy(self, lat, lon):
        return QPointF((lon+180.0)/360.0*340, 4+(90.0-lat)/180.0*170)

    def mouseReleaseEvent(self, e):
        if e.button() == Qt.LeftButton: self.clicked.emit()
        super().mouseReleaseEvent(e)

    def mouseMoveEvent(self, e):
        # Hover a city dot: its local time.
        for city, zone in WORLD_CITIES:
            pos=zone_position(zone)
            if pos and (self.xy(pos[0], pos[1])-QPointF(e.pos())).manhattanLength() < 9:
                z=zone_info(zone); dst=' • '+_('daylight saving time') if z['dst_now'] else ''
                QToolTip.showText(e.globalPos(), f"{city}: {z['local'].strftime('%H:%M')} ({z['offset']}{dst})", self); return
        QToolTip.hideText()
        super().mouseMoveEvent(e)

    def paintEvent(self, e):
        p=QPainter(self); p.setRenderHint(QPainter.Antialiasing)
        clip=QPainterPath(); clip.addRoundedRect(QRectF(0, 4, 340, 170), 12, 12); p.setClipPath(clip)
        if not self.map.isNull(): p.drawImage(QPointF(0, 4), self.map)
        else: p.fillRect(QRectF(0, 4, 340, 170), QColor('#1b507c'))
        # Night side (terminator from the sun's position).
        decl, slon=sun_position()
        night=QPainterPath(); td=math.tan(math.radians(decl)) or 1e-6
        pts=[]
        for i in range(0, 341, 4):
            lon=i/340.0*360-180
            lat=math.degrees(math.atan(-math.cos(math.radians(lon-slon))/td))
            pts.append(self.xy(lat, lon))
        edge=4+170 if decl > 0 else 4
        night.moveTo(pts[0]);
        for q in pts[1:]: night.lineTo(q)
        night.lineTo(QPointF(340, edge)); night.lineTo(QPointF(0, edge)); night.closeSubpath()
        p.setPen(Qt.NoPen); p.setBrush(QColor(5, 12, 40, 110)); p.drawPath(night)
        # Time zone bands every 15 degrees; this computer's zone in the accent color.
        z=zone_info(self.zone); hours=z['hours']
        band=QColor(self.accent); band.setAlpha(70)
        x0=(hours*15+180-7.5)/360*340
        p.setBrush(band); p.drawRect(QRectF(x0, 4, 340/24.0, 170))
        p.setPen(QPen(QColor(255, 255, 255, 45), 1))
        for k in range(25):
            x=(k*15-7.5)/360*340; p.drawLine(QPointF(x, 4), QPointF(x, 174))
        f=QFont(self.font()); f.setPixelSize(8); f.setBold(True); p.setFont(f)
        utc=QDateTime.currentDateTimeUtc()
        for k in range(-12, 13, 3):
            x=(k*15+180)/360*340; t=utc.addSecs(k*3600).toString('HH')
            p.setPen(QColor(255, 255, 255, 200)); p.drawText(QRectF(x-10, 6, 20, 10), Qt.AlignCenter, t)
        # Cities.
        f.setPixelSize(8); f.setBold(False); p.setFont(f)
        for city, zone in WORLD_CITIES:
            pos=zone_position(zone)
            if not pos: continue
            q=self.xy(pos[0], pos[1]); p.setPen(Qt.NoPen); p.setBrush(QColor(255, 255, 255, 210)); p.drawEllipse(q, 1.8, 1.8)
        # This computer: pulsing dot.
        pos=zone_position(self.zone)
        if pos:
            q=self.xy(pos[0], pos[1]); r=4+10*self.pulse
            ring=QColor(self.accent); ring.setAlphaF(max(0.0, 0.8*(1-self.pulse)))
            p.setPen(QPen(ring, 2)); p.setBrush(Qt.NoBrush); p.drawEllipse(q, r, r)
            p.setPen(QPen(QColor('#ffffff'), 1.5)); p.setBrush(self.accent); p.drawEllipse(q, 4.5, 4.5)




def sun_position(utc=None):
    """(declination, subsolar longitude) in degrees for a UTC QDateTime."""
    utc=utc or QDateTime.currentDateTimeUtc()
    n=utc.date().dayOfYear(); hours=utc.time().hour()+utc.time().minute()/60.0+utc.time().second()/3600.0
    decl=-23.44*math.cos(2*math.pi/365.0*(n+10))
    b=2*math.pi*(n-81)/364.0
    eot=9.87*math.sin(2*b)-7.53*math.cos(b)-1.5*math.sin(b)       # minutes
    lon=-15.0*(hours-12.0+eot/60.0)
    return decl, ((lon+180) % 360)-180


class GlobeWidget(QWidget):
    """A small rotating Earth with day and night. Drag to spin it; it keeps
    turning slowly by itself. Rendered from an equirectangular map with a
    per-row lookup (pure Python, no extra libraries)."""
    clicked=pyqtSignal()
    def __init__(self, diameter=210, parent=None):
        super().__init__(parent)
        self.d=diameter; self.setFixedSize(diameter+16, diameter+16)
        self.setCursor(Qt.OpenHandCursor); self.setToolTip('Drag to turn the Earth • click to go back to the clock')
        self.lon0=sun_position()[1]+30.0      # start with the day side in view
        self._drag=None; self._moved=False; self._vel=0.0; self._last=None
        self.map=QImage(str(WORLD_MAP)).convertToFormat(QImage.Format_RGB32) if WORLD_MAP.exists() else QImage()
        self.tex=None; self.tex_stamp=None
        self._build_lookup()
        self.timer=QTimer(self); self.timer.timeout.connect(self.tick)

    def showEvent(self, e):
        self.timer.start(50); super().showEvent(e)

    def hideEvent(self, e):
        self.timer.stop(); super().hideEvent(e)

    def _build_lookup(self):
        """For each screen row (a latitude) the map columns of its pixels,
        relative to the centre longitude."""
        R=self.d/2.0; self.rows=[]
        W=self.map.width() or 1024; H=self.map.height() or 512; self.W=W; self.H=H
        for y in range(self.d):
            yy=R-(y+0.5)
            if abs(yy) >= R: self.rows.append(None); continue
            lat=math.asin(yy/R); half=math.sqrt(R*R-yy*yy)
            x0=int(math.ceil(R-half)); x1=int(math.floor(R+half))
            if x1 <= x0: self.rows.append(None); continue
            coslat=math.cos(lat) or 1e-6
            cols=[]
            for x in range(x0, x1):
                v=max(-1.0, min(1.0, (x+0.5-R)/(R*coslat)))
                cols.append(int(round(math.degrees(math.asin(v))/360.0*W)) + W//4)
            ty=min(H-1, max(0, int((90-math.degrees(lat))/180.0*H)))
            self.rows.append((x0, ty, itemgetter(*cols) if len(cols) > 1 else (lambda seq, c=cols[0]: (seq[c],))))

    def _texture(self):
        """Map with the night side darkened (redrawn once a minute)."""
        stamp=QDateTime.currentDateTimeUtc().toString('yyyyMMddhhmm')
        if self.tex is not None and stamp == self.tex_stamp:
            return self.tex
        img=QImage(self.map) if not self.map.isNull() else QImage(self.W, self.H, QImage.Format_RGB32)
        if self.map.isNull(): img.fill(QColor('#1f6fa8'))
        decl, slon=sun_position()
        p=QPainter(img); p.setRenderHint(QPainter.Antialiasing); p.setPen(Qt.NoPen)
        dec=math.radians(decl if abs(decl) > 0.2 else 0.2)
        for shift, alpha in ((6, 60), (0, 70), (-6, 60)):
            pts=[]
            for i in range(0, 361, 3):
                lon=-180+i; lat=math.degrees(math.atan(-math.cos(math.radians(lon-slon))/math.tan(dec)))+shift*(1 if decl > 0 else -1)
                pts.append(QPointF((lon+180)/360.0*self.W, (90-lat)/180.0*self.H))
            if decl > 0: pts+= [QPointF(self.W, self.H), QPointF(0, self.H)]
            else: pts+= [QPointF(self.W, 0), QPointF(0, 0)]
            p.setBrush(QColor(4, 10, 32, alpha)); p.drawPolygon(QPolygonF(pts))
        p.end()
        # Doubled rows let a plain slice handle the wrap at 180 degrees.
        self.tex=img; self.tex_stamp=stamp
        ptr=img.constBits(); ptr.setsize(img.sizeInBytes())
        self.tex_rows=[]
        raw=memoryview(bytes(ptr)).cast('I')
        for ty in range(self.H):
            row=array('I', raw[ty*self.W:(ty+1)*self.W])
            self.tex_rows.append(row+row)
        return img

    def render(self):
        self._texture()
        d=self.d; W=self.W
        out=array('I', bytes(4*d*d))
        start=int(((self.lon0+180.0)/360.0)*W - W//4) % W
        for y, row in enumerate(self.rows):
            if row is None: continue
            x0, ty, getter=row
            vals=getter(self.tex_rows[ty][start:start+W//2+2])
            out[y*d+x0:y*d+x0+len(vals)]=array('I', vals)
        self._buf=out.tobytes()
        return QImage(self._buf, d, d, 4*d, QImage.Format_ARGB32_Premultiplied)

    def paintEvent(self, e):
        p=QPainter(self); p.setRenderHint(QPainter.Antialiasing); p.setRenderHint(QPainter.SmoothPixmapTransform)
        c=QPointF(self.width()/2, self.height()/2); R=self.d/2.0
        glow=QRadialGradient(c, R+8); glow.setColorAt(0.85, QColor(80,170,255,90)); glow.setColorAt(1.0, QColor(80,170,255,0))
        p.setPen(Qt.NoPen); p.setBrush(glow); p.drawEllipse(c, R+8, R+8)
        p.drawImage(QPointF(c.x()-R, c.y()-R), self.render())
        shade=QRadialGradient(QPointF(c.x()-R*0.35, c.y()-R*0.4), R*1.5)
        shade.setColorAt(0.0, QColor(255,255,255,40)); shade.setColorAt(0.55, QColor(255,255,255,0)); shade.setColorAt(1.0, QColor(0,0,0,90))
        p.setBrush(shade); p.drawEllipse(c, R, R)
        p.setPen(QPen(QColor(150,210,255,140), 1.6)); p.setBrush(Qt.NoBrush); p.drawEllipse(c, R, R)

    def tick(self):
        if self._drag is None:
            if abs(self._vel) > 0.05: self._vel*=0.94
            else: self._vel=0.0
            self.lon0+=0.35+self._vel
            self.update()

    def mousePressEvent(self, e):
        if e.button() == Qt.LeftButton:
            self._drag=e.pos().x(); self._last=(e.pos().x(), time.monotonic()); self._moved=False
            self.setCursor(Qt.ClosedHandCursor)

    def mouseMoveEvent(self, e):
        if self._drag is not None:
            dx=e.pos().x()-self._last[0]
            if abs(e.pos().x()-self._drag) > 3: self._moved=True
            self.lon0-=dx*180.0/self.d; self._vel=-dx*180.0/self.d*0.5
            self._last=(e.pos().x(), time.monotonic()); self.update()

    def mouseReleaseEvent(self, e):
        if self._drag is not None:
            self._drag=None; self.setCursor(Qt.OpenHandCursor)
            if not self._moved: self.clicked.emit()

    def wheelEvent(self, e):
        self.lon0+=e.angleDelta().y()/12.0; self.update()


def media_icon(kind, color, size=28):
    """Play, pause, previous and next drawn in one style (icon themes mix
    styles and sizes)."""
    pix=QPixmap(size*2, size*2); pix.fill(Qt.transparent)
    p=QPainter(pix); p.setRenderHint(QPainter.Antialiasing); p.scale(2, 2)
    p.setPen(Qt.NoPen); p.setBrush(QColor(color)); s=size
    def tri(x0, flip=False):
        w=s*0.30; h=s*0.36; y=(s-h)/2
        pts=[QPointF(x0, y), QPointF(x0, y+h), QPointF(x0+w, y+h/2)] if not flip else [QPointF(x0+w, y), QPointF(x0+w, y+h), QPointF(x0, y+h/2)]
        p.drawPolygon(QPolygonF(pts))
    if kind == 'play':
        w=s*0.34; h=s*0.40; x=(s-w)/2+s*0.04; y=(s-h)/2
        path=QPainterPath(); path.moveTo(x, y); path.lineTo(x, y+h); path.lineTo(x+w, y+h/2); path.closeSubpath()
        p.drawPath(path)
    elif kind == 'pause':
        w=s*0.11; h=s*0.38; y=(s-h)/2
        p.drawRoundedRect(QRectF(s*0.33, y, w, h), w/2.5, w/2.5); p.drawRoundedRect(QRectF(s*0.56, y, w, h), w/2.5, w/2.5)
    elif kind in ('next', 'prev'):
        flip=kind == 'prev'
        x0=s*0.24
        tri(x0 if not flip else s*0.40, flip); tri(s*0.40 if not flip else x0, flip)
        bar=QRectF(s*0.70, s*0.32, s*0.07, s*0.36) if not flip else QRectF(s*0.23, s*0.32, s*0.07, s*0.36)
        p.drawRoundedRect(bar, 1, 1)
    p.end(); pix.setDevicePixelRatio(2)
    return QIcon(pix)


def raise_application(pid=None, player=None):
    """Bring the window of a playing application to the front: MPRIS
    Raise() first, then the window that belongs to the process."""
    if player:
        safe_popen(['dbus-send','--session','--type=method_call',f'--dest={player}','/org/mpris/MediaPlayer2','org.mpris.MediaPlayer2.Raise'])
    pids=set()
    try:
        if pid:
            pids.add(str(int(pid)))
            # Browsers play sound in a child process: also try its parents.
            cur=str(int(pid))
            for _ in range(4):
                stat=Path(f'/proc/{cur}/stat').read_text().rsplit(')', 1)[1].split()
                cur=stat[1]
                if cur in ('0', '1'): break
                pids.add(cur)
    except Exception:
        pass
    if not pids:
        return
    out=_run_text(['wmctrl','-lp'], timeout=1.5) or ''
    for line in out.splitlines():
        parts=line.split(None, 4)
        if len(parts) >= 3 and parts[2] in pids:
            safe_popen(['wmctrl','-ia',parts[0]]); return


class MarqueeLabel(QWidget):
    """One line of text that scrolls slowly when it is too long."""
    def __init__(self, parent=None):
        super().__init__(parent)
        self.text=''; self.offset=0.0; self.pause=60
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
        self.timer=QTimer(self); self.timer.timeout.connect(self.step)

    def setText(self, text):
        text=str(text or '')
        if text != self.text:
            self.text=text; self.offset=0.0; self.pause=60; self.update()
        self.setAccessibleName(text)
        self.check()

    def sizeHint(self):
        return QSize(120, self.fontMetrics().height()+2)

    def check(self):
        long_text=self.fontMetrics().horizontalAdvance(self.text) > self.width()
        if long_text and self.isVisible() and not self.timer.isActive(): self.timer.start(40)
        if not long_text: self.timer.stop(); self.offset=0.0

    def resizeEvent(self, e): self.check(); super().resizeEvent(e)
    def showEvent(self, e): self.check(); super().showEvent(e)
    def hideEvent(self, e): self.timer.stop(); super().hideEvent(e)

    def step(self):
        if self.pause > 0:
            self.pause-=1; return
        full=self.fontMetrics().horizontalAdvance(self.text)+40
        self.offset+=1.0
        if self.offset >= full: self.offset=0.0; self.pause=60
        self.update()

    def paintEvent(self, e):
        p=QPainter(self); p.setRenderHint(QPainter.TextAntialiasing)
        p.setPen(self.palette().color(QPalette.WindowText)); p.setFont(self.font())
        fm=self.fontMetrics(); y=(self.height()+fm.ascent()-fm.descent())//2
        if fm.horizontalAdvance(self.text) <= self.width():
            p.drawText(0, y, self.text); return
        # Soft fade at both ends while the title scrolls.
        full=fm.horizontalAdvance(self.text)+40
        p.drawText(int(-self.offset), y, self.text); p.drawText(int(full-self.offset), y, self.text)


class MediaRow(QFrame):
    """One application playing sound or video: icon, a scrolling title,
    previous / play-pause / next (MPRIS). Clicking the row opens the
    application. Volume stays with the sound control below."""
    def __init__(self, ac, key, parent=None):
        super().__init__(parent)
        self.ac=ac; self.key=key; self.stream=None; self.player=None
        self.setObjectName('mediaRow'); self.setCursor(Qt.PointingHandCursor)
        lay=QHBoxLayout(self); lay.setContentsMargins(8,6,6,6); lay.setSpacing(8)
        self.icon=QLabel(); self.icon.setFixedSize(30,30); self.icon.setAlignment(Qt.AlignCenter); lay.addWidget(self.icon)
        texts=QVBoxLayout(); texts.setSpacing(1)
        self.title=MarqueeLabel(); self.title.setObjectName('mediaTitle')
        self.app=QLabel(''); self.app.setObjectName('popHint'); self.app.setTextFormat(Qt.PlainText)
        texts.addWidget(self.title); texts.addWidget(self.app); lay.addLayout(texts, 1)
        ink=ui_colors()['title']; self.ink=ink; self.buttons={}
        for kind, tip in (('prev', 'Previous'), ('play', 'Play'), ('next', 'Next')):
            b=QToolButton(); b.setObjectName('mediaPlay' if kind == 'play' else 'mediaBtn')
            b.setFixedSize(36 if kind == 'play' else 30, 36 if kind == 'play' else 30); b.setIconSize(QSize(28, 28))
            b.setIcon(media_icon(kind, '#ffffff' if kind == 'play' else ink)); b.setToolTip(tip); b.setAccessibleName(tip)
            b.setCursor(Qt.PointingHandCursor)
            b.clicked.connect(lambda _=False, k=kind: self.control(k)); lay.addWidget(b); self.buttons[kind]=b

    def set_data(self, stream, player):
        self.stream=stream; self.player=player
        title=(player or {}).get('title') or (stream or {}).get('title') or ''
        artist=(player or {}).get('artist') or ''
        app=(stream or {}).get('app') or (player or {}).get('identity') or 'Player'
        self.title.setText(title or app)
        fm=self.app.fontMetrics()
        playing=(player or {}).get('status') == 'Playing' if player else not (stream or {}).get('corked')
        state=_('Playing') if playing else _('Paused')
        self.app.setText(fm.elidedText(' • '.join(x for x in (artist, app if title else state) if x) or state, Qt.ElideRight, 150))
        self.setToolTip(_('Click to open {a}').replace('{a}', app))
        icon=(stream or {}).get('icon') or (player or {}).get('name','').split('.')[3:4] or ''
        icon=icon[0] if isinstance(icon, list) else icon
        self.icon.setPixmap(get_icon(icon or 'multimedia-player', 'audio-x-generic').pixmap(28,28))
        for b in self.buttons.values(): b.setVisible(player is not None)
        if player is not None:
            kind='pause' if playing else 'play'
            self.buttons['play'].setIcon(media_icon(kind, '#ffffff'))
            self.buttons['play'].setToolTip(_('Pause') if playing else _('Play'))

    def control(self, kind):
        if not self.player: return
        method={'prev': 'Previous', 'next': 'Next', 'play': 'PlayPause'}[kind]
        safe_popen(['dbus-send','--session','--type=method_call',f"--dest={self.player['name']}",'/org/mpris/MediaPlayer2',f'org.mpris.MediaPlayer2.Player.{method}'])
        QTimer.singleShot(450, self.ac.panel.update_status_icons)

    def mouseReleaseEvent(self, e):
        if e.button() == Qt.LeftButton and self.rect().contains(e.pos()):
            pid=(self.stream or {}).get('pid') or (self.player or {}).get('pid')
            raise_application(pid, (self.player or {}).get('name'))
            self.ac.close()
        super().mouseReleaseEvent(e)


class GripBar(QWidget):
    """Handle at the top of the Action Center. Dragging it down shrinks the
    Action Center (the month calendar folds away), dragging up grows it."""
    dragStarted=pyqtSignal(); dragged=pyqtSignal(int); dragFinished=pyqtSignal(int); clicked=pyqtSignal()
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setFixedHeight(16); self.setCursor(Qt.SizeVerCursor)
        self.setAccessibleName('Resize Action Center'); self._start=None; self._moved=False; self.hot=False
        u=ui_colors(); self.color=qcolor(u['muted']); self.accent=qcolor(u['accent'])

    def paintEvent(self, e):
        p=QPainter(self); p.setRenderHint(QPainter.Antialiasing)
        p.setPen(Qt.NoPen); p.setBrush(self.accent if (self.hot or self._start is not None) else self.color)
        w=48; p.drawRoundedRect(QRectF((self.width()-w)/2, 5, w, 5), 2.5, 2.5)

    def enterEvent(self, e): self.hot=True; self.update()
    def leaveEvent(self, e): self.hot=False; self.update()

    def mousePressEvent(self, e):
        if e.button() == Qt.LeftButton:
            self._start=e.globalPos().y(); self._moved=False; self.dragStarted.emit(); self.update(); e.accept()

    def mouseMoveEvent(self, e):
        if self._start is not None:
            dy=e.globalPos().y()-self._start
            if abs(dy) > 3: self._moved=True
            self.dragged.emit(dy); e.accept()

    def mouseReleaseEvent(self, e):
        if self._start is not None:
            dy=e.globalPos().y()-self._start; self._start=None; self.update()
            if self._moved: self.dragFinished.emit(dy)
            else: self.clicked.emit()
            e.accept()


def network_pixmap(kind, led_on=True, size=24, color='#2d4a43', signal=None):
    """Network picture: Wi-Fi bars, or a LAN port with a small light that
    is green (blinking) when the cable works and red when offline."""
    if kind == 'wifi':
        level='excellent' if (signal or 100) >= 75 else 'good' if signal >= 50 else 'ok' if signal >= 25 else 'weak'
        icon=get_icon(f'network-wireless-signal-{level}', 'network-wireless')
        if not icon.isNull():
            return icon.pixmap(size, size)
    pix=QPixmap(size*2, size*2); pix.fill(Qt.transparent); pix.setDevicePixelRatio(2.0)
    p=QPainter(pix); p.setRenderHint(QPainter.Antialiasing)
    ink=qcolor(color); s=size/24.0
    p.setPen(QPen(ink, 1.8*s)); p.setBrush(Qt.NoBrush)
    if kind == 'wifi-off':
        # Wi-Fi arcs, dimmed
        for r in (9, 6, 3):
            p.drawArc(QRectF(12*s-r*s, 14*s-r*s, 2*r*s, 2*r*s), 45*16, 90*16)
        p.setBrush(ink); p.setPen(Qt.NoPen); p.drawEllipse(QPointF(12*s, 15*s), 1.6*s, 1.6*s)
    else:
        # RJ45 socket: body, latch notch and contacts
        p.drawRoundedRect(QRectF(3.5*s, 6*s, 17*s, 13*s), 2.5*s, 2.5*s)
        path=QPainterPath(); path.moveTo(8*s, 19*s); path.lineTo(8*s, 15*s); path.lineTo(16*s, 15*s); path.lineTo(16*s, 19*s)
        p.drawPath(path)
        p.setPen(QPen(ink, 1.1*s))
        for i in range(4):
            x=8.6*s+i*2.2*s; p.drawLine(QPointF(x, 8.5*s), QPointF(x, 11*s))
    led={'ethernet': ('#36d27a' if led_on else '#1e6d43'), 'offline': '#e5484d', 'wifi-off': '#e5484d'}.get(kind, '#36d27a')
    p.setPen(QPen(QColor(255,255,255,200), 1.2*s)); p.setBrush(QColor(led))
    p.drawEllipse(QPointF(19.5*s, 5.5*s), 3.6*s, 3.6*s)
    p.end()
    return pix


def multicolor_ac_qss():
    """Every Action Center tile in its own color (Eduka-MultiColor)."""
    if not multicolor_on(): return ''
    dark=current_theme() in DARK_THEMES; q=''
    for i, c in enumerate(MULTI_COLORS):
        col=QColor(c); r, g, b=col.red(), col.green(), col.blue()
        q+=(f'QToolButton#acTile[mc="{i}"]{{background:rgba({r},{g},{b},{48 if dark else 40});border:1px solid rgba({r},{g},{b},{100 if dark else 90});}}'
            f'QToolButton#acTile[mc="{i}"]:hover{{background:rgba({r},{g},{b},{80 if dark else 64});border:1px solid {c};}}'
            f'QToolButton#acTile[mc="{i}"][on="true"]{{background:{c};border:1px solid {col.darker(115).name()};color:#ffffff;}}')
    return q

def ac_qss():
    return _ac_qss()+multicolor_ac_qss()

