        head=QHBoxLayout(); head.setSpacing(6)
        app=QLabel(item.get('app','')); app.setObjectName('notifApp'); head.addWidget(app, 1)
        age=QLabel(notification_age(item.get('time'))); age.setObjectName('notifAge'); head.addWidget(age)
        text.addLayout(head)
        if item.get('summary'):
            summary=QLabel(item['summary']); summary.setObjectName('notifSummary'); summary.setWordWrap(True); summary.setTextFormat(Qt.PlainText); text.addWidget(summary)
        if item.get('body'):
            body=QLabel(item['body']); body.setObjectName('notifBody'); body.setWordWrap(True); body.setTextFormat(Qt.PlainText); text.addWidget(body)
        lay.addLayout(text, 1)
        close=QToolButton(); close.setObjectName('notifClose'); close.setText('✕'); close.setAccessibleName('Dismiss notification'); close.setCursor(Qt.PointingHandCursor); close.clicked.connect(on_dismiss)
        lay.addWidget(close, 0, Qt.AlignTop)


def notif_qss():
    u=ui_colors()
    return f"""
QFrame#notifRow{{background:{u['tile']};border:1px solid {u['btn_border']};border-radius:12px;}}
QFrame#notifRow:hover{{border:1px solid {u['accent']};}}
QLabel#notifApp{{font-size:11px;font-weight:700;color:{u['sub']};}}
QLabel#notifAge{{font-size:11px;color:{u['sub']};}}
QLabel#notifSummary{{font-size:13px;font-weight:700;color:{u['title']};}}
QLabel#notifBody{{font-size:12px;color:{u['text']};}}
QToolButton#notifClose{{background:transparent;border:0;border-radius:10px;padding:2px 6px;color:{u['sub']};}}
QToolButton#notifClose:hover{{background:{u['btn_hover']};color:{u['title']};}}
QPushButton#linkButton{{background:transparent;border:0;padding:3px 6px;color:{u['accent']};font-weight:700;}}
QPushButton#linkButton:hover{{text-decoration:underline;background:transparent;border:0;}}
"""


class NotificationPopup(PopupFrame):
    """Notification history: newest first, dismiss one or clear all."""
    def __init__(self, panel):
        super().__init__(panel)
        self.panel=panel; self.center=panel.notifications
        self.setAccessibleName('Notifications')
        self.box.setFixedWidth(360)
        self.setStyleSheet(self.styleSheet()+notif_qss())
        row, self.pic, self.sub=popup_header('preferences-system-notifications', 'Notifications', '')
        self.dnd=QPushButton(tr('dnd')); self.dnd.setObjectName('switch'); self.dnd.setCheckable(True); self.dnd.setChecked(dnd_enabled())
        self.dnd.toggled.connect(lambda on: (save_panel_state(dnd=bool(on)), panel.update_notification_badge()))
        row.addWidget(self.dnd)
        self.v.addLayout(row)
        self.list_widget=QWidget(); self.list_layout=QVBoxLayout(self.list_widget); self.list_layout.setContentsMargins(0,0,4,0); self.list_layout.setSpacing(6)
        self.scroll=QScrollArea(); self.scroll.setWidgetResizable(True); self.scroll.setFrameShape(QFrame.NoFrame); self.scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff); self.scroll.setWidget(self.list_widget)
        self.v.addWidget(self.scroll)
        foot=QHBoxLayout()
        settings=QPushButton('Settings'); settings.setObjectName('linkButton'); settings.clicked.connect(lambda: (self.close(), launch_app('eduka-settings --page notifications')))
        self.clear_button=QPushButton('Clear all'); self.clear_button.setObjectName('linkButton'); self.clear_button.clicked.connect(self.center.clear)
        foot.addWidget(settings); foot.addStretch(); foot.addWidget(self.clear_button)
        self.v.addLayout(foot)
        self.center.changed.connect(self.fill)
        self.fill(); self.center.mark_read()

    def fill(self):
        while self.list_layout.count():
            item=self.list_layout.takeAt(0); w=item.widget()
            if w: w.setParent(None); w.deleteLater()
        items=self.center.items
        self.sub.setText(f'{len(items)} notification{"s" if len(items) != 1 else ""}' if items else tr('no_notif'))
        self.clear_button.setEnabled(bool(items))
        if not items:
            empty=QLabel(tr('no_notif')); empty.setAlignment(Qt.AlignCenter); empty.setObjectName('popHint'); empty.setMinimumHeight(70)
            self.list_layout.addWidget(empty)
        for i, item in enumerate(items[:20]):
            self.list_layout.addWidget(NotificationRow(item, lambda _=False, idx=i: self.center.remove(idx)))
        self.list_layout.addStretch()
        self.list_widget.adjustSize()
        self.scroll.setFixedHeight(min(380, max(80, self.list_layout.sizeHint().height()+4)))


# ---------------------------------------------------------------------------
# Action Center
# ---------------------------------------------------------------------------

class ClockFace(QWidget):
    """The Action Center clock: digital, analog or LED (seven segments in a
    chosen color), with optional seconds and a blinking colon. Drawn with
    QPainter, so it costs nothing while the Action Center is closed."""
    clicked=pyqtSignal()
    SEGMENTS={'0':'abcfed','1':'bc','2':'abged','3':'abgcd','4':'fgbc','5':'afgcd','6':'afgedc','7':'abc','8':'abcdefg','9':'abcdfg',' ':''}

    def __init__(self, parent=None):
        super().__init__(parent)
        self.opts=clock_options(); self.big=True
        u=ui_colors(); self.ink=qcolor(u['title']); self.sub=qcolor(u['sub']); self.accent=qcolor(u['accent']); self.face=qcolor(u['cal'])
        self.setCursor(Qt.PointingHandCursor)
        self.setToolTip('Click: world globe • Right-click: clock style')
        self.setAccessibleName('Clock')

    def set_options(self, opts, big):
        self.opts=dict(opts); self.big=big
        self.setFixedSize(self.sizeHint()); self.update()

    def sizeHint(self):
        style=self.opts['style']; secs=self.opts['seconds']; twelve=self.opts['format'] == '12h'
        if style == 'analog':
            d=132 if self.big else 64
            return QSize(d, d)
        h=60 if self.big else 42
        chars=(8 if secs else 5)
        w=int(h*0.62*chars) + (int(h*0.9) if twelve else 0)
        if style == 'led': w=int(w*1.05)+12
        return QSize(min(330, w), h+(8 if style == 'led' else 0))

    def mouseReleaseEvent(self, e):
        if e.button() == Qt.LeftButton and self.rect().contains(e.pos()):
            self.clicked.emit()
        super().mouseReleaseEvent(e)

    def text_parts(self):
        now=QTime.currentTime(); o=self.opts
        colon=':' if (not o['blink'] or now.second() % 2 == 0) else ' '
        if o['format'] == '12h':
            t=now.toString('hh:mm:ss' if o['seconds'] else 'hh:mm'); ap=now.toString('AP')
            if t.startswith('0'): t=' '+t[1:]
        else:
            t=now.toString('HH:mm:ss' if o['seconds'] else 'HH:mm'); ap=''
        return t.replace(':', colon), ap

    def paintEvent(self, e):
        p=QPainter(self); p.setRenderHint(QPainter.Antialiasing)
        style=self.opts['style']
        if style == 'analog': self.paint_analog(p)
        elif style == 'led': self.paint_led(p)
        else: self.paint_digital(p)

    def paint_digital(self, p):
        t, ap=self.text_parts()
        f=QFont(self.font()); f.setPixelSize(int(self.height()*0.78)); f.setBold(True)
        f.setStyleHint(QFont.Monospace); f.setFamilies(['DejaVu Sans Mono', 'Noto Sans Mono', 'Monospace'])
        p.setFont(f); p.setPen(self.ink)
        fm=QFontMetrics(f); tw=fm.horizontalAdvance(t)
        if ap:
            f2=QFont(f); f2.setPixelSize(int(self.height()*0.3)); fm2=QFontMetrics(f2); total=tw+6+fm2.horizontalAdvance(ap)
        else:
            total=tw
        x=(self.width()-total)/2; base=(self.height()+fm.ascent()-fm.descent())/2
        p.drawText(QPointF(x, base), t)
        if ap:
            p.setFont(f2); p.setPen(self.accent); p.drawText(QPointF(x+tw+6, base), ap)

    def paint_led(self, p):
        t, ap=self.text_parts()
        color=QColor(self.opts['led_color']); off=QColor(color); off.setAlpha(26)
        r=QRectF(self.rect()).adjusted(1,1,-1,-1)
        p.setPen(QPen(QColor(255,255,255,30), 1)); p.setBrush(QColor('#0d0f0e')); p.drawRoundedRect(r, 10, 10)
        h=self.height()-16; dw=h*0.52; gap=h*0.16; colw=h*0.22
        widths=[colw if ch in ': ' and i in (2, 5) else dw for i, ch in enumerate(t)]
        total=sum(widths)+gap*(len(t)-1)+(h*0.7 if ap else 0)
        x=(self.width()-total)/2; y=8
        for i, ch in enumerate(t):
            if i in (2, 5):
                # colon position (blinks when ' ')
                c=color if ch == ':' else off
                p.setPen(Qt.NoPen); p.setBrush(c); d=h*0.11
                p.drawEllipse(QPointF(x+colw/2, y+h*0.32), d, d); p.drawEllipse(QPointF(x+colw/2, y+h*0.70), d, d)
            else:
                self.seven(p, ch, x, y, dw, h, color, off)
            x+=widths[i]+gap
        if ap:
            f=QFont(self.font()); f.setPixelSize(int(h*0.3)); f.setBold(True); p.setFont(f); p.setPen(color)
            p.drawText(QRectF(x, y, h*0.7, h), Qt.AlignVCenter | Qt.AlignLeft, ap)

    def seven(self, p, ch, x, y, w, h, on, off):
        lit=self.SEGMENTS.get(ch, '')
        t=max(2.5, w*0.17); hh=h/2
        segs={'a': QRectF(x+t*0.6, y, w-t*1.2, t), 'g': QRectF(x+t*0.6, y+hh-t/2, w-t*1.2, t), 'd': QRectF(x+t*0.6, y+h-t, w-t*1.2, t),
              'f': QRectF(x, y+t*0.6, t, hh-t*0.9), 'b': QRectF(x+w-t, y+t*0.6, t, hh-t*0.9),
              'e': QRectF(x, y+hh+t*0.3, t, hh-t*0.9), 'c': QRectF(x+w-t, y+hh+t*0.3, t, hh-t*0.9)}
        p.setPen(Qt.NoPen)
        for name, rect in segs.items():
            p.setBrush(on if name in lit else off); p.drawRoundedRect(rect, t/2, t/2)

    def paint_analog(self, p):
        now=QTime.currentTime(); side=min(self.width(), self.height())
        p.translate(self.width()/2, self.height()/2); p.scale(side/200.0, side/200.0)
        p.setPen(QPen(self.accent, 5)); p.setBrush(self.face); p.drawEllipse(QPointF(0,0), 94, 94)
        for i in range(60):
            p.save(); p.rotate(i*6)
            if i % 5 == 0:
                p.setPen(QPen(self.ink, 4, Qt.SolidLine, Qt.RoundCap)); p.drawLine(QPointF(0,-80), QPointF(0,-70))
            elif self.big:
                p.setPen(QPen(self.sub, 1.5, Qt.SolidLine, Qt.RoundCap)); p.drawLine(QPointF(0,-80), QPointF(0,-76))
            p.restore()
        def hand(angle, length, width, color):
            p.save(); p.rotate(angle); p.setPen(QPen(color, width, Qt.SolidLine, Qt.RoundCap)); p.drawLine(QPointF(0, 12), QPointF(0, -length)); p.restore()
        hand(30.0*((now.hour()%12)+now.minute()/60.0), 46, 7, self.ink)
        hand(6.0*(now.minute()+now.second()/60.0), 66, 5, self.ink)
        if self.opts['seconds'] or self.big:
            hand(6.0*now.second(), 72, 2, self.accent)
        p.setPen(Qt.NoPen); p.setBrush(self.accent); p.drawEllipse(QPointF(0,0), 6, 6)


WORLD_MAP = Path('/usr/share/edukasaun-desktop/assets/world-map.png')

def sun_position(utc=None):
    """(declination, subsolar longitude) in degrees for a UTC QDateTime."""
    utc=utc or QDateTime.currentDateTimeUtc()
    n=utc.date().dayOfYear(); hours=utc.time().hour()+utc.time().minute()/60.0+utc.time().second()/3600.0
    decl=-23.44*math.cos(2*math.pi/365.0*(n+10))
    b=2*math.pi*(n-81)/364.0
    eot=9.87*math.sin(2*b)-7.53*math.cos(b)-1.5*math.sin(b)       # minutes
    lon=-15.0*(hours-12.0+eot/60.0)
    return decl, ((lon+180) % 360)-180


class GlobeWidget(QWidget):
    """A small rotating Earth with day and night. Drag to spin it; it keeps
    turning slowly by itself. Rendered from an equirectangular map with a
    per-row lookup (pure Python, no extra libraries)."""
    clicked=pyqtSignal()
    def __init__(self, diameter=210, parent=None):
        super().__init__(parent)
        self.d=diameter; self.setFixedSize(diameter+16, diameter+16)
        self.setCursor(Qt.OpenHandCursor); self.setToolTip('Drag to turn the Earth • click to go back to the clock')
        self.lon0=sun_position()[1]+30.0      # start with the day side in view
        self._drag=None; self._moved=False; self._vel=0.0; self._last=None
        self.map=QImage(str(WORLD_MAP)).convertToFormat(QImage.Format_RGB32) if WORLD_MAP.exists() else QImage()
        self.tex=None; self.tex_stamp=None
        self._build_lookup()
        self.timer=QTimer(self); self.timer.timeout.connect(self.tick)

    def showEvent(self, e):
        self.timer.start(50); super().showEvent(e)

    def hideEvent(self, e):
        self.timer.stop(); super().hideEvent(e)

    def _build_lookup(self):
        """For each screen row (a latitude) the map columns of its pixels,
        relative to the centre longitude."""
        R=self.d/2.0; self.rows=[]
        W=self.map.width() or 1024; H=self.map.height() or 512; self.W=W; self.H=H
        for y in range(self.d):
            yy=R-(y+0.5)
            if abs(yy) >= R: self.rows.append(None); continue
            lat=math.asin(yy/R); half=math.sqrt(R*R-yy*yy)
            x0=int(math.ceil(R-half)); x1=int(math.floor(R+half))
            if x1 <= x0: self.rows.append(None); continue
            coslat=math.cos(lat) or 1e-6
            cols=[]
            for x in range(x0, x1):
                v=max(-1.0, min(1.0, (x+0.5-R)/(R*coslat)))
                cols.append(int(round(math.degrees(math.asin(v))/360.0*W)) + W//4)
            ty=min(H-1, max(0, int((90-math.degrees(lat))/180.0*H)))
            self.rows.append((x0, ty, itemgetter(*cols) if len(cols) > 1 else (lambda seq, c=cols[0]: (seq[c],))))

    def _texture(self):
        """Map with the night side darkened (redrawn once a minute)."""
        stamp=QDateTime.currentDateTimeUtc().toString('yyyyMMddhhmm')
        if self.tex is not None and stamp == self.tex_stamp:
            return self.tex
        img=QImage(self.map) if not self.map.isNull() else QImage(self.W, self.H, QImage.Format_RGB32)
        if self.map.isNull(): img.fill(QColor('#1f6fa8'))
        decl, slon=sun_position()
        p=QPainter(img); p.setRenderHint(QPainter.Antialiasing); p.setPen(Qt.NoPen)
        dec=math.radians(decl if abs(decl) > 0.2 else 0.2)
        for shift, alpha in ((6, 60), (0, 70), (-6, 60)):
            pts=[]
            for i in range(0, 361, 3):
                lon=-180+i; lat=math.degrees(math.atan(-math.cos(math.radians(lon-slon))/math.tan(dec)))+shift*(1 if decl > 0 else -1)
                pts.append(QPointF((lon+180)/360.0*self.W, (90-lat)/180.0*self.H))
            if decl > 0: pts+= [QPointF(self.W, self.H), QPointF(0, self.H)]
            else: pts+= [QPointF(self.W, 0), QPointF(0, 0)]
            p.setBrush(QColor(4, 10, 32, alpha)); p.drawPolygon(QPolygonF(pts))
        p.end()
        # Doubled rows let a plain slice handle the wrap at 180 degrees.
        self.tex=img; self.tex_stamp=stamp
        ptr=img.constBits(); ptr.setsize(img.sizeInBytes())
        self.tex_rows=[]
        raw=memoryview(bytes(ptr)).cast('I')
        for ty in range(self.H):
            row=array('I', raw[ty*self.W:(ty+1)*self.W])
            self.tex_rows.append(row+row)
        return img

    def render(self):
        self._texture()
        d=self.d; W=self.W
        out=array('I', bytes(4*d*d))
        start=int(((self.lon0+180.0)/360.0)*W - W//4) % W
        for y, row in enumerate(self.rows):
            if row is None: continue
            x0, ty, getter=row
            vals=getter(self.tex_rows[ty][start:start+W//2+2])
            out[y*d+x0:y*d+x0+len(vals)]=array('I', vals)
        self._buf=out.tobytes()
        return QImage(self._buf, d, d, 4*d, QImage.Format_ARGB32_Premultiplied)

    def paintEvent(self, e):
        p=QPainter(self); p.setRenderHint(QPainter.Antialiasing); p.setRenderHint(QPainter.SmoothPixmapTransform)
        c=QPointF(self.width()/2, self.height()/2); R=self.d/2.0
        glow=QRadialGradient(c, R+8); glow.setColorAt(0.85, QColor(80,170,255,90)); glow.setColorAt(1.0, QColor(80,170,255,0))
        p.setPen(Qt.NoPen); p.setBrush(glow); p.drawEllipse(c, R+8, R+8)
        p.drawImage(QPointF(c.x()-R, c.y()-R), self.render())
        shade=QRadialGradient(QPointF(c.x()-R*0.35, c.y()-R*0.4), R*1.5)
        shade.setColorAt(0.0, QColor(255,255,255,40)); shade.setColorAt(0.55, QColor(255,255,255,0)); shade.setColorAt(1.0, QColor(0,0,0,90))
        p.setBrush(shade); p.drawEllipse(c, R, R)
        p.setPen(QPen(QColor(150,210,255,140), 1.6)); p.setBrush(Qt.NoBrush); p.drawEllipse(c, R, R)

    def tick(self):
        if self._drag is None:
            if abs(self._vel) > 0.05: self._vel*=0.94
            else: self._vel=0.0
            self.lon0+=0.35+self._vel
            self.update()

    def mousePressEvent(self, e):
        if e.button() == Qt.LeftButton:
            self._drag=e.pos().x(); self._last=(e.pos().x(), time.monotonic()); self._moved=False
            self.setCursor(Qt.ClosedHandCursor)

    def mouseMoveEvent(self, e):
        if self._drag is not None:
            dx=e.pos().x()-self._last[0]
            if abs(e.pos().x()-self._drag) > 3: self._moved=True
            self.lon0-=dx*180.0/self.d; self._vel=-dx*180.0/self.d*0.5
            self._last=(e.pos().x(), time.monotonic()); self.update()

    def mouseReleaseEvent(self, e):
        if self._drag is not None:
            self._drag=None; self.setCursor(Qt.OpenHandCursor)
            if not self._moved: self.clicked.emit()

    def wheelEvent(self, e):
        self.lon0+=e.angleDelta().y()/12.0; self.update()


class MediaRow(QFrame):
    """One application playing sound: icon, title, play/pause (when the
    player supports MPRIS), its own mute button and volume slider."""
    def __init__(self, ac, key, parent=None):
        super().__init__(parent)
        self.ac=ac; self.key=key; self.stream=None; self.player=None
        self.setObjectName('mediaRow')
        lay=QHBoxLayout(self); lay.setContentsMargins(6,4,6,4); lay.setSpacing(6)
        self.icon=QLabel(); self.icon.setFixedSize(26,26); lay.addWidget(self.icon)
        texts=QVBoxLayout(); texts.setSpacing(0)
        self.title=QLabel(''); self.title.setObjectName('mediaTitle'); self.title.setTextFormat(Qt.PlainText)
        self.app=QLabel(''); self.app.setObjectName('popHint'); self.app.setTextFormat(Qt.PlainText)
        texts.addWidget(self.title); texts.addWidget(self.app); lay.addLayout(texts, 1)
        self.play=QToolButton(); self.play.setObjectName('mediaBtn'); self.play.setFixedSize(26,26); self.play.setIconSize(QSize(14,14)); self.play.clicked.connect(self.play_pause); lay.addWidget(self.play)
        self.mute=QToolButton(); self.mute.setObjectName('mediaBtn'); self.mute.setCheckable(True); self.mute.setFixedSize(26,26); self.mute.setIconSize(QSize(14,14)); self.mute.clicked.connect(self.toggle_mute); lay.addWidget(self.mute)
        self.slider=QSlider(Qt.Horizontal); self.slider.setRange(0,100); self.slider.setFixedWidth(84); lay.addWidget(self.slider)
        self.timer=QTimer(self); self.timer.setSingleShot(True); self.timer.timeout.connect(self.apply_volume)
        self.slider.valueChanged.connect(lambda _v: self.timer.start(80))

    def set_data(self, stream, player):
        self.stream=stream; self.player=player
        title=(player or {}).get('title') or (stream or {}).get('title') or ''
        artist=(player or {}).get('artist') or ''
        app=(stream or {}).get('app') or (player or {}).get('identity') or 'Player'
        shown=title or app
        fm=self.title.fontMetrics(); self.title.setText(fm.elidedText(shown, Qt.ElideRight, 118))
        self.app.setText(fm.elidedText(' • '.join(x for x in (artist, app if title else '') if x) or ('Paused' if (stream or {}).get('corked') else 'Playing'), Qt.ElideRight, 118))
        self.setToolTip(f'{app}: {title}' if title else app)
        icon=(stream or {}).get('icon') or (player or {}).get('name','').split('.')[3:4] or ''
        icon=icon[0] if isinstance(icon, list) else icon
        self.icon.setPixmap(get_icon(icon or 'multimedia-player', 'audio-x-generic').pixmap(24,24))
        self.play.setVisible(player is not None)
        if player is not None:
            playing=player.get('status') == 'Playing'
            self.play.setIcon(get_icon('media-playback-pause' if playing else 'media-playback-start', 'media-playback-start'))
            self.play.setToolTip('Pause' if playing else 'Play')
        muted=bool((stream or {}).get('muted'))
        self.mute.blockSignals(True); self.mute.setChecked(muted); self.mute.blockSignals(False)
        self.mute.setIcon(get_icon('audio-volume-muted' if muted else 'audio-volume-high', 'audio-volume-medium'))
        self.mute.setVisible(stream is not None); self.mute.setToolTip('Unmute' if muted else 'Mute only this application')
        vol=(stream or {}).get('volume') if stream else (int(round((player.get('volume') or 0)*100)) if player and player.get('volume') is not None else None)
        self.slider.setVisible(vol is not None)
        if vol is not None and not self.slider.isSliderDown():
            self.slider.blockSignals(True); self.slider.setValue(min(100, int(vol))); self.slider.blockSignals(False)

    def play_pause(self):
        if self.player:
            safe_popen(['dbus-send','--session','--type=method_call',f"--dest={self.player['name']}",'/org/mpris/MediaPlayer2','org.mpris.MediaPlayer2.Player.PlayPause'])
            QTimer.singleShot(500, self.ac.panel.update_status_icons)

    def toggle_mute(self, on):
        if self.stream:
            safe_popen(['pactl','set-sink-input-mute',str(self.stream['id']),'1' if on else '0'])
            self.mute.setIcon(get_icon('audio-volume-muted' if on else 'audio-volume-high', 'audio-volume-medium'))

    def apply_volume(self):
        v=self.slider.value()
        if self.stream:
            safe_popen(['pactl','set-sink-input-volume',str(self.stream['id']),f'{v}%'])
        elif self.player:
            safe_popen(['dbus-send','--session','--type=method_call',f"--dest={self.player['name']}",'/org/mpris/MediaPlayer2',
                        'org.freedesktop.DBus.Properties.Set','string:org.mpris.MediaPlayer2.Player','string:Volume',f'variant:double:{v/100.0:.2f}'])


class GripBar(QWidget):
    """Handle at the top of the Action Center. Dragging it down shrinks the
    Action Center (the month calendar folds away), dragging up grows it."""
    dragStarted=pyqtSignal(); dragged=pyqtSignal(int); dragFinished=pyqtSignal(int); clicked=pyqtSignal()
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setFixedHeight(16); self.setCursor(Qt.SizeVerCursor)
        self.setAccessibleName('Resize Action Center'); self._start=None; self._moved=False; self.hot=False
        u=ui_colors(); self.color=qcolor(u['muted']); self.accent=qcolor(u['accent'])

    def paintEvent(self, e):
        p=QPainter(self); p.setRenderHint(QPainter.Antialiasing)
        p.setPen(Qt.NoPen); p.setBrush(self.accent if (self.hot or self._start is not None) else self.color)
        w=48; p.drawRoundedRect(QRectF((self.width()-w)/2, 5, w, 5), 2.5, 2.5)

    def enterEvent(self, e): self.hot=True; self.update()
    def leaveEvent(self, e): self.hot=False; self.update()

    def mousePressEvent(self, e):
        if e.button() == Qt.LeftButton:
            self._start=e.globalPos().y(); self._moved=False; self.dragStarted.emit(); self.update(); e.accept()

    def mouseMoveEvent(self, e):
        if self._start is not None:
            dy=e.globalPos().y()-self._start
            if abs(dy) > 3: self._moved=True
            self.dragged.emit(dy); e.accept()

    def mouseReleaseEvent(self, e):
        if self._start is not None:
            dy=e.globalPos().y()-self._start; self._start=None; self.update()
            if self._moved: self.dragFinished.emit(dy)
            else: self.clicked.emit()
            e.accept()


def network_pixmap(kind, led_on=True, size=24, color='#2d4a43', signal=None):
    """Network picture: Wi-Fi bars, or a LAN port with a small light that
    is green (blinking) when the cable works and red when offline."""
    if kind == 'wifi':
        level='excellent' if (signal or 100) >= 75 else 'good' if signal >= 50 else 'ok' if signal >= 25 else 'weak'
        icon=get_icon(f'network-wireless-signal-{level}', 'network-wireless')
        if not icon.isNull():
            return icon.pixmap(size, size)
    pix=QPixmap(size*2, size*2); pix.fill(Qt.transparent); pix.setDevicePixelRatio(2.0)
    p=QPainter(pix); p.setRenderHint(QPainter.Antialiasing)
    ink=qcolor(color); s=size/24.0
    p.setPen(QPen(ink, 1.8*s)); p.setBrush(Qt.NoBrush)
    if kind == 'wifi-off':
        # Wi-Fi arcs, dimmed
        for r in (9, 6, 3):
            p.drawArc(QRectF(12*s-r*s, 14*s-r*s, 2*r*s, 2*r*s), 45*16, 90*16)
        p.setBrush(ink); p.setPen(Qt.NoPen); p.drawEllipse(QPointF(12*s, 15*s), 1.6*s, 1.6*s)
    else:
        # RJ45 socket: body, latch notch and contacts
        p.drawRoundedRect(QRectF(3.5*s, 6*s, 17*s, 13*s), 2.5*s, 2.5*s)
        path=QPainterPath(); path.moveTo(8*s, 19*s); path.lineTo(8*s, 15*s); path.lineTo(16*s, 15*s); path.lineTo(16*s, 19*s)
        p.drawPath(path)
        p.setPen(QPen(ink, 1.1*s))
        for i in range(4):
            x=8.6*s+i*2.2*s; p.drawLine(QPointF(x, 8.5*s), QPointF(x, 11*s))
    led={'ethernet': ('#36d27a' if led_on else '#1e6d43'), 'offline': '#e5484d', 'wifi-off': '#e5484d'}.get(kind, '#36d27a')
    p.setPen(QPen(QColor(255,255,255,200), 1.2*s)); p.setBrush(QColor(led))
    p.drawEllipse(QPointF(19.5*s, 5.5*s), 3.6*s, 3.6*s)
    p.end()
    return pix


def ac_qss():
    u=ui_colors()
    return f"""
QToolButton#acChevron{{background:{u['btn_bg']};border:1px solid {u['btn_border']};border-radius:13px;padding:0;margin-top:4px;}}
QToolButton#acChevron:hover{{border:1px solid {u['accent']};}}
QFrame#mediaRow{{background:{u['tile']};border:1px solid {u['btn_border']};border-radius:10px;}}
QLabel#mediaTitle{{font-size:12px;font-weight:700;color:{u['title']};}}
QToolButton#mediaBtn{{background:{u['btn_bg']};border:1px solid {u['btn_border']};border-radius:13px;padding:0;}}
QToolButton#mediaBtn:hover{{border:1px solid {u['accent']};}}
QToolButton#mediaBtn:checked{{background:#e5484d;border:1px solid #e5484d;}}
QFrame#acClock{{background:{u['cal']};border:1px solid {u['btn_border']};border-radius:18px;}}
QLabel#acTime{{font-size:46px;font-weight:800;color:{u['title']};}}
QLabel#acGreeting{{font-size:15px;font-weight:800;color:{u['accent']};}}
QLabel#acDate{{font-size:13px;color:{u['sub']};font-weight:600;}}
QToolButton#acTile{{background:{u['tile']};border:1px solid {u['btn_border']};border-radius:14px;padding:6px 4px;color:{u['text']};font-size:11px;font-weight:700;}}
QToolButton#acTile:hover{{background:{u['btn_hover']};border:1px solid {u['accent']};}}
QToolButton#acTile[on="true"]{{background:{u['accent']};color:#ffffff;border:1px solid {u['accent_border']};}}
QToolButton#acTile[on="true"]:hover{{background:{u['accent_hover']};}}
QToolButton#acTile[alert="true"]{{border:1px solid #e5484d;}}
QToolButton#acTile:disabled{{background:{u['tile_off']};color:{u['tile_off_text']};border:1px solid {u['btn_border']};}}
QToolButton#acSession{{background:{u['tile']};border:1px solid {u['btn_border']};border-radius:14px;padding:6px 2px;color:{u['text']};font-size:11px;font-weight:700;}}
QToolButton#acSession:hover{{background:{u['accent']};border:1px solid {u['accent']};color:#ffffff;}}
QToolButton#acSession[danger="true"]:hover{{background:#e5484d;border:1px solid #e5484d;}}
QLabel#calTitle{{font-size:14px;font-weight:800;color:{u['title']};}}
QToolButton#calNav{{background:transparent;border:1px solid transparent;border-radius:14px;padding:4px;}}
QToolButton#calNav:hover{{background:{u['cal_hover']};border:1px solid {u['btn_border']};}}
QPushButton#calToday{{padding:3px 10px;border-radius:11px;font-size:11px;}}
QCalendarWidget QWidget{{background:{u['cal']};alternate-background-color:{u['cal']};}}
QCalendarWidget QAbstractItemView{{background:{u['cal']};color:{u['text']};selection-background-color:transparent;selection-color:{u['text']};outline:0;border:0;}}
"""


class ActionCenter(PopupFrame):
    """Clock popup: big clock with greeting, quick toggles, sound and
    brightness, notifications, the month calendar and the session buttons."""
    TILES=[
        ('network','Network','network-wired'),
        ('bluetooth','Bluetooth','bluetooth'),
        ('airplane','Airplane','airplane-mode'),
        ('display','Display','preferences-desktop-display'),
        ('dnd','Do Not Disturb','notifications-disabled'),
        ('settings','Settings','preferences-system'),
    ]
    def __init__(self, panel):
        super().__init__(panel)
        self.panel=panel; self.lang=ui_language()
        self.setAccessibleName('Action Center')
        self.box.setFixedWidth(372)
        self.setStyleSheet(self.styleSheet()+ac_qss()+notif_qss())
        self.v.setSpacing(8); self.v.setContentsMargins(14,2,14,12)
        self.ink='#e0e0e0' if is_dark_theme() else '#2d4a43'

        # Handle row: the grip in the middle, the size chevron at the right.
        top=QHBoxLayout(); top.setContentsMargins(0,0,0,0); top.addSpacing(26)
        self.grip=GripBar(); top.addWidget(self.grip, 1)
        self.mode_button=QToolButton(); self.mode_button.setObjectName('acChevron'); self.mode_button.setFixedSize(26,26); self.mode_button.setIconSize(QSize(11,11)); self.mode_button.setCursor(Qt.PointingHandCursor)
        self.mode_button.clicked.connect(lambda: self.set_compact(not self.compact, remember=True)); top.addWidget(self.mode_button)
        self.v.addLayout(top)
        self.grip.dragStarted.connect(self.drag_start); self.grip.dragged.connect(self.drag_move); self.grip.dragFinished.connect(self.drag_end)
        self.grip.clicked.connect(lambda: self.set_compact(not self.compact, remember=True))

        # Clock card in the middle: digital or analog, greeting and date.
        self.clock_card=QFrame(); self.clock_card.setObjectName('acClock')
        card_lay=QVBoxLayout(self.clock_card); card_lay.setContentsMargins(0,0,0,0)
        self.clock_stack=QStackedWidget(); card_lay.addWidget(self.clock_stack)
        clock_page=QWidget(); self.ck=QGridLayout(clock_page); self.ck.setContentsMargins(12,10,12,12); self.ck.setHorizontalSpacing(12); self.ck.setVerticalSpacing(2)
        self.face=ClockFace(); self.face.clicked.connect(self.show_globe)
        self.greeting=QLabel(); self.greeting.setObjectName('acGreeting')
        self.date_label=QLabel(); self.date_label.setObjectName('acDate')
        self.date_label.setWordWrap(True); self._dense=None
        self.clock_stack.addWidget(clock_page)
        globe_page=QWidget(); gl=QVBoxLayout(globe_page); gl.setContentsMargins(8,8,8,8); gl.setSpacing(4)
        self.globe=GlobeWidget(176); self.globe.clicked.connect(self.show_clock); gl.addWidget(self.globe, 0, Qt.AlignHCenter)
        self.globe_info=QLabel(''); self.globe_info.setObjectName('acDate'); self.globe_info.setAlignment(Qt.AlignCenter); gl.addWidget(self.globe_info)
        self.clock_stack.addWidget(globe_page)
        # A stacked widget is as tall as its tallest page: size only by the visible one.
        self.clock_stack.currentChanged.connect(self._stack_sizes); self._stack_sizes(0)
        self.clock_card.setContextMenuPolicy(Qt.CustomContextMenu); self.clock_card.customContextMenuRequested.connect(self.clock_menu)
        self.clock_card.setToolTip('Click the clock for the world globe • Right-click: clock style')
        self.v.addWidget(self.clock_card)
        self.clock_opts=clock_options(); self.clock_format=self.clock_opts['format']

        grid=QGridLayout(); grid.setSpacing(8); self.tiles={}
        for i,(key,label,icon) in enumerate(self.TILES):
            t=QToolButton(); t.setObjectName('acTile'); t.setText(tr('dnd') if key == 'dnd' else label)
            t.setIcon(get_icon(icon,'video-display' if key == 'display' else 'preferences-system-notifications' if key == 'dnd' else 'preferences-system'))
            t.setIconSize(QSize(24,24)); t.setToolButtonStyle(Qt.ToolButtonTextUnderIcon); t.setFixedSize(108,54)
            t.setAccessibleName(label); t.setProperty('on', False); t.setCursor(Qt.PointingHandCursor)
            t.clicked.connect(lambda _=False,k=key: self.tile_clicked(k))
            t.setContextMenuPolicy(Qt.CustomContextMenu); t.customContextMenuRequested.connect(lambda _pos,k=key: self.tile_settings(k))
            grid.addWidget(t, i//3, i%3); self.tiles[key]=t
        self.v.addLayout(grid)
        self._led=True
        self.blink=QTimer(self); self.blink.timeout.connect(self.blink_led)

        # One sound control and brightness below it.
        card=QFrame(); card.setObjectName('acCard'); cl=QGridLayout(card); cl.setContentsMargins(10,8,10,10); cl.setHorizontalSpacing(8); cl.setVerticalSpacing(6)
        self.mute=QToolButton(); self.mute.setObjectName('roundIcon'); self.mute.setCheckable(True); self.mute.setIconSize(QSize(18,18)); self.mute.setFixedSize(34,34)
        self.mute.setAccessibleName('Mute'); self.mute.setToolTip('Mute / unmute'); self.mute.clicked.connect(self.toggle_mute)
        self.vol_slider=QSlider(Qt.Horizontal); self.vol_slider.setRange(0,100); self.vol_slider.setAccessibleName('Volume')
        self.vol_value=QLabel('')
        self.sound_more=QToolButton(); self.sound_more.setObjectName('roundIcon'); self.sound_more.setFixedSize(34,34)
        self.sound_more.setIcon(QIcon(arrow_icon_path('right', self.ink))); self.sound_more.setIconSize(QSize(12,12))
        self.sound_more.setAccessibleName('Sound output and settings'); self.sound_more.setToolTip('Output device and sound settings'); self.sound_more.clicked.connect(self.sound_menu)
        self.bri_icon=QLabel(); self.bri_icon.setFixedSize(34,34); self.bri_icon.setAlignment(Qt.AlignCenter); self.bri_icon.setPixmap(get_icon('display-brightness','video-display').pixmap(18,18))
        self.bri_slider=QSlider(Qt.Horizontal); self.bri_slider.setRange(5,100); self.bri_slider.setAccessibleName('Screen brightness'); self.bri_value=QLabel('')
        for w in (self.vol_value, self.bri_value): w.setFixedWidth(40); w.setAlignment(Qt.AlignRight|Qt.AlignVCenter)
        cl.addWidget(self.mute,0,0); cl.addWidget(self.vol_slider,0,1); cl.addWidget(self.vol_value,0,2); cl.addWidget(self.sound_more,0,3)
        cl.addWidget(self.bri_icon,1,0); cl.addWidget(self.bri_slider,1,1); cl.addWidget(self.bri_value,1,2)
        self.battery_label=QLabel(''); cl.addWidget(self.battery_label,2,0,1,4)
        self.battery_label.setObjectName('popHint')
        # Applications playing sound (players, browsers, games): each with
        # its own volume and mute, and play/pause when the player allows it.
        self.media_box=QWidget(); self.media_lay=QVBoxLayout(self.media_box); self.media_lay.setContentsMargins(0,2,0,0); self.media_lay.setSpacing(2)
        self.media_rows={}; self.media_box.setVisible(False)
        cl.addWidget(self.media_box,4,0,1,4)
        MEDIA_WANTED['on']=True
        self.update_button=QPushButton(''); self.update_button.setVisible(False); self.update_button.clicked.connect(lambda: (self.close(), panel.open_eus())); cl.addWidget(self.update_button,3,0,1,4)
        self.v.addWidget(card)
        self._vol_timer=QTimer(self); self._vol_timer.setSingleShot(True); self._vol_timer.timeout.connect(self.apply_volume)
        self._bri_timer=QTimer(self); self._bri_timer.setSingleShot(True); self._bri_timer.timeout.connect(self.apply_brightness)
        self.vol_slider.valueChanged.connect(lambda v: (self.vol_value.setText(f'{v}%'), self.update_sound_icon(), self._vol_timer.start(70)))
        self.bri_slider.valueChanged.connect(lambda v: (self.bri_value.setText(f'{v}%'), self._bri_timer.start(90)))

        # Latest notification (the full history opens with "All").
        self.notif_card=QFrame(); self.notif_card.setObjectName('acCard'); nl=QHBoxLayout(self.notif_card); nl.setContentsMargins(10,8,8,8); nl.setSpacing(8)
        self.notif_icon=QLabel(); self.notif_icon.setFixedSize(26,26); nl.addWidget(self.notif_icon)
        self.notif_text=QLabel(''); self.notif_text.setWordWrap(True); self.notif_text.setTextFormat(Qt.PlainText); nl.addWidget(self.notif_text, 1)
        self.notif_open=QPushButton('All'); self.notif_open.setObjectName('linkButton'); self.notif_open.clicked.connect(lambda: (self.close(), panel.notification_popup())); nl.addWidget(self.notif_open)
        self.v.addWidget(self.notif_card)
        panel.notifications.changed.connect(self.update_notifications); self.update_notifications()

        # Month calendar in a holder whose height follows the grip.
        self.cal_holder=QWidget(); hl=QVBoxLayout(self.cal_holder); hl.setContentsMargins(0,0,0,0)
        self.calendar_card=CalendarCard(); self.calendar=self.calendar_card.calendar; hl.addWidget(self.calendar_card)
        self.cal_full=self.calendar_card.sizeHint().height()
        self.v.addWidget(self.cal_holder)

        # Session: Lock, Log Out, Restart, Shut Down.
        session=QHBoxLayout(); session.setSpacing(6)
        for action in ('lock', 'logout', 'restart', 'shutdown'):
            b=QToolButton(); b.setObjectName('acSession'); b.setText(tr(action)); b.setIcon(get_icon(SESSION_ICONS[action], 'system-shutdown')); b.setIconSize(QSize(20,20))
            b.setToolButtonStyle(Qt.ToolButtonTextUnderIcon); b.setFixedHeight(52); b.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
            b.setProperty('danger', action == 'shutdown'); b.setCursor(Qt.PointingHandCursor); b.setAccessibleName(tr(action))
            b.clicked.connect(lambda _=False, a=action: self.session(a)); session.addWidget(b)
        self.v.addLayout(session)

        self.update_time()
        self.refresh(panel.last_status or {})
        self.compact=None
        self.apply_clock_style()
        self.set_compact(bool(read_panel_state().get('action_center_compact', False)) or self.too_tall())

    # -------------------------------------------------------------- size
    def too_tall(self):
        """Small screens (1024x600 netbooks) start in compact mode."""
        return QApplication.primaryScreen().availableGeometry().height() < 640

    def room(self):
        screen=QApplication.primaryScreen().availableGeometry()
        return self.panel.y()-8-(screen.y()+4)

    def set_clock_layout(self, dense):
        """With the month calendar: one row (clock left, greeting and date
        right). Without it: a big clock in the middle."""
        if dense == self._dense:
            return
        self._dense=dense
        for w in (self.face, self.greeting, self.date_label):
            self.ck.removeWidget(w)
        self.face.set_options(self.clock_opts, big=not dense)
        if dense:
            self.ck.addWidget(self.face, 0, 0, 2, 1, Qt.AlignVCenter)
            self.ck.addWidget(self.greeting, 0, 1, Qt.AlignBottom); self.ck.addWidget(self.date_label, 1, 1, Qt.AlignTop)
            self.ck.setColumnStretch(1, 1)
            for w in (self.greeting, self.date_label): w.setAlignment(Qt.AlignLeft | Qt.AlignVCenter)
        else:
            self.ck.addWidget(self.face, 0, 0, 1, 2, Qt.AlignHCenter)
            self.ck.addWidget(self.greeting, 1, 0, 1, 2); self.ck.addWidget(self.date_label, 2, 0, 1, 2)
            self.ck.setColumnStretch(1, 0)
            for w in (self.greeting, self.date_label): w.setAlignment(Qt.AlignCenter)
        self.update_time()

    def _stack_sizes(self, index):
        for i in range(self.clock_stack.count()):
            self.clock_stack.widget(i).setSizePolicy(QSizePolicy.Preferred if i == index else QSizePolicy.Ignored,
                                                     QSizePolicy.Preferred if i == index else QSizePolicy.Ignored)
        self.clock_stack.adjustSize()

    def show_globe(self):
        self.clock_stack.setCurrentIndex(1); self.update_time()
        if self.isVisible(): self.place()

    def show_clock(self):
        self.clock_stack.setCurrentIndex(0)
        if self.isVisible(): self.place()

    def set_compact(self, compact, remember=False):
        compact=bool(compact)
        self.compact=compact
        self.set_clock_layout(not compact)
        self.set_calendar_height(0 if compact else self.cal_full)
        self.cal_holder.setVisible(not compact)
        self.mode_button.setIcon(QIcon(arrow_icon_path('up' if compact else 'down', self.ink)))
        tip='Show the calendar (drag the handle up)' if compact else 'Smaller: hide the calendar (drag the handle down)'
        self.mode_button.setToolTip(tip); self.mode_button.setAccessibleName(tip); self.grip.setToolTip(tip)
        if remember:
            save_panel_state(action_center_compact=compact)
        if self.isVisible():
            self.place(); QTimer.singleShot(0, self.place)

    CAL_MIN=128   # smallest calendar that still shows all six weeks

    def set_calendar_height(self, h):
        """Calendar holder height; the month grid shrinks with it."""
        h=max(0, min(self.cal_full, int(h)))
        self.cal_holder.setMinimumHeight(h); self.cal_holder.setMaximumHeight(h)
        grid=max(90, 160-(self.cal_full-h)) if h < self.cal_full else 166
        if self.calendar.height() != grid: self.calendar.setFixedHeight(grid)

    def drag_start(self):
        self._drag_from=self.cal_holder.maximumHeight() if self.cal_holder.isVisible() else 0
        self.set_clock_layout(True)
        self.cal_holder.setVisible(True)

    def drag_move(self, dy):
        h=max(0, min(self.cal_full, self._drag_from-dy, self.room()-self.base_height()))
        self.set_calendar_height(h)
        self.place(check_room=False)

    def drag_end(self, dy):
        self.set_compact(self.cal_holder.maximumHeight() < self.CAL_MIN*0.7, remember=True)

    def settle(self):
        # Layout changes are applied lazily: settle them before measuring.
        self.ck.activate(); self.v.activate(); self.layout().activate()
        self.box.adjustSize(); self.adjustSize()

    def base_height(self):
        """Height of the Action Center without the calendar."""
        self.settle()
        return self.sizeHint().height()-(self.cal_holder.maximumHeight() if self.cal_holder.isVisible() else 0)

    def room(self):
        return self.panel.popup_room()

    def place(self, check_room=True):
        """Open next to Eduka-Panel (any edge). When the full calendar does
        not fit, it is made smaller first; only on very small screens the
        Action Center switches to the compact view."""
        if check_room:
            self.notif_card.setVisible(True)
        if check_room and not self.compact:
            free=self.room()-self.base_height()
            if free < self.CAL_MIN:
                # Make room for the calendar the user asked for: the latest
                # notification is still behind the bell on the panel.
                self.notif_card.setVisible(False); free=self.room()-self.base_height()
            if free >= self.CAL_MIN:
                self.set_calendar_height(min(self.cal_full, free)); self.cal_holder.setVisible(True)
            else:
                self.compact=True; self.cal_holder.setVisible(False); self.set_calendar_height(0)
                self.mode_button.setIcon(QIcon(arrow_icon_path('up', self.ink))); self.set_clock_layout(False)
        self.settle()
        if self.sizeHint().height() > self.room() and self.notif_card.isVisible():
            self.notif_card.setVisible(False); self.settle()
        h=min(self.sizeHint().height(), self.room()) if self.panel.edge in ('Bottom','Top') else self.sizeHint().height()
        anchor=self.panel.clock.mapToGlobal(QPoint(self.panel.clock.width()//2, self.panel.clock.height()//2))
        pos=self.panel.popup_position(self.width(), h, anchor)
        self.setGeometry(pos.x(), pos.y(), self.width(), h)

    def wheelEvent(self, e):
        # Scrolling on the clock or the handle also changes the size.
        if self.grip.underMouse() or self.clock_card.underMouse():
            self.set_compact(e.angleDelta().y() < 0, remember=True); return
        super().wheelEvent(e)

    # -------------------------------------------------------------- clock
    def apply_clock_style(self):
        self.clock_opts=clock_options(); self.clock_format=self.clock_opts['format']
        dense=self._dense; self._dense=None
        self.set_clock_layout(bool(dense) if dense is not None else False)

    def clock_menu(self, pos):
        o=clock_options()
        m=RoundedMenu(self)
        for label, key, value, current in [('Digital clock','clock_style','digital',o['style']), ('Analog clock','clock_style','analog',o['style']),
                                           ('LED clock','clock_style','led',o['style']), (None,None,None,None),
                                           ('24 hours (14:30)','clock_format','24h',o['format']), ('12 hours (2:30 PM)','clock_format','12h',o['format'])]:
            if label is None:
                m.addSeparator(); continue
            act=m.addAction(label); act.setCheckable(True); act.setChecked(value == current)
            act.triggered.connect(lambda _=False, k=key, v=value: self.set_clock(k, v))
        m.addSeparator()
        sec=m.addAction('Show seconds'); sec.setCheckable(True); sec.setChecked(o['seconds']); sec.triggered.connect(lambda on: self.set_clock('clock_seconds', bool(on)))
        blink=m.addAction('Blinking colon'); blink.setCheckable(True); blink.setChecked(o['blink']); blink.triggered.connect(lambda on: self.set_clock('clock_blink', bool(on)))
        colors=m.addMenu('LED color')
        for value, name in LED_COLORS:
            pix=QPixmap(14,14); pix.fill(QColor(value))
            act=colors.addAction(QIcon(pix), name); act.setCheckable(True); act.setChecked(o['led_color'].casefold() == value)
            act.triggered.connect(lambda _=False, v=value: (self.set_clock('clock_led_color', v), self.set_clock('clock_style', 'led')))
        m.addSeparator()
        m.addAction(get_icon('applications-internet', 'globe'), 'World globe', self.show_globe)
        m.addAction(get_icon('preferences-system'), 'Clock settings…', lambda: self.launch('eduka-settings --page clock'))
        m.exec_(self.clock_card.mapToGlobal(pos))

    def set_clock(self, key, value):
        save_panel_config({key: value})
        self.apply_clock_style(); self.panel.update_clock()
        if self.isVisible(): self.place()

    def update_time(self):
        now=QDateTime.currentDateTime(); loc=QLocale()
        self.greeting.setText(f'{greeting_text(now.time().hour(), self.lang)}, {user_display_name()}'.rstrip(', '))
        date=loc.toString(now.date(), QLocale.LongFormat)
        if self.clock_opts['style'] == 'analog':
            date=format_clock(now.time(), self.clock_format)+' • '+date
        self.date_label.setText(date)
        self.face.update()
        if self.clock_stack.currentIndex() == 1:
            utc=QDateTime.currentDateTimeUtc()
            self.globe_info.setText(f"{format_clock(now.time(), self.clock_format)} here • UTC {utc.toString('HH:mm')} • lit side is day")

    # -------------------------------------------------------------- tiles
    def set_tile(self, key, on, enabled=True, tip=''):
        t=self.tiles[key]
        if bool(t.property('on')) != bool(on):
            t.setProperty('on', bool(on)); t.style().unpolish(t); t.style().polish(t)
        t.setEnabled(enabled)
        t.setToolTip(tip or t.text())
        if key in ('network','bluetooth','airplane','dnd'):
            t.setAccessibleDescription('On' if on else 'Off')

    def update_network_tile(self, st):
        net=st.get('net','offline'); t=self.tiles['network']
        self._net_kind={'wifi':'wifi','ethernet':'ethernet'}.get(net, 'wifi-off' if st.get('wifi_hw') and st.get('wifi_on') else 'offline')
        self._net_signal=st.get('signal')
        if net == 'wifi':
            name=st.get('connection') or 'Wi-Fi'
            t.setText(name if len(name) <= 13 else name[:12]+'…')
            tip=f"{tr('net_wifi', self.lang)}: {name}" + (f" ({st.get('signal')}%)" if st.get('signal') else '')
        elif net == 'ethernet':
            t.setText('Ethernet'); tip=tr('net_lan', self.lang)
        else:
            t.setText(tr('offline', self.lang)); tip=tr('net_off', self.lang)
        self.set_tile('network', net in ('wifi','ethernet'), True, tip+' — right-click: network settings')
        t.setAccessibleName(tip)
        alert=net not in ('wifi','ethernet')
        if bool(t.property('alert')) != alert:
            t.setProperty('alert', alert); t.style().unpolish(t); t.style().polish(t)
        self._led=True; self.paint_network_icon()
        if self._net_kind == 'ethernet':
            if not self.blink.isActive(): self.blink.start(600)
        else:
            self.blink.stop()

    def paint_network_icon(self):
        t=self.tiles['network']
        color='#ffffff' if t.property('on') else self.ink
        t.setIcon(QIcon(network_pixmap(self._net_kind, self._led, 24, color, self._net_signal)))

    def blink_led(self):
        if not self.isVisible():
            self.blink.stop(); return
        self._led=not self._led; self.paint_network_icon()

    def update_sound_icon(self):
        v=self.vol_slider.value(); muted=self.mute.isChecked()
        name='audio-volume-muted' if muted or v == 0 else ('audio-volume-low' if v < 34 else 'audio-volume-medium' if v < 67 else 'audio-volume-high')
        self.mute.setIcon(get_icon(name,'audio-volume-high'))
        self.mute.setAccessibleDescription('Muted' if muted else 'Sound on')

    def refresh(self, st):
        self.update_network_tile(st)
        wifi_on=st.get('wifi_on')
        bt_on=st.get('bt_on')
        self.set_tile('bluetooth', bool(bt_on), bool(st.get('bt_hw')) and bt_on is not None, 'Bluetooth — right-click for devices' if st.get('bt_hw') else 'No Bluetooth adapter found')
        self.set_tile('airplane', bool(st.get('airplane')), wifi_on is not None, 'Turn all wireless radios off')
        self.set_tile('display', False, True, 'Monitor and resolution settings')
        self.set_tile('dnd', dnd_enabled(), True, tr('dnd', self.lang)+': only urgent notifications pop up')
        self.set_tile('settings', False, True, 'Eduka-Settings — right-click for LXQt Settings')
        vol=st.get('volume')
        self.vol_slider.blockSignals(True); self.vol_slider.setEnabled(vol is not None); self.vol_slider.setValue(int(vol or 0)); self.vol_slider.blockSignals(False)
        self.vol_value.setText(f'{vol}%' if vol is not None else '—')
        self.mute.blockSignals(True); self.mute.setChecked(bool(st.get('muted'))); self.mute.setEnabled(vol is not None); self.mute.blockSignals(False)
        self.update_sound_icon()
        self.update_media(st.get('streams') or [], st.get('players') or [])
        bri=st.get('brightness'); method=st.get('brightness_method')
        self.bri_slider.blockSignals(True)
        self.bri_slider.setMinimum(SOFTWARE_BRIGHTNESS_MIN if method == 'software' else 5)
        self.bri_slider.setEnabled(bri is not None); self.bri_slider.setValue(int(bri or 100))
        self.bri_slider.blockSignals(False)
        self.bri_value.setText(f'{bri}%' if bri is not None else '—')
        self.bri_slider.setToolTip({'backlight':'Screen brightness','software':'Screen brightness (display has no backlight control; adjusted by Eduka)'}.get(method, 'Brightness is not available on this display'))
        bat=st.get('battery')
        info=[f"Battery {bat['capacity']}% ({bat['status']})" if bat else 'Power: AC', f"Keyboard {st.get('layout','EN')}"]
        if st.get('printers'): info.append('Printer ready')
        self.battery_label.setText('  •  '.join(info))
        count=int(self.panel.eus_status.get('count',0) or 0) if self.panel.eus_status else 0
        self.update_button.setVisible(count > 0)
        if count: self.update_button.setText(f'  {count} update{"s" if count != 1 else ""} available'); self.update_button.setIcon(get_icon(str(EUS_ICON_DIR/'eus-update-available.png'),'system-software-update'))

    def update_media(self, streams, players):
        rows=[]; used=set()
        for stream in streams:
            pl=match_player(stream, players)
            if pl: used.add(pl['name'])
            rows.append((f"s{stream['id']}", stream, pl))
        for pl in players:
            if pl['name'] not in used and pl['status'] in ('Playing', 'Paused'):
                rows.append((pl['name'], None, pl))
        rows=rows[:4]
        keys={k for k, _s, _p in rows}
        for k in list(self.media_rows):
            if k not in keys:
                w=self.media_rows.pop(k); self.media_lay.removeWidget(w); w.deleteLater()
        for k, stream, pl in rows:
            if k not in self.media_rows:
                w=MediaRow(self, k); self.media_rows[k]=w; self.media_lay.addWidget(w)
            self.media_rows[k].set_data(stream, pl)
        had=self.media_box.isVisible(); self.media_box.setVisible(bool(rows))
        if had != bool(rows) and self.isVisible():
            QTimer.singleShot(0, self.place)

    def update_notifications(self):
        items=self.panel.notifications.items
        if items:
            n=items[0]; text=n.get('summary') or n.get('body') or ''
            self.notif_text.setText(f"{n.get('app','')}: {text}"[:90] + (f"   (+{len(items)-1})" if len(items) > 1 else ''))
            self.notif_icon.setPixmap(notification_icon(n, 22))
        else:
            self.notif_text.setText(tr('no_notif', self.lang))
            self.notif_icon.setPixmap(get_icon('preferences-system-notifications','dialog-information').pixmap(22,22))
        self.notif_open.setVisible(bool(items))

    def launch(self, cmd):
        self.close(); launch_app(cmd)

    def session(self, action):
        self.close()
        QTimer.singleShot(120, lambda: confirm_session_action(action))

    def tile_clicked(self, key):
        st=self.panel.last_status or {}
        if key == 'network':
            self.close(); QTimer.singleShot(80, self.panel.network_popup); return
        elif key == 'bluetooth':
            safe_popen(['bluetoothctl','power','off' if st.get('bt_on') else 'on'])
        elif key == 'airplane':
            if st.get('airplane'):
                safe_popen(['nmcli','radio','all','on'])
            else:
                safe_popen(['nmcli','radio','all','off'])
                if st.get('bt_on'): safe_popen(['bluetoothctl','power','off'])
        elif key == 'display':
            self.launch('lxqt-config-monitor'); return
        elif key == 'dnd':
            save_panel_state(dnd=not dnd_enabled()); self.set_tile('dnd', dnd_enabled(), True, self.tiles['dnd'].toolTip())
            self.panel.update_notification_badge(); return
        elif key == 'settings':
            self.launch('eduka-settings'); return
        # Optimistic feedback, then confirm with a fresh status read.
        t=self.tiles[key]; self.set_tile(key, not bool(t.property('on')), t.isEnabled(), t.toolTip())
        QTimer.singleShot(700, self.panel.update_status_icons)

    def tile_settings(self, key):
        cmd={'network':'nm-connection-editor','airplane':'nm-connection-editor','bluetooth':'blueman-manager','display':'lxqt-config-monitor','settings':'lxqt-config','dnd':'eduka-settings --page notifications'}.get(key)
        if cmd: self.launch(cmd)

    def toggle_mute(self, on):
        safe_popen(['pactl','set-sink-mute','@DEFAULT_SINK@','1' if on else '0'])
        self.panel.last_status['muted']=bool(on); self.update_sound_icon()
        QTimer.singleShot(400, self.panel.update_status_icons)

    def sound_menu(self):
        m=RoundedMenu(self)
        sinks=[]; current=None
        for line in (_run_text(['pactl','list','short','sinks'], timeout=2) or '').splitlines():
            parts=line.split('\t')
            if len(parts) >= 2: sinks.append(parts[1])
        default=(_run_text(['pactl','get-default-sink']) or '').strip()
        names={}
        for line in (_run_text(['pactl','list','sinks'], timeout=3) or '').splitlines():
            line=line.strip()
            if line.startswith('Name:'): current=line.split(':',1)[1].strip()
            elif line.startswith('Description:') and current: names[current]=line.split(':',1)[1].strip()
        if sinks:
            header=m.addAction('Output'); header.setEnabled(False)
            for sink in sinks:
                act=m.addAction(names.get(sink, sink)); act.setCheckable(True); act.setChecked(sink == default)
                act.triggered.connect(lambda _=False, s=sink: (safe_popen(['pactl','set-default-sink',s]), QTimer.singleShot(400, self.panel.update_status_icons)))
            m.addSeparator()
        m.addAction(get_icon('preferences-desktop-sound','audio-card'),'Sound Settings…', lambda: self.launch('pavucontrol-qt'))
        m.exec_(self.sound_more.mapToGlobal(QPoint(self.sound_more.width(), 0)))

    def apply_volume(self):
        value=self.vol_slider.value()
        self.panel.last_status['volume']=value
        safe_popen(['pactl','set-sink-volume','@DEFAULT_SINK@',f'{value}%'])
        QTimer.singleShot(400, self.panel.update_status_icons)

    def apply_brightness(self):
        value=self.bri_slider.value()
        method=(self.panel.last_status or {}).get('brightness_method') or 'software'
        set_brightness(value, method)
        self.panel.last_status['brightness']=value

    def hideEvent(self, e):
        MEDIA_WANTED['on']=False
        self.blink.stop()
        self.panel._action_center_closed_at=time.monotonic()
        self.panel.set_tray_compact(False)
        super().hideEvent(e)

SESSION_ICONS = {'lock': 'system-lock-screen', 'logout': 'system-log-out', 'restart': 'system-reboot', 'shutdown': 'system-shutdown'}


def _nm_split(line):
    """Split an `nmcli -t` line; SSIDs may contain escaped colons."""
    fields=re.split(r'(?<!\\):', line)
    return [f.replace('\\:', ':').replace('\\\\', '\\') for f in fields]


class WifiScanWorker(QThread):
    ready=pyqtSignal(object)
    def run(self):
        result={'nm': shutil.which('nmcli') is not None, 'networks': [], 'known': set()}
        if result['nm']:
            out=_run_text(['nmcli','-t','-f','IN-USE,SSID,SIGNAL,SECURITY','device','wifi','list','--rescan','auto'], timeout=12)
            seen={}
            for line in (out or '').splitlines():
                f=_nm_split(line)
                if len(f) < 4 or not f[1]: continue
                ssid=f[1]; active=f[0].strip() == '*'
                try: signal=int(f[2] or 0)
                except ValueError: signal=0
                secure=bool(f[3].strip() and f[3].strip() != '--')
                old=seen.get(ssid)
                if old is None or active or signal > old['signal']:
                    seen[ssid]={'ssid':ssid,'active':active or (old or {}).get('active',False),'signal':signal,'secure':secure}
            result['networks']=sorted(seen.values(), key=lambda n: (not n['active'], -n['signal'], n['ssid'].casefold()))
            known=_run_text(['nmcli','-t','-f','NAME,TYPE','connection','show'])
            result['known']={_nm_split(l)[0] for l in (known or '').splitlines() if 'wireless' in l}
        self.ready.emit(result)


def _signal_icon(signal):
    if signal >= 75: return 'network-wireless-signal-excellent'
    if signal >= 50: return 'network-wireless-signal-good'
    if signal >= 25: return 'network-wireless-signal-ok'
    return 'network-wireless-signal-weak'


class NetworkPopup(PopupFrame):
    """Wi-Fi list with signal, lock and connected state; Wi-Fi switch."""
    def __init__(self, panel):
        super().__init__(panel); self.panel=panel
        self.box.setFixedWidth(340); self.setAccessibleName('Network')
        st=panel.last_status or {}
        head, self.head_icon, self.subtitle = popup_header('network-wireless','Network', self.status_text(st))
        self.switch=QPushButton('On'); self.switch.setObjectName('switch'); self.switch.setCheckable(True); self.switch.setAccessibleName('Wi-Fi')
        self.switch.setChecked(bool(st.get('wifi_on'))); self.switch.setText('On' if self.switch.isChecked() else 'Off')
        self.switch.setEnabled(st.get('wifi_on') is not None); self.switch.toggled.connect(self.toggle_wifi)
        head.addWidget(self.switch); self.v.addLayout(head)
        self.list_widget=QWidget(); self.list_layout=QVBoxLayout(self.list_widget); self.list_layout.setContentsMargins(0,0,0,0); self.list_layout.setSpacing(3)
        scroll=QScrollArea(); scroll.setWidgetResizable(True); scroll.setFrameShape(QFrame.NoFrame); scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        scroll.setWidget(self.list_widget); scroll.setFixedHeight(250); self.v.addWidget(scroll)
        self.message=QLabel(''); self.message.setObjectName('popHint'); self.message.setWordWrap(True); self.v.addWidget(self.message)
        foot=QHBoxLayout()
        refresh=QPushButton(get_icon('view-refresh'),' Refresh'); refresh.clicked.connect(self.scan); foot.addWidget(refresh)
        settings=QPushButton(get_icon('preferences-system-network','preferences-system'),' Network Settings'); settings.clicked.connect(lambda: (self.close(), launch_app('nm-connection-editor'))); foot.addWidget(settings)
        self.v.addLayout(foot)
        self.worker=None; self.scan()

    @staticmethod
    def status_text(st):
        if st.get('net') == 'wifi': return f"Connected to {st.get('connection') or 'Wi-Fi'}"
        if st.get('net') == 'ethernet': return 'Ethernet connected'
        return 'Not connected'

    def show_message(self, text):
        self.clear_list(); lab=QLabel(text); lab.setObjectName('popSub'); lab.setAlignment(Qt.AlignCenter); lab.setWordWrap(True)
        self.list_layout.addWidget(lab); self.list_layout.addStretch()

    def clear_list(self):
        while self.list_layout.count():
            item=self.list_layout.takeAt(0)
            if item.widget(): item.widget().deleteLater()

    def scan(self):
        if self.worker is not None: return
        if self.panel.last_status.get('wifi_on') is False:
            self.show_message('Wi-Fi is off.'); return
        self.show_message('Searching for Wi-Fi networks…')
        # Parented to the panel: the popup may close while nmcli still scans.
        worker=WifiScanWorker(self.panel); self.worker=worker
        worker.ready.connect(self.fill); worker.finished.connect(self._scan_done); worker.finished.connect(worker.deleteLater); worker.start()

    def _scan_done(self):
        self.worker=None

    def closeEvent(self, e):
        if self.worker is not None:
            try:
                self.worker.ready.disconnect(self.fill); self.worker.finished.disconnect(self._scan_done)
            except (TypeError, RuntimeError):
                pass
            self.worker=None
        super().closeEvent(e)

    def fill(self, result):
        if not result.get('nm'):
            self.show_message('NetworkManager is not available.'); return
        nets=result.get('networks') or []
        if not nets:
            self.show_message('No Wi-Fi networks found.'); return
        self.clear_list(); known=result.get('known') or set()
        for n in nets[:20]:
            row=QPushButton(); row.setObjectName('netRow'); row.setProperty('active', n['active']); row.setCursor(Qt.PointingHandCursor)
            row.setAccessibleName(f"{n['ssid']}, signal {n['signal']} percent" + (', secured' if n['secure'] else '') + (', connected' if n['active'] else ''))
            lay=QHBoxLayout(row); lay.setContentsMargins(8,4,8,4); lay.setSpacing(8)
            ic=QLabel(); ic.setPixmap(get_icon(_signal_icon(n['signal']),'network-wireless').pixmap(20,20)); lay.addWidget(ic)
            name=QLabel(n['ssid']); name.setStyleSheet('font-weight:%s;' % ('800' if n['active'] else '600')); lay.addWidget(name,1)
            if n['active']:
                tag=QLabel('Connected'); tag.setStyleSheet('color:#00875f;font-weight:700;font-size:11px;'); lay.addWidget(tag)
            if n['secure']:
                lock=QLabel(); lock.setPixmap(get_icon('network-wireless-encrypted','changes-prevent').pixmap(14,14)); lay.addWidget(lock)
            for w in row.findChildren(QLabel): w.setAttribute(Qt.WA_TransparentForMouseEvents)
            row.setMinimumHeight(38)
            row.clicked.connect(lambda _=False, net=n, k=(n['ssid'] in known): self.choose(net, k))
            self.list_layout.addWidget(row)
        self.list_layout.addStretch()

    def toggle_wifi(self, on):
        self.switch.setText('On' if on else 'Off')
        safe_popen(['nmcli','radio','wifi','on' if on else 'off'])
        self.panel.last_status['wifi_on']=on
        if on: QTimer.singleShot(2500, self.scan)
        else: self.show_message('Wi-Fi is off.')
        QTimer.singleShot(800, self.panel.update_status_icons)

    def choose(self, net, known):
        ssid=net['ssid']
        if net['active']:
            m=RoundedMenu(self); m.addAction(get_icon('network-disconnect','process-stop'),'Disconnect', lambda: self.panel.run_network(['nmcli','connection','down','id',ssid], f'Disconnected from {ssid}.'))
            m.exec_(QCursor.pos()); return
        if known:
            self.close(); self.panel.run_network(['nmcli','connection','up','id',ssid], f'Connected to {ssid}.'); return
        if net['secure']:
            self.close()
            password, ok = QInputDialog.getText(None, 'Connect to Wi-Fi', f'Password for “{ssid}”:', QLineEdit.Password)
            if not ok or not password: return
            self.panel.run_network(['nmcli','device','wifi','connect',ssid,'password',password], f'Connected to {ssid}.')
            return
        self.close(); self.panel.run_network(['nmcli','device','wifi','connect',ssid], f'Connected to {ssid}.')


class SinkWorker(QThread):
    ready=pyqtSignal(object)
    def run(self):
        sinks=[]; current={}
        for line in (_run_text(['pactl','list','sinks'], timeout=3) or '').splitlines():
            line=line.strip()
            if line.startswith('Sink #'):
                current={}; sinks.append(current)
            elif line.startswith('Name:') and sinks:
                current['name']=line.split(':',1)[1].strip()
            elif line.startswith('Description:') and sinks:
                current['description']=line.split(':',1)[1].strip()
        default=(_run_text(['pactl','get-default-sink']) or '').strip()
        self.ready.emit({'sinks':[x for x in sinks if x.get('name')], 'default':default})


class SoundPopup(PopupFrame):
    """Volume, mute and output device."""
    def __init__(self, panel):
        super().__init__(panel); self.panel=panel
        self.box.setFixedWidth(330); self.setAccessibleName('Sound')
        st=panel.last_status or {}
        head, self.head_icon, self.subtitle = popup_header('audio-volume-high','Sound','Output device')
        self.v.addLayout(head)
        card=QFrame(); card.setObjectName('acCard'); row=QHBoxLayout(card); row.setContentsMargins(10,8,12,8); row.setSpacing(10)
        self.mute=QToolButton(); self.mute.setObjectName('roundIcon'); self.mute.setCheckable(True); self.mute.setIconSize(QSize(20,20)); self.mute.setAccessibleName('Mute')
        self.mute.setChecked(bool(st.get('muted'))); self.mute.toggled.connect(self.toggle_mute); row.addWidget(self.mute)
        self.slider=QSlider(Qt.Horizontal); self.slider.setRange(0,100); self.slider.setAccessibleName('Volume'); row.addWidget(self.slider,1)
        self.value=QLabel(''); self.value.setFixedWidth(42); self.value.setAlignment(Qt.AlignRight|Qt.AlignVCenter); row.addWidget(self.value)
        vol=st.get('volume'); self.slider.setEnabled(vol is not None); self.slider.setValue(50 if vol is None else int(vol)); self.value.setText(f'{self.slider.value()}%' if vol is not None else '—')
        self.v.addWidget(card)
        self.devices=QComboBox(); self.devices.setAccessibleName('Output device'); self.devices.setVisible(False); self.devices.activated.connect(self.choose_device); self.v.addWidget(self.devices)
        foot=QHBoxLayout()
        settings=QPushButton(get_icon('preferences-desktop-sound','audio-volume-high'),' Sound Settings'); settings.clicked.connect(lambda: (self.close(), launch_app('pavucontrol-qt'))); foot.addWidget(settings)
        self.v.addLayout(foot)
        self._timer=QTimer(self); self._timer.setSingleShot(True); self._timer.timeout.connect(self.apply_volume)
        self.slider.valueChanged.connect(lambda v: (self.value.setText(f'{v}%'), self.update_icons(), self._timer.start(60)))
        self.update_icons()
        worker=SinkWorker(panel); self.worker=worker
        worker.ready.connect(self.fill_devices); worker.finished.connect(worker.deleteLater); worker.start()

    def update_icons(self):
        muted=self.mute.isChecked(); v=self.slider.value()
        name='audio-volume-muted' if muted or v == 0 else ('audio-volume-low' if v < 34 else 'audio-volume-medium' if v < 67 else 'audio-volume-high')
        self.mute.setIcon(get_icon(name,'audio-volume-high')); self.head_icon.setPixmap(get_icon(name,'audio-volume-high').pixmap(30,30))

    def fill_devices(self, data):
        sinks=data.get('sinks') or []
        current=next((s for s in sinks if s.get('name') == data.get('default')), sinks[0] if sinks else None)
        self.subtitle.setText((current or {}).get('description') or ('No output device' if not sinks else 'Output device'))
        if len(sinks) > 1:
            for sink in sinks:
                self.devices.addItem(get_icon('audio-card','audio-speakers'), sink.get('description') or sink['name'], sink['name'])
            self.devices.setCurrentIndex(max(0, self.devices.findData(data.get('default'))))
            self.devices.setVisible(True); self.adjustSize()

    def choose_device(self, index):
        name=self.devices.itemData(index)
        if name:
            safe_popen(['pactl','set-default-sink',name]); self.subtitle.setText(self.devices.itemText(index))
            QTimer.singleShot(400, self.panel.update_status_icons)

    def toggle_mute(self, on):
        safe_popen(['pactl','set-sink-mute','@DEFAULT_SINK@','1' if on else '0'])
        self.panel.last_status['muted']=on; self.update_icons(); QTimer.singleShot(300, self.panel.update_status_icons)

    def apply_volume(self):
        v=self.slider.value(); self.panel.last_status['volume']=v
        safe_popen(['pactl','set-sink-volume','@DEFAULT_SINK@',f'{v}%'])
        QTimer.singleShot(400, self.panel.update_status_icons)

    def closeEvent(self, e):
        try: self.worker.ready.disconnect(self.fill_devices)
        except (TypeError, RuntimeError): pass
        super().closeEvent(e)


class EdukaPanel(QWidget):
    def __init__(self):
        super().__init__(); ensure_dirs(); icon_theme_setup(); self.setWindowTitle('Eduka-Panel')
        self.setWindowFlags(Qt.FramelessWindowHint | Qt.Window | Qt.WindowStaysOnTopHint); self.setAttribute(Qt.WA_ShowWithoutActivating)
        # Transparent only with a compositor; otherwise X11 paints the
        # transparent parts black. watch_compositor() restarts the panel when
        # a compositor starts or stops.
        self._composited=compositor_running(force=True)
        if self._composited: self.setAttribute(Qt.WA_TranslucentBackground)
        try: self.setAttribute(Qt.WA_X11DoNotAcceptFocus, True)
        except (AttributeError, TypeError): pass
        self.tasks={}; self.buttons={}; self.pinned_buttons={}; self.quick_launchers={}; self.icon_geometry_cache={}; self.current_cfg={}; self._last_active_wid=''; self._fullscreen_hidden=False; self._fullscreen_wid=''; self._hidden_reason=''; self.hearing_accessibility=False; self.eus_status={}; self._ewmh_cache={}
        self._tray_compact=False; self._showing_desktop=False; self._spy=None
        self.edge='Bottom'; self.vertical=False; self.thickness=42
        self.last_status={}; self._status_worker=None; self._status_again=False; self.action_center=None; self._action_center_closed_at=0.0
        self._app_match_cache={}; self._app_match_stamp=None; self._task_order=[]; self._button_seq=0
        self.notifications=NotificationCenter(self); self.notifications.changed.connect(self.update_notification_badge)
        self.build_ui(); self.load_config(); self.setup_watcher(); self.setup_screen_tracking()
        QApplication.instance().aboutToQuit.connect(self.notifications.stop)
        # Eduka-Panel shows every notification itself (LXQt's daemon is stopped).
        self.notify_server=NotificationServer(self, self.notifications)
        self.clock_timer=QTimer(self); self.clock_timer.timeout.connect(self.update_clock); self.clock_timer.start(1000); self.update_clock()
        self.task_timer=QTimer(self); self.task_timer.timeout.connect(self.update_tasks); self.task_timer.start(900); self.update_tasks()
        self.status_timer=QTimer(self); self.status_timer.timeout.connect(self.update_status_icons); self.status_timer.start(2500); self.update_status_icons()
        self.workarea_timer=QTimer(self); self.workarea_timer.timeout.connect(self.enforce_window_space); self.workarea_timer.start(1400)
        self.start_window_spy()
        # Software brightness (no backlight) is lost at logout: re-apply it.
        QTimer.singleShot(1500, restore_software_brightness)
        # Openbox has no compositor: start picom so transparency works.
        QTimer.singleShot(0, ensure_compositor)
        self._compositor_watch=watch_compositor(self, before_restart=self.stop_window_spy, initial=self._composited)
        # Eduka-Panel replaces lxqt-panel, but only in Eduka-Desktop sessions.
        QTimer.singleShot(2500, stop_lxqt_panel_in_eduka_session)
        QTimer.singleShot(9000, stop_lxqt_panel_in_eduka_session)
        QTimer.singleShot(2500, stop_lxqt_notifications_in_eduka_session)
        QTimer.singleShot(500, lambda: safe_popen(['eduka-app-cache','--warm']))
        QTimer.singleShot(900, lambda: safe_popen(['eduka-menu','--daemon']))
    def build_ui(self):
        outer=QVBoxLayout(self); outer.setContentsMargins(0,0,0,0); self.bg=QFrame(); self.bg.setObjectName('panelBg'); outer.addWidget(self.bg)
        # Panel shadow is optional. Default OFF for 512MB/old CPU target.
        self.bg.setGraphicsEffect(None)
        self.layout=QBoxLayout(QBoxLayout.LeftToRight, self.bg); self.layout.setContentsMargins(10,4,10,4); self.layout.setSpacing(7)
        self.bg.setContextMenuPolicy(Qt.CustomContextMenu); self.bg.customContextMenuRequested.connect(self.panel_context)
        self.start=QPushButton(); self.start.setObjectName('startButton'); self.start.setAccessibleName('Edukasaun application menu'); self.start.clicked.connect(self.toggle_menu); self.start.setContextMenuPolicy(Qt.CustomContextMenu); self.start.customContextMenuRequested.connect(self.start_context); self.layout.addWidget(self.start)
        for kind, name, icon, cmd in [('files','File Manager','system-file-manager','pcmanfm-qt'),('terminal','Terminal','utilities-terminal','qterminal')]:
            b=QPushButton(); b.setToolTip(name); b.setAccessibleName(name); b.setObjectName('launcherButton'); b.setIcon(get_icon(icon)); b.clicked.connect(lambda _,c=cmd: launch_app(c))
            b.setContextMenuPolicy(Qt.CustomContextMenu)
            b.customContextMenuRequested.connect(lambda pos,k=kind,w=b: self.launcher_context(k,w,pos))
            self.quick_launchers[kind]=b; self.layout.addWidget(b)
        self.task_area=QWidget(); self.task_area.setObjectName('taskArea'); self.task_area.setStyleSheet('QWidget#taskArea{background:transparent;}'); self.task_area.setMinimumWidth(80); self.task_area.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed); self.task_area.setContextMenuPolicy(Qt.CustomContextMenu); self.task_area.customContextMenuRequested.connect(self.panel_context); self.task_layout=QBoxLayout(QBoxLayout.LeftToRight, self.task_area); self.task_layout.setContentsMargins(0,0,0,0); self.task_layout.setSpacing(6); self.task_layout.setAlignment(Qt.AlignLeft | Qt.AlignVCenter); self.layout.addWidget(self.task_area,1)
        self.net=QPushButton(); self.net.setObjectName('trayButton'); self.net.clicked.connect(self.network_popup); self.net.setContextMenuPolicy(Qt.CustomContextMenu); self.net.customContextMenuRequested.connect(self.network_context)
        self.bt=QPushButton(); self.bt.setObjectName('trayButton'); self.bt.clicked.connect(self.bluetooth_popup); self.bt.setContextMenuPolicy(Qt.CustomContextMenu); self.bt.customContextMenuRequested.connect(self.bluetooth_context)
        self.printer=QPushButton(); self.printer.setObjectName('trayButton'); self.printer.clicked.connect(lambda: launch_app('system-config-printer')); self.printer.setContextMenuPolicy(Qt.CustomContextMenu); self.printer.customContextMenuRequested.connect(self.printer_context)
        self.battery=QPushButton(); self.battery.setObjectName('batteryButton'); self.battery.clicked.connect(self.battery_popup); self.battery.setContextMenuPolicy(Qt.CustomContextMenu); self.battery.customContextMenuRequested.connect(self.battery_context)
        self.vol=QPushButton(); self.vol.setObjectName('trayButton'); self.vol.clicked.connect(self.volume_popup); self.vol.setContextMenuPolicy(Qt.CustomContextMenu); self.vol.customContextMenuRequested.connect(self.volume_context)
        self.eus=QPushButton(); self.eus.setObjectName('updateButton'); self.eus.setVisible(False); self.eus.clicked.connect(self.open_eus); self.eus.setContextMenuPolicy(Qt.CustomContextMenu); self.eus.customContextMenuRequested.connect(self.eus_context)
        self.notif=QPushButton(); self.notif.setObjectName('trayButton'); self.notif.setIcon(get_icon('preferences-system-notifications')); self.notif.clicked.connect(self.notification_popup); self.notif.setContextMenuPolicy(Qt.CustomContextMenu); self.notif.customContextMenuRequested.connect(self.notification_context)
        self.lang=QLabel('EN'); self.lang.setObjectName('langLabel'); self.lang.setContextMenuPolicy(Qt.CustomContextMenu); self.lang.customContextMenuRequested.connect(self.language_context)
        self.clock=QPushButton(); self.clock.setObjectName('clockButton'); self.clock.clicked.connect(self.toggle_action_center); self.clock.setContextMenuPolicy(Qt.CustomContextMenu); self.clock.customContextMenuRequested.connect(self.clock_context)
        for button,name in [(self.net,'Network'),(self.bt,'Bluetooth'),(self.printer,'Printers'),(self.battery,'Battery'),(self.vol,'Volume'),(self.eus,'Eduka Update System'),(self.notif,'Notifications'),(self.clock,'Clock and calendar')]: button.setAccessibleName(name)
        # Status icons and the clock sit together in one rounded tray group.
        self.tray=QFrame(); self.tray.setObjectName('trayGroup'); self.tray.setContextMenuPolicy(Qt.CustomContextMenu); self.tray.customContextMenuRequested.connect(self.panel_context)
