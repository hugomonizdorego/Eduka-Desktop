        self.globe_info=QLabel(''); self.globe_info.setObjectName('acDate'); self.globe_info.setAlignment(Qt.AlignCenter); gl.addWidget(self.globe_info)
        self.clock_stack.addWidget(globe_page)
        # Third page: the time zone map (click the globe again).
        zone_page=QWidget(); zl=QVBoxLayout(zone_page); zl.setContentsMargins(8,8,8,8); zl.setSpacing(4)
        self.zone_map=TimeZoneMap(); self.zone_map.clicked.connect(self.show_clock); zl.addWidget(self.zone_map, 0, Qt.AlignHCenter)
        self.zone_info=QLabel(''); self.zone_info.setObjectName('acDate'); self.zone_info.setAlignment(Qt.AlignCenter); self.zone_info.setWordWrap(True); zl.addWidget(self.zone_info)
        self.clock_stack.addWidget(zone_page)
        # A stacked widget is as tall as its tallest page: size only by the visible one.
        self.clock_stack.currentChanged.connect(self._stack_sizes); self._stack_sizes(0)
        self.clock_card.setContextMenuPolicy(Qt.CustomContextMenu); self.clock_card.customContextMenuRequested.connect(self.clock_menu)
        self.clock_card.setToolTip('Click the clock for the world globe • Right-click: clock style')
        self.v.addWidget(self.clock_card)
        # Everything between the clock and the session buttons scrolls when
        # the screen is too small, so the Action Center never runs off screen.
        self.body=QWidget(); self.body.setObjectName('acBody'); self.bv=QVBoxLayout(self.body); self.bv.setContentsMargins(0,0,0,0); self.bv.setSpacing(8)
        self.scroll=QScrollArea(); self.scroll.setWidgetResizable(True); self.scroll.setFrameShape(QFrame.NoFrame)
        self.scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff); self.scroll.setWidget(self.body)
