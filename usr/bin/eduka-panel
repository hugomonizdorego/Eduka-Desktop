            self.bg.setStyleSheet(self.bg.styleSheet()+f'''QFrame#panelBg{{background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 rgba(52,52,52,{bg_alpha}),stop:1 rgba(33,33,33,{bg_alpha}));border:1px solid rgba(255,255,255,40);border-bottom:1px solid rgba(0,0,0,90);border-radius:{radius}px;}}
            QPushButton#startButton{{background:#26A69A;border:1px solid #26A69A;color:#ffffff;}} QPushButton#startButton:hover{{background:#4DB6AC;}}
            QPushButton#taskButton{{background:transparent;border:1px solid transparent;border-bottom:3px solid transparent;color:rgba(255,255,255,225);}}
