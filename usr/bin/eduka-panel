    def open_eus(self):
        launch_app('/usr/local/bin/eduka-update-system --ui', 'Eduka Update System')

    def eus_context(self, pos):
        m=RoundedMenu(self)
        m.addAction(get_icon(str(EUS_ICON_DIR/'eus-update-available.png'),'system-software-update'), 'Open Eduka Update System', self.open_eus)
        count=max(0, int(self.eus_status.get('count',0) or 0))
        status=m.addAction(f'{count} update{"s" if count != 1 else ""} available')
        status.setEnabled(False)
        self._show_context(m, self.eus, pos)

    def update_eus_status(self):
        """Consume the stable EUS v1 panel protocol without owning EUS state."""
        data={}
        try:
            if EUS_PANEL_STATUS_PATH.is_file() and EUS_PANEL_STATUS_PATH.stat().st_size <= 65536:
                candidate=json.loads(EUS_PANEL_STATUS_PATH.read_text(encoding='utf-8'))
                if isinstance(candidate, dict) and int(candidate.get('version',0)) == 1:
                    data=candidate
        except Exception:
            data={}
        state=str(data.get('state','hidden')).strip().casefold()
        try: count=max(0, int(data.get('count',0) or 0))
        except (TypeError, ValueError): count=0
        visible=state == 'available' and count > 0
        self.eus_status=data if visible else {}
        self.eus.setVisible(visible)
        if not visible:
            self.eus.setText('')
            return
        icon_path=EUS_ICON_DIR/'eus-update-available.png'
        self.eus.setIcon(get_icon(str(icon_path),'system-software-update'))
        message=str(data.get('message','')).strip() or f'{count} update{"s" if count != 1 else ""} available'
        self.eus.setToolTip(message+' — Click to open Eduka Update System')
        self.eus.setAccessibleName(f'Eduka Update System: {count} update{"s" if count != 1 else ""} available')
        self.eus.setText(f' {count} Updates' if self.hearing_accessibility else '')

    def language_context(self, pos):
        m=RoundedMenu(self)
        m.addAction(get_icon('preferences-desktop-locale'), 'Language Settings', lambda: launch_app('lxqt-config-locale'))
        m.addAction(get_icon('input-keyboard'), 'Keyboard Settings', lambda: launch_app('lxqt-config-input'))
        self._show_context(m, self.lang, pos)

    def clock_context(self, pos):
        m=RoundedMenu(self)
        m.addAction(get_icon('office-calendar'), 'Action Center', self.toggle_action_center)
        m.addAction(get_icon('preferences-system-time'), 'Date and Time Settings', lambda: launch_app('lxqt-admin-time'))
        self._show_context(m, self.clock, pos)

    def update_status_icons(self):
        """Refresh tray state in a worker thread (nmcli/pactl can be slow)."""
        self.update_eus_status()
        if self._status_worker is not None:
            self._status_again=True
            return
        worker=StatusWorker(self); worker.ready.connect(self.apply_status); worker.finished.connect(self._status_finished)
        self._status_worker=worker; worker.start()

    def _status_finished(self):
        if self._status_worker is not None:
            self._status_worker.deleteLater(); self._status_worker=None
        if self._status_again:
            self._status_again=False; QTimer.singleShot(0, self.update_status_icons)

    def apply_status(self, st):
        self.last_status=st
        text=st.get('layout','EN')
        if self.lang.text() != text: self.lang.setText(text)
        self.lang.setToolTip(f'Keyboard layout: {text}'); self.lang.setAccessibleName(f'Keyboard layout {text}')
        net=st.get('net','offline')
        nicon={'wifi':'network-wireless','ethernet':'network-wired'}.get(net,'network-offline')
        tip={'wifi':'Wi-Fi connected'+(f": {st.get('connection')}" if st.get('connection') else ''),'ethernet':'Ethernet connected'}.get(net,'Offline')
        self.net.setIcon(get_icon(nicon,'network-transmit-receive')); self.net.setToolTip(tip); self.net.setAccessibleName('Network: '+tip); self.net.setText(' '+tip.split(':')[0].replace(' connected','') if self.hearing_accessibility else '')
        info=st.get('battery'); self.battery.setVisible(info is not None)
        if info:
            status=str(info['status']).lower(); self.battery.setIcon(get_icon('battery-good-charging' if 'charg' in status else 'battery-good', 'battery')); self.battery.setText(f" {info['capacity']}%")
            self.battery.setToolTip(f"Battery {info['capacity']}% • {info['status']}")
        self.bt.setVisible(bool(st.get('bt_hw'))); self.bt.setIcon(get_icon('bluetooth','preferences-system-bluetooth'))
        self.bt.setToolTip('Bluetooth on' if st.get('bt_on') else 'Bluetooth off')
        self.printer.setVisible(bool(st.get('printers'))); self.printer.setIcon(get_icon('printer','printer'))
        muted=bool(st.get('muted')); vol=st.get('volume')
        volume_status=('Muted' if muted else 'Volume')+(f': {vol}%' if vol is not None else '')
        self.vol.setIcon(get_icon('audio-volume-muted' if muted else 'audio-volume-high','audio-volume-medium')); self.vol.setToolTip(volume_status); self.vol.setAccessibleName(volume_status); self.vol.setText(' '+volume_status if self.hearing_accessibility else '')
        self.notif.setText(' Alerts' if self.hearing_accessibility else ''); self.notif.setToolTip('Notifications and visual alerts'); self.notif.setAccessibleName('Notifications and visual alerts')
        if self.action_center is not None and self.action_center.isVisible():
            self.action_center.refresh(st)

    def toggle_action_center(self):
        if self.action_center is not None and self.action_center.isVisible():
            self.action_center.close(); return
        # Clicking the clock while the popup is open first closes the popup
        # (Qt.Popup); do not reopen it from that same click.
        if time.monotonic() - self._action_center_closed_at < 0.3:
            return
        ac=ActionCenter(self); self.action_center=ac
        ac.destroyed.connect(lambda *_: setattr(self, 'action_center', None))
        ac.adjustSize()
        screen=QApplication.primaryScreen().availableGeometry()
        x=min(self.x()+self.width()-ac.width(), screen.right()-ac.width()-4); x=max(screen.x()+4, x)
        y=self.y()-ac.height()-8
        ac.move(x, y); ac.show(); ac.activateWindow()
        self.update_status_icons()

    def wheelEvent(self,e):
        if self.vol.underMouse(): self.change_volume(5 if e.angleDelta().y()>0 else -5)
    def change_volume(self,delta):
        # Stay within 0-100 % so scrolling over the icon cannot distort speakers.
        current=self.last_status.get('volume')
        current=50 if current is None else int(current)
        target=max(0, min(100, current+delta))
        self.last_status['volume']=target
        self.vol.setToolTip(f'Volume: {target}%')
        safe_popen(['pactl','set-sink-volume','@DEFAULT_SINK@',f'{target}%']); QTimer.singleShot(250, self.update_status_icons)
    def show_popup_above(self,popup,anchor):
        popup.adjustSize(); g=anchor.mapToGlobal(QPoint(anchor.width()//2,0)); x=g.x()-popup.width()//2; y=self.y()-popup.height()-8; screen=QApplication.primaryScreen().availableGeometry(); x=max(screen.x()+6,min(x,screen.right()-popup.width()-6)); popup.move(x,y); popup.show()
    def volume_popup(self):
        p=PopupFrame(self); p.resize(270,125); p.v.addWidget(QLabel('<b>Sound</b>')); slider=QSlider(Qt.Horizontal); slider.setRange(0,100)
        vol=self.last_status.get('volume'); slider.setValue(50 if vol is None else int(vol))
        slider.valueChanged.connect(lambda v: safe_popen(['pactl','set-sink-volume','@DEFAULT_SINK@',f'{v}%'])); p.v.addWidget(slider)
        row=QHBoxLayout(); row.addWidget(QPushButton('Mute')); row.addWidget(QPushButton('Sound Settings')); row.itemAt(0).widget().clicked.connect(lambda: (safe_popen(['pactl','set-sink-mute','@DEFAULT_SINK@','toggle']), self.update_status_icons())); row.itemAt(1).widget().clicked.connect(lambda: launch_app('pavucontrol-qt')); p.v.addLayout(row); self.show_popup_above(p,self.vol)
    def notification_popup(self): p=PopupFrame(self); p.v.addWidget(QLabel('<b>Notifications</b>')); p.v.addWidget(QLabel('No new notifications')); self.show_popup_above(p,self.notif)
    def battery_info(self):
        return battery_info()
    def battery_popup(self): info=self.battery_info(); p=PopupFrame(self); p.v.addWidget(QLabel('<b>Battery</b>')); p.v.addWidget(QLabel(f"{info['capacity']}% • {info['status']}" if info else 'No battery detected')); self.show_popup_above(p,self.battery)
    def bluetooth_popup(self): p=PopupFrame(self); p.v.addWidget(QLabel('<b>Bluetooth</b>')); p.v.addWidget(QLabel('Use Bluetooth manager to pair devices.')); b=QPushButton('Open Bluetooth'); b.clicked.connect(lambda: launch_app('blueman-manager')); p.v.addWidget(b); self.show_popup_above(p,self.bt)
    def network_popup(self):
        p=PopupFrame(self); p.resize(310,230); p.v.addWidget(QLabel('<b>Network</b>'))
        try:
            out=subprocess.check_output(['nmcli','-t','-f','SSID,SIGNAL,SECURITY','device','wifi','list','--rescan','no'], text=True, stderr=subprocess.DEVNULL, timeout=2); rows=[]
            for r in out.splitlines():
                parts=r.split(':');
                if parts and parts[0] and parts[0] not in rows: rows.append(parts[0])
            if not rows: p.v.addWidget(QLabel('No Wi-Fi networks found'))
            for ssid in rows[:7]:
                btn=QPushButton(ssid); btn.clicked.connect(lambda _,s=ssid: self.connect_wifi(s)); p.v.addWidget(btn)
        except Exception: p.v.addWidget(QLabel('NetworkManager not available'))
        self.show_popup_above(p,self.net)
    def connect_wifi(self, ssid):
        if not safe_popen(['nmcli','device','wifi','connect',ssid]): launch_app('nm-connection-editor')
    def calendar_popup(self):
        self.toggle_action_center()

PANEL_LOCK = RUNTIME_DIR/'panel.lock'

def acquire_panel_lock(wait_seconds=3.0):
    """Keep one Eduka-Panel per session.

    'Restart Eduka-Panel' starts the new panel right after pkill, so wait a
    moment for the old process to release the lock instead of giving up.
    """
    ensure_dirs()
    lock_file=open(PANEL_LOCK, 'w')
    deadline=time.monotonic()+wait_seconds
    while True:
        try:
            fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return lock_file
        except OSError:
            if time.monotonic() >= deadline:
                lock_file.close(); return None
            time.sleep(0.1)

if __name__ == '__main__':
    panel_lock=acquire_panel_lock()
    if panel_lock is None:
        print('Eduka-Panel is already running.', file=sys.stderr); sys.exit(0)
    app=QApplication(sys.argv); app.setApplicationName('eduka-panel'); icon_theme_setup(); panel=EdukaPanel()
    if not panel._fullscreen_hidden: panel.show()
    registry_update('panel', {'pid': os.getpid(), 'running': True}); sys.exit(app.exec_())
