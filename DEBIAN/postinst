#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Edukasaun Desktop: system-wide setup after the files are installed.
# Nothing here writes into the users' home folders or stops running
# programs: Eduka-Panel and Eduka-Desktop restart by themselves after an
# update, and the per-user LXQt settings are made at login
# (eduka-desktop-session) by the user's own session.
set -e

UNITS="eduka-live-autologin.service eduka-parental.service"

case "$1" in
    configure)
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        # The files of this version are in place again.
        if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ] && command -v deb-systemd-invoke >/dev/null 2>&1; then
            deb-systemd-invoke start eduka-parental.service >/dev/null 2>&1 || true
        fi
        exit 0
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

# Old copies set aside by preinst (the files in /etc are conffiles now).
for f in /etc/sddm.conf.d/10-edukasaun.conf /etc/xdg/autostart/eduka-panel.desktop \
         /etc/xdg/autostart/eduka-menu-daemon.desktop; do
    rm -f "$f.eduka-old"
done

# Versions before 0.10.0~beta3 wrote an LXQt notification override into
# /etc/skel. Eduka-Panel now stops lxqt-notificationd itself in
# Eduka-Desktop sessions, so plain LXQt sessions keep their notifications.
if [ -n "$2" ] && dpkg --compare-versions "$2" lt-nl 0.10.0~beta3; then
    skel_override=/etc/skel/.config/autostart/lxqt-notifications.desktop
    if [ -f "$skel_override" ] && [ ! -L "$skel_override" ] && grep -qs 'Disabled by Edukasaun Desktop' "$skel_override"; then
        rm -f "$skel_override"
        rmdir --ignore-fail-on-non-empty /etc/skel/.config/autostart /etc/skel/.config 2>/dev/null || true
    fi
fi

# --- Login screen: only Eduka-Desktop -----------------------------------
# Hide the other session entries (LXQt, Openbox, labwc, ...) from SDDM,
# LightDM and other greeters with dpkg-divert: the files are moved, not
# deleted, the programs stay installed (openbox/xfwm4 still run as the window
# manager inside Eduka-Desktop), and removing this package restores them.
hidden_dir=/usr/share/edukasaun-desktop/hidden-sessions
for entry in \
    /usr/share/xsessions/lxqt.desktop \
    /usr/share/xsessions/openbox.desktop \
    /usr/share/xsessions/openbox-kde.desktop \
    /usr/share/wayland-sessions/labwc.desktop \
    /usr/share/wayland-sessions/lxqt-wayland.desktop; do
    kind=$(basename "$(dirname "$entry")")
    target="$hidden_dir/$kind/$(basename "$entry")"
    owner=$(dpkg-divert --listpackage "$entry" 2>/dev/null || true)
    if [ "$owner" = "edukasaun-desktop-menu" ]; then
        continue
    fi
    if [ -z "$owner" ]; then
        mkdir -p "$hidden_dir/$kind"
        dpkg-divert --package edukasaun-desktop-menu --add --rename --divert "$target" "$entry" >/dev/null 2>&1 || true
    fi
done
# The Eduka-Desktop Wayland preview entry of 0.9.12/0.9.13 is no longer shipped.
rm -f /usr/share/wayland-sessions/edukasaun-desktop-wayland.desktop 2>/dev/null || true

# SDDM autologin pointing to a now hidden session would fail: use Eduka-Desktop.
for conf in /etc/sddm.conf /etc/sddm.conf.d/*.conf; do
    [ -f "$conf" ] || continue
    if grep -Eq '^[[:space:]]*Session=(lxqt|openbox|openbox-kde|labwc|lxqt-wayland)(\.desktop)?[[:space:]]*$' "$conf"; then
        sed -i -E 's/^[[:space:]]*Session=(lxqt|openbox|openbox-kde|labwc|lxqt-wayland)(\.desktop)?[[:space:]]*$/Session=edukasaun-desktop.desktop/' "$conf"
    fi
done

# --- Login screen theme -------------------------------------------------
# /etc/sddm.conf is read after /etc/sddm.conf.d; point a theme set there to
# the Edukasaun theme as well.
if [ -f /etc/sddm.conf ] && grep -q '^[[:space:]]*Current=' /etc/sddm.conf; then
    sed -i 's/^[[:space:]]*Current=.*/Current=edukasaun/' /etc/sddm.conf
fi
mkdir -p /usr/share/Edukasaun/SDDM
if [ -d /etc/sddm.conf.d ] || command -v sddm >/dev/null 2>&1; then
    mkdir -p /etc/sddm.conf.d
    printf '# Edukasaun OS: use the Edukasaun login screen (read last).\n[Theme]\nCurrent=edukasaun\n' > /etc/sddm.conf.d/zz-edukasaun-theme.conf
    # The login screen stores the language picked there for the session
    # (eduka-desktop-session checks the user name and the language).
    if getent passwd sddm >/dev/null 2>&1; then
        mkdir -p /var/lib/edukasaun-desktop/login
        chown sddm: /var/lib/edukasaun-desktop/login 2>/dev/null || true
        chmod 0755 /var/lib/edukasaun-desktop/login
    fi
fi
# SDDM 0.21 with only the Qt 6 greeter loads a theme only with QtVersion=6;
# the Edukasaun theme runs on both greeters.
meta=/usr/share/sddm/themes/edukasaun/metadata.desktop
if [ -f "$meta" ]; then
    sed -i '/^QtVersion=/d' "$meta"
    if command -v sddm-greeter-qt6 >/dev/null 2>&1 && ! command -v sddm-greeter >/dev/null 2>&1; then
        echo 'QtVersion=6' >> "$meta"
    fi
fi

# --- Services -------------------------------------------------------------
# eduka-live-autologin only acts when booted with boot=live; on installed
# systems it removes any live autologin file so the login screen asks for a
# password. eduka-parental counts the Parental Control time as root, so
# closing Eduka-Panel does not stop it; it is off until a parent switches it
# on in Eduka-Settings. A service the administrator disabled stays disabled.
mkdir -p /etc/edukasaun-desktop /var/lib/edukasaun-desktop
if command -v deb-systemd-helper >/dev/null 2>&1; then
    for unit in $UNITS; do
        if deb-systemd-helper --quiet was-enabled "$unit"; then
            deb-systemd-helper enable "$unit" >/dev/null || true
        else
            deb-systemd-helper update-state "$unit" >/dev/null || true
        fi
    done
fi
# Not inside the Cubic chroot (no systemd running there).
if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
    if command -v deb-systemd-invoke >/dev/null 2>&1; then
        deb-systemd-invoke restart eduka-parental.service >/dev/null || true
    fi
fi

# --- Standard account edukasaun / edukasaun --------------------------------
# Only while the ISO is built: no personal account exists yet (the Cubic
# chroot). An installed computer with its own users is never changed; there
# 'sudo eduka-default-user' adds the account on request.
# The live system uses this account too (live-config would otherwise add
# a second user "user"), and it is an administrator so the polkit password
# prompt asks for "edukasaun" instead of root.
human=$(getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 && $1 != "nobody" && $1 != "edukasaun" {print $1; exit}')
if [ -z "$human" ]; then
    eduka-default-user >/dev/null 2>&1 || true
    # Accounts made by 0.9.15/0.9.16 have no marker yet.
    getent passwd edukasaun >/dev/null 2>&1 && { mkdir -p /var/lib/edukasaun-desktop; echo edukasaun > /var/lib/edukasaun-desktop/default-user; }
    mkdir -p /etc/live/config.conf.d
    cat > /etc/live/config.conf.d/90-edukasaun.conf <<'CONF'
# Edukasaun OS: the live session uses the standard account edukasaun.
LIVE_USERNAME="edukasaun"
LIVE_USER_FULLNAME="Edukasaun"
CONF
elif getent passwd edukasaun >/dev/null 2>&1 && [ -f /var/lib/edukasaun-desktop/default-user ]; then
    eduka-default-user >/dev/null 2>&1 || true
fi

# SDDM has no "default session" option; it preselects the session stored in
# its state file. Preselect Eduka-Desktop (X11) when nothing is stored, when
# the stored session was removed, or when it is the plain LXQt session.
eduka_session=/usr/share/xsessions/edukasaun-desktop.desktop
state=/var/lib/sddm/state.conf
if [ -d /var/lib/sddm ] && [ ! -L "$state" ]; then
    current=$(sed -n 's/^[[:space:]]*Session=//p' "$state" 2>/dev/null | head -n1)
    update=no
    case "$current" in
        "") update=yes ;;
        *lxqt*.desktop) update=yes ;;
        /*) [ -e "$current" ] || update=yes ;;
        *) [ -e "/usr/share/xsessions/$current" ] || [ -e "/usr/share/wayland-sessions/$current" ] || update=yes ;;
    esac
    if [ "$update" = yes ]; then
        if [ -f "$state" ] && grep -q '^[[:space:]]*Session=' "$state"; then
            sed -i "s|^[[:space:]]*Session=.*|Session=$eduka_session|" "$state"
        elif [ -f "$state" ] && grep -q '^\[Last\]' "$state"; then
            sed -i "/^\[Last\]/a Session=$eduka_session" "$state"
        else
            printf '[Last]\nSession=%s\n' "$eduka_session" >> "$state"
        fi
        if id sddm >/dev/null 2>&1; then chown -h sddm:sddm "$state" 2>/dev/null || true; fi
    fi
fi
exit 0
