#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -e
# Stop the Parental Control service before its files are removed. On an
# upgrade it keeps running until postinst restarts it with the new files.
if [ "$1" = remove ] && [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
    if command -v deb-systemd-invoke >/dev/null 2>&1; then
        deb-systemd-invoke stop eduka-parental.service >/dev/null || true
    fi
fi
# The Edukasaun fingerprint PAM profile goes away with the package: take it
# out of the PAM stack first (Debian policy for packages with a PAM profile).
if [ "$1" = remove ] && command -v pam-auth-update >/dev/null 2>&1; then
    pam-auth-update --package --remove eduka-fingerprint >/dev/null 2>&1 || true
fi
exit 0
